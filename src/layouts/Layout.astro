---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import TopAnnouncementBar from '../components/common/TopAnnouncementBar.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Young Scholars Academy',
	description = 'Premium online learning for gifted learners.',
} = Astro.props;

const topAnnouncementEntry = await getEntry('top-announcement', 'top-announcement');
if (!topAnnouncementEntry) {
	throw new Error('Missing top announcement content at src/content/top-announcement/top-announcement.md');
}
const announcement = topAnnouncementEntry.data;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<TopAnnouncementBar
			message={announcement.message}
			ctaLabel={announcement.ctaLabel}
			ctaHref={announcement.ctaHref}
		/>
		<slot />
	</body>
</html>
