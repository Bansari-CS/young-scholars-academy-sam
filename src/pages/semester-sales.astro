---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { heroData } from '../data/home';
import SemesterSalesHeroSection from '../components/semester-sales/SemesterSalesHeroSection.astro';
import SemesterSalesChallengeSection from '../components/semester-sales/SemesterSalesChallengeSection.astro';
import SemesterSalesAcademySection from '../components/semester-sales/SemesterSalesAcademySection.astro';
import SemesterSalesDifferentThinkersSection from '../components/semester-sales/SemesterSalesDifferentThinkersSection.astro';
import SemesterSalesHowSemesterWorksSection from '../components/semester-sales/SemesterSalesHowSemesterWorksSection.astro';
import SemesterSalesSubjectsSection from '../components/semester-sales/SemesterSalesSubjectsSection.astro';
import SemesterSalesVirtualWorksSection from '../components/semester-sales/SemesterSalesVirtualWorksSection.astro';
import SemesterSalesFamiliesSayingSection from '../components/semester-sales/SemesterSalesFamiliesSayingSection.astro';
import SemesterSalesPricingSection from '../components/semester-sales/SemesterSalesPricingSection.astro';
import SemesterSalesFaqSection from '../components/semester-sales/SemesterSalesFaqSection.astro';
import SemesterSalesFinalCtaSection from '../components/semester-sales/SemesterSalesFinalCtaSection.astro';
import { getEntry } from 'astro:content';

const semesterSalesEntry = await getEntry('semester-sales', 'semester-sales');

if (!semesterSalesEntry) {
	throw new Error(
		'Missing semester sales page content entry at src/content/semester-sales/semester-sales.md',
	);
}

const semesterSalesContent = semesterSalesEntry.data;
---

<Layout
	title={semesterSalesContent.seo.title}
	description={semesterSalesContent.seo.description}
>
	<Header brand="Young Scholars Academy" navItems={heroData.navItems} />
	<main>
		<SemesterSalesHeroSection content={semesterSalesContent.hero} />
		<SemesterSalesChallengeSection content={semesterSalesContent.challenge} />
		<SemesterSalesAcademySection content={semesterSalesContent.academy} />
		<SemesterSalesDifferentThinkersSection content={semesterSalesContent.differentThinkers} />
		<SemesterSalesHowSemesterWorksSection content={semesterSalesContent.howSemesterWorks} />
		<SemesterSalesSubjectsSection content={semesterSalesContent.subjects} />
		<SemesterSalesVirtualWorksSection content={semesterSalesContent.virtualWorks} />
		<SemesterSalesFamiliesSayingSection content={semesterSalesContent.familiesSaying} />
		<SemesterSalesPricingSection content={semesterSalesContent.pricing} />
		<SemesterSalesFaqSection content={semesterSalesContent.faq} />
		<SemesterSalesFinalCtaSection content={semesterSalesContent.finalCta} />
	</main>
	<Footer />
</Layout>
