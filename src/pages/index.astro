---
import Header from '../components/common/Header.astro';
import { heroData } from '../data/home';
import HeroSection from '../components/home/HeroSection.astro';
import TrustStripSection from '../components/home/TrustStripSection.astro';
import LearnerNeedsSection from '../components/home/LearnerNeedsSection.astro';
import ProgramsSection from '../components/home/ProgramsSection.astro';
import MethodologySection from '../components/home/MethodologySection.astro';
import PlatformSection from '../components/home/PlatformSection.astro';
import RealGrowthSection from '../components/common/RealGrowthSection.astro';
import TeachersSection from '../components/home/TeachersSection.astro';
import WorldKidsSection from '../components/home/WorldKidsSection.astro';
import FitCheckSection from '../components/home/FitCheckSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
import CommunityCtaSection from '../components/home/CommunityCtaSection.astro';
import Footer from '../components/common/Footer.astro';
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const homeEntry = await getEntry('home', 'home');

if (!homeEntry) {
	throw new Error('Missing home page content entry at src/content/home/home.md');
}

const homeContent = homeEntry.data;
---

<Layout
	title={homeContent.seo.title}
	description={homeContent.seo.description}
>
	<Header brand="Young Scholars Academy" navItems={heroData.navItems} />
	<main class="block w-full">
		<HeroSection content={homeContent.hero} />
		<TrustStripSection
			title={homeContent.trustStrip.title}
			organizations={homeContent.trustStrip.organizations}
		/>
		<LearnerNeedsSection content={homeContent.learnerNeeds} processContent={homeContent.process} />
		<ProgramsSection content={homeContent.programs} />
		<MethodologySection content={homeContent.methodology} />
		<PlatformSection content={homeContent.platform} />
		<RealGrowthSection content={homeContent.impact} />
		<TeachersSection content={homeContent.teachers} />
		<WorldKidsSection content={homeContent.world} />
		<FitCheckSection content={homeContent.fit} />
		<FaqSection content={homeContent.faq} />
		<CommunityCtaSection content={homeContent.communityCta} />
	</main>
	<Footer />
</Layout>
