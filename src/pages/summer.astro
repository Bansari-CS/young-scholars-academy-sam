---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import SummerHeroSection from '../components/summer/SummerHeroSection.astro';
import SummerStruggleSection from '../components/summer/SummerStruggleSection.astro';
import SummerFullSections from '../components/summer/SummerFullSections.astro';
import { getEntry } from 'astro:content';
import { getSiteNavItems } from '../utils/getSiteNavItems';

const [summerEntry, navItems] = await Promise.all([getEntry('summer', 'summer'), getSiteNavItems()]);

if (!summerEntry) {
	throw new Error('Missing summer page content entry at src/content/summer/summer.md');
}

const summerContent = summerEntry.data;
---

<Layout
	title={summerContent.seo.title}
	description={summerContent.seo.description}
>
	<Header brand="Young Scholars Academy" navItems={navItems} />
	<main>
		<SummerHeroSection content={summerContent.hero} />
		<SummerStruggleSection content={summerContent.struggle} />
		<SummerFullSections content={summerContent} />
	</main>
	<Footer />
</Layout>
