---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import BlogDetailContentSection from '../../components/blog-detail/BlogDetailContentSection.astro';
import BlogDetailRelatedSection from '../../components/blog-detail/BlogDetailRelatedSection.astro';
import BlogDetailFinalCtaSection from '../../components/blog-detail/BlogDetailFinalCtaSection.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { heroData } from '../../data/home';

export async function getStaticPaths() {
	const [blogDetailEntry] = await getCollection('blog-detail');
	const blogPageEntry = await getEntry('blog-page', 'blog-page');
	if (!blogDetailEntry) return [];
	const slugs = new Set<string>([blogDetailEntry.data.slug]);
	for (const item of blogPageEntry?.data?.latestArticles?.items ?? []) slugs.add(item.slug);
	return Array.from(slugs).map((slug) => ({ params: { slug } }));
}

const [blogDetailEntry] = await getCollection('blog-detail');

if (!blogDetailEntry) {
	throw new Error('Missing blog detail content entry in src/content/blog-detail/');
}

if (Astro.params.slug !== blogDetailEntry.data.slug) {
	return Astro.redirect(`/blog/${blogDetailEntry.data.slug}`);
}

const { Content } = await render(blogDetailEntry);
---

<Layout title={blogDetailEntry.data.seo.title} description={blogDetailEntry.data.seo.description}>
	<Header brand="Young Scholars Academy" navItems={heroData.navItems} />
	<main class="bg-[#f8fafc] pt-12 pb-[80px] text-[#111827]">
		<BlogDetailContentSection content={blogDetailEntry.data} Content={Content} />
		<BlogDetailRelatedSection content={blogDetailEntry.data.relatedSection} />
		<BlogDetailFinalCtaSection content={blogDetailEntry.data.finalCta} />
	</main>
	<Footer />
</Layout>
