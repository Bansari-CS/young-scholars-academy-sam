---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import GeneralFaqSection from '../components/common/GeneralFaqSection.astro';
import TeachersHeroSection from '../components/teachers/TeachersHeroSection.astro';
import TeachersMentorListSection from '../components/teachers/TeachersMentorListSection.astro';
import TeachersParentLoveSection from '../components/teachers/TeachersParentLoveSection.astro';
import TeachersParentQuoteSection from '../components/teachers/TeachersParentQuoteSection.astro';
import TeachersAdminTeamSection from '../components/teachers/TeachersAdminTeamSection.astro';
import TeachersParentTestimonialsSection from '../components/teachers/TeachersParentTestimonialsSection.astro';
import TeachersMentorFitCtaSection from '../components/teachers/TeachersMentorFitCtaSection.astro';
import { getEntry } from 'astro:content';
import { getSiteNavItems } from '../utils/getSiteNavItems';

const [teachersEntry, navItems] = await Promise.all([
	getEntry('teachers', 'teachers'),
	getSiteNavItems(),
]);

if (!teachersEntry) {
	throw new Error('Missing teachers page content entry at src/content/teachers/teachers.md');
}

const teachersContent = teachersEntry.data;
---

<Layout
	title={teachersContent.seo.title}
	description={teachersContent.seo.description}
>
	<Header brand="Young Scholars Academy" navItems={navItems} />
	<main>
		<TeachersHeroSection content={teachersContent.hero} />
		<TeachersParentLoveSection content={teachersContent.parentLove} />
		<TeachersParentQuoteSection content={teachersContent.parentQuote} />
		<TeachersMentorListSection content={teachersContent.mentors} />
		<TeachersAdminTeamSection content={teachersContent.adminTeam} />
		<TeachersParentTestimonialsSection content={teachersContent.parentTestimonials} />
		<TeachersMentorFitCtaSection content={teachersContent.mentorFitCta} />
		<GeneralFaqSection />
	</main>
	<Footer />
</Layout>
