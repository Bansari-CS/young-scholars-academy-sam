---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import BlogHeroSection from '../components/blog/BlogHeroSection.astro';
import BlogFeaturedInsightsSection from '../components/blog/BlogFeaturedInsightsSection.astro';
import BlogLatestArticlesSection from '../components/blog/BlogLatestArticlesSection.astro';
import BlogTopicsSection from '../components/blog/BlogTopicsSection.astro';
import BlogTestimonialsSection from '../components/blog/BlogTestimonialsSection.astro';
import BlogNewsletterSection from '../components/blog/BlogNewsletterSection.astro';
import BlogFaqSection from '../components/blog/BlogFaqSection.astro';
import BlogFinalCtaSection from '../components/blog/BlogFinalCtaSection.astro';
import { getCollection } from 'astro:content';
import { heroData } from '../data/home';

const blogPosts = (await getCollection('blog')).sort((a, b) => {
	if (typeof a.data.order === 'number' && typeof b.data.order === 'number') {
		return a.data.order - b.data.order;
	}
	return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
});
---

<Layout title="Blog | Young Scholars Academy" description="Insights for raising bright, differently-wired kids.">
	<Header brand="Young Scholars Academy" navItems={heroData.navItems} />
	<main class="bg-[#f1f5f9] text-[#111827]">
		<BlogHeroSection />
		<BlogFeaturedInsightsSection />
		<BlogLatestArticlesSection posts={blogPosts} />
		<BlogTopicsSection />
		<BlogTestimonialsSection />

		<BlogNewsletterSection />

		<BlogFaqSection />

		<BlogFinalCtaSection />
	</main>
	<Footer />
</Layout>
