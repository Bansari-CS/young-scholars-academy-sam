---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import BlogHeroSection from '../components/blog/BlogHeroSection.astro';
import BlogFeaturedInsightsSection from '../components/blog/BlogFeaturedInsightsSection.astro';
import BlogLatestArticlesSection from '../components/blog/BlogLatestArticlesSection.astro';
import BlogTopicsSection from '../components/blog/BlogTopicsSection.astro';
import BlogTestimonialsSection from '../components/blog/BlogTestimonialsSection.astro';
import BlogNewsletterSection from '../components/blog/BlogNewsletterSection.astro';
import BlogFaqSection from '../components/blog/BlogFaqSection.astro';
import BlogFinalCtaSection from '../components/blog/BlogFinalCtaSection.astro';
import { getCollection } from 'astro:content';
import { heroData } from '../data/home';

const blogPosts = (await getCollection('blog')).sort((a, b) => {
	if (typeof a.data.order === 'number' && typeof b.data.order === 'number') {
		return a.data.order - b.data.order;
	}
	return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
});

const categories = ['All', ...new Set(blogPosts.map((post) => post.data.category))];

const categoryTagColorMap: Record<string, string> = {
	'Gifted & 2e': 'text-[#7c3aed]',
	ADHD: 'text-[#0a9dfb]',
	Homeschooling: 'text-[#f59e0b]',
	'Social-Emotional': 'text-[#f43f5e]',
	'Learning Differences': 'text-[#048c3c]',
};

const latestArticles = blogPosts.map((post) => ({
	slug: post.id,
	title: post.data.title,
	description: post.data.description,
	image: post.data.coverImage,
	tag: post.data.category,
	tagColor: categoryTagColorMap[post.data.category] ?? 'text-[#7c3aed]',
	readTime: post.data.readTime,
}));
---

<Layout title="Blog | Young Scholars Academy" description="Insights for raising bright, differently-wired kids.">
	<Header brand="Young Scholars Academy" navItems={heroData.navItems} />
	<main class="bg-[#f1f5f9] text-[#111827]">
		<section class="px-6 pb-16 pt-16 md:pt-20 lg:px-[120px]" style="background-image: radial-gradient(98.86% 86.83% at 50% 0%, rgba(124,58,237,0.05) 0%, rgba(124,58,237,0) 50%);">
			<div class="mx-auto w-full max-w-[1200px]">
				<div class="mx-auto mb-8 flex w-fit items-center gap-2 rounded-full border border-[#e0e9ff] bg-white px-4 py-2 shadow-sm">
					<span class="h-2 w-2 rounded-full bg-[#048c3c]"></span>
					<span class="text-xs font-medium tracking-[0.3px] text-[#7c3aed]">New Resources Available</span>
				</div>
				<h1 class="mx-auto max-w-[800px] text-center text-[34px] font-bold leading-tight md:text-[44px]">
					Insights for Raising Bright,
					<span class="block bg-gradient-to-r from-[#0084ff] to-[#7c3aed] bg-clip-text text-transparent">Differently-Wired Kids</span>
				</h1>
				<p class="mx-auto mt-6 max-w-[700px] text-center text-lg leading-[32px] text-[#475569]">
					Expert advice, practical strategies, and emotional support for parents navigating the unique journey of raising gifted and neurodivergent children.
				</p>
				<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
					<a href="#" class="rounded-xl bg-[#0a9dfb] px-[40px] py-4 text-base font-medium text-white shadow-[0px_2px_16px_-4px_rgba(0,0,0,0.06)]">Find My Child’s Best Fit</a>
					<a href="#" class="rounded-xl border border-[#0a9dfb] bg-white px-8 py-4 text-base font-medium text-[#111827]">Explore All Articles</a>
				</div>
			</div>
		</section>

		<section class="mx-auto w-full max-w-[1200px] px-6 pb-20 pt-[11px]">
			<div class="mb-10 flex items-end justify-between">
				<h2 class="text-[30px] font-bold md:text-[44px]">Featured Insights</h2>
				<a href="#" class="text-base font-semibold text-[#0a9dfb]">View all →</a>
			</div>
			<div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
				<article class="overflow-hidden rounded-2xl border border-[rgba(226,232,240,0.5)] bg-white shadow-sm md:col-span-2 md:grid md:h-[536px] md:grid-cols-2">
					<img src="https://www.figma.com/api/mcp/asset/5f63b12a-dd61-44b2-9d12-5bf5a659110e" alt="Featured insight" class="h-[300px] w-full object-cover md:h-[536px]" />
					<div class="flex flex-col justify-between p-6 md:p-10">
						<div>
							<div class="mb-4 flex items-center gap-4">
								<span class="rounded-2xl bg-[#e1f3ff] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.55px] text-[#0a9dfb]">Gifted & 2e</span>
								<span class="text-sm text-[rgba(71,85,105,0.7)]">8 min read</span>
							</div>
							<h3 class="text-[17px] font-semibold leading-7 pt-[8px]">Navigating the complexities of Twice-Exceptional (2e) learners at home.</h3>
							<p class="mt-4 text-base leading-[26px] text-[#475569]">
								Discover actionable strategies for supporting children who possess both exceptional cognitive abilities and significant learning challenges.
							</p>
						</div>
						<a href="#" class="mt-6 text-sm font-medium text-[#7c3aed]">Read Article →</a>
					</div>
				</article>
				<div class="flex flex-col gap-6 md:h-[536px]">
					<article class="flex h-full flex-col justify-between rounded-2xl border border-[rgba(226,232,240,0.5)] bg-white p-8 shadow-sm md:min-h-[256px]">
						<div>
							<span class="rounded-2xl bg-[#decbfe] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.55px] text-[#7c3aed]">Social Skills</span>
							<h3 class="mt-4 text-[17px] font-semibold leading-7">Building lasting friendships for quirky kids.</h3>
							<p class="mt-3 text-base leading-[26px] text-[#475569]">Practical advice for helping differently-wired children navigate social...</p>
						</div>
						<a href="#" class="pt-4 text-sm font-medium text-[#7c3aed]">Read Article →</a>
					</article>
					<article class="flex h-full flex-col justify-between rounded-2xl border border-[rgba(226,232,240,0.5)] bg-white p-8 shadow-sm md:min-h-[256px]">
						<div>
							<span class="rounded-2xl bg-[#dff8e9] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.55px] text-[#048c3c]">ADHD</span>
							<h3 class="mt-4 text-[17px] font-semibold leading-7">Harnessing hyperfocus as a superpower.</h3>
							<p class="mt-3 text-base leading-[26px] text-[#475569]">Reframing ADHD traits and learning how to channel intense interests into...</p>
						</div>
						<a href="#" class="pt-4 text-sm font-medium text-[#7c3aed]">Read Article →</a>
					</article>
				</div>
			</div>
		</section>

		<section class="bg-white px-6 py-20 lg:px-[120px]">
			<div class="mx-auto w-full max-w-[1152px]">
				<h2 class="text-[30px] font-bold md:text-[44px]">Latest Articles</h2>
				<div class="mt-10 rounded-2xl border border-[rgba(226,232,240,0.5)] bg-white p-4 shadow-sm">
					<div class="flex flex-col gap-4 lg:flex-row lg:items-center">
						<div class="w-full max-w-[361px]">
							<div class="rounded-[52px] border border-[#e2e8f0] bg-[#f8fafc] px-6 py-3 text-sm text-[#9ca3af]">Search articles, topics...</div>
						</div>
						<div class="flex w-full items-center gap-2 overflow-x-auto pb-1">
							{categories.map((category, index) => (
								<span class:list={['whitespace-nowrap rounded-full border px-5 py-2.5 text-[15px] font-medium', index === 0 ? 'border-[#0a9dfb] bg-[#0a9dfb] text-white shadow-[0px_10px_15px_-3px_rgba(0,132,255,0.2),0px_4px_6px_-4px_rgba(0,132,255,0.2)]' : 'border-[#e2e8f0] bg-[#f8fafc] text-[#475569]']}>{category}</span>
							))}
						</div>
					</div>
				</div>

				<div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
					{latestArticles.map((article) => (
						<a href={`/blog/${article.slug}`} class="group flex h-full flex-col gap-[17px] rounded-xl">
							<img src={article.image} alt={article.title} class="h-[252px] w-full rounded-xl object-cover" />
							<div class="flex flex-1 flex-col mt-[9px]">
								<p class:list={['text-[10px] font-semibold uppercase tracking-[1.1px]', article.tagColor]}>{article.tag}</p>
								<h3 class="mt-[12px] text-[17px] font-semibold leading-7 text-[#111827] group-hover:text-[#0a9dfb]">{article.title}</h3>
								<p class="mt-2 text-sm leading-[22.75px] text-[#374151]">{article.description}</p>
							</div>
							<div class="mt-3 flex items-center justify-between border-t border-[#f1f5f9] pt-3">
								<span class="text-xs text-[#6b7280]">{article.readTime}</span>
								<span class="text-sm font-medium text-[#7c3aed]">Read Article →</span>
							</div>
						</a>
					))}
				</div>

				<div class="mt-12 flex justify-center mt-[60px]">
					<button class="rounded-[10px] bg-gradient-to-r from-[#0a9dfb] to-[#38b6ff] px-8 py-4 text-base font-semibold text-white shadow-[0px_4px_10px_rgba(10,157,251,0.3)]">
						Load More Articles
					</button>
				</div>
			</div>
		</section>

		<section class="mx-auto w-full max-w-[1200px] px-6 py-20">
			<h2 class="text-center text-[30px] font-bold md:text-[44px]">Explore by Topic</h2>
			<div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6 lg:grid-cols-5">
				<div class="flex min-h-[160px] flex-col items-center justify-center rounded-2xl border border-[#e2e8f0] bg-white px-8 py-8 text-center"><div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[rgba(0,132,255,0.1)]"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13.3497 2.84375C13.1003 2.32813 12.5753 2 11.9997 2C11.4231 2 10.9031 2.32812 10.6497 2.84375L7.63469 9.04531L0.90422 10.0391C0.34172 10.1234 -0.126998 10.5172 -0.300435 11.0562C-0.473873 11.5953 -0.333248 12.1906 0.0698774 12.5891L4.95425 17.4219L3.80113 24.2516C3.70738 24.8141 3.94175 25.3859 4.40581 25.7188C4.86988 26.0516 5.48394 26.0938 5.99019 25.8266L12.0043 22.6156L18.0184 25.8266C18.5247 26.0938 19.1388 26.0562 19.6028 25.7188C20.0669 25.3813 20.3013 24.8141 20.2075 24.2516L19.0504 17.4219L23.9348 12.5891C24.3379 12.1906 24.4825 11.5953 24.3048 11.0562C24.1272 10.5172 23.6631 10.1234 23.1006 10.0391L16.3647 9.04531L13.3497 2.84375Z" fill="#0A9DFB"/></svg></div><p class="text-[17px] font-medium">Giftedness</p></div>
				<div class="flex min-h-[160px] flex-col items-center justify-center rounded-2xl border border-[#e2e8f0] bg-white px-8 py-8 text-center"><div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[rgba(124,58,237,0.1)]"><svg width="21" height="24" viewBox="0 0 21 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16.3781 2.09105C16.6547 1.44886 16.4484 0.698862 15.8812 0.286362C15.3141 -0.126138 14.5406 -0.0886384 14.0109 0.370737L2.01093 10.8707C1.54218 11.2832 1.37343 11.9442 1.59374 12.5254C1.81405 13.1067 2.37655 13.5004 2.99999 13.5004H8.22655L4.62186 21.9098C4.3453 22.552 4.55155 23.302 5.11874 23.7145C5.68593 24.127 6.45937 24.0895 6.98905 23.6301L18.9891 13.1301C19.4578 12.7176 19.6266 12.0567 19.4062 11.4754C19.1859 10.8942 18.6281 10.5051 18 10.5051H12.7734L16.3781 2.09105Z" fill="#7C3AED"/></svg></div><p class="text-[17px] font-medium">ADHD</p></div>
				<div class="flex min-h-[160px] flex-col items-center justify-center rounded-2xl border border-[#e2e8f0] bg-white px-8 py-8 text-center"><div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[#fffad4]"><svg width="27" height="24" viewBox="0 0 27 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M26.9906 11.9766C26.9906 12.8203 26.2875 13.4813 25.4906 13.4813H23.9906L24.0234 20.9906C24.0328 22.6547 22.6875 24.0047 21.0234 24.0047H6.00469C4.35 24.0047 3.00469 22.6594 3.00469 21.0047V13.4813H1.5C0.65625 13.4813 0 12.825 0 11.9766C0 11.5547 0.140625 11.1797 0.46875 10.8516L12.4875 0.375C12.8156 0.046875 13.1906 0 13.5187 0C13.8469 0 14.2219 0.09375 14.5031 0.328125L26.475 10.8516C26.85 11.1797 27.0375 11.5547 26.9906 11.9766ZM16.5 10.5C16.5 9.70435 16.1839 8.94129 15.6213 8.37868C15.0587 7.81607 14.2956 7.5 13.5 7.5C12.7044 7.5 11.9413 7.81607 11.3787 8.37868C10.8161 8.94129 10.5 9.70435 10.5 10.5C10.5 11.2956 10.8161 12.0587 11.3787 12.6213C11.9413 13.1839 12.7044 13.5 13.5 13.5C14.2956 13.5 15.0587 13.1839 15.6213 12.6213C16.1839 12.0587 16.5 11.2956 16.5 10.5ZM12 15C9.92813 15 8.25 16.6781 8.25 18.75C8.25 19.1625 8.5875 19.5 9 19.5H18C18.4125 19.5 18.75 19.1625 18.75 18.75C18.75 16.6781 17.0719 15 15 15H12Z" fill="#F2DD35"/></svg></div><p class="text-[17px] font-medium">Homeschooling</p></div>
				<div class="flex min-h-[160px] flex-col items-center justify-center rounded-2xl border border-[#e2e8f0] bg-white px-8 py-8 text-center"><div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[rgba(244,63,94,0.1)]"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.23125 14.0813L10.7016 21.9891C11.0531 22.3172 11.5172 22.5 12 22.5C12.4828 22.5 12.9469 22.3172 13.2984 21.9891L21.7687 14.0813C23.1938 12.7547 24 10.8938 24 8.94844V8.67657C24 5.40001 21.6328 2.60626 18.4031 2.06719C16.2656 1.71094 14.0906 2.40938 12.5625 3.93751L12 4.50001L11.4375 3.93751C9.90938 2.40938 7.73438 1.71094 5.59688 2.06719C2.36719 2.60626 0 5.40001 0 8.67657V8.94844C0 10.8938 0.80625 12.7547 2.23125 14.0813Z" fill="#F43F5E"/></svg></div><p class="text-[17px] font-medium">Social-Emotional</p></div>
				<div class="flex min-h-[160px] flex-col items-center justify-center rounded-2xl border border-[#e2e8f0] bg-white px-8 py-8 text-center"><div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[rgba(16,185,129,0.1)]"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.625 0C10.0734 0 11.25 1.17656 11.25 2.625V21.375C11.25 22.8234 10.0734 24 8.625 24C7.27031 24 6.15469 22.9734 6.01406 21.6516C5.77031 21.7172 5.5125 21.75 5.25 21.75C3.59531 21.75 2.25 20.4047 2.25 18.75C2.25 18.4031 2.31094 18.0656 2.41875 17.7562C1.00312 17.2219 0 15.8531 0 14.25C0 12.7547 0.876562 11.4609 2.14687 10.8609C1.73906 10.35 1.5 9.70312 1.5 9C1.5 7.56094 2.5125 6.36094 3.8625 6.06562C3.7875 5.80781 3.75 5.53125 3.75 5.25C3.75 3.84844 4.71563 2.66719 6.01406 2.33906C6.15469 1.02656 7.27031 0 8.625 0ZM15.375 0C16.7297 0 17.8406 1.02656 17.9859 2.33906C19.2891 2.66719 20.25 3.84375 20.25 5.25C20.25 5.53125 20.2125 5.80781 20.1375 6.06562C21.4875 6.35625 22.5 7.56094 22.5 9C22.5 9.70312 22.2609 10.35 21.8531 10.8609C23.1234 11.4609 24 12.7547 24 14.25C24 15.8531 22.9969 17.2219 21.5812 17.7562C21.6891 18.0656 21.75 18.4031 21.75 18.75C21.75 20.4047 20.4047 21.75 18.75 21.75C18.4875 21.75 18.2297 21.7172 17.9859 21.6516C17.8453 22.9734 16.7297 24 15.375 24C13.9266 24 12.75 22.8234 12.75 21.375V2.625C12.75 1.17656 13.9266 0 15.375 0Z" fill="#048C3C"/></svg></div><p class="text-[17px] font-medium">Learning Differences</p></div>
			</div>
		</section>

		<section class="overflow-hidden bg-[#111827] px-6 py-20 lg:px-[120px]" style="background-image: radial-gradient(158.45% 146.94% at 100% 0%, rgba(124,58,237,0.15) 0%, rgba(124,58,237,0) 100%), linear-gradient(90deg, #081738 0%, #2b1f63 100%);">
			<div class="mx-auto w-full max-w-[1200px]">
				<h2 class="text-center text-[30px] font-bold text-white md:text-[44px]">From Families Like Yours</h2>
				<div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
					<article class="rounded-3xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.05)] p-8 md:p-10">
						<p class="text-base italic leading-[26px] text-[#f0f4ff]">"For years we felt like we were failing our son because traditional school wasn't working. The insights here helped us realize he wasn't broken—he was just different. Today, he's thriving in a home-learning environment that honors his intensity."</p>
						<div class="mt-8 flex items-center gap-4">
							<img src="https://www.figma.com/api/mcp/asset/a6247f26-d61e-4fcc-a625-f8c67e2aa340" alt="Sarah Jenkins" class="h-14 w-14 rounded-full border-2 border-[#0084ff] object-cover" />
							<div><p class="text-sm font-medium text-white">Sarah Jenkins</p><p class="text-xs text-[#c7d5fe]">Parent of two 2e boys</p></div>
						</div>
					</article>
					<article class="rounded-3xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.05)] p-8 md:p-10">
						<p class="text-base italic leading-[26px] text-[#f0f4ff]">"Finding a community that understands the unique combination of high IQ and executive dysfunction was a game changer. We've gone from constant frustration to celebrating small wins and building a world that works for our daughter's brain."</p>
						<div class="mt-8 flex items-center gap-4">
							<img src="https://www.figma.com/api/mcp/asset/a97199eb-c27f-45d3-8ccf-fa49abf86a76" alt="Mark Thompson" class="h-14 w-14 rounded-full border-2 border-[#7c3aed] object-cover" />
							<div><p class="text-sm font-medium text-white">Mark Thompson</p><p class="text-xs text-[#c7d5fe]">Homeschooling Dad</p></div>
						</div>
					</article>
				</div>
			</div>
		</section>

		<section class="mx-auto mt-16 w-[calc(100%-2rem)] max-w-[1104px] rounded-[24px] bg-gradient-to-br from-[#7c3aed] to-[#0a9dfb] px-6 py-12 md:py-16 lg:px-20">
			<div class="text-center">
				<h2 class="text-[30px] font-bold text-white md:text-[44px]">Not Ready Yet? Start Here.</h2>
				<p class="mx-auto mt-4 max-w-[600px] text-base leading-7 text-[#e0e9ff] opacity-90">Join 5,000+ parents receiving weekly insights, strategies, and curated resources delivered straight to your inbox.</p>
				<div class="mx-auto mt-6 flex w-full max-w-[500px] items-center rounded-2xl border border-[rgba(255,255,255,0.2)] bg-[rgba(255,255,255,0.1)] p-2">
					<input type="email" placeholder="Your email address" class="w-full bg-transparent px-4 py-4 text-sm font-medium text-[rgba(255,255,255,0.8)] placeholder:text-[rgba(255,255,255,0.8)] outline-none" />
					<button class="whitespace-nowrap rounded-xl bg-white px-8 py-4 text-base font-medium text-[#0a9dfb]">Join Now</button>
				</div>
				<p class="mt-4 text-base text-[#e0e9ff] opacity-60">We value your privacy. Unsubscribe at any time.</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-[800px] px-6 pb-12 pt-20">
			<h2 class="text-center text-[30px] font-bold md:text-[44px]">Answers to Your Questions</h2>
			<div class="mt-12 space-y-4">
				<div class="overflow-hidden rounded-2xl border border-[#e2e8f0] bg-white">
					<div class="flex items-center justify-between p-6">
						<h3 class="text-[17px] font-semibold leading-7">How often is the blog updated?</h3>
						<span class="text-lg text-[#64748b]">−</span>
					</div>
					<p class="px-6 pb-6 text-base leading-[26px] text-[#475569]">We publish new expert-written articles every Tuesday and Thursday. Our weekend edition usually features success stories and resource roundups from our community members.</p>
				</div>
				{['Are the strategies research-based?', 'Can I contribute an article?', 'What makes Young Scholars different?'].map((item) => (
					<div class="rounded-2xl border border-[#e2e8f0] bg-white p-6"><div class="flex items-center justify-between"><h3 class="text-[17px] font-semibold leading-7">{item}</h3><span class="text-lg text-[#64748b]">+</span></div></div>
				))}
			</div>
		</section>

		<section class="mx-auto mt-2 mb-20 w-[calc(100%-2rem)] max-w-[1152px] rounded-[24px] bg-[#111827] px-6 py-16 md:py-20 lg:px-24" style="background-image: radial-gradient(63.3% 63.06% at 50% 50%, rgba(0,132,255,0.1) 0%, rgba(0,132,255,0) 100%), linear-gradient(90deg, #081738 0%, #111827 100%);">
