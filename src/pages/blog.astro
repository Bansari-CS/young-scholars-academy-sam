---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import GeneralFaqSection from '../components/common/GeneralFaqSection.astro';
import BlogHeroSection from '../components/blog/BlogHeroSection.astro';
import BlogFeaturedInsightsSection from '../components/blog/BlogFeaturedInsightsSection.astro';
import BlogLatestArticlesSection from '../components/blog/BlogLatestArticlesSection.astro';
import BlogTopicsSection from '../components/blog/BlogTopicsSection.astro';
import BlogTestimonialsSection from '../components/blog/BlogTestimonialsSection.astro';
import BlogNewsletterSection from '../components/blog/BlogNewsletterSection.astro';
import BlogFinalCtaSection from '../components/blog/BlogFinalCtaSection.astro';
import { getEntry } from 'astro:content';
import { getSiteNavItems } from '../utils/getSiteNavItems';

const [blogPageEntry, navItems] = await Promise.all([
	getEntry('blog-page', 'blog-page'),
	getSiteNavItems(),
]);

if (!blogPageEntry) {
	throw new Error('Missing blog page content entry at src/content/blog-page/blog-page.md');
}

const blogPageContent = blogPageEntry.data;
---

<Layout title={blogPageContent.seo.title} description={blogPageContent.seo.description}>
	<Header brand="Young Scholars Academy" navItems={navItems} />
	<main class="bg-[#f1f5f9] text-[#111827]">
		<BlogHeroSection content={blogPageContent.hero} />
		<BlogFeaturedInsightsSection content={blogPageContent.featuredInsights} />
		<BlogLatestArticlesSection content={blogPageContent.latestArticles} />
		<BlogTopicsSection content={blogPageContent.topics} />
		<BlogTestimonialsSection content={blogPageContent.testimonials} />

		<!-- <BlogNewsletterSection content={blogPageContent.newsletter} /> -->

		<GeneralFaqSection />

		<BlogFinalCtaSection content={blogPageContent.finalCta} />
	</main>
	<Footer />
</Layout>
