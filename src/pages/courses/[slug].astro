---
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/course-detail/Hero.astro';
import TabsBar from '../../components/course-detail/TabsBar.astro';
import MainContentSection from '../../components/course-detail/MainContentSection.astro';
import ReviewsSection from '../../components/course-detail/ReviewsSection.astro';
import AboutSection from '../../components/course-detail/AboutSection.astro';
import SummerResultsSection from '../../components/summer/SummerResultsSection.astro';
import FinalCtaSection from '../../components/course-detail/FinalCtaSection.astro';
import { getEntry } from 'astro:content';
export async function getStaticPaths() {
	const [courseTemplateEntry, homeEntry] = await Promise.all([
		getEntry('course-detail', 'course-detail'),
		getEntry('home', 'home'),
	]);
	if (!courseTemplateEntry || !homeEntry) return [];

	const baseContent = courseTemplateEntry.data;
	const programCards = homeEntry.data.programs?.cards ?? [];
	const uniqueCourseSlugs = new Map<string, string>();

	for (const card of programCards) {
		const slug = card.title
			.toLowerCase()
			.trim()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-+|-+$/g, '');
		if (!uniqueCourseSlugs.has(slug)) {
			uniqueCourseSlugs.set(slug, card.title);
		}
	}

	return Array.from(uniqueCourseSlugs.entries()).map(([slug, courseName]) => ({
		params: { slug },
		props: {
			courseContent: {
				...baseContent,
				seo: {
					...baseContent.seo,
					title: `${courseName} | Young Scholars Academy`,
				},
				hero: {
					...baseContent.hero,
					titleAccent: courseName,
				},
			},
		},
	}));
}

const { courseContent } = Astro.props;
const shareTitle = `${courseContent.hero.titleLead} ${courseContent.hero.titleAccent}`.trim();
---

<Layout title={courseContent.seo.title} description={courseContent.seo.description}>
	<Header brand="Young Scholars Academy" navItems={courseContent.navItems} />

	<main class="block w-full bg-[#f8fafc]">
		<Hero {...courseContent.hero} />
		<TabsBar tabs={courseContent.tabs} shareTitle={shareTitle} />
		<MainContentSection content={courseContent.content} sidebar={courseContent.sidebar} shareTitle={shareTitle} />
		<ReviewsSection reviews={courseContent.reviews} />
		{courseContent.testimonials && <SummerResultsSection content={courseContent.testimonials} />}
		<AboutSection {...courseContent.about} />
		<FinalCtaSection {...courseContent.finalCta} />
	</main>

	<Footer />
</Layout>
