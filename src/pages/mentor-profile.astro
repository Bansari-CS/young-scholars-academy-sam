---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import MentorProfileHeroSection from '../components/mentor-profile/MentorProfileHeroSection.astro';
import MentorProfileAboutSection from '../components/mentor-profile/MentorProfileAboutSection.astro';
import MentorProfileBeyondClassroomSection from '../components/mentor-profile/MentorProfileBeyondClassroomSection.astro';
import MentorProfileHowITeachSection from '../components/mentor-profile/MentorProfileHowITeachSection.astro';
import MentorProfileInsideClassroomSection from '../components/mentor-profile/MentorProfileInsideClassroomSection.astro';
import MentorProfileClassroomVideoGallerySection from '../components/mentor-profile/MentorProfileClassroomVideoGallerySection.astro';
import MentorProfileClassesSection from '../components/mentor-profile/MentorProfileClassesSection.astro';
import MentorProfileStudentExperienceSection from '../components/mentor-profile/MentorProfileStudentExperienceSection.astro';
import MentorProfileTestimonialsSection from '../components/mentor-profile/MentorProfileTestimonialsSection.astro';
import MentorProfileFindClassCtaSection from '../components/mentor-profile/MentorProfileFindClassCtaSection.astro';
import { heroData } from '../data/home';
import { getEntry } from 'astro:content';

const mentorProfileEntry = await getEntry('mentor-profile', 'mentor-profile');

if (!mentorProfileEntry) {
	throw new Error('Missing mentor profile content entry at src/content/mentor-profile/mentor-profile.md');
}

const mentorProfileContent = mentorProfileEntry.data;
---

<Layout
	title={mentorProfileContent.seo.title}
	description={mentorProfileContent.seo.description}
>
	<Header brand="Young Scholars Academy" navItems={heroData.navItems} />
	<main>
		<MentorProfileHeroSection
			content={mentorProfileContent.hero}
			shareTitle={`${mentorProfileContent.hero.name} | Young Scholars Academy`}
		/>
		<MentorProfileAboutSection content={mentorProfileContent.about} />
		<MentorProfileBeyondClassroomSection content={mentorProfileContent.beyondClassroom} />
		<MentorProfileHowITeachSection content={mentorProfileContent.howITeach} />
		<MentorProfileInsideClassroomSection content={mentorProfileContent.insideClassroom} />
		<MentorProfileClassroomVideoGallerySection content={mentorProfileContent.classroomVideoGallery} />
		<MentorProfileClassesSection content={mentorProfileContent.classes} />
		<MentorProfileStudentExperienceSection content={mentorProfileContent.studentExperience} />
		<MentorProfileTestimonialsSection content={mentorProfileContent.testimonials} />
		<MentorProfileFindClassCtaSection content={mentorProfileContent.findClassCta} />
	</main>
	<Footer />
</Layout>
