---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/course-detail/Hero.astro';
import TabsBar from '../components/course-detail/TabsBar.astro';
import MainContentSection from '../components/course-detail/MainContentSection.astro';
import ReviewsSection from '../components/course-detail/ReviewsSection.astro';
import AboutSection from '../components/course-detail/AboutSection.astro';
import FinalCtaSection from '../components/course-detail/FinalCtaSection.astro';
import { courseDetailData } from '../data/courseDetail';
---

<Layout title="Course Detail | Young Scholars Academy" description="Course details for robotics and coding program.">
	<Header brand="Young Scholars Academy" navItems={courseDetailData.navItems} />

	<main class="site-main bg-[#f8fafc]">
		<Hero {...courseDetailData.hero} />
		<TabsBar tabs={courseDetailData.tabs} />
		<MainContentSection content={courseDetailData.content} sidebar={courseDetailData.sidebar} />
		<ReviewsSection reviews={courseDetailData.reviews} />
		<AboutSection {...courseDetailData.about} />
		<FinalCtaSection {...courseDetailData.finalCta} />
	</main>

	<Footer />
</Layout>
