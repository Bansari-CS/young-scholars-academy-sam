---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/course-detail/Hero.astro';
import Content from '../components/course-detail/Content.astro';
import Sidebar from '../components/course-detail/Sidebar.astro';
import Reviews from '../components/course-detail/Reviews.astro';
import { courseDetailData } from '../data/courseDetail';
---

<Layout title="Course Detail | Young Scholars Academy" description="Course details for robotics and coding program.">
	<Header brand="Young Scholars Academy" navItems={courseDetailData.navItems} />

	<main class="w-full bg-[#f8fafc] pb-10">
		<div class="mx-auto w-full max-w-[1440px] bg-white">
			<Hero {...courseDetailData.hero} />

			<nav class="border-y border-slate-100 bg-white" aria-label="Course sections">
				<div class="mx-auto flex min-h-12 max-w-[1216px] items-center justify-between gap-4 px-4">
					<ul class="m-0 flex list-none items-center gap-5 p-0">
						{
							courseDetailData.tabs.map((tab, index) => (
								<li
									class:list={[
										'border-b-2 border-transparent py-3 text-xs font-semibold text-slate-500',
										index === 0 && 'border-b-sky-500 text-sky-500',
									]}
								>
									{tab}
								</li>
							))
						}
					</ul>
					<a
						href="#"
						class="inline-flex items-center gap-1.5 rounded-lg border border-violet-100 bg-violet-50/40 px-2.5 py-1 text-xs font-semibold text-violet-500 no-underline"
					>
						<img
							src="https://www.figma.com/api/mcp/asset/76f362ad-eb08-48c1-974b-2585c781c963"
							alt=""
							aria-hidden="true"
							class="h-3 w-3"
							loading="lazy"
						/>
						<span>Share</span>
					</a>
				</div>
			</nav>

			<section class="bg-slate-50 py-8">
				<div class="mx-auto grid max-w-[1216px] grid-cols-1 items-start gap-12 px-4 lg:grid-cols-[757px_1fr]">
					<Content {...courseDetailData.content} />
					<Sidebar {...courseDetailData.sidebar} />
				</div>
			</section>

			<section class="bg-white py-10">
				<div class="mx-auto max-w-[1216px] px-4">
					<Reviews {...courseDetailData.reviews} />
				</div>
			</section>

			<section class="relative left-1/2 right-1/2 w-screen -translate-x-1/2 bg-[#dbeafe] py-16 md:py-20">
				<div class="mx-auto flex w-full max-w-[800px] flex-col items-center gap-6 px-4 text-center">
					<span class="inline-grid h-16 w-16 place-items-center rounded-2xl bg-[#0284c7] text-[30px] leading-9 font-bold text-white shadow-[0px_20px_25px_-5px_rgba(2,132,199,0.2),0px_8px_10px_-6px_rgba(2,132,199,0.2)]">Y</span>
					<h2 class="max-w-[520px] text-[44px] leading-[52px] font-semibold tracking-[-0.02em] text-slate-900">
						About Young Scholars Academy
					</h2>
					<p class="mx-auto max-w-[746px] text-[18px] leading-[29.25px] text-slate-600">
						We believe that the best way to learn is by doing. Founded by educators and engineers, YSA provides a safe, interactive, and high-energy environment for kids to explore their passions in STEM and Beyond.
					</p>
					<a href="#" class="inline-block text-[16px] leading-6 font-bold text-[#0284c7] no-underline">Learn more about our mission →</a>
				</div>
			</section>

			<section class="bg-[#f8fafc] px-4 py-24 lg:px-0">
				<div class="mx-auto grid max-w-[1184px] grid-cols-1 items-center gap-12 rounded-[48px] bg-[#111827] p-10 shadow-[0px_25px_50px_-12px_rgba(0,0,0,0.25)] lg:grid-cols-[576px_400px] lg:gap-4 lg:p-24">
					<div class="flex flex-col gap-6">
						<h2 class="m-0 text-[36px] leading-10 font-bold text-white">Ready to build the future?</h2>
						<p class="max-w-[526px] text-[16px] leading-7 text-[#e0e9ff]">
							Join 5,000+ young innovators. Enrollment for the Winter 2024 cohort is now open. Limited seats per class to ensure quality.
						</p>
						<div class="flex flex-wrap gap-4">
							<a
								href="#"
								class="inline-flex min-h-[68px] items-center justify-center rounded-2xl bg-gradient-to-r from-[#0084ff] to-[#7c3aed] px-10 text-[16px] leading-6 font-medium text-white no-underline"
							>
								Enroll Now - $299
							</a>
							<a
								href="#"
								class="inline-flex min-h-[68px] items-center justify-center rounded-2xl border border-white/20 bg-white/10 px-10 text-[16px] leading-6 font-medium text-white no-underline backdrop-blur-[6px]"
							>
								Contact Us
							</a>
						</div>
					</div>
					<img
						class="block h-[400px] w-[400px] rounded-3xl object-cover"
						src="https://www.figma.com/api/mcp/asset/0345f576-ee1c-4a7d-b99b-85fda78589e1"
						alt="Student holding a robot"
						loading="lazy"
					/>
				</div>
			</section>

		</div>
	</main>

	<Footer />
</Layout>
