---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/course-detail/Hero.astro';
import TabsBar from '../components/course-detail/TabsBar.astro';
import MainContentSection from '../components/course-detail/MainContentSection.astro';
import ReviewsSection from '../components/course-detail/ReviewsSection.astro';
import AboutSection from '../components/course-detail/AboutSection.astro';
import FinalCtaSection from '../components/course-detail/FinalCtaSection.astro';
import { getEntry } from 'astro:content';

const courseDetailEntry = await getEntry('course-detail', 'course-detail');

if (!courseDetailEntry) {
	throw new Error('Missing course detail content entry at src/content/course-detail/course-detail.md');
}

const courseDetailContent = courseDetailEntry.data;
---

<Layout title={courseDetailContent.seo.title} description={courseDetailContent.seo.description}>
	<Header brand="Young Scholars Academy" navItems={courseDetailContent.navItems} />

	<main class="site-main bg-[#f8fafc] overflow-x-hidden">
		<Hero {...courseDetailContent.hero} />
		<TabsBar tabs={courseDetailContent.tabs} />
		<MainContentSection content={courseDetailContent.content} sidebar={courseDetailContent.sidebar} />
		<ReviewsSection reviews={courseDetailContent.reviews} />
		<AboutSection {...courseDetailContent.about} />
		<FinalCtaSection {...courseDetailContent.finalCta} />
	</main>

	<Footer />
</Layout>
