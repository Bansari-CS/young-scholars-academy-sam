---
import FaqSection from '../common/FaqSection.astro';
import '../../styles/components/summer-full.css';

interface Props {
	containerClass?: string;
}

const { containerClass = 'summer-wrap faq' } = Astro.props;

const faqItems = [
	{
		question: 'Will my child get "Zoom fatigue"?',
		answer:
			'No - our sessions are designed to keep students engaged, not exhausted.\nEach 50-minute class uses a high-engagement model where students actively participate instead of passively watching. In addition, our Topia virtual campus allows movement and social interaction, making the experience feel more like a game than a traditional online class.',
		open: true,
	},
	{ question: 'Do you require a formal diagnosis for 2e or giftedness?' },
	{ question: 'Can I pay with ESA or Charter School funds?' },
	{ question: 'What is the refund policy?' },
];
---

<FaqSection
	title="Answers to Your Questions"
	description="Everything you need to know before getting started"
	items={faqItems}
	sectionClass="summer-section bg-[#F8FAFC] py-20"
	containerClass={containerClass}
/>
