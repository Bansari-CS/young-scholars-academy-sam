---
interface Props {
	content: any;
}

const { content } = Astro.props as Props;
---

<section class="summer-section py-20 px-5 bg-[#F8FAFC]">
	<div class="summer-wrap faq">
		<h2 class="text-[28px] font-bold sm:text-[36px] lg:text-[44px]">{content.title}</h2>
		<p class="summer-sub mb-16">{content.subtitle}</p>
		{
			content.items.map((item) => (
				<details open={item.open}>
					<summary>
						{item.q} <img src={item.open ? '/images/summer/faq/chevron-up.svg' : '/images/summer/faq/chevron-down.svg'} alt="" />
					</summary>
					{item.a && <p>{item.a}</p>}
				</details>
			))
		}
	</div>
</section>
