---
interface Props {
	content: any;
}

const { content } = Astro.props as Props;
---

<section id="programs" class="summer-section summer-camps-section py-20 px-4 md:px-10 lg:px-16 pt-0">
	<div class="summer-wrap summer-camps-wrap px-5 sm:px-8 lg:px-16">
		<h2 class="text-[28px] sm:text-[36px] lg:text-[44px]">{content.title}</h2>
		<p class="summer-sub mb-12 mt-[10px]">{content.subtitle}</p>
		<div class="summer-camps-filters mb-12 flex-wrap md:flex-nowrap">
			<div class="summer-camps-search">
				<img src="/images/summer/camps/icon-search.svg" alt="" aria-hidden="true" />
				<span>{content.searchPlaceholder}</span>
			</div>
			<div class="summer-camps-filter-chips flex-wrap md:flex-nowrap">
				<button>{content.filterLabels[0]} <img src="/images/summer/camps/icon-chevron.svg" alt="" aria-hidden="true" /></button>
				<button>{content.filterLabels[1]} <img src="/images/summer/camps/icon-chevron.svg" alt="" aria-hidden="true" /></button>
				<button>{content.filterLabels[2]} <img src="/images/summer/camps/icon-chevron.svg" alt="" aria-hidden="true" /></button>
				<button>{content.filterLabels[3]} <img src="/images/summer/camps/icon-calendar.svg" alt="" aria-hidden="true" /></button>
			</div>
			<a href="#">{content.exploreLabel}</a>
		</div>
		<div class="summer-grid-3 summer-camp-grid grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				content.cards.map((camp) => (
					<article class="summer-program-card-figma">
						<div class="summer-program-image-figma">
							<img src={camp.image} alt={camp.name} />
						</div>
						<div class="summer-program-content !pt-8">
							<span class={camp.tagClass}>{camp.tag}</span>
							<h3>{camp.name}</h3>
							<p class="max-w-[285px]">{camp.description}</p>
						</div>
						<div class="summer-program-footer-figma">
							<div class="summer-program-meta-item">
								<img src="/images/summer/camps/icon-age.svg" alt="" aria-hidden="true" />
								<small>{camp.ages}</small>
							</div>
							<div class="summer-program-meta-item">
								<img src={camp.levelIcon} alt="" aria-hidden="true" />
								<small>{camp.level}</small>
							</div>
							<strong>{camp.price}</strong>
						</div>
					</article>
				))
			}
		</div>
		<div class="summer-ai-strip p-5 md:p-8 lg:p-10 flex-wrap md:flex-nowrap">
			<div>
				<h3 class="font-bold">{content.aiTitle}</h3>
				<p>{content.aiDescription}</p>
			</div>
			<a href={content.aiCtaHref}>
				<img src="/images/summer/camps/icon-ai.svg" alt="" aria-hidden="true" />
				{content.aiCtaLabel}
			</a>
		</div>
		<div class="summer-browse-wrap">
			<a href={content.browseHref} class="summer-browse-btn">{content.browseLabel}</a>
		</div>
	</div>
</section>
