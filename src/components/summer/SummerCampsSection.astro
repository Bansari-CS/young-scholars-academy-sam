---
import { courseHref } from '../../utils/courseRoutes';
import { readFileSync } from 'fs';
import { resolve } from 'path';

interface Props {
	content: any;
	dataFile?: 'summer_camps' | 'semester_courses';
}

const { content, dataFile = 'summer_camps' } = Astro.props as Props;

const tagClassMap: Record<string, string> = {
	'tag-stem': 'bg-[#dcfce7] text-[#048c3c]',
	'tag-humanities': 'bg-[#decbfe] text-[#7c3aed]',
	'tag-creative': 'bg-[#e1f3ff] text-[#0a9dfb]',
	'tag-play': 'bg-[#fffad4] text-[#f2dd35]',
};

// Load JSON data from file
let rawCards: any[] = [];
try {
	const jsonPath = resolve(`./src/assets/${dataFile}.json`);
	const jsonContent = readFileSync(jsonPath, 'utf-8');
	const jsonData = JSON.parse(jsonContent);
	rawCards = Array.isArray(jsonData) ? jsonData : (content.cards ?? []);
} catch (e) {
	console.warn(`Could not load JSON ${dataFile}, using content fallback`, e);
	rawCards = content.cards ?? [];
}

const cards = rawCards.map((camp: any) => {
	// Map JSON fields to card fields
	const name = camp.course_name || camp.name || '';
	const ages = camp.age_group || camp.ages || '';
	const description = camp.description || '';
	const image = camp.image || '/images/summer/camps/placeholder.jpg';
	const price = camp.price || 0;
	const dateStart = camp.start_date || '';
	const dateEnd = camp.end_date || '';
	const dateStartDisplay = camp.start_date_display || '';
	const dateEndDisplay   = camp.end_date_display   || '';
	const tag = camp.tag || 'Creative';
	const level = camp.level || 'Beginner';
	const tagClass = camp.tagClass || 'tag-creative';
	const levelIcon = camp.levelIcon || '/images/summer/camps/icon-level.svg';

	return {
		name,
		ages,
		description,
		image,
		price,
		dateStart,
		dateEnd,
		dateStartDisplay,
		dateEndDisplay,
		tag,
		level,
		tagClass,
		levelIcon,
		registration_link: camp.registration_link || '',
		teacher: camp.teacher || '',
	};
});

const categories = [...new Set(cards.map((c: any) => c.tag).filter(Boolean))].sort() as string[];
const levels = [...new Set(cards.map((c: any) => c.level).filter(Boolean))].sort() as string[];

const guided = content.guided as
	| { title: string; options: { label: string; categories: string[] }[] }
	| undefined;

// Build age options dynamically from actual data, sorted numerically
const rawAgeGroups = [...new Set(cards.map((c: any) => c.ages).filter(Boolean))] as string[];
const sortedAgeGroups = rawAgeGroups.sort((a, b) => {
	const aFrom = parseInt(a.split('-')[0]) || 0;
	const bFrom = parseInt(b.split('-')[0]) || 0;
	return aFrom !== bFrom ? aFrom - bFrom : (parseInt(a.split('-')[1]) || 0) - (parseInt(b.split('-')[1]) || 0);
});
const ageOptions = [
	{ value: 'all', label: 'All ages' },
	...sortedAgeGroups.map((ag) => ({ value: ag, label: `Ages ${ag}` })),
];

const searchBlob = (camp: any) => `${camp.name} ${camp.description} ${camp.tag} ${camp.teacher || ''}`.toLowerCase();

const campsConfig = JSON.stringify({ guidedOptions: guided?.options ?? [] });

const SCHEDULEY_EMBED_SRC = 'https://summer-camp-guide-v1.on.chipp.ai';
const scheduleyEmbedSrc =
	typeof content.aiEmbedSrc === 'string' && content.aiEmbedSrc.trim()
		? content.aiEmbedSrc.trim()
		: SCHEDULEY_EMBED_SRC;

const selectBase =
	'w-full min-h-11 min-w-[7.5rem] max-w-[220px] appearance-none rounded-[10px] border border-[#e2e8f0] bg-gradient-to-b from-white to-[#f8fafc] py-2.5 pr-9 pl-3.5 text-sm font-semibold leading-tight text-[#1e293b] shadow-[inset_0_1px_0_rgba(255,255,255,0.85)] transition-[border-color,box-shadow,background] duration-150 hover:border-[#cbd5e1] hover:bg-white focus:border-[#0a9dfb] focus:outline-none focus:shadow-[0_0_0_3px_rgba(10,157,251,0.22),inset_0_1px_0_rgba(255,255,255,0.9)]';
---

<section id="programs" class="bg-[#f8fafc] py-20 pt-0" data-summer-camps-root>
	<div class="mx-auto box-border w-full max-w-[90rem] px-4 pt-12 sm:px-6 lg:px-10">
		<h2 class="mx-auto max-w-[1092px] text-center text-[25px] font-bold leading-[1.15] text-[#111827] sm:text-[36px] lg:text-[44px] lg:leading-[1.1]">
			{content.title}
		</h2>
		<p class="mx-auto mt-4 mb-16 max-w-[696px] text-center text-base leading-[26px] text-[#475569] sm:mt-5 md:mb-[4.5rem]">
			{content.subtitle}
		</p>

		{
			guided?.title ? (
				<div class="mb-8 mt-0 w-full text-center">
					<p class="mb-3.5 w-full text-center text-lg font-semibold text-[#0f172a]">{guided.title}</p>
				</div>
			) : null
		}

		<div
			class="mb-12 flex flex-wrap items-center gap-4 rounded-2xl border border-[#e5e7eb] bg-white p-3 shadow-[0_8px_15px_rgba(0,0,0,0.08)] md:flex-nowrap"
		>
			<label class="flex min-w-[200px] flex-1 cursor-text items-center gap-3 rounded-xl bg-[#f9fafb] px-4 py-2.5 text-sm text-[#4b5563]">
				<img class="size-4 shrink-0" src="/images/summer/camps/icon-search.svg" alt="" aria-hidden="true" />
				<input
					type="search"
					class="min-w-0 flex-1 border-0 bg-transparent text-sm text-[#111827] outline-none placeholder:text-[#6b7280]"
					placeholder={content.searchPlaceholder}
					autocomplete="off"
					data-camp-search
					aria-label={content.searchPlaceholder}
				/>
			</label>
			<div
				class="flex flex-wrap items-center gap-3 border-l border-[#e5e7eb] pl-2 max-[900px]:mt-2 max-[900px]:w-full max-[900px]:basis-full max-[900px]:border-t max-[900px]:border-l-0 max-[900px]:pt-3 max-[900px]:pl-0"
			>
				<div class="flex flex-wrap items-center gap-3 max-[900px]:w-full">
					<div class="relative inline-flex min-w-0 items-stretch focus-within:z-[1]">
						<label class="sr-only" for="camp-filter-category">{content.filterLabels[0]}</label>
						<select
							id="camp-filter-category"
							class:list={[selectBase, 'min-w-[10.5rem] max-w-[240px]']}
							data-camp-filter="category"
							aria-label={content.filterLabels[0]}
						>
							<option value="all" selected>All camp types</option>
							{categories.map((cat) => (
								<option value={cat}>{cat}</option>
							))}
						</select>
						<img
							class="pointer-events-none absolute top-1/2 right-3 size-2.5 -translate-y-1/2 opacity-55"
							src="/images/summer/camps/icon-chevron.svg"
							alt=""
							aria-hidden="true"
						/>
					</div>
					<div class="relative inline-flex min-w-0 items-stretch focus-within:z-[1]">
						<label class="sr-only" for="camp-filter-age">{content.filterLabels[1]}</label>
						<select
							id="camp-filter-age"
							class:list={[selectBase, 'min-w-[8.25rem]']}
							data-camp-filter="age"
							aria-label={content.filterLabels[1]}
						>
							{
								ageOptions.map((o, i) => (
									<option value={o.value} selected={i === 0}>
										{o.label}
									</option>
								))
							}
						</select>
						<img
							class="pointer-events-none absolute top-1/2 right-3 size-2.5 -translate-y-1/2 opacity-55"
							src="/images/summer/camps/icon-chevron.svg"
							alt=""
							aria-hidden="true"
						/>
					</div>
				</div>
				<div
					class="flex flex-wrap items-center gap-3 border-l border-[#e5e7eb] pl-3 ml-1 max-[900px]:mt-1 max-[900px]:w-full max-[900px]:basis-full max-[900px]:border-t max-[900px]:border-l-0 max-[900px]:pt-2.5 max-[900px]:pl-0 max-[900px]:ml-0"
				>
					<div class="relative inline-flex min-w-0 items-stretch focus-within:z-[1]">
						<label class="sr-only" for="camp-filter-level">{content.filterLabels[2]}</label>
						<select
							id="camp-filter-level"
							class={selectBase}
							data-camp-filter="level"
							aria-label={content.filterLabels[2]}
						>
							<option value="all" selected>All levels</option>
							{levels.map((lvl) => (
								<option value={lvl}>{lvl}</option>
							))}
						</select>
						<img
							class="pointer-events-none absolute top-1/2 right-3 size-2.5 -translate-y-1/2 opacity-55"
							src="/images/summer/camps/icon-chevron.svg"
							alt=""
							aria-hidden="true"
						/>
					</div>
					<div
						class="flex min-h-11 min-w-[10.5rem] max-w-[240px] flex-[0_1_auto] items-center gap-0.5 rounded-[10px] border border-[#e2e8f0] bg-gradient-to-b from-white to-[#f8fafc] py-1 pl-3 pr-1.5 shadow-[inset_0_1px_0_rgba(255,255,255,0.85)] transition-[border-color,box-shadow] duration-150 focus-within:z-[1] focus-within:border-[#0a9dfb] focus-within:shadow-[0_0_0_3px_rgba(10,157,251,0.22),inset_0_1px_0_rgba(255,255,255,0.9)]"
					>
						<label class="sr-only" for="camp-filter-date">{content.filterLabels[3]}</label>
						<input
							type="date"
							id="camp-filter-date"
							class="relative min-w-0 flex-1 cursor-pointer border-0 bg-transparent text-sm font-semibold text-[#1e293b] outline-none [&::-moz-calendar-picker-indicator]:opacity-0 [&::-webkit-calendar-picker-indicator]:absolute [&::-webkit-calendar-picker-indicator]:inset-0 [&::-webkit-calendar-picker-indicator]:h-full [&::-webkit-calendar-picker-indicator]:w-full [&::-webkit-calendar-picker-indicator]:cursor-pointer [&::-webkit-calendar-picker-indicator]:opacity-0"
							data-camp-filter="date"
							min="2026-06-01"
							max="2026-08-14"
							aria-label={content.filterLabels[3]}
						/>
						<button
							type="button"
							class="inline-flex h-9 w-10 shrink-0 items-center justify-center rounded-lg border-0 bg-[rgba(10,157,251,0.1)] p-0 text-[#0369a1] transition-[background,transform] duration-150 hover:bg-[rgba(10,157,251,0.18)] active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0a9dfb]"
							data-camp-date-picker
							aria-label={`Open calendar for ${content.filterLabels[3]}`}
						>
							<img class="block size-4" src="/images/summer/camps/icon-calendar.svg" alt="" aria-hidden="true" />
						</button>
					</div>
				</div>
			</div>
			<button
				type="button"
				class="cursor-pointer rounded-xl border-0 bg-[#0a9dfb] px-8 py-3 font-medium text-white transition-[filter] duration-150 hover:brightness-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0369a1]"
				data-camp-explore
			>
				{content.exploreLabel}
			</button>
		</div>

		<p class="sr-only" data-camp-status aria-live="polite" />

		<div
			id="summer-camp-results"
			class="grid grid-cols-1 gap-x-5 gap-y-[15px] md:grid-cols-2 lg:grid-cols-3"
			data-camp-grid
		>
			{
				cards.map((camp) => {
					const campHref = courseHref(camp.name);
					return (
					<a
						class="block rounded-2xl border border-[#e2e8f0] bg-white p-2 text-inherit no-underline transition-[box-shadow,border-color] duration-200 ease-out hover:border-[#cbd5e1] hover:shadow-[0_4px_20px_rgba(15,23,42,0.08)]"
						href={campHref}
						data-camp-card
						data-category={camp.tag}
						data-level={camp.level}
						data-date-slot={camp.dateSlot ?? ''}
						data-date-start={camp.dateStart ?? ''}
						data-date-end={camp.dateEnd ?? ''}
						data-age={camp.ages ?? ''}
						data-search={searchBlob(camp)}
					>
						<div class="relative w-full overflow-hidden rounded-xl bg-[#f1f5f9]" style="aspect-ratio:16/9;">
							<img
								class="absolute inset-0 h-full w-full object-contain"
								src={camp.image}
								alt={camp.name}
								loading="lazy"
								decoding="async"
							/>
							{camp.dateStartDisplay && (
								<span class="absolute bottom-2 left-2 inline-flex items-center gap-1 rounded-md bg-black/60 px-2 py-1 text-[10px] font-semibold text-white backdrop-blur-sm">
									<img class="size-2.5 shrink-0 invert" src="/images/summer/camps/icon-calendar.svg" alt="" aria-hidden="true" />
									{camp.dateStartDisplay}
									{camp.dateEndDisplay && camp.dateEndDisplay !== camp.dateStartDisplay
										? ` – ${camp.dateEndDisplay}`
										: ''}
								</span>
							)}
						</div>
						<div class="p-4 pt-8">
							<span
								class:list={[
									'inline-block rounded px-2 py-1 text-[10px] font-bold tracking-[0.03em] uppercase',
									tagClassMap[camp.tagClass] ?? 'bg-[#e2e8f0] text-[#475569]',
								]}
							>
								{camp.tag}
							</span>
							<h3 class="mt-2 mb-0 text-[17px] leading-7 font-semibold text-[#111827]">{camp.name}</h3>
							<p class="mt-0 max-w-[285px] text-base leading-[26px] text-[#475569]">{camp.description}</p>
						</div>
						<div class="flex items-center gap-4 border-t border-[#e5e7eb] p-1.5">
							<div class="inline-flex items-center gap-1.5">
								<img class="size-3" src="/images/summer/camps/icon-age.svg" alt="" aria-hidden="true" />
								<small class="text-xs font-medium text-[#334155]">{camp.ages}</small>
							</div>
							<div class="inline-flex items-center gap-1.5">
								<img src={camp.levelIcon} alt="" aria-hidden="true" class="size-3" />
								<small class="text-xs font-medium text-[#334155]">{camp.level}</small>
							</div>
							<strong class="ml-auto text-lg leading-7 text-[#0a9dfb]">${camp.price}</strong>
						</div>
					</a>
					);
				})
			}
		</div>

		<!-- Pagination Controls -->
		<div
			class="mt-8 flex flex-wrap items-center justify-center gap-2"
			data-camp-pagination
			role="navigation"
			aria-label="Camps pagination"
		>
			<button
				type="button"
				class="inline-flex items-center gap-2 rounded-lg border border-[#e2e8f0] bg-white px-4 py-2 text-sm font-medium text-[#1e293b] transition-[border-color,background] duration-150 hover:border-[#cbd5e1] hover:bg-[#f8fafc] disabled:opacity-50 disabled:cursor-not-allowed"
				data-camp-prev-page
				aria-label="Previous page"
			>
				Prev
			</button>
			<div class="text-sm font-medium text-[#475569]" data-camp-page-buttons></div>
			<button
				type="button"
				class="inline-flex items-center gap-2 rounded-lg border border-[#e2e8f0] bg-white px-4 py-2 text-sm font-medium text-[#1e293b] transition-[border-color,background] duration-150 hover:border-[#cbd5e1] hover:bg-[#f8fafc] disabled:opacity-50 disabled:cursor-not-allowed"
				data-camp-next-page
				aria-label="Next page"
			>
				Next
			</button>
		</div>

		<p class="mt-8 hidden text-center text-[#64748b]" data-camp-empty>
			No camps match your filters. Try clearing search, setting camp type and age to All, or clearing the date.
		</p>

		<div
			class="relative mt-12 overflow-hidden rounded-3xl border border-[rgba(124,58,237,0.2)] bg-[linear-gradient(135deg,#F5F3FF_0%,#EFF6FF_100%)] p-8 lg:p-10"
		>
			<!-- Decorative sparkle blobs -->
			<div class="pointer-events-none absolute right-0 top-0 size-48 -translate-y-1/3 translate-x-1/3 rounded-full bg-[#7C3AED]/8 blur-[60px]" aria-hidden="true"></div>
			<div class="pointer-events-none absolute left-0 bottom-0 size-32 translate-y-1/3 -translate-x-1/3 rounded-full bg-[#0A9DFB]/8 blur-[40px]" aria-hidden="true"></div>

			<div class="relative flex flex-wrap items-center justify-between gap-6 md:flex-nowrap max-md:flex-col max-md:text-center">
				<div>
					<!-- AI badge -->
					<div class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#7C3AED]/10 px-3 py-1 max-md:mx-auto">
						<span class="text-base leading-none" aria-hidden="true">✨</span>
						<span class="text-xs font-bold tracking-[0.08em] text-[#7C3AED] uppercase">AI-Powered Scheduling</span>
						<span class="text-base leading-none" aria-hidden="true">✨</span>
					</div>
					<h3 class="m-0 text-2xl leading-9 font-bold text-[#111827]">{content.aiTitle}</h3>
					<p class="mt-2 mb-0 text-base text-[#475569]">{content.aiDescription}</p>
				</div>
				<button
					type="button"
					class="relative z-[1] inline-flex shrink-0 items-center gap-2.5 whitespace-nowrap rounded-xl bg-[#7C3AED] px-8 py-3.5 text-white font-bold shadow-[0_4px_16px_rgba(124,58,237,0.3)] transition-[opacity,transform] hover:-translate-y-px hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7C3AED] max-md:w-full max-md:justify-center"
					data-scheduley-open
					data-scheduley-embed-src={scheduleyEmbedSrc}
					aria-haspopup="dialog"
				>
					<span class="text-lg leading-none" aria-hidden="true">✨</span>
					{content.aiCtaLabel ?? '✨ Chat with Scheduley AI'}
				</button>
			</div>
		</div>
		<div class="mt-[45px] text-center">
			<a
				href={content.browseHref}
				class="inline-flex items-center justify-center rounded-xl border-2 border-[#0a9dfb] px-10 py-4 text-base font-bold text-[#0a9dfb] no-underline"
			>
				{content.browseLabel}
			</a>
		</div>
	</div>

	<div
		id="summer-scheduley-modal"
		class="fixed inset-0 z-[110] flex items-center justify-center p-4 opacity-100 pointer-events-auto transition-opacity duration-200 max-md:p-2 [&.is-closed]:pointer-events-none [&.is-closed]:opacity-0"
		aria-hidden="true"
	>
		<button
			type="button"
			class="absolute inset-0 cursor-pointer border-0 bg-slate-900/75 p-0"
			data-scheduley-modal-close
			aria-label="Close Scheduley AI"
		/>
		<div
			class="relative z-[1] flex max-h-[min(800px,92vh)] w-full max-w-4xl flex-col overflow-hidden rounded-2xl bg-white shadow-[0_24px_48px_rgba(15,23,42,0.2)] max-md:max-h-[96vh] max-md:rounded-xl"
			role="dialog"
			aria-modal="true"
			aria-labelledby="summer-scheduley-modal-title"
		>
			<div class="flex items-center justify-between gap-3 border-b border-[#e2e8f0] bg-[#f8fafc] px-4 py-3">
				<p id="summer-scheduley-modal-title" class="m-0 text-base font-bold text-[#0f172a]">
					{content.aiEmbedTitle ?? content.aiCtaLabel ?? 'Scheduley AI'}
				</p>
				<button
					type="button"
					class="inline-flex size-10 shrink-0 items-center justify-center rounded-full border-0 bg-transparent p-0 text-[#475569] hover:bg-[#e2e8f0] hover:text-[#0f172a]"
					data-scheduley-modal-close
					aria-label="Close Scheduley AI"
				>
					<svg
						class="block size-[1.125rem] shrink-0"
						aria-hidden="true"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
					>
						<path d="M18 6 6 18M6 6l12 12" />
					</svg>
				</button>
			</div>
			<iframe
				class="block min-h-[min(720px,calc(92vh-3.5rem))] w-full flex-1 border-0 bg-white max-md:min-h-[min(720px,calc(96vh-3.25rem))]"
				data-scheduley-iframe
				title={content.aiEmbedTitle ?? 'Summer Camp Guide'}
				allow="microphone; clipboard-write; screen-wake-lock"
			/>
		</div>
	</div>

	<script type="application/json" id="summer-camps-config" set:html={campsConfig} />

	<script is:inline>
		(function () {
			const modal = document.getElementById('summer-scheduley-modal');
			const iframe = modal && modal.querySelector('[data-scheduley-iframe]');

			function closeScheduleyModal() {
				if (!modal || !iframe) return;
				modal.classList.add('is-closed');
				modal.setAttribute('aria-hidden', 'true');
				document.body.classList.remove('overflow-hidden');
				iframe.removeAttribute('src');
			}

			function openScheduleyModal(embedSrc) {
				if (!modal || !iframe || !embedSrc) return;
				modal.classList.remove('is-closed');
				modal.setAttribute('aria-hidden', 'false');
				document.body.classList.add('overflow-hidden');
				iframe.src = embedSrc;
			}

			function bindScheduleyModal() {
				document.querySelectorAll('[data-scheduley-open]').forEach(function (btn) {
					if (btn.dataset.scheduleyBound === '1') return;
					btn.dataset.scheduleyBound = '1';
					btn.addEventListener('click', function () {
						const embedSrc = btn.getAttribute('data-scheduley-embed-src');
						if (embedSrc) openScheduleyModal(embedSrc);
					});
				});

				modal?.querySelectorAll('[data-scheduley-modal-close]').forEach(function (btn) {
					btn.addEventListener('click', closeScheduleyModal);
				});

				document.addEventListener('keydown', function (event) {
					if (event.key === 'Escape' && modal && !modal.classList.contains('is-closed')) {
						closeScheduleyModal();
					}
				});
			}

			if (modal) {
				modal.classList.add('is-closed');
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', bindScheduleyModal);
			} else {
				bindScheduleyModal();
			}

			document.addEventListener('astro:page-load', bindScheduleyModal);
		})();
	</script>

	<script>
		function readConfig() {
			const el = document.getElementById('summer-camps-config');
			try {
				return JSON.parse(el?.textContent || '{}');
			} catch {
				return { guidedOptions: [] };
			}
		}

		function initSummerCamps() {
			const root = document.querySelector('[data-summer-camps-root]');
			if (!root) return;
			const rootEl = root as HTMLElement;
			if (rootEl.dataset.summerCampsInited === '1') return;
			rootEl.dataset.summerCampsInited = '1';

			const { guidedOptions } = readConfig() as { guidedOptions: { label: string; categories: string[] }[] };
			const searchEl = root.querySelector('[data-camp-search]') as HTMLInputElement | null;
			const ageEl = root.querySelector('[data-camp-filter="age"]') as HTMLSelectElement | null;
			const categoryEl = root.querySelector('[data-camp-filter="category"]') as HTMLSelectElement | null;
			const levelEl = root.querySelector('[data-camp-filter="level"]') as HTMLSelectElement | null;
			const dateEl = root.querySelector('[data-camp-filter="date"]') as HTMLInputElement | null;
			const datePickerBtn = root.querySelector('[data-camp-date-picker]') as HTMLButtonElement | null;
			const cards = [...root.querySelectorAll('[data-camp-card]')] as HTMLElement[];
			const emptyEl = root.querySelector('[data-camp-empty]') as HTMLElement | null;
			const statusEl = root.querySelector('[data-camp-status]') as HTMLElement | null;
			const exploreBtn = root.querySelector('[data-camp-explore]') as HTMLButtonElement | null;
			const grid = root.querySelector('[data-camp-grid]') as HTMLElement | null;
			const paginationEl = root.querySelector('[data-camp-pagination]') as HTMLElement | null;
			const pageButtonsContainer = root.querySelector('[data-camp-page-buttons]') as HTMLElement | null;
			const prevBtn = root.querySelector('[data-camp-prev-page]') as HTMLButtonElement | null;
			const nextBtn = root.querySelector('[data-camp-next-page]') as HTMLButtonElement | null;

			let guidedCategories: string[] | null = null;
			let currentPage = 1;
			const campsPerPage = 6; // 2 rows × 3 columns

			function ageFilterMatches(cardAge: string, filterAge: string): boolean {
				if (!filterAge || filterAge === 'all') return true;
				if (!cardAge) return false;
				// Both are range strings like "8-11" — direct comparison
				return String(cardAge).trim() === String(filterAge).trim();
			}

			function selectedAgeFilterValue(): string {
				const val = (ageEl?.value || '').trim();
				if (!val || val === 'all') return '';
				return val;
			}

			function filterSentinel(raw: string | undefined): string {
				const v = (raw ?? '').trim();
				if (!v || v.toLowerCase() === 'all') return '';
				return v;
			}

			function dateInRange(pick: string, start: string, end: string) {
				if (!pick || !start || !end) return false;
				return pick >= start && pick <= end;
			}

			function updateSelectOptions(selectEl: HTMLSelectElement, options: { value: string; label: string }[], defaultLabel: string, selectedValue: string) {
				selectEl.innerHTML = '';
				for (const option of options) {
					const opt = document.createElement('option');
					opt.value = option.value;
					opt.textContent = option.label;
					if (option.value === selectedValue) opt.selected = true;
					selectEl.appendChild(opt);
				}
				if (!options.some((opt) => opt.value === selectedValue)) {
					selectEl.value = 'all';
				}
			}

			function updateFilterOptions(searchMatchedCards: HTMLElement[]) {
				if (!categoryEl || !levelEl || !ageEl) return;

				const categories = [...new Set(searchMatchedCards.map((card) => (card.dataset.category || '').trim()).filter(Boolean))].sort();
				const levels = [...new Set(searchMatchedCards.map((card) => (card.dataset.level || '').trim()).filter(Boolean))].sort();

				// Build age options from matched cards, sorted numerically by lower bound
				const ageSet = [...new Set(searchMatchedCards.map((card) => (card.dataset.age || '').trim()).filter(Boolean))];
				const ageSorted = ageSet.sort((a, b) => {
					const aFrom = parseInt(a.split('-')[0]) || 0;
					const bFrom = parseInt(b.split('-')[0]) || 0;
					return aFrom !== bFrom ? aFrom - bFrom : (parseInt(a.split('-')[1]) || 0) - (parseInt(b.split('-')[1]) || 0);
				});
				const ageValues = [
					{ value: 'all', label: defaultAgeLabel() },
					...ageSorted.map((ag) => ({ value: ag, label: `Ages ${ag}` })),
				];

				updateSelectOptions(
					categoryEl,
					[{ value: 'all', label: defaultCategoryLabel() }, ...categories.map((value) => ({ value, label: value }))],
					defaultCategoryLabel(),
					categoryEl.value,
				);

				updateSelectOptions(
					levelEl,
					[{ value: 'all', label: defaultLevelLabel() }, ...levels.map((value) => ({ value, label: value }))],
					defaultLevelLabel(),
					levelEl.value,
				);

				updateSelectOptions(ageEl, ageValues, defaultAgeLabel(), ageEl.value);
			}

			function defaultCategoryLabel() {
				return 'All camp types';
			}

			function defaultLevelLabel() {
				return 'All levels';
			}

			function defaultAgeLabel() {
				return 'All ages';
			}

			function updatePaginationButtons() {
				const visibleCards = cards.filter((card) => !card.classList.contains('hidden'));
				const totalPages = Math.ceil(visibleCards.length / campsPerPage);

				if (pageButtonsContainer) {
					pageButtonsContainer.textContent = totalPages > 0 ? `page ${currentPage} of ${totalPages}` : '';
				}

				if (prevBtn) prevBtn.disabled = currentPage === 1;
				if (nextBtn) nextBtn.disabled = currentPage === totalPages || totalPages === 0;
			}

			function applyPagination(scroll = true) {
				const visibleCards = cards.filter((card) => !card.classList.contains('hidden'));
				const start = (currentPage - 1) * campsPerPage;
				const end = start + campsPerPage;

				visibleCards.forEach((card, index) => {
					card.style.display = index >= start && index < end ? '' : 'none';
				});

				updatePaginationButtons();

				// Only scroll when triggered by a user action, not on initial load
				if (scroll && grid) {
					grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
			}

			function applyFilters(scroll = true) {
				const q = (searchEl?.value || '').trim().toLowerCase();
				const searchMatchedCards = q
					? cards.filter((card) => (card.dataset.search || '').includes(q))
					: cards;
				updateFilterOptions(searchMatchedCards);

				const filterAgeLabel = selectedAgeFilterValue();
				const catVal = filterSentinel(categoryEl?.value);
				const levelVal = filterSentinel(levelEl?.value);
				const datePick = (dateEl?.value || '').trim();

				let visible = 0;

				const catValKey = catVal.trim().toLowerCase();
				const levelValKey = levelVal.trim().toLowerCase();

				for (const card of cards) {
					const blob = (card.getAttribute('data-search') || '').toLowerCase();
					const category = (card.getAttribute('data-category') || '').trim();
					const level = (card.getAttribute('data-level') || '').trim();
					const dateStart = card.getAttribute('data-date-start') || '';
					const dateEnd = card.getAttribute('data-date-end') || '';
					const cardAge = (card.getAttribute('data-age') || '').trim();

					let ok = true;

					if (q && !blob.includes(q)) ok = false;

					const catKey = category.toLowerCase();

					if (ok && guidedCategories && guidedCategories.length) {
						const inGuided = guidedCategories.some((c) => c.trim().toLowerCase() === catKey);
						if (!inGuided) ok = false;
					} else if (ok && catVal && catKey !== catValKey) ok = false;

					if (ok && levelValKey && level.toLowerCase() !== levelValKey) ok = false;

					if (ok && datePick) {
						if (!dateInRange(datePick, dateStart, dateEnd)) ok = false;
					}

					if (ok && filterAgeLabel && !ageFilterMatches(cardAge, filterAgeLabel)) ok = false;

					card.classList.toggle('hidden', !ok);
					if (ok) visible++;
				}

				if (emptyEl) emptyEl.classList.toggle('hidden', visible !== 0);
				if (statusEl) {
					statusEl.textContent =
						visible === cards.length
							? `Showing all ${visible} camps`
							: `Showing ${visible} of ${cards.length} camps`;
				}

				// Reset to page 1 and apply pagination
				currentPage = 1;
				applyPagination(scroll);
			}

			function clearGuided() {
				guidedCategories = null;
			}

			searchEl?.addEventListener('input', () => {
				if ((searchEl.value || '').trim()) clearGuided();
				applyFilters();
			});

			for (const sel of [ageEl, categoryEl, levelEl]) {
				const run = () => {
					if (sel === categoryEl) clearGuided();
					applyFilters();
				};
				sel?.addEventListener('change', run);
				sel?.addEventListener('input', run);
			}

			dateEl?.addEventListener('change', () => applyFilters());
			dateEl?.addEventListener('input', () => applyFilters());

			// Pagination button listeners
			if (prevBtn) {
				prevBtn.addEventListener('click', () => {
					if (currentPage > 1) {
						currentPage--;
						applyPagination();
					}
				});
			}

			if (nextBtn) {
				nextBtn.addEventListener('click', () => {
					const visibleCards = cards.filter((card) => !card.classList.contains('hidden'));
					const totalPages = Math.ceil(visibleCards.length / campsPerPage);
					if (currentPage < totalPages) {
						currentPage++;
						applyPagination();
					}
				});
			}

			datePickerBtn?.addEventListener('click', () => {
				const inp = dateEl;
				if (!inp) return;
				const dt = inp as HTMLInputElement & { showPicker?: () => void };
				if (typeof dt.showPicker === 'function') {
					try {
						dt.showPicker();
					} catch {
						inp.focus();
					}
				} else {
					inp.focus();
				}
			});

			root.querySelectorAll('[data-guided-index]').forEach((btn) => {
				btn.addEventListener('click', () => {
					const idx = parseInt((btn as HTMLElement).dataset.guidedIndex || '-1', 10);
					const opt = guidedOptions[idx];
					if (!opt?.categories?.length) return;

					guidedCategories = [...opt.categories];
					if (categoryEl) categoryEl.value = 'all';
					applyFilters();
					grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
				});
			});

			exploreBtn?.addEventListener('click', () => {
				grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});

			// Initial render — do NOT scroll, just show the cards
			applyFilters(false);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initSummerCamps);
		} else {
			initSummerCamps();
		}

		document.addEventListener('astro:page-load', initSummerCamps);
	</script>
</section>
