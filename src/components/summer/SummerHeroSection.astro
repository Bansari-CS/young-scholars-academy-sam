---
interface Props {
	content: any;
}

const { content } = Astro.props as Props;
---

<section class="relative summer-hero bg-[linear-gradient(169deg,#f8fafc_0%,rgba(240,244,255,0.3)_50%,#f8fafc_100%)] py-20">
	<div class="mx-auto box-border grid w-full max-w-[90rem] grid-cols-1 items-center gap-[48px] px-4 sm:px-6 lg:px-10 lg:grid-cols-[1fr_576px]">
		<div>
			<span class="inline-flex items-center gap-2 rounded-full border border-[#e0e9ff] bg-white px-4 py-2 font-[Inter,ui-sans-serif,system-ui,sans-serif] text-[12px] font-medium tracking-[-0.3px] text-[#7c3aed] uppercase">
				<span class="h-2 w-2 rounded-full bg-[#048c3c]"></span>
				{content.badge}
			</span>
			<h1 class="m-[1.5rem_0_1.5rem] text-[28px] sm:text-[36px] lg:text-[44px] font-bold text-[#111827] leading-[55px]">
				{content.titlePrefix}
				<span class="bg-gradient-to-b from-[#0a9dfb] to-[#7c3aed] bg-clip-text text-transparent">{content.titleHighlight}</span>
			</h1>
			<div class="max-w-[580px]">
				<p class="m-0 text-lg leading-[1.8] text-[#475569]">
					{typeof content.description === 'string' && content.description.trim()
						? content.description.trim()
						: Array.isArray(content.descriptionLines)
							? content.descriptionLines.join(' ')
							: ''}
				</p>
			</div>
			<div class="my-6 flex gap-4 pb-6 mt-[28px]">
				<a
					class="inline-flex items-center gap-2 rounded-xl bg-[#0a9dfb] px-8 py-4 font-[var(--ysa-font-display)] font-medium text-white no-underline"
					href={content.primaryCtaHref}
				>
					{content.primaryCtaLabel}
					<svg width="11" height="10" viewBox="0 0 11 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path
							d="M6.83333 1L10 4.16667M10 4.16667L6.83333 7.33333M10 4.16667H0"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						></path>
					</svg>
				</a>
				<a class="rounded-xl border border-[#e2e8f0] bg-white px-8 py-4 font-[var(--ysa-font-display)] font-medium text-[#475569] no-underline" href={content.secondaryCtaHref}>{content.secondaryCtaLabel}</a>
			</div>
			<ul class="m-0  mr-auto flex flex-wrap md:flex-nowrap max-w-[497px] flex list-none grid-cols-4 gap-8 border-t border-[#e2e8f0] pt-6 md:pt-8">
				{
					content.stats.map((stat, index) => (
						<li class={`flex flex-col w-fit ${index < content.stats.length - 1 ? 'border-r border-[#E2E8F0] pr-8' : ''}`.trim()}>
							<strong class="font-[var(--ysa-font-display)] text-sm text-[#111827] font-semibold leading-[28px]">{stat.value}</strong>
							<span class="text-[14px] leading-[normal] text-[rgba(71,85,105,0.6)]">{stat.label}</span>
						</li>
					))
				}
			</ul>
		</div>

		<div class="rounded-3xl border border-[#e2e8f0] bg-white lg:py-5 lg:px-6 p-5 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)] z-[1] xl:max-w-[537px]">
			<div class="flex items-center justify-between gap-4">
				<div class="flex items-center gap-3 flex-wrap lg:flex-nowrap">
					<img class="h-12 w-12 rounded-full object-cover" src="/images/summer/avatar.png" alt={content.classImageAlt} />
					<div>
						<h3 class="m-0 text-base font-bold leading-6">{content.dashboardTitle}</h3>
						<p class="m-0 text-xs text-[#64748b]">{content.dashboardSubtitle}</p>
					</div>
				</div>
				<span class="rounded-lg border border-[#048c3c] bg-[#e3ffee] px-3 py-1 text-xs font-bold text-[#048c3c]">{content.liveLabel}</span>
			</div>

			<div class="relative mt-[26px]">
				<img class="h-[320px] w-full rounded-xl border-2 border-[#e2e8f0] object-cover" src="/images/summer/hero-classroom.png" alt={content.classImageAlt} />
				<span class="absolute inset-0 grid place-content-center text-[1.6rem] text-[#0a9dfb]">▶</span>
			</div>

			<div class="mt-[26px] grid grid-cols-1 md:grid-cols-2 gap-4">
				<div class="rounded-xl border border-[#decbfe] bg-[#f5f3ff] p-4">
					<small class="text-[0.625rem] font-bold uppercase tracking-[0.06em] text-[#7c3aed]">{content.nextActivityLabel}</small>
					<p class="m-[0.25rem_0_0] text-sm font-semibold text-[#1e293b]">{content.nextActivityValue}</p>
				</div>
				<div class="rounded-xl border border-[#e0e9ff] bg-[#eff6ff] p-4">
					<small class="text-[0.625rem] font-bold uppercase tracking-[0.06em] text-[#0a9dfb]">{content.classmateCountLabel}</small>
					<p class="m-[0.25rem_0_0] text-sm font-semibold text-[#1e293b]">{content.classmateCountValue}</p>
				</div>
			</div>
		</div>
	</div>
</section>
