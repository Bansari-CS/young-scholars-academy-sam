---
---

<section class="bg-[linear-gradient(169deg,#f8fafc_0%,rgba(240,244,255,0.3)_50%,#f8fafc_100%)] px-4 py-20">
	<div class="mx-auto grid max-w-[69rem] grid-cols-[1fr_535px] items-center gap-[48px]">
		<div>
			<span class="inline-flex items-center gap-2 rounded-full border border-[#e0e9ff] bg-white px-4 py-2 text-xs font-medium uppercase text-[#7c3aed]">
				<span class="h-2 w-2 rounded-full bg-[#048c3c]"></span>
				Summer 2026 Enrollment Open
			</span>
			<h1 class="m-[1.5rem_0_1rem] text-[44px] font-bold text-[#111827]">
				The Summer Your Child 
				Finally <span class="bg-[linear-gradient(90deg,#0a9dfb_0%,#7c3aed_100%)] bg-clip-text text-transparent">Finds Their People.</span>
			</h1>
			<p class="m-0 text-lg leading-[1.8] text-[#475569]">
				321 virtual camps for gifted, 2e, and neurodivergent kids.<br />
				Join a global community where "quirky" is the superpower.<br />
				June 1 - August 14, 2026.
			</p>
			<div class="my-6 flex gap-4">
				<a class="rounded-xl bg-[#0a9dfb] px-8 py-4 font-[var(--ysa-font-display)] font-medium text-white no-underline" href="#programs">Find Their Camp -&gt;</a>
				<a class="rounded-xl border border-[#e2e8f0] bg-white px-8 py-4 font-[var(--ysa-font-display)] font-medium text-[#475569] no-underline" href="#how-it-works">How It Works</a>
			</div>
			<ul class="m-0 grid list-none grid-cols-4 gap-4 border-t border-[#e2e8f0] pt-6">
				<li class="flex flex-col gap-1"><strong class="font-[var(--ysa-font-display)] text-sm text-[#111827]">321+</strong><span class="text-sm text-[#64748b]">Camps</span></li>
				<li class="flex flex-col gap-1"><strong class="font-[var(--ysa-font-display)] text-sm text-[#111827]">10 Weeks</strong><span class="text-sm text-[#64748b]">June-August</span></li>
				<li class="flex flex-col gap-1"><strong class="font-[var(--ysa-font-display)] text-sm text-[#111827]">50 Min</strong><span class="text-sm text-[#64748b]">Sessions</span></li>
				<li class="flex flex-col gap-1"><strong class="font-[var(--ysa-font-display)] text-sm text-[#111827]">Ages 5-18</strong><span class="text-sm text-[#64748b]">All Levels</span></li>
			</ul>
		</div>

		<div class="rounded-3xl border border-[#e2e8f0] bg-white p-6 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)]">
			<div class="flex items-center justify-between gap-4">
				<div class="flex items-center gap-3">
					<img class="h-12 w-12 rounded-full object-cover" src="/images/summer/avatar.png" alt="Instructor avatar" />
					<div>
						<h3 class="m-0 text-base">Summer Camp Dashboard</h3>
						<p class="m-0 text-xs text-[#64748b]">Dungeons &amp; Dragons Strategy - Session 3</p>
					</div>
				</div>
				<span class="rounded-lg border border-[#048c3c] bg-[#e3ffee] px-3 py-1 text-xs font-bold text-[#048c3c]">LIVE NOW</span>
			</div>

			<div class="relative mt-6">
				<img class="h-[320px] w-full rounded-xl border-2 border-[#e2e8f0] object-cover" src="/images/summer/hero-classroom.png" alt="Virtual class session" />
				<span class="absolute inset-0 grid place-content-center text-[1.6rem] text-[#0a9dfb]">▶</span>
			</div>

			<div class="mt-4 grid grid-cols-2 gap-4">
				<div class="rounded-xl border border-[#decbfe] bg-[#f5f3ff] p-4">
					<small class="text-[0.625rem] font-bold uppercase tracking-[0.06em] text-[#7c3aed]">Next Activity</small>
					<p class="m-[0.25rem_0_0] text-sm font-semibold text-[#1e293b]">Dragon Boss Battle</p>
				</div>
				<div class="rounded-xl border border-[#e0e9ff] bg-[#eff6ff] p-4">
					<small class="text-[0.625rem] font-bold uppercase tracking-[0.06em] text-[#0a9dfb]">Classmate Count</small>
					<p class="m-[0.25rem_0_0] text-sm font-semibold text-[#1e293b]">6 Peers Online</p>
				</div>
			</div>
		</div>
	</div>
</section>
