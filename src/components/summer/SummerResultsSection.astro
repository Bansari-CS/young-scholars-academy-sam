---
import {
	googleDriveDownloadUrl,
	googleDrivePreviewUrl,
	googleDriveThumbnailUrl,
} from '../../utils/googleDrive';

interface TestimonialItem {
	name: string;
	meta: string;
	driveFileId: string;
	posterSrc: string;
	quote: string;
}

interface Props {
	content: {
		eyebrow: string;
		title: string;
		description: string;
		items: TestimonialItem[];
	};
}

const { content } = Astro.props;
const playIcon = '/assets/images/Vector.svg';

function getPoster(item: TestimonialItem) {
	return item.posterSrc || googleDriveThumbnailUrl(item.driveFileId);
}
---

<section
	class="bg-[#1a0f3a] py-16 md:py-20 xl:py-24"
	aria-labelledby="summer-results-heading"
>
	<div class="mx-auto box-border w-full max-w-[90rem] px-4 sm:px-6 lg:px-10">
		<p class="mx-auto mb-4 w-max rounded-full bg-white/10 px-4 py-2 text-xs font-bold text-white">
			{content.eyebrow}
		</p>
		<h2
			id="summer-results-heading"
			class="m-0 text-center text-[28px] font-bold text-white sm:text-[36px] lg:text-[44px]"
		>
			{content.title}
		</h2>
		<p class="mx-auto mt-4 mb-16 max-w-[48rem] text-center text-base text-[#c7d5fe]">
			{content.description}
		</p>

		<div
			class="mx-auto grid max-w-[960px] grid-cols-1 gap-6 md:grid-cols-2 md:gap-8"
			aria-label="Summer camp family testimonials"
		>
			{
				content.items.map((item) => (
					<article class="overflow-hidden rounded-2xl border border-white/20 bg-white/10">
						<div
							class="group relative cursor-pointer bg-slate-900"
							data-summer-video-trigger
							data-drive-download={googleDriveDownloadUrl(item.driveFileId)}
							data-drive-preview={googleDrivePreviewUrl(item.driveFileId)}
							data-video-title={`${item.name} testimonial`}
						>
							<img
								src={getPoster(item)}
								alt={`${item.name} testimonial`}
								width={640}
								height={360}
								loading="lazy"
								class="block h-48 w-full object-cover"
							/>
							<button
								type="button"
								class="absolute left-1/2 top-1/2 z-[1] flex h-6 w-[2.15rem] -translate-x-1/2 -translate-y-1/2 items-center justify-center border-0 bg-transparent p-0 transition-transform duration-200 group-hover:scale-105"
								data-summer-video-play
								aria-label={`Play ${item.name} testimonial`}
							>
								<img src={playIcon} alt="" class="h-full w-full object-contain" />
							</button>
						</div>
						<div class="p-6">
							<p class="m-0 text-base italic leading-[26px] text-[#f0f4ff]">"{item.quote}"</p>
							<footer class="mt-4 flex items-center gap-3">
								<img
									src={getPoster(item)}
									alt=""
									width={40}
									height={40}
									loading="lazy"
									aria-hidden="true"
									class="h-10 w-10 shrink-0 rounded-full border-2 border-white/30 object-cover"
								/>
								<div>
									<strong class="block text-sm leading-5 text-white">{item.name}</strong>
									<span class="mt-0.5 block text-xs leading-4 text-[#c7d5fe]">{item.meta}</span>
								</div>
							</footer>
						</div>
					</article>
				))
			}
		</div>
	</div>

	<div
		id="summer-video-modal"
		class="pointer-events-none fixed inset-0 z-[100] flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 [&:not(.is-closed)]:pointer-events-auto [&:not(.is-closed)]:opacity-100"
		aria-hidden="true"
	>
		<button
			type="button"
			class="absolute inset-0 border-0 bg-black/75 p-0"
			data-summer-modal-close
			aria-label="Close video"
		/>
		<div
			class="relative z-[1] w-full max-w-4xl overflow-hidden rounded-2xl bg-slate-950 shadow-2xl"
			role="dialog"
			aria-modal="true"
			aria-labelledby="summer-video-modal-title"
		>
			<p id="summer-video-modal-title" class="sr-only" />
			<button
				type="button"
				class="absolute right-3 top-3 z-[2] inline-flex h-10 w-10 items-center justify-center rounded-full border-0 bg-black/60 p-0 text-white"
				data-summer-modal-close
				aria-label="Close video"
			>
				<svg
					aria-hidden="true"
					class="block h-4 w-4 shrink-0"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
				>
					<path d="M18 6 6 18M6 6l12 12" />
				</svg>
			</button>
			<video class="block max-h-[80vh] w-full bg-black" controls playsinline preload="metadata" />
			<iframe
				class="hidden aspect-video w-full bg-black"
				title="Testimonial video"
				allow="autoplay; fullscreen"
				allowfullscreen
			/>
		</div>
	</div>
</section>

<script is:inline>
	(function () {
		const modal = document.getElementById('summer-video-modal');
		const modalTitle = document.getElementById('summer-video-modal-title');
		const video = modal && modal.querySelector('video');
		const iframe = modal && modal.querySelector('iframe');

		function closeModal() {
			if (!modal || !video || !iframe) return;
			modal.classList.add('is-closed');
			modal.setAttribute('aria-hidden', 'true');
			document.body.classList.remove('overflow-hidden');
			video.pause();
			video.removeAttribute('src');
			video.classList.remove('hidden');
			iframe.classList.add('hidden');
			iframe.removeAttribute('src');
		}

		function openModal(trigger) {
			if (!modal || !video || !iframe || !modalTitle) return;
			const downloadUrl = trigger.getAttribute('data-drive-download');
			const previewUrl = trigger.getAttribute('data-drive-preview');
			const title = trigger.getAttribute('data-video-title') || 'Testimonial video';
			if (!downloadUrl || !previewUrl) return;

			modalTitle.textContent = title;
			modal.classList.remove('is-closed');
			modal.setAttribute('aria-hidden', 'false');
			document.body.classList.add('overflow-hidden');

			iframe.classList.add('hidden');
			iframe.removeAttribute('src');
			video.classList.remove('hidden');
			video.src = downloadUrl;
			video.load();
			video.play().catch(function () {});

			video.onerror = function () {
				video.pause();
				video.removeAttribute('src');
				video.classList.add('hidden');
				iframe.classList.remove('hidden');
				iframe.src = previewUrl;
			};
		}

		function bindTriggers() {
			document.querySelectorAll('[data-summer-video-trigger]').forEach(function (trigger) {
				if (trigger.dataset.summerVideoBound === '1') return;
				trigger.dataset.summerVideoBound = '1';

				var play = function (event) {
					event.preventDefault();
					event.stopPropagation();
					openModal(trigger);
				};

				trigger.querySelector('[data-summer-video-play]')?.addEventListener('click', play);
				trigger.addEventListener('click', function (event) {
					if (event.target === trigger || event.target.closest('img')) {
						play(event);
					}
				});
			});

			modal?.querySelectorAll('[data-summer-modal-close]').forEach(function (btn) {
				btn.addEventListener('click', closeModal);
			});

			document.addEventListener('keydown', function (event) {
				if (event.key === 'Escape' && modal && !modal.classList.contains('is-closed')) {
					closeModal();
				}
			});
		}

		if (modal) {
			modal.classList.add('is-closed');
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', bindTriggers);
		} else {
			bindTriggers();
		}

		document.addEventListener('astro:page-load', bindTriggers);
	})();
</script>
