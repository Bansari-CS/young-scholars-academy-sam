---
interface Props {
	content: any;
}

const { content } = Astro.props as Props;
---

<section class="summer-pricing-figma px-5 py-12 md:px-10 md:py-16 xl:px-[120px] xl:py-20">
	<div class="summer-wrap">
		<h2 class="text-[28px] sm:text-[36px] lg:text-[44px] mb-4 font-bold">{content.title}</h2>
		<p class="summer-sub mb-16 text-base">{content.subtitle}</p>
		<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				content.plans.map((plan) => (
					<article class={`summer-price-card ${plan.featured ? 'featured' : ''}`.trim()}>
						{plan.badge && <span>{plan.badge}</span>}
						<h3 class="font-bold">{plan.name}</h3>
						<p class="price font-bold">
							{plan.price}
							<small>{plan.unit}</small>
						</p>
						{plan.savingText && <b>{plan.savingText}</b>}
						{plan.description && <p>{plan.description}</p>}
						<ul>
							{plan.features.map((feature) => <li><img src={plan.checkIcon} alt="" />{feature}</li>)}
						</ul>
						<a href={plan.ctaHref} class={plan.outline ? 'outline' : ''}>{plan.ctaLabel}</a>
					</article>
				))
			}
		</div>
		<p class="summer-pricing-note">
			{content.fundsText} <a href={content.fundsCtaHref} class="underline">{content.fundsCtaLabel}</a>
		</p>
	</div>
</section>
