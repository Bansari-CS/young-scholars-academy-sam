---
interface Props {
	content: any;
}

const { content } = Astro.props as Props;
---

<section class="summer-section summer-cream summer-promise-section px-4 lg:px-[320px] py-20 bg-white">
	<div class="summer-guarantee p-5 sm:p-8 md:p-10 lg:p-12">
		<span class="summer-guarantee-pill">{content.kicker}</span>
		<h2 class="text-[28px] sm:text-[36px] lg:text-[44px] mt-2 sm:!mt-0 !mb-[23px]">{content.title}</h2>
		<p>{content.description}</p>
		<a href={content.ctaHref} class="summer-guarantee-cta !mt-[40px]">{content.ctaLabel}</a>
	</div>
</section>
