---
import GradientCtaSection from '../common/GradientCtaSection.astro';
---

<div id="cta" class="bg-[#f0f9ff]">
	<GradientCtaSection
		variant="outlined"
		title="Their People Are Waiting."
		description="Give your child a summer that doesn't just pass the time, but builds their identity and connects them with a global community of like-minded peers."
		primaryCta={{ label: 'Find the Perfect Camp', href: '#programs' }}
		secondaryCta={{ label: 'View All 321 Camps', href: '#programs' }}
		primaryTrailingIcon="/images/summer/final/arrow-right.svg"
		footnote="Limited spots available per class. Enrollment closes June 1st."
	/>
</div>
