---
import GradientCtaSection from '../common/GradientCtaSection.astro';

interface Props {
	content: {
		title: string;
		description: string;
		primaryCtaLabel: string;
		primaryCtaHref: string;
		secondaryCtaLabel?: string;
		secondaryCtaHref?: string;
		footnote?: string;
	};
}

const { content } = Astro.props;
---

<div id="cta" class="bg-[#f0f9fe]">
	<GradientCtaSection
		variant="outlined"
		title={content.title}
		description={content.description}
		primaryCta={{ label: content.primaryCtaLabel, href: content.primaryCtaHref }}
		secondaryCta={
			content.secondaryCtaLabel && content.secondaryCtaHref
				? { label: content.secondaryCtaLabel, href: content.secondaryCtaHref }
				: undefined
		}
		primaryTrailingIcon="/images/summer/final/arrow-right.svg"
		footnote={content.footnote}
	/>
</div>
