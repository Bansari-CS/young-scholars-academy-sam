---
interface Props {
	content: any;
}

const { content } = Astro.props as Props;
---

<section
	id="how-it-works"
	class="summer-section summer-expect-section scroll-mt-28 py-12 pb-[4px] md:py-16 xl:py-20"
>
	<div class="summer-wrap">
		<h2 class="mx-auto mb-16 text-center font-bold leading-normal text-[#111827] text-[28px] md:text-[36px] lg:text-[44px] max-w-[1072px]">{content.title}</h2>
		<div class="summer-grid-3 summer-expect-grid">
			{
				content.cards.map((card) => (
					<article class="summer-card summer-expect-card">
						<span class={`summer-expect-icon ${card.iconBg}`}>
							<img src={card.icon} alt="" aria-hidden="true" />
						</span>
						<span class="summer-card-num">{card.num}</span>
						<h3>{card.title}</h3>
						<p>{card.desc}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
