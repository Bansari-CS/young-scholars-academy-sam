---
interface ExpectCard {
	title: string;
	desc: string;
	num: string;
	icon: string;
	iconBg: string;
}

interface Props {
	content: {
		title: string;
		cards: ExpectCard[];
	};
}

const { content } = Astro.props as Props;

const expectIconBg: Record<string, string> = {
	'expect-icon-primary': 'bg-[#0a9dfb]',
	'expect-icon-secondary': 'bg-[#7c3aed]',
	'expect-icon-accent': 'bg-[#f2dd35]',
	'expect-icon-success': 'bg-[#048c3c]',
};

const expectConnectorByIndex = [
	'before:bg-[#0a9dfb] after:bg-[#0a9dfb]',
	'before:bg-[#7c3aed] after:bg-[#7c3aed]',
	'before:bg-[#f2dd35] after:bg-[#f2dd35]',
	'before:bg-[#048c3c] after:bg-[#048c3c]',
	'before:bg-[#0a9dfb] after:bg-[#0a9dfb]',
	'before:bg-[#7c3aed] after:bg-[#7c3aed]',
];

const expectGridPlacement = [
	'min-[901px]:col-start-1 min-[901px]:row-start-1 min-[901px]:mt-0',
	'min-[901px]:col-start-3 min-[901px]:row-start-1 min-[901px]:mt-40',
	'min-[901px]:col-start-1 min-[901px]:row-start-2 min-[901px]:mt-0',
	'min-[901px]:col-start-3 min-[901px]:row-start-2 min-[901px]:mt-[83px]',
	'min-[901px]:col-start-1 min-[901px]:row-start-3 min-[901px]:mt-0',
	'min-[901px]:col-start-3 min-[901px]:row-start-3 min-[901px]:mt-40',
];

const expectConnectorOdd =
	"min-[901px]:before:content-[''] min-[901px]:before:absolute min-[901px]:before:top-[102px] min-[901px]:before:right-[-88px] min-[901px]:before:z-[3] min-[901px]:before:size-3 min-[901px]:before:rounded-full min-[901px]:after:content-[''] min-[901px]:after:absolute min-[901px]:after:top-[108px] min-[901px]:after:right-[-80px] min-[901px]:after:z-[2] min-[901px]:after:h-0.5 min-[901px]:after:w-[80px]";

const expectConnectorEven =
	"min-[901px]:before:content-[''] min-[901px]:before:absolute min-[901px]:before:top-[102px] min-[901px]:before:left-[-88px] min-[901px]:before:z-[3] min-[901px]:before:size-3 min-[901px]:before:rounded-full min-[901px]:after:content-[''] min-[901px]:after:absolute min-[901px]:after:top-[108px] min-[901px]:after:left-[-80px] min-[901px]:after:z-[2] min-[901px]:after:h-0.5 min-[901px]:after:w-[80px]";
---

<section
	id="how-it-works"
	class="scroll-mt-28 bg-white py-12 pb-px md:py-16 max-[900px]:py-[60px] max-[600px]:py-12 xl:py-20"
>
	<div class="mx-auto box-border w-full max-w-[90rem] px-4 sm:px-6 lg:px-10">
		<h2
			class="mx-auto mb-16 max-w-[1072px] text-center text-[28px] leading-normal font-bold text-[#111827] max-[900px]:mb-10 max-[900px]:text-[32px] max-[600px]:mb-8 max-[600px]:text-[26px] max-[600px]:leading-[1.3] md:text-[36px] lg:text-[44px]"
		>
			{content.title}
		</h2>
		<div
			class="relative mx-auto grid w-full grid-cols-1 gap-5 py-5 min-[901px]:grid-cols-[1fr_126px_1fr] min-[901px]:grid-rows-[auto_auto_auto] min-[901px]:gap-y-0 min-[901px]:before:absolute min-[901px]:before:top-0 min-[901px]:before:bottom-0 min-[901px]:before:left-1/2 min-[901px]:before:-ml-px min-[901px]:before:z-0 min-[901px]:before:w-0.5 min-[901px]:before:border-l-2 min-[901px]:before:border-dashed min-[901px]:before:border-[#cbd5e1]"
		>
			{
				content.cards.map((card, index) => {
					const isOdd = index % 2 === 0;
					const iconBg = expectIconBg[card.iconBg] ?? expectIconBg['expect-icon-primary'];
					const connector = expectConnectorByIndex[index] ?? expectConnectorByIndex[0];
					return (
						<article
							class:list={[
								'relative z-[1] self-start flex h-auto min-h-[240px] flex-col overflow-visible rounded-2xl bg-white p-8 outline outline-1 outline-[#e2e8f0] max-[900px]:col-start-1 max-[900px]:row-auto max-[900px]:mt-0 max-[600px]:p-6',
								expectGridPlacement[index] ?? 'min-[901px]:col-start-1 min-[901px]:row-auto min-[901px]:mt-0',
								isOdd ? expectConnectorOdd : expectConnectorEven,
								connector,
							]}
						>
							<span
								class:list={[
									'relative z-[1] mb-6 inline-flex size-12 shrink-0 items-center justify-center rounded-xl',
									iconBg,
								]}
							>
								<img
									class="block h-auto max-h-6 max-w-6 w-auto"
									src={card.icon}
									alt=""
									aria-hidden="true"
								/>
							</span>
							<span class="pointer-events-none absolute top-4 right-4 z-0 max-w-[calc(100%-32px)] overflow-hidden text-[56px] leading-none font-bold text-[#f1f5f9] select-none max-[600px]:text-[40px]">
								{card.num}
							</span>
							<h3 class="relative z-[1] m-0 text-[17px] leading-7 font-semibold text-[#111827]">
								{card.title}
							</h3>
							<p class="relative font-medium z-[1] mt-[7px] m-0 max-w-[392px] p-0 text-[16px] leading-[26px] text-[#475569]">
								{card.desc}
							</p>
						</article>
					);
				})
			}
		</div>
	</div>
</section>
