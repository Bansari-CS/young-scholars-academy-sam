---
/** Matches Figma node 117:3774 — centered title + single bordered narrative card (no grid / avatar). */
interface StruggleContent {
	title: string;
	narrative: string;
}

interface Props {
	content: StruggleContent;
}

const { content } = Astro.props;
---

<section class="bg-[#f8fafc]  px-4 md:px-10 lg:px-16 py-20">
	<div class="mx-auto flex w-full max-w-[1200px] flex-col items-center gap-16 px-4 md:px-8 lg:px-16">
		<div class="flex w-full flex-col items-center gap-4">
			<h2
				class="m-0 text-center font-[var(--ysa-font-display)] text-[32px] font-bold leading-normal tracking-normal text-[#111827] md:text-[40px] lg:text-[44px]"
			>
				{content.title}
			</h2>
		</div>
		<div
			class="w-full max-w-[800px] rounded-2xl border border-solid border-[#0a9dfb] bg-[#eff6ff] p-8 md:p-10 lg:p-[40px]"
		>
			<p
				class="m-0 text-center font-[var(--ysa-font-display)] text-[17px] font-medium italic leading-[28px] text-[#1a1647]"
			>
				{content.narrative.trim()}
			</p>
		</div>
	</div>
</section>
