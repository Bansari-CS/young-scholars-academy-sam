<section class="summer-fit-dark px-5 py-12 md:px-10 md:py-16 xl:px-16 xl:py-20">
	<div class="max-w-[1311px] m-auto">
		<h2 class="!text-white text-[28px] sm:text-[36px] lg:text-[44px]">Is YSA Summer Right for Your Child?</h2>
		<div class="grid grid-cols-1 gap-[30px] md:grid-cols-2">
			<article class="summer-fit-card good p-5 lg:p-10">
				<h3 class="summer-fit-heading text-[22px] md:text-[26px] lg:text-[32px]">
					<img src="/images/summer/fit/check-circle.svg" alt="" aria-hidden="true" />
					<span>Great fit for...</span>
				</h3>
				<ul>
					<li class="max-w-[440px]">Kids who have "intense" niche interests (from transit maps to deep sea biology).</li>
					<li class="max-w-[440px]">Students who feel bored or "different" in traditional school settings.</li>
					<li class="max-w-[440px]">2e (Twice Exceptional) learners who need both challenge and support.</li>
					<li class="max-w-[440px]">Parents looking for an inclusive, high-level social community.</li>
				</ul>
			</article>
			<article class="summer-fit-card bad p-5 lg:p-10">
				<h3 class="summer-fit-heading text-[22px] md:text-[26px] lg:text-[32px]">
					<img src="/images/summer/fit/x-circle.svg" alt="" aria-hidden="true" />
					<span>May not be the right fit for...</span>
				</h3>
				<ul>
					<li class="max-w-[440px]">Kids who prefer passive, lecture-style learning without interaction.</li>
					<li class="max-w-[440px]">Families looking for 8-hour childcare or non-interactive "edu-tainment."</li>
					<li class="max-w-[440px]">Students who do not have a reliable internet connection or device.</li>
					<li class="max-w-[440px]">Families who require strictly offline, physical-only experiences.</li>
				</ul>
			</article>
		</div>
	</div>
</section>
