---
interface Props {
	content: any;
}

const { content } = Astro.props as Props;
---

<section class="summer-fit-dark py-12 md:py-16 xl:py-20">
	<div class="mx-auto box-border w-full max-w-[90rem] px-4 sm:px-6 lg:px-10">
		<h2 class="!text-white text-[28px] sm:text-[36px] lg:text-[44px]">{content.title}</h2>
		<div class="grid grid-cols-1 gap-[30px] md:grid-cols-2">
			<article class="summer-fit-card good p-5 lg:p-10">
				<h3 class="summer-fit-heading text-[22px] md:text-[26px] lg:text-[32px]">
					<img src="/images/summer/fit/check-circle.svg" alt="" aria-hidden="true" />
					<span>{content.goodTitle}</span>
				</h3>
				<ul>
					{content.goodItems.map((item) => <li class="max-w-[440px] list-disc ml-5">{item}</li>)}
				</ul>
			</article>
			<article class="summer-fit-card bad p-5 lg:p-10">
				<h3 class="summer-fit-heading text-[22px] md:text-[26px] lg:text-[32px]">
					<img src="/images/summer/fit/x-circle.svg" alt="" aria-hidden="true" />
					<span>{content.badTitle}</span>
				</h3>
				<ul>
					{content.badItems.map((item) => <li class="max-w-[440px] list-disc ml-5">{item}</li>)}
				</ul>
			</article>
		</div>
	</div>
</section>
