---
interface Props {
	content: any;
}

const { content } = Astro.props as Props;

const bonusIconBg: Record<string, string> = {
	'bonus-yellow': 'bg-[#f2dd35]',
	'bonus-purple': 'bg-[#7c3aed]',
	'bonus-green': 'bg-[#048c3c]',
};
---

<section class="bg-white py-12 md:py-16 xl:py-24">
	<div class="mx-auto box-border w-full max-w-[90rem] px-4 sm:px-6 lg:px-10">
		<p class="m-0 mb-4 text-center text-sm font-bold tracking-[0.2em] text-[#0a9dfb]">{content.kicker}</p>
		<h2 class="mx-auto my-4 mb-6 text-center text-[28px] leading-[48px] font-semibold sm:text-[36px] lg:text-[44px]">
			{content.title}
		</h2>
		<p class="mx-auto mb-16 max-w-[595px] text-center text-base leading-[26px] text-[#475569]">
			{content.description}
		</p>

		<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 xl:gap-8">
			{
				content.cards.map((card) => {
					const iconBg = bonusIconBg[card.iconClass ?? ''] ?? 'bg-[#0a9dfb]';
					return (
						<article
							class:list={[
								'min-h-[328px] rounded-[32px] border border-[#f3f4f6] bg-white p-8 shadow-[0_8px_15px_rgba(0,0,0,0.04)]',
								card.tall && 'min-h-[340.75px]',
							]}
						>
							<span class:list={['grid size-14 place-items-center rounded-2xl', iconBg]}>
								<img class="block size-6 object-contain" src={card.icon} alt="" />
							</span>
							<h3 class="my-2 mt-6 text-[17px] leading-7 font-semibold text-[#111827]">{card.title}</h3>
							<p class="min-h-[46px] pb-6 text-sm leading-[22.75px] text-[#475569]">{card.description}</p>
							<div class="mt-6 flex items-center justify-between border-t border-[#f3f4f6] pt-6">
								<small class="text-sm font-bold text-[#048c3c]">{card.valueLabel}</small>
								<strong class="text-lg text-[#111827]">{card.value}</strong>
							</div>
						</article>
					);
				})
			}
			<article
				class="relative col-span-1 overflow-hidden rounded-[32px] bg-[linear-gradient(90deg,#5751e4,#0a9dfb)] p-5 text-white md:col-span-2 lg:p-[30px]"
			>
				<header class="flex items-center justify-between">
					<span class="grid size-14 place-items-center rounded-2xl bg-white/20">
						<img class="block h-5 w-4 object-contain" src={content.security.icon} alt="" />
					</span>
					<em class="rounded-full bg-white/20 px-4 py-1.5 text-xs font-bold uppercase not-italic">
						{content.security.label}
					</em>
				</header>
				<h3 class="my-3 mt-6 text-[28px] leading-9 font-semibold">{content.security.title}</h3>
				<p class="m-0 max-w-[720px] text-base leading-[26px]">{content.security.description}</p>
				<footer class="mt-8 flex items-center justify-between">
					<span class="inline-flex items-center gap-2 text-white/90">
						<img class="block size-4 object-contain" src={content.security.riskIcon} alt="" />
						{content.security.riskLabel}
					</span>
					<strong class="text-[18px] italic lg:text-[24px]">{content.security.value}</strong>
				</footer>
			</article>
		</div>

		<div class="mt-16 rounded-[40px] bg-[#f9fafb] p-5 lg:px-12 lg:pt-16 lg:pb-12">
			<div class="flex flex-wrap items-center justify-between gap-2.5 md:flex-nowrap">
				<div>
					<p class="m-0 text-sm font-bold tracking-[0.14em] text-[#0a9dfb]">{content.mentors.kicker}</p>
					<h3 class="mt-1 mb-0 text-[20px] leading-9 font-semibold md:text-[24px] lg:text-[28px]">
						{content.mentors.title}
					</h3>
				</div>
				<div class="flex items-center [&>img]:size-12 [&>img]:rounded-full [&>img]:border-4 [&>img]:border-white [&>img:not(:first-child)]:-ml-4">
					{content.mentors.avatars.map((avatar) => <img src={avatar} alt="" />)}
					<span class="grid -ml-4 size-12 place-items-center rounded-full border-4 border-white bg-[#0a9dfb] text-xs font-bold text-white">
						{content.mentors.avatarsCountLabel}
					</span>
				</div>
			</div>
			<div class="mt-10 grid grid-cols-1 gap-5 bg-white py-8 text-center sm:grid-cols-2 lg:grid-cols-4">
				{
					content.mentors.items.map((mentor) => (
						<article class="flex flex-col items-center justify-center">
							<img class="size-24 rounded-full object-cover" src={mentor.image} alt="" />
							<h4 class="mt-4 mb-0 text-[17px] leading-7 font-bold">{mentor.name}</h4>
							<p class="m-0 text-sm leading-[22.75px] text-[#475569]">{mentor.specialty}</p>
						</article>
					))
				}
			</div>
		</div>

		<div
			class="mt-16 flex flex-wrap items-center justify-center gap-5 rounded-[32px] border-2 border-[#0a9dfb] bg-[#f0f9fe] p-5 md:flex-nowrap md:p-8 lg:justify-between lg:p-12"
		>
			<div>
				<small class="text-sm font-bold tracking-[0.14em] text-[#0a9dfb]">{content.total.label}</small>
				<p class="mt-[0.3rem] mb-0 text-[17px] font-semibold text-[#111827]">
					<strong class="text-[24px] md:text-[30px] lg:text-[38px]">{content.total.value}</strong>
					{' '}
					{content.total.suffix}
				</p>
			</div>
			<div class="max-w-[300px] text-center lg:text-right">
				<span
					class="inline-flex items-center gap-2 rounded-2xl bg-[#0a9dfb] px-[15px] py-[15px] text-white shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)] lg:px-8 lg:py-4"
				>
					<img class="block h-[22px] w-[68px] shrink-0 object-contain" src={content.total.chipIcon} alt="" />
					{content.total.chipLabel}
				</span>
				<p class="mt-4 mb-0 text-sm leading-[22.75px] text-[#475569]">{content.total.description}</p>
			</div>
		</div>
	</div>
</section>
