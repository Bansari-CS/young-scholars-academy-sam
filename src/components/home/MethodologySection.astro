											fill="#2563EB"
										/>
									</svg>
								)}
							</div>
							<h3 class="m-0 pt-[0.57rem] font-display text-[1.0625rem] font-semibold leading-7 text-[#111827]">
								{p.title}
							</h3>
							<p class="m-0 text-sm leading-[1.421875rem] text-[#475569]">{p.description}</p>
						</div>
					</li>
				))
			}
