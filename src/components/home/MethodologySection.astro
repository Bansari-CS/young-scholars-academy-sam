											fill="#059669"
										/>
									</svg>
								) : p.principleIcon === 'peer' ? (
									<svg
										class="block h-5 w-[25px] object-contain"
										width="25"
										height="20"
										viewBox="0 0 25 20"
										fill="none"
										xmlns="http://www.w3.org/2000/svg"
									>
										<path
											d="M21.25 9.6875V9.81641L23.9727 7.09375C24.8281 6.23828 24.8281 4.85547 23.9727 4L20.9219 0.953125C20.0664 0.0976562 18.6836 0.0976562 17.8281 0.953125L16.2617 2.51953C16.1562 2.50781 16.0469 2.5 15.9375 2.5H11.5625C10.1133 2.5 8.92188 3.59375 8.76562 5H8.75V9.6875C8.75 10.5508 9.44922 11.25 10.3125 11.25C11.1758 11.25 11.875 10.5508 11.875 9.6875V6.875V6.87109V6.25H12.5H17.8125C17.8125 6.25 17.8125 6.25 17.8164 6.25H18.125C19.8516 6.25 21.25 7.64844 21.25 9.375V9.6875ZM13.125 7.5V9.6875C13.125 11.2422 11.8658 12.5 10.3125 12.5C8.7592 12.5 7.5 11.2422 7.5 9.6875V5.05469C6.09766 5.29688 4.92969 6.31641 4.53125 7.71875L3.88672 9.96875L1.02734 12.8281C0.171875 13.6836 0.171875 15.0664 1.02734 15.9219L4.07812 18.9727C4.93359 19.8281 6.31641 19.8281 7.17188 18.9727L8.64453 17.5C8.67969 17.5 8.71484 17.5039 8.75 17.5039H15C16.0352 17.5039 16.875 16.6641 16.875 15.6289C16.875 15.4102 16.8359 15.1992 16.7695 15.0039H16.875C17.9102 15.0039 18.75 14.1641 18.75 13.1289C18.75 12.6289 18.5547 12.1758 18.2344 11.8398C19.2383 11.6445 19.9961 10.7617 20 9.69922V9.68359C19.9961 8.48047 19.0195 7.50391 17.8125 7.50391H13.125V7.5Z"
											fill="#0D9488"
										/>
									</svg>
								) : (
									<svg
										class="block size-5 object-contain"
