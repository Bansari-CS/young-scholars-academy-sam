---

<section class="w-full bg-white py-[clamp(3rem,8vw,6rem)]" aria-labelledby="pathways-heading">
	<div class="mx-auto max-w-[var(--ysa-max)] px-[clamp(1rem,4.44vw,4rem)]">
		<header class="mb-12 text-center">
			<p class="mb-4 inline-flex items-center justify-center rounded-full bg-[#E1F3FF] px-4 py-2 text-xs font-bold tracking-[0.06em] text-[#0A9DFB] uppercase">
				How Families Use YSA
			</p>
			<h2 id="pathways-heading" class="m-0 text-[clamp(2rem,4vw,2.75rem)] font-bold leading-[1.12] tracking-[-0.02em] text-[#0F172A]">
				There's No Single Way In.
			</h2>
			<p class="mx-auto mt-4 max-w-[38rem] text-base leading-[1.7] text-[#64748B]">
				Pick the path that matches where your family is right now.
			</p>
		</header>

		<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
			{pathways.map((p) => (
				<article class:list={['group flex flex-col overflow-hidden rounded-2xl border-t-4 border border-[#F1F5F9] bg-white shadow-[0_1px_3px_rgba(15,23,42,0.04),0_8px_24px_-12px_rgba(15,23,42,0.12)] transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:shadow-[0_12px_32px_-12px_rgba(15,23,42,0.18)]', p.accentBorder]}>
					<div class="flex flex-1 flex-col p-7">
						<!-- Icon + tag row -->
						<div class="mb-5 flex items-start justify-between gap-3">
							<div class:list={['flex size-11 shrink-0 items-center justify-center rounded-xl', p.iconBg]} aria-hidden="true">
								<svg class="block size-5" viewBox="0 0 24 24" fill="none" stroke={p.iconColor} stroke-width="1.7" set:html={p.icon} />
							</div>
							<span class:list={['mt-0.5 shrink-0 rounded-full px-2.5 py-1 text-[0.65rem] font-bold tracking-[0.04em] uppercase', p.tagClass]}>
								{p.tag}
							</span>
						</div>

						<h3 class="m-0 mb-3 text-[1.0625rem] font-bold leading-[1.3] text-[#0F172A]">{p.title}</h3>
						<p class="m-0 flex-1 text-[0.9375rem] leading-[1.7] text-[#475569]">{p.description}</p>

						<!-- Pricing note -->
						<div class="mt-5 flex items-center gap-2">
							<svg class="block size-4 shrink-0 text-[#94A3B8]" viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M8 1C4.1 1 1 4.1 1 8C1 11.9 4.1 15 8 15C11.9 15 15 11.9 15 8C15 4.1 11.9 1 8 1ZM6.8 11.3L3.7 8.2L4.8 7.1L6.8 9.1L11.2 4.7L12.3 5.8L6.8 11.3Z" fill="currentColor"/>
							</svg>
							<span class="text-sm text-[#64748B]">{p.pricing}</span>
						</div>
					</div>

					<!-- CTA -->
					<div class="border-t border-[#F1F5F9] px-7 py-4">
						<a
							href={p.href}
							class:list={['inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold text-white no-underline transition-colors duration-150', p.ctaClass]}
						>
							{p.cta}
							<svg class="block size-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
								<path d="M1 7H13M7.5 1.5L13 7L7.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</a>
					</div>
				</article>
			))}
		</div>

		<p class="mt-10 text-center text-sm text-[#94A3B8]">
			Most families start with one class and go from there. There's no wrong entry point.
		</p>
	</div>
</section>
