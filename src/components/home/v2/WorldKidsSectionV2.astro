---

<section class="w-full bg-white py-[clamp(3rem,8vw,6rem)]" aria-labelledby="world-v2-heading">
	<div class="mx-auto max-w-[var(--ysa-max)] px-[clamp(1rem,4.44vw,4rem)]">
		<div class="mb-10 text-center">
			<p class="mb-3 text-[0.625rem] font-bold tracking-[0.2em] text-[#7C3AED] uppercase">Global Community</p>
			<h2 id="world-v2-heading" class="m-0 text-[clamp(2rem,4vw,2.75rem)] font-bold leading-[1.12] tracking-[-0.02em] text-[#0F172A]">Our Kids Are All Around the World.</h2>
			<p class="mx-auto mt-3 max-w-[36rem] text-[0.9375rem] leading-[1.7] text-[#64748B]">1,200+ families across 47 US states and 17 countries have found their people at YSA.</p>
		</div>
		<div class="mb-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
			{stats.map((s) => (
				<div class="rounded-2xl border border-[#E2E8F0] bg-[#F8FAFC] px-5 py-4 text-center shadow-[0_1px_3px_rgba(15,23,42,0.04)]">
					<p class="m-0 font-display text-[clamp(1.5rem,2.5vw,2rem)] font-black text-[#7C3AED]">{s.value}</p>
					<p class="m-0 mt-0.5 text-xs text-[#94A3B8]">{s.label}</p>
				</div>
			))}
		</div>
		<div class="relative mx-auto" style="max-width:640px;">
			<div class="relative mx-auto overflow-hidden rounded-full shadow-[0_0_0_6px_#1E1B4B,0_20px_60px_rgba(30,27,75,0.4),0_0_80px_rgba(124,58,237,0.15)]" style="padding-bottom:100%;height:0;background:radial-gradient(circle at 48% 38%,#0278cb 0%,#061897 38%,#001a5a 68%,#000d46 100%);">
				<div id="world-globe-v2" class="absolute inset-0 cursor-grab [&.is-dragging]:cursor-grabbing" data-points={JSON.stringify(pins)} role="img" aria-label="Interactive 3D globe showing YSA student locations worldwide"></div>
				<p id="globe-hint" class="pointer-events-none absolute bottom-4 left-0 right-0 z-[5] text-center text-[0.6rem] font-semibold tracking-[0.08em] text-white/50 uppercase transition-opacity duration-500">Drag to rotate · Scroll to zoom</p>
			</div>
		</div>
		<div class="mt-8 text-center">
			<p class="mb-4 text-[0.6875rem] font-bold tracking-[0.14em] text-[#94A3B8] uppercase">17 Countries across 6 continents</p>
			<div class="flex flex-wrap items-center justify-center gap-2">
				{countries.map((c) => (
					<div class="flex items-center gap-2 rounded-full border border-[#E2E8F0] bg-white px-3 py-1.5 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-shadow hover:shadow-[0_2px_8px_rgba(15,23,42,0.08)]">
						<img src={`https://flagcdn.com/w40/${c.iso}.png`} srcset={`https://flagcdn.com/w80/${c.iso}.png 2x`} alt="" width="20" height="14" class="h-3.5 w-5 shrink-0 rounded-[2px] object-cover shadow-sm ring-1 ring-slate-200/60" loading="lazy"/>
						<span class="text-xs font-medium text-[#374151]">{c.name}</span>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<script>
import Globe from 'globe.gl';
import * as THREE from 'three';

function ss(e0: number, e1: number, x: number) { const t = Math.min(1,Math.max(0,(x-e0)/(e1-e0))); return t*t*(3-2*t); }
function c255(v: number) { return v<0?0:v>255?255:v|0; }

async function buildTex(dark: string, night: string) {
	const ck = 'ysa-globe-v2-t';
	try { const h = sessionStorage.getItem(ck); if (h && h.length > 80000) return h; } catch {}
	const loadImg = (src: string) => new Promise<HTMLImageElement>((res,rej) => { const i=new Image(); i.crossOrigin='anonymous'; i.onload=()=>res(i); i.onerror=()=>rej(new Error('')); i.src=src; });
	const [dImg,nImg] = await Promise.all([loadImg(dark),loadImg(night)]);
	const W=1024,H=512,cv=document.createElement('canvas'); cv.width=W; cv.height=H;
	const ctx=cv.getContext('2d',{willReadFrequently:true})!;
	ctx.drawImage(dImg,0,0,W,H); const dd=ctx.getImageData(0,0,W,H).data;
	ctx.drawImage(nImg,0,0,W,H); const nd=ctx.getImageData(0,0,W,H).data;
	const out=ctx.createImageData(W,H); const o=out.data;
	for (let y=0;y<H;y++) for (let x=0;x<W;x++) {
		const i=(y*W+x)*4;
		const lD=(0.299*dd[i]+0.587*dd[i+1]+0.114*dd[i+2])/255;
		const lN=(0.299*nd[i]+0.587*nd[i+1]+0.114*nd[i+2])/255;
		const lW=1-ss(0.07,0.12,lD); let lr=6,lg=38,lb=116;
		if (lN>0.1) { const k=Math.min(1,(lN-0.1)/0.5); lr+=(255-lr)*k; lg+=(250-lg)*k; lb+=(255-lb)*k; }
		const or=lD*44,og=10+lD*34,ob=40+lD*98;
		const cst=ss(0.072,0.096,lD)*(1-ss(0.096,0.14,lD));
		o[i]=c255(or*(1-lW)+lr*lW+cst*88); o[i+1]=c255(og*(1-lW)+lg*lW+cst*205);
		o[i+2]=c255(ob*(1-lW)+lb*lW+cst*238); o[i+3]=255;
	}
	ctx.putImageData(out,0,0);
	const url=cv.toDataURL('image/png');
	try { sessionStorage.setItem(ck,url); } catch {}
	return url;
}

function buildDots(n: number) {
	const R=[{lat:[-55,72],lng:[-130,-30]},{lat:[-38,38],lng:[-25,55]},{lat:[-12,55],lng:[70,180]},{lat:[-12,55],lng:[-180,-95]}];
	const C=['#ffffff','#e8fdff','#4df0f0','#18e0eb','#b8f6ff'];
	const rnd=(a: number,b: number)=>a+Math.random()*(b-a);
	return Array.from({length:n},()=>{ const r=R[Math.floor(Math.random()*R.length)]; return {lat:rnd(r.lat[0],r.lat[1]),lng:rnd(r.lng[0],r.lng[1]),size:0.0016+Math.random()*0.005,r:0.022+Math.random()*0.045,color:C[Math.floor(Math.random()*C.length)]}; });
}

function initGlobe() {
	const el = document.getElementById('world-globe-v2') as HTMLElement & {_gi?: boolean};
	if (!el || el._gi) return;
	el._gi = true;
	const pins = JSON.parse(el.getAttribute('data-points') || '[]');
	const hint = document.getElementById('globe-hint');

	(async () => {
		const globe = Globe({ animateIn: false, waitForGlobeReady: true })(el);
		const dark = '/assets/globe/textures/earth-dark.jpg';
		const night = '/assets/globe/textures/earth-night.jpg';
		let tex = dark;
		try { tex = await buildTex(dark, night); } catch {}

		const dots = buildDots(1800);
		globe
			.backgroundColor('rgba(0,0,0,0)')
			.width(el.clientWidth).height(el.clientHeight)
			.globeImageUrl(tex)
			.showAtmosphere(true).atmosphereColor('#4df0f0').atmosphereAltitude(0.2)
			.showGraticules(false)
			.pointsData(dots).pointLat('lat').pointLng('lng')
			.pointAltitude('size').pointColor('color').pointRadius('r').pointResolution(14)
			.htmlElementsData(pins)
			.htmlLat((d: any) => d.lat).htmlLng((d: any) => d.lng)
			.htmlAltitude(() => 0.012)
			.htmlElement((d: any) => {
				const root = document.createElement('div');
				const sq = d.shape === 'squircle';
				root.style.cssText = `width:${d.size}px;height:${d.size}px;position:relative;transform:translate(-50%,-50%);pointer-events:none;`;
				const glow = document.createElement('span');
				glow.style.cssText = `position:absolute;inset:-8px;z-index:0;border-radius:${sq?'20px':'50%'};background:#061897;opacity:.4;filter:blur(6px);`;
				const inner = document.createElement('div');
				inner.style.cssText = `position:relative;z-index:1;width:100%;height:100%;border-radius:${sq?'8px':'50%'};overflow:hidden;border:2px solid white;box-shadow:0 2px 4px rgba(0,0,0,.25);`;
				if (d.face) { const img=document.createElement('img'); img.src=d.face; img.alt=''; img.style.cssText='display:block;width:100%;height:100%;object-fit:cover;'; img.loading='lazy'; inner.appendChild(img); }
				root.appendChild(glow); root.appendChild(inner);
				return root;
			});

		const arcs: any[] = []; let tries=0;
		while (arcs.length<180 && tries++<10000) {
			const a=dots[Math.floor(Math.random()*dots.length)],b=dots[Math.floor(Math.random()*dots.length)];
			const dL=Math.abs(a.lat-b.lat),dN=Math.abs(a.lng-b.lng),sp=dL+dN;
			if (dL<40&&dN<100&&sp>6&&sp<58) arcs.push({startLat:a.lat,startLng:a.lng,endLat:b.lat,endLng:b.lng});
		}
		globe.arcsData(arcs).arcColor(()=>'rgba(77,240,240,0.35)').arcStroke(0.14).arcAltitude(0.085).arcDashLength(0.2).arcDashGap(0.16).arcDashAnimateTime(11000);

		const ctrl = globe.controls();
		ctrl.enableZoom = true; ctrl.zoomSpeed = 0.8;
		ctrl.enableRotate = true; ctrl.rotateSpeed = 0.7;
		ctrl.enableDamping = true; ctrl.dampingFactor = 0.08;
		ctrl.autoRotate = true; ctrl.autoRotateSpeed = 0.7;
		ctrl.enablePan = false;
		ctrl.minDistance = 120; ctrl.maxDistance = 400;

		el.addEventListener('pointerdown', () => {
			ctrl.autoRotate = false;
			el.classList.add('is-dragging');
			if (hint) hint.style.opacity = '0';
		}, { once: true });
		el.addEventListener('pointerdown', () => { ctrl.autoRotate = false; el.classList.add('is-dragging'); });
		window.addEventListener('pointerup', () => { setTimeout(()=>{ ctrl.autoRotate=true; }, 2000); el.classList.remove('is-dragging'); });

		globe.pointOfView({ lat: 20, lng: -20, altitude: 1.4 }, 0);

		const mat = globe.globeMaterial() as any;
		if (mat) { mat.emissive=new THREE.Color(0x041028); mat.emissiveIntensity=0.07; if ('shininess' in mat) mat.shininess=68; if ('metalness' in mat) mat.metalness=0.12; if ('roughness' in mat) mat.roughness=0.32; }
		for (const l of globe.lights() as any[]) {
			if (l.type==='AmbientLight') { l.color=new THREE.Color('#2a5088'); l.intensity=0.62; }
			if (l.type==='DirectionalLight') { l.color=new THREE.Color('#f2fbff'); l.intensity=1.05; l.position.set(1.25,0.9,0.65); }
		}
		const sc=globe.scene() as any;
		if (!sc.getObjectByName('ysa-hemi')) {
			const h=new THREE.HemisphereLight(0x7eedf5,0x000814,0.32); h.name='ysa-hemi'; sc.add(h);
		}
		window.addEventListener('resize', () => globe.width(el.clientWidth).height(el.clientHeight));
	})();
}

function observe() {
	const s = document.querySelector('[aria-labelledby="world-v2-heading"]');
	if (!s) return;
	const io = new IntersectionObserver(e => { if (e[0].isIntersecting) { initGlobe(); io.disconnect(); } }, { threshold: 0.1 });
	io.observe(s);
}
observe();
window.addEventListener('load', () => {
	const el = document.getElementById('world-globe-v2');
	if (el) { const r=el.getBoundingClientRect(); if (r.top<window.innerHeight&&r.bottom>0) initGlobe(); }
});
document.addEventListener('astro:page-load', observe);
</script>
