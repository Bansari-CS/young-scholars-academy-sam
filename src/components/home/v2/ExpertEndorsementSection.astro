---
// §7 — Expert Endorsement: Debbie Steinberg-Kuntz — Full-width redesign
---

<section class="w-full bg-[#F5F3FF] py-[clamp(3rem,7vw,5.5rem)]" aria-labelledby="endorsement-heading">
	<div class="mx-auto max-w-[var(--ysa-max)] px-[clamp(1rem,4.44vw,4rem)]">

		<!-- Eyebrow -->
		<div class="mb-10 text-center">
			<p class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2 text-[0.625rem] font-bold tracking-[0.18em] text-[#7C3AED] uppercase shadow-sm">
				<svg class="block size-3.5" viewBox="0 0 14 14" fill="#7C3AED" aria-hidden="true">
					<path d="M7 1L8.5 4.5H12.5L9.5 6.5L10.5 10L7 8L3.5 10L4.5 6.5L1.5 4.5H5.5L7 1Z"/>
				</svg>
				Trusted by the Leading Voice in Gifted &amp; 2e Education
			</p>
		</div>

		<!-- Full-width card -->
		<div class="overflow-hidden rounded-3xl bg-[linear-gradient(135deg,#1E1B4B_0%,#2E1B69_40%,#1A3560_100%)] shadow-[0_32px_80px_-16px_rgba(124,58,237,0.35)]">

			<div class="grid grid-cols-1 lg:grid-cols-[280px_1fr]">

				<!-- Left: Author panel -->
				<div class="relative flex flex-col items-center justify-center gap-6 overflow-hidden border-b border-white/10 px-8 py-10 text-center lg:border-b-0 lg:border-r lg:py-14">
					<!-- Decorative background circle -->
					<div class="pointer-events-none absolute -bottom-16 -left-16 size-48 rounded-full bg-[#7C3AED]/15 blur-3xl" aria-hidden="true"></div>
					<div class="pointer-events-none absolute -top-10 -right-10 size-32 rounded-full bg-[#0A9DFB]/10 blur-2xl" aria-hidden="true"></div>

					<!-- Avatar with glow -->
					<div class="relative z-[1]">
						<div
							class="flex size-24 items-center justify-center rounded-2xl bg-[linear-gradient(135deg,#7C3AED_0%,#5751E4_100%)] text-3xl font-black text-white shadow-[0_8px_32px_rgba(124,58,237,0.5)]"
							aria-hidden="true"
						>
							DS
						</div>
						<!-- Star badge -->
						<div class="absolute -bottom-2 -right-2 flex size-7 items-center justify-center rounded-full border-2 border-[#1E1B4B] bg-[#F59E0B] shadow-[0_2px_8px_rgba(245,158,11,0.4)]" aria-hidden="true">
							<svg class="block size-3.5" viewBox="0 0 14 14" fill="white" aria-hidden="true">
								<path d="M7 1L8.5 4.5H12.5L9.5 6.5L10.5 10L7 8L3.5 10L4.5 6.5L1.5 4.5H5.5L7 1Z"/>
							</svg>
						</div>
					</div>

					<!-- Name & title -->
					<div class="relative z-[1]">
						<p class="m-0 text-base font-bold text-white">Debbie Steinberg-Kuntz</p>
						<p class="m-0 mt-1.5 text-sm font-semibold text-[#A78BFA]">Founder, Bright &amp; Quirky</p>
						<p class="m-0 mt-1 text-xs text-white/40">#1 voice in gifted &amp; 2e education</p>
					</div>

					<!-- Stats -->
					<div class="relative z-[1] flex w-full flex-col gap-2">
						{[
							{ label: 'Gifted/2e Expert', icon: '🎓' },
							{ label: 'Author & Speaker', icon: '📚' },
							{ label: 'Former Bridges Academy', icon: '🏫' },
						].map((item) => (
							<div class="flex items-center gap-2.5 rounded-xl border border-white/8 bg-white/5 px-3.5 py-2.5 text-left">
								<span class="text-base leading-none" aria-hidden="true">{item.icon}</span>
								<span class="text-xs font-medium text-white/60">{item.label}</span>
							</div>
						))}
					</div>
				</div>

				<!-- Right: Quote content -->
				<div class="relative flex flex-col justify-center px-8 py-10 sm:px-10 lg:px-14 lg:py-14">
					<!-- Large decorative quote mark -->
					<div
						class="pointer-events-none absolute right-8 top-8 select-none font-serif text-[9rem] leading-none text-white/5 lg:right-12 lg:top-6 lg:text-[12rem]"
						aria-hidden="true"
					>&rdquo;</div>

					<blockquote class="relative z-[1] m-0 p-0">
						<!-- Pull quote — hero sentence -->
						<p class="m-0 text-[clamp(1.25rem,2.2vw,1.625rem)] font-semibold italic leading-[1.65] text-white">
							&ldquo;The secret to putting the light in your child's eyes is: blowing on the embers of their strengths and interests.&rdquo;
						</p>

						<!-- Divider with glow -->
						<div class="my-7 flex items-center gap-4">
							<div class="h-px flex-1 bg-[linear-gradient(90deg,rgba(124,58,237,0.5),transparent)]"></div>
							<div class="size-1.5 rounded-full bg-[#7C3AED]/50"></div>
						</div>

						<!-- Supporting paragraphs -->
						<div class="space-y-4 text-[0.9375rem] leading-[1.85] text-white/60">
							<p class="m-0">
								I first met Sam when we did a pop-up program for kids during Covid — a former teacher at Bridges Academy who came highly recommended.
								<strong class="font-semibold text-white/85">I mentored him in business for free because I was so impressed by him.</strong>
							</p>
							<p class="m-0">
								Now he's running a very unique program with intriguing classes for kids 5–18, like executive function, D&amp;D, debate, AP classes, social club, and much more.
							</p>
							<p class="m-0">
								I feel confident in recommending Sam and team to enrich your child's education.
							</p>
						</div>

						<!-- Author sign-off -->
						<div class="mt-8 flex flex-wrap items-center gap-4 border-t border-white/10 pt-7">
							<div>
								<p class="m-0 text-sm font-bold text-white">— Debbie Steinberg-Kuntz</p>
								<p class="m-0 mt-0.5 text-xs text-[#A78BFA]">Founder, Bright &amp; Quirky · #1 gifted/2e voice</p>
							</div>
							<div class="ml-auto flex flex-wrap gap-2">
								{['Bright & Quirky Summit', 'Gifted/2e Summit', 'TEDx Adjacent'].map((tag) => (
									<span class="rounded-full border border-white/10 bg-white/6 px-3 py-1 text-[0.6875rem] font-medium text-white/45">
										{tag}
									</span>
								))}
							</div>
						</div>
					</blockquote>
				</div>

			</div>
		</div>

	</div>
</section>
