---
// §18 — Your State May Already Cover This — ESA/Charter funding
---

<section class="w-full bg-[#F8FAFC] py-[clamp(3rem,7vw,5rem)]" aria-labelledby="esa-heading">
	<div class="mx-auto max-w-[var(--ysa-max)] px-[clamp(1rem,4.44vw,4rem)]">
		<div class="mx-auto max-w-[64rem] overflow-hidden rounded-2xl border border-[#BFDBFE] bg-[linear-gradient(135deg,#EFF6FF_0%,#F0F9FF_100%)]">
			<div class="flex flex-col gap-0 lg:flex-row">
				<!-- Left accent panel -->
				<div class="flex shrink-0 flex-row items-center justify-center gap-4 bg-[#0A9DFB] px-8 py-6 text-white lg:w-48 lg:flex-col lg:py-10">
					<svg class="block size-12" viewBox="0 0 48 48" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="4" y="12" width="40" height="30" rx="4"/>
						<path d="M4 20H44"/>
						<path d="M16 30H28M16 35H22"/>
						<circle cx="36" cy="32.5" r="5" fill="rgba(255,255,255,0.2)"/>
						<path d="M34 32.5L35.5 34L38 31"/>
					</svg>
					<p class="m-0 text-center text-sm font-bold leading-5 text-white/90">ESA &amp; Charter<br/>Funding Accepted</p>
				</div>

				<!-- Right content -->
				<div class="flex flex-1 flex-col justify-center gap-5 px-6 py-7 sm:px-8 lg:px-10 lg:py-10">
					<div>
						<h2 id="esa-heading" class="m-0 text-[clamp(1.375rem,2.5vw,1.75rem)] font-bold leading-[1.2] tracking-[-0.02em] text-[#0F172A]">
							Your State May Already Cover This.
						</h2>
						<p class="mt-3 text-[0.9375rem] leading-[1.7] text-[#475569]">
							Many families use Education Savings Accounts or charter school funds to pay for YSA. <strong class="font-semibold text-[#0F172A]">Some pay zero out of pocket.</strong>
						</p>
					</div>

					<!-- How it works steps -->
					<ol class="m-0 flex flex-col gap-3 p-0 list-none sm:flex-row">
						{[
							{ step: '1', text: 'You enroll directly' },
							{ step: '2', text: 'We provide the invoice' },
							{ step: '3', text: 'Your ESA reimburses you' },
						].map((item) => (
							<li class="flex items-center gap-3 rounded-xl bg-white px-4 py-3 shadow-[0_1px_3px_rgba(15,23,42,0.06)] flex-1">
								<span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#0A9DFB] text-xs font-black text-white">
									{item.step}
								</span>
								<span class="text-sm font-medium text-[#374151]">{item.text}</span>
							</li>
						))}
					</ol>

					<div class="flex flex-wrap items-center gap-4">
						<a
							href="/summer"
							class="inline-flex items-center gap-2 rounded-xl bg-[#0A9DFB] px-6 py-3 text-sm font-semibold text-white no-underline shadow-[0_2px_8px_rgba(10,157,251,0.3)] transition-[opacity,transform] duration-150 hover:-translate-y-px hover:opacity-90"
						>
							Check If Your State Qualifies
							<svg class="block size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M3 8H13M8.5 3.5L13 8L8.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</a>
						<p class="m-0 text-xs text-[#64748B]">We walk you through every step.</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
