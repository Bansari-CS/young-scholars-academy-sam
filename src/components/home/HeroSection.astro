---
import { figmaHero } from '../../data/figmaAssets';
import type { HeroDashboardData } from '../../types/home';
import DashboardPreview from './DashboardPreview.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';

interface Props {
	content: {
		trustBadges: string[];
		titleLineOne: string;
		titleHighlight: string;
		description: string;
		primaryCta: { label: string; href: string };
		secondaryCta: { label: string; href: string };
		ratingText: string;
		ratingAriaLabel?: string;
		dashboard: HeroDashboardData;
	};
}

const { content } = Astro.props;
---

<div
	class="relative w-full overflow-hidden bg-[linear-gradient(150.46deg,#f8fafc_0%,rgba(240,244,255,0.3)_50%,#f8fafc_100%)]"
>
	<!-- Blur Background -->
	<div class="pointer-events-none absolute left-[15%] top-[-5%] h-[min(600px,90vw)] w-[min(600px,90vw)] rounded-full bg-[rgba(199,213,254,0.2)] blur-[70px]"></div>

	<div class="pointer-events-none absolute bottom-[-8%] right-[10%] h-[min(500px,75vw)] w-[min(500px,75vw)] rounded-full bg-[rgba(168,85,247,0.15)] blur-[60px]"></div>

	<div class="mx-auto max-w-[var(--ysa-max)] px-4 pb-10 sm:px-6 md:px-10 lg:px-10 lg:pb-24">
		<section
			class="relative z-[1] grid min-h-0 grid-cols-1 items-start gap-6 pt-20 lg:grid-cols-2 lg:gap-12"
		>
			<!-- Content -->
			<div class="flex max-w-[39.5rem] flex-col items-start gap-6">
				<!-- Trust badges (Figma 1175:1842) -->
				<ul
					class="m-0 flex list-none flex-wrap items-start gap-3 p-0"
					aria-label="Trust and reach highlights"
				>
					{
						content.trustBadges.map((label) => (
							<li class="m-0 p-0">
								<p class="m-0 inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-[#e0e9ff] bg-white px-[1.0625rem] py-[0.5625rem] font-display text-xs font-medium leading-4 tracking-[0.01875rem] text-[#7c3aed] shadow-[0_1px_1px_rgba(0,0,0,0.05)]">
									<span class="size-2 shrink-0 rounded-full bg-[#048c3c]" aria-hidden="true" />
									<span>{label}</span>
								</p>
							</li>
						))
					}
				</ul>

				<!-- Title -->
				<h1
					class="m-0 pb-[0.08em] text-[clamp(2.25rem,6vw,3.75rem)] font-bold leading-[1.08] tracking-[-0.09375rem] text-[var(--ysa-figma-brand)]"
				>
					<span class="block leading-[1.08]">
						{content.titleLineOne}
					</span>

					<span
						class="mt-1 block bg-[linear-gradient(90deg,#0A9DFB_18.75%,#7C3AED_66.35%)] bg-clip-text pb-[0.08em] leading-[1.08] text-transparent"
					>
						{content.titleHighlight}
					</span>
				</h1>

				<!-- Description -->
				<p
					class="max-w-[39.5rem] text-[clamp(1rem,2vw,1.125rem)] leading-[2.03125rem] text-[#475569]"
				>
					{content.description}
				</p>

				<!-- CTAs (Figma 31:2682) -->
				<div class="flex flex-wrap items-start gap-4 pb-4 pt-2">
					<PrimaryButton
						href={content.primaryCta.href}
						label={content.primaryCta.label}
						variant="lg"
						showTrailingArrow
					/>
					<!-- <PrimaryButton
						href={content.secondaryCta.href}
						label={content.secondaryCta.label}
						variant="lg"
						showTrailingArrow
					/> -->
				</div>

				<!-- Divider -->
				<div class="h-0 w-full max-w-[39.5rem] border-t border-[#E2E8F0]"></div>

				<!-- Social Proof -->
				<div class="flex w-full flex-wrap items-center gap-5 pt-[1.5625rem] sm:gap-8">
					<!-- Avatars -->
					<div class="flex items-center">
						<img
							class="-mr-3 block h-11 w-11 shrink-0 rounded-full border-2 border-white object-cover shadow-[0_1px_2px_rgba(0,0,0,0.05)]"
							src={figmaHero.avatar2}
							alt=""
							width="44"
							height="44"
							loading="lazy"
						/>

						<img
							class="-mr-3 block h-11 w-11 shrink-0 rounded-full border-2 border-white object-cover shadow-[0_1px_2px_rgba(0,0,0,0.05)]"
							src={figmaHero.avatar1}
							alt=""
							width="44"
							height="44"
							loading="lazy"
						/>

						<img
							class="-mr-3 block h-11 w-11 shrink-0 rounded-full border-2 border-white object-cover shadow-[0_1px_2px_rgba(0,0,0,0.05)]"
							src={figmaHero.avatar3}
							alt=""
							width="44"
							height="44"
							loading="lazy"
						/>

						<span
							class="-mr-3 grid h-11 w-11 shrink-0 place-items-center rounded-full border-2 border-white bg-[#E0E9FF] text-xs font-bold text-[#4A42C9] shadow-[0_1px_1px_rgba(0,0,0,0.05)]"
						>
							+2k
						</span>
					</div>

					<!-- Rating -->
					<div class="flex flex-col gap-1.5">
						<div class="flex items-center gap-0" aria-label={content.ratingAriaLabel ?? '5 star rating'}>
							{
								Array.from({ length: 5 }).map(() => (
									<svg
										class="block h-4 w-[18px] shrink-0"
										width="18"
										height="16"
										viewBox="0 0 18 16"
										fill="none"
										xmlns="http://www.w3.org/2000/svg"
										aria-hidden="true"
									>
										<path
											d="M9.90303 0.5625C9.73741 0.21875 9.38741 0 9.00303 0C8.61866 0 8.27178 0.21875 8.10303 0.5625L6.09366 4.69688L1.60616 5.35938C1.23116 5.41563 0.918658 5.67812 0.803033 6.0375C0.687408 6.39687 0.781158 6.79375 1.04991 7.05937L4.30616 10.2812L3.53741 14.8344C3.47491 15.2094 3.63116 15.5906 3.94053 15.8125C4.24991 16.0344 4.65928 16.0625 4.99678 15.8844L9.00616 13.7437L13.0155 15.8844C13.353 16.0625 13.7624 16.0375 14.0718 15.8125C14.3812 15.5875 14.5374 15.2094 14.4749 14.8344L13.703 10.2812L16.9593 7.05937C17.228 6.79375 17.3249 6.39687 17.2062 6.0375C17.0874 5.67812 16.778 5.41563 16.403 5.35938L11.9124 4.69688L9.90303 0.5625Z"
											fill="#FBBF24"
										/>
									</svg>
								))
							}
						</div>

						<p class="m-0 font-display text-sm font-medium leading-5 text-[#334155]">
							{content.ratingText}
						</p>
					</div>
				</div>
			</div>

			<!-- Dashboard -->
			<DashboardPreview dashboard={content.dashboard} />
		</section>
	</div>
</div>