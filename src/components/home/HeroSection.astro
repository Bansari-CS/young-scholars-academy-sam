---
import { heroData } from '../../data/home';
import Header from '../common/Header.astro';
import '../../styles/components/hero-section.css';
import DashboardPreview from './DashboardPreview.astro';
import studentImageUrl from '../../assets/images/student.svg';

---

<main class="home">
	<Header brand="Young Scholars Academy" navItems={heroData.navItems} />

	<div class="home-container">
		<section class="hero">
			<div class="hero-content">
				<span class="hero-badge">{heroData.badgeText}</span>
				<h1>
					<span class="title-line">{heroData.titleLineOne}</span>
					<span class="title-line highlight">{heroData.titleHighlight}</span>
				</h1>
				<p>{heroData.description}</p>

				<div class="hero-cta-group">
					<a class="hero-primary" href={heroData.primaryCta.href}>
						{heroData.primaryCta.label}
						<svg class="btn-icon" viewBox="0 0 16 16" aria-hidden="true">
							<path
								d="M3 8h9M8.8 4.2 13 8l-4.2 3.8"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>

					</a>
					<a class="hero-secondary" href={heroData.secondaryCta.href}>
						<svg class="btn-icon" viewBox="0 0 16 16" aria-hidden="true">
							<rect x="2.2" y="3.2" width="11.6" height="10.2" rx="2" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
							<path d="M2.8 6h10.4M5.2 1.9v2.3M10.8 1.9v2.3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
						</svg>

						{heroData.secondaryCta.label}
					</a>
				</div>

				<div class="hero-divider" aria-hidden="true"></div>

				<div class="hero-social-proof">
					<div class="hero-avatars" aria-hidden="true">
						<img class="hero-avatar" src={studentImageUrl.src} alt="" />
						<img class="hero-avatar" src={studentImageUrl.src} alt="" />
						<img class="hero-avatar" src={studentImageUrl.src} alt="" />
					</div>
					<div class="hero-review-meta">
						<div class="hero-stars" aria-label="5 star rating">
							{
								Array.from({ length: 5 }).map(() => (
									<svg viewBox="0 0 18 16" aria-hidden="true">
										<path d="M9.90312 0.5625C9.7375 0.21875 9.3875 0 9.00313 0C8.61875 0 8.27187 0.21875 8.10313 0.5625L6.09375 4.69688L1.60625 5.35938C1.23125 5.41563 0.91875 5.67812 0.803125 6.0375C0.6875 6.39687 0.78125 6.79375 1.05 7.05937L4.30625 10.2812L3.5375 14.8344C3.475 15.2094 3.63125 15.5906 3.94062 15.8125C4.25 16.0344 4.65937 16.0625 4.99687 15.8844L9.00625 13.7437L13.0156 15.8844C13.3531 16.0625 13.7625 16.0375 14.0719 15.8125C14.3812 15.5875 14.5375 15.2094 14.475 14.8344L13.7031 10.2812L16.9594 7.05937C17.2281 6.79375 17.325 6.39687 17.2062 6.0375C17.0875 5.67812 16.7781 5.41563 16.4031 5.35938L11.9125 4.69688L9.90312 0.5625Z" />
									</svg>
								))
							}
						</div>
						<strong>{heroData.ratingText}</strong>
					</div>
				</div>
			</div>

			<DashboardPreview dashboard={heroData.dashboard} />
		</section>
	</div>
</main>
