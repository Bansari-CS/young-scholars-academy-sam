---
import { heroData } from '../../data/home';
import { figmaHero } from '../../data/figmaAssets';
import '../../styles/components/hero-section.css';
import DashboardPreview from './DashboardPreview.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';
---

<div class="hero-area">
	<div class="home-container">
		<section class="hero">
			<div class="hero-content">
				<p class="hero-badge">
					<span class="hero-badge-dot" aria-hidden="true"></span>
					<span>{heroData.badgeText}</span>
				</p>
				<h1 class="hero-title">
					<span class="hero-title-line">{heroData.titleLineOne}</span>
					<span class="hero-title-gradient">{heroData.titleHighlight}</span>
				</h1>
				<p class="hero-lede">{heroData.description}</p>

				<div class="hero-cta-group">
					<PrimaryButton
						href={heroData.primaryCta.href}
						label={heroData.primaryCta.label}
						variant="lg"
						trailingIconSrc={figmaHero.ctaArrow}
					/>
				</div>

				<div class="hero-divider" aria-hidden="true"></div>

				<div class="hero-social-proof">
					<div class="hero-avatars" aria-hidden="true">
						<img class="hero-avatar" src={figmaHero.avatar1} alt="" width="44" height="44" loading="lazy" />
						<img class="hero-avatar" src={figmaHero.avatar2} alt="" width="44" height="44" loading="lazy" />
						<img class="hero-avatar" src={figmaHero.avatar3} alt="" width="44" height="44" loading="lazy" />
						<span class="hero-avatar-more">+2k</span>
					</div>
					<div class="hero-review-meta">
						<div class="hero-stars" aria-label="5 star rating">
							{
								Array.from({ length: 5 }).map(() => (
									<img
										class="hero-star-img"
										src={figmaHero.star}
										alt=""
										width="18"
										height="16"
										loading="lazy"
									/>
								))
							}
						</div>
						<p class="hero-rating-copy">{heroData.ratingText}</p>
					</div>
				</div>
			</div>

			<DashboardPreview dashboard={heroData.dashboard} />
		</section>
	</div>
</div>
