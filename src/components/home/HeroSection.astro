---
import { figmaHero } from '../../data/figmaAssets';
import type { HeroDashboardData } from '../../types/home';
import '../../styles/components/hero-section.css';
import DashboardPreview from './DashboardPreview.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';

interface Props {
	content: {
		badgeText: string;
		titleLineOne: string;
		titleHighlight: string;
		description: string;
		primaryCta: { label: string; href: string };
		ratingText: string;
		ratingAriaLabel?: string;
		dashboard: HeroDashboardData;
	};
}

const { content } = Astro.props;
---

<div class="relative w-full overflow-hidden bg-[var(--ysa-hero-bg)]">
	<!-- Blur Background -->
	<div class="pointer-events-none absolute left-[15%] top-[-5%] h-[min(600px,90vw)] w-[min(600px,90vw)] rounded-full bg-[rgba(199,213,254,0.2)] blur-[70px]"></div>

	<div class="pointer-events-none absolute bottom-[-8%] right-[10%] h-[min(500px,75vw)] w-[min(500px,75vw)] rounded-full bg-[rgba(168,85,247,0.15)] blur-[60px]"></div>

	<div class="mx-auto max-w-[var(--ysa-max)] px-4 pb-10 sm:px-6 md:px-10 lg:px-10 lg:pb-24">
		<section
			class="relative z-[1] grid min-h-0 grid-cols-1 items-start gap-6 pt-20 lg:grid-cols-2 lg:gap-12"
		>
			<!-- Content -->
			<div class="flex max-w-[39.5rem] flex-col items-start gap-6">
				<!-- Badge -->
				<p
					class="inline-flex items-center gap-2 rounded-full border border-[#E0E9FF] bg-white px-[17px] py-[9px] text-xs font-medium tracking-[0.01875rem] text-[#7C3AED] shadow-[0_1px_1px_rgba(0,0,0,0.05)]"
				>
					<span class="h-2 w-2 shrink-0 rounded-full bg-[#048C3C]"></span>
					<span>{content.badgeText}</span>
				</p>

				<!-- Title -->
				<h1
					class="pb-[0.08em] text-[clamp(2.25rem,6vw,3.75rem)] font-bold leading-[1.08] tracking-[-0.09375rem] text-[var(--ysa-figma-brand)]"
				>
					<span class="block leading-[1.08]">
						{content.titleLineOne}
					</span>

					<span
						class="mt-1 block bg-[linear-gradient(90deg,#0A9DFB_18.75%,#7C3AED_66.35%)] bg-clip-text pb-[0.08em] leading-[1.08] text-transparent"
					>
						{content.titleHighlight}
					</span>
				</h1>

				<!-- Description -->
				<p
					class="max-w-[39.5rem] text-[clamp(1rem,2vw,1.125rem)] leading-[2.03125rem] text-[#475569]"
				>
					{content.description}
				</p>

				<!-- CTA -->
				<div class="flex flex-wrap items-start gap-4 pb-4 pt-2">
					<PrimaryButton
						href={content.primaryCta.href}
						label={content.primaryCta.label}
						variant="lg"
						trailingIconSrc={figmaHero.ctaArrow}
					/>
				</div>

				<!-- Divider -->
				<div class="h-0 w-full max-w-[39.5rem] border-t border-[#E2E8F0]"></div>

				<!-- Social Proof -->
				<div class="flex w-full flex-wrap items-center gap-5 pt-[1.5625rem] sm:gap-8">
					<!-- Avatars -->
					<div class="flex items-center">
						<img
							class="-mr-3 block h-11 w-11 shrink-0 rounded-full border-2 border-white object-cover shadow-[0_1px_2px_rgba(0,0,0,0.05)]"
							src={figmaHero.avatar1}
							alt=""
							width="44"
							height="44"
							loading="lazy"
						/>

						<img
							class="-mr-3 block h-11 w-11 shrink-0 rounded-full border-2 border-white object-cover shadow-[0_1px_2px_rgba(0,0,0,0.05)]"
							src={figmaHero.avatar2}
							alt=""
							width="44"
							height="44"
							loading="lazy"
						/>

						<img
							class="-mr-3 block h-11 w-11 shrink-0 rounded-full border-2 border-white object-cover shadow-[0_1px_2px_rgba(0,0,0,0.05)]"
							src={figmaHero.avatar3}
							alt=""
							width="44"
							height="44"
							loading="lazy"
						/>

						<span
							class="-mr-3 grid h-11 w-11 shrink-0 place-items-center rounded-full border-2 border-white bg-[#E0E9FF] text-xs font-bold text-[#4A42C9] shadow-[0_1px_1px_rgba(0,0,0,0.05)]"
						>
							+2k
						</span>
					</div>

					<!-- Rating -->
					<div class="flex flex-col gap-1.5">
						<div class="flex items-center gap-0" aria-label={content.ratingAriaLabel ?? '5 star rating'}>
							{
								Array.from({ length: 5 }).map(() => (
									<img
										class="block h-4 w-[18px] shrink-0"
										src={figmaHero.star}
										alt=""
										width="18"
										height="16"
										loading="lazy"
									/>
								))
							}
						</div>

						<p class="text-sm font-medium leading-5 text-[#334155]">
							{content.ratingText}
						</p>
					</div>
				</div>
			</div>

			<!-- Dashboard -->
			<DashboardPreview dashboard={content.dashboard} />
		</section>
	</div>
</div>