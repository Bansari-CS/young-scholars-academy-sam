---
import type { HeroDashboardData } from '../../types/home';
import { figmaDashboard } from '../../data/figmaAssets';
import '../../styles/components/dashboard-preview.css';

interface Props {
	dashboard: HeroDashboardData;
}

const { dashboard } = Astro.props;

const statIcons = {
	accuracy: figmaDashboard.statAccuracy,
	points: figmaDashboard.statPoints,
	study: figmaDashboard.statStudy,
} as const;
---

<aside class="dashboard-card" aria-label={dashboard.cardAriaLabel ?? 'Product preview'}>
	<div class="dashboard-card__shell">
		<div class="dashboard-header">
			<div class="dashboard-user">
				<img
					class="dashboard-avatar"
					src={figmaDashboard.student}
					alt=""
					width="48"
					height="48"
					loading="lazy"
				/>
				<div class="dashboard-user-text">
					<p class="dashboard-student">{dashboard.studentName}</p>
					<p class="dashboard-course">{dashboard.course}</p>
				</div>
			</div>
			<p class="streak">
				<img src={figmaDashboard.streakFlame} alt="" width="11" height="12" loading="lazy" />
				<span>{dashboard.streakLabel}</span>
			</p>
		</div>

		<div class="lesson-card">
			<span class="progress-tag">{dashboard.progressTag}</span>
			<h3 class="lesson-card__title">{dashboard.lessonTitle}</h3>
			<p class="lesson-card__desc">{dashboard.lessonDescription}</p>

			<div class="lesson-progress-head">
				<span class="lesson-progress-label">{dashboard.lessonProgressLabel}</span>
				<span class="lesson-progress-value">{dashboard.progressPercent}%</span>
			</div>
			<div
				class="progress-track"
				role="progressbar"
				aria-valuenow={dashboard.progressPercent}
				aria-valuemin="0"
				aria-valuemax="100"
				style={`--lesson-progress: ${dashboard.progressPercent}%`}
			>
				<div class="progress-fill"></div>
			</div>
		</div>

		<div class="stats-grid">
			{
				dashboard.stats.map((item) => (
					<article class="stat">
						<div class={`stat-icon stat-icon--${item.icon}`} aria-hidden="true">
							<img src={statIcons[item.icon]} alt="" width="18" height="18" loading="lazy" />
						</div>
						<p class="stat-label">{item.label}</p>
						<div class="stat-value-wrap">
							<strong>{item.value}</strong>
							{item.change ? (
								<span class="stat-change">
									<img src={figmaDashboard.statTrend} alt="" width="9" height="12" loading="lazy" />
									<span class="stat-change-text">{item.change.replace(/^\+/, '')}</span>
								</span>
							) : null}
						</div>
					</article>
				))
			}
		</div>

		<div class="next-session" role="group" aria-labelledby="next-session-label">
			<p id="next-session-label" class="next-session-label">
				{dashboard.nextSession.label}
			</p>
			<div class="next-session-row">
				<div class="next-session-icon" aria-hidden="true">
					<img src={figmaDashboard.sessionIcon} alt="" width="18" height="16" loading="lazy" />
				</div>
				<p class="next-session-title">{dashboard.nextSession.title}</p>
				<span class="next-session-chip">{dashboard.nextSession.chipText}</span>
			</div>
		</div>
	</div>
</aside>
