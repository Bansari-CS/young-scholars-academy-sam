---
import type { PartnerOrg } from "../../types/home";
import { figmaTrustStrip } from "../../data/figmaAssets";
import "../../styles/components/trust-strip-section.css";

interface Props {
  title: string;
  organizations: PartnerOrg[];
}

const { title, organizations } = Astro.props;

function iconMeta(org: PartnerOrg) {
  switch (org.icon) {
    case "tree":
      return {
        kind: "img" as const,
        src: figmaTrustStrip.stanford,
        w: 40,
        h: 40,
      };
    case "star":
      return { kind: "nagc" as const };
    case "twoe":
      return { kind: "twoe" as const };
    case "heart":
      return { kind: "img" as const, src: figmaTrustStrip.seng, w: 36, h: 36 };
    case "book":
      return {
        kind: "img" as const,
        src: figmaTrustStrip.hoagies,
        w: 36,
        h: 36,
      };
  }
}

function nameClass(org: PartnerOrg) {
  return org.icon === "tree"
    ? "trust-strip__name trust-strip__name--lg"
    : "trust-strip__name trust-strip__name--md";
}

function subtitleClass(org: PartnerOrg) {
  if (org.icon === "tree")
    return "trust-strip__subtitle trust-strip__subtitle--caps";
  if (org.icon === "star")
    return "trust-strip__subtitle trust-strip__subtitle--narrow";
  return "trust-strip__subtitle";
}
---

<section
  class="w-full border-t border-[#F1F5F9] border-b-0 bg-white py-[clamp(2.5rem,5vw,3rem)]"
  aria-labelledby="trust-strip-heading"
>
  <div class="mx-auto max-w-[var(--ysa-max)] px-[clamp(1rem,4.44vw,4rem)]">
    
    <h2
      id="trust-strip-heading"
      class="m-0 text-center font-[var(--ysa-font-display)] text-[clamp(1.125rem,2.5vw,1.5rem)] font-medium leading-[1.35] tracking-[0] text-[#94A3B8] normal-case max-sm:tracking-[0.03em]"
    >
      {title}
    </h2>

    <div
      class="mt-5 grid w-full grid-cols-5 items-center gap-0 bg-[length:1px_48px,1px_48px,1px_48px,1px_48px] bg-no-repeat [background-image:linear-gradient(#e2e8f0,#e2e8f0),linear-gradient(#e2e8f0,#e2e8f0),linear-gradient(#e2e8f0,#e2e8f0),linear-gradient(#e2e8f0,#e2e8f0)] [background-position:calc(100%/5)_50%,calc((100%/5)*2)_50%,calc((100%/5)*3)_50%,calc((100%/5)*4)_50%] max-lg:flex max-lg:flex-nowrap max-lg:justify-start max-lg:gap-0 max-lg:overflow-x-auto max-lg:bg-none max-lg:pb-1 max-lg:[scroll-snap-type:x_proximity] [-webkit-overflow-scrolling:touch]"
      role="list"
    >
      {
        organizations.map((org) => {
          const meta = iconMeta(org);

          return (
            <div
              class="relative flex min-w-0 w-full items-center justify-start px-1 py-2 pb-[0.8125rem] max-lg:min-w-[11rem] max-lg:flex-[0_0_auto] max-lg:[scroll-snap-align:start]"
              role="listitem"
            >
              <div class="flex max-w-full items-center gap-3 px-5">
                
                {meta.kind === "twoe" ? (
                  <div
                    class="relative flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-[8px]"
                    aria-hidden="true"
                  >
                    <img
                      class="absolute h-[80%] w-[80%] object-contain"
                      src={figmaTrustStrip.twoeVector}
                      alt=""
                      width="32"
                      height="32"
                      loading="lazy"
                    />

                    <span class="pointer-events-none absolute inset-0 grid place-items-center font-[var(--ysa-font-body)] text-[1.25rem] font-bold leading-none text-[#94A3B8]">
                      2e
                    </span>
                  </div>
                ) : meta.kind === "nagc" ? (
                  <svg
                    width="36"
                    height="36"
                    viewBox="0 0 36 36"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M18 3L21.5 13.5H33L23.5 20.5L27 31L18 24L9 31L12.5 20.5L3 13.5H14.5L18 3Z"
                      fill="#94A3B8"
                    />
                    <path
                      d="M18 23C20.7614 23 23 20.7614 23 18C23 15.2386 20.7614 13 18 13C15.2386 13 13 15.2386 13 18C13 20.7614 15.2386 23 18 23Z"
                      fill="white"
                    />
                    <path
                      d="M18 21C19.6569 21 21 19.6569 21 18C21 16.3431 19.6569 15 18 15C16.3431 15 15 16.3431 15 18C15 19.6569 16.3431 21 18 21Z"
                      fill="#CBD5E1"
                    />
                  </svg>
                ) : (
                  <div
                    class:list={[
                      "shrink-0 flex items-center justify-center",
                      meta.w === 40
                        ? "h-10 w-10"
                        : "h-9 w-9",
                    ]}
                    aria-hidden="true"
                  >
                    <img
                      class="block h-auto w-full"
                      src={meta.src}
                      alt=""
                      width={meta.w}
                      height={meta.h}
                      loading="lazy"
                    />
                  </div>
                )}

                <div class="flex max-w-[125px] flex-col gap-0.5">
                  
                  <p
                    class:list={[
                      "m-0 font-[var(--ysa-font-body)] font-bold leading-[1.1] tracking-[-0.02em] text-[#94A3B8] mb-[0.188rem]",
                      org.name.length > 10
                        ? "text-[1rem]"
                        : "text-[1.125rem]",
                    ]}
                  >
                    {org.name}
                  </p>

                  <p
                    class:list={[
                      "m-0 overflow-hidden text-ellipsis font-[var(--ysa-font-body)] text-[0.75rem] font-light leading-[1.2] text-[#CBD5E1] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] [display:-webkit-box]",
                      subtitleClass(org),
                    ]}
                  >
                    {org.subtitle}
                  </p>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
