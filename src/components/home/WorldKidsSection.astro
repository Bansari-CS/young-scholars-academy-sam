---
import '../../styles/components/world-kids-section.css';

interface Props {
	content: {
		eyebrow: string;
		title: string;
		titleLine2: string;
		description: string;
		stats: Array<{ value: string; label: string }>;
		globeAlt?: string;
	};
}

const { content: d } = Astro.props;

const faces = [
	'/assets/images/Teacher (1).png',
	'/assets/images/Teacher (2).png',
	'/assets/images/Teacher (3).png',
	'/assets/images/Teacher (4).png',
	'/assets/images/Teacher (5).png',
	'/assets/images/Teacher (6).png',
	'/assets/images/Teacher (1).png',
	'/assets/images/Teacher (2).png',
	'/assets/images/Teacher (3).png',
];

/** Figma 1037:3902 — mixed sizes; squircle = 32px rounded-[16px] student pins */
const markerPoints = [
	{ lat: 49.2827, lng: -123.1207, face: faces[0], size: 48, shape: 'circle' },
	{ lat: 37.7749, lng: -122.4194, face: faces[1], size: 40, shape: 'circle' },
	{ lat: 40.7128, lng: -74.006, face: faces[2], size: 48, shape: 'circle' },
	{ lat: -23.5505, lng: -46.6333, face: faces[3], size: 40, shape: 'circle' },
	{ lat: -34.6037, lng: -58.3816, face: faces[4], size: 32, shape: 'squircle' },
	{ lat: 51.5072, lng: -0.1276, face: faces[5], size: 40, shape: 'circle' },
	{ lat: 48.8566, lng: 2.3522, face: faces[6], size: 48, shape: 'circle' },
	{ lat: 30.0444, lng: 31.2357, face: faces[7], size: 32, shape: 'squircle' },
	{ lat: -1.2864, lng: 36.8172, face: faces[8], size: 40, shape: 'circle' },
	{ lat: 19.076, lng: 72.8777, face: faces[0], size: 32, shape: 'squircle' },
	{ lat: 28.6139, lng: 77.209, face: faces[1], size: 40, shape: 'circle' },
	{ lat: 1.3521, lng: 103.8198, face: faces[2], size: 32, shape: 'squircle' },
	{ lat: 35.6762, lng: 139.6503, face: faces[3], size: 48, shape: 'circle' },
	{ lat: 37.5665, lng: 126.978, face: faces[4], size: 56, shape: 'circle' },
	{ lat: -33.8688, lng: 151.2093, face: faces[5], size: 48, shape: 'circle' },
	{ lat: -6.2088, lng: 106.8456, face: faces[6], size: 32, shape: 'squircle' },
	{ lat: 55.7558, lng: 37.6173, face: faces[2], size: 40, shape: 'circle' },
	{ lat: 25.2048, lng: 55.2708, face: faces[3], size: 32, shape: 'squircle' },
];
---

<section class="ysa-world" aria-labelledby="world-heading">
	<div class="home-section-inner">
		<header class="ysa-world__head">
			<p class="ysa-world__badge">{d.eyebrow}</p>
			<h2 class="ysa-world__title" id="world-heading">
				<span>{d.title}</span>
				<span>{d.titleLine2}</span>
			</h2>
			<p class="ysa-world__desc">{d.description}</p>
		</header>

		<div class="ysa-world__stage">
			<div class="ysa-world__stat ysa-world__stat--lt">
				<p class="ysa-world__stat-value">{d.stats[0].value}</p>
				<p class="ysa-world__stat-label">{d.stats[0].label}</p>
			</div>
			<div class="ysa-world__stat ysa-world__stat--rt">
				<p class="ysa-world__stat-value">{d.stats[1].value}</p>
				<p class="ysa-world__stat-label">{d.stats[1].label}</p>
			</div>
			<div class="ysa-world__stat ysa-world__stat--lb">
				<p class="ysa-world__stat-value">{d.stats[2].value}</p>
				<p class="ysa-world__stat-label">{d.stats[2].label}</p>
			</div>
			<div class="ysa-world__stat ysa-world__stat--rb">
				<p class="ysa-world__stat-value">{d.stats[3].value}</p>
				<p class="ysa-world__stat-label">{d.stats[3].label}</p>
			</div>

			<div class="ysa-world__ring">
				<div class="ysa-world__globe-wrap">
					<div
						class="ysa-world__globe"
						data-world-globe
						data-globe-alt={d.globeAlt ?? 'Global network of YSA students around the world'}
						data-points={JSON.stringify(markerPoints)}
						role="img"
						aria-label={d.globeAlt ?? 'Global network of YSA students around the world'}
					></div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const globeRoot = document.querySelector('[data-world-globe]');
	if (globeRoot) {
		const points = JSON.parse(globeRoot.getAttribute('data-points') ?? '[]');
		Promise.all([import('globe.gl'), import('three')]).then(([{ default: Globe }, THREE]) => {
			const globe = Globe({
				animateIn: false,
				waitForGlobeReady: true
			})(globeRoot);

			const earthMapUrl = '//unpkg.com/three-globe/example/img/earth-blue-marble.jpg';
			const earthBumpUrl = '//unpkg.com/three-globe/example/img/earth-topology.png';

			globe
				.backgroundColor('rgba(0,0,0,0)')
				.width(globeRoot.clientWidth)
				.height(globeRoot.clientHeight)
				.globeImageUrl(earthMapUrl)
				.bumpImageUrl(earthBumpUrl)
				.showAtmosphere(true)
				.atmosphereColor('#18e0eb')
				.atmosphereAltitude(0.14)
				.htmlElementsData(points)
				.htmlLat((d) => d.lat)
				.htmlLng((d) => d.lng)
				.htmlAltitude(() => 0.012)
				.htmlElement((d) => {
					const root = document.createElement('div');
					const shape = d.shape === 'squircle' ? 'squircle' : 'circle';
					root.className = `ysa-world__marker ysa-world__marker--${shape}`;
					const markerSize = Number(d.size) || 40;
					root.style.width = `${markerSize}px`;
					root.style.height = `${markerSize}px`;

					const glow = document.createElement('span');
					glow.className = 'ysa-world__marker-glow';
					glow.setAttribute('aria-hidden', 'true');

					const inner = document.createElement('div');
					inner.className = 'ysa-world__marker-inner';

					const img = document.createElement('img');
					img.src = d.face;
					img.alt = '';
					img.className = 'ysa-world__marker-img';
					img.loading = 'lazy';
					inner.append(img);
					root.append(glow, inner);
					return root;
				});

			const controls = globe.controls();
			controls.enableZoom = false;
			controls.enablePan = false;
			controls.enableRotate = true;
			controls.autoRotate = false;
			controls.rotateSpeed = 0.7;
			controls.enableDamping = true;
			controls.dampingFactor = 0.08;

			globe.pointOfView({ lat: 12, lng: 12, altitude: 1.2 }, 0);

			const mat = globe.globeMaterial();
			if (mat) {
				mat.color = new THREE.Color('#6ab0f0');
				mat.emissive = new THREE.Color('#0278cb');
				mat.emissiveIntensity = 0.07;
				if ('bumpScale' in mat && typeof mat.bumpScale === 'number') {
					mat.bumpScale = 5;
				}
				if ('shininess' in mat && typeof mat.shininess === 'number') {
					mat.shininess = 20;
				}
				if ('metalness' in mat && typeof mat.metalness === 'number') {
					mat.metalness = 0.08;
				}
				if ('roughness' in mat && typeof mat.roughness === 'number') {
					mat.roughness = 0.52;
				}
			}
			for (const light of globe.lights()) {
				if (light.type === 'AmbientLight') {
					light.color = new THREE.Color('#2c65a8');
					light.intensity = 0.34;
				}
				if (light.type === 'DirectionalLight') {
					light.color = new THREE.Color('#e8fbff');
					light.intensity = 0.95;
					light.position.set(1.35, 0.85, 0.75);
				}
			}
			/* Even lighting on night side of sphere (sky / ground from sampled Figma blues) */
			const scene = globe.scene();
			if (!scene.getObjectByName('ysa-world-globe-hemi')) {
				const hemi = new THREE.HemisphereLight(0x18e0eb, 0x000d46, 0.32);
				hemi.name = 'ysa-world-globe-hemi';
				scene.add(hemi);
			}

			const onPointerDown = () => {
				globeRoot.classList.add('is-dragging');
			};
			const onPointerUp = () => {
				globeRoot.classList.remove('is-dragging');
			};

			globeRoot.addEventListener('pointerdown', onPointerDown);
			window.addEventListener('pointerup', onPointerUp);

			const onResize = () => {
				globe.width(globeRoot.clientWidth);
				globe.height(globeRoot.clientHeight);
			};

			window.addEventListener('resize', onResize);
		});
	}
</script>
