---
import { WORLD_COUNTRY_COORDS } from '../../content/home/worldCountryCoords';
import { WORLD_COUNTRY_FLAG_ISO } from '../../content/home/worldCountryFlags';

interface Props {
	content: {
		eyebrow: string;
		title: string;
		titleLine2: string;
		description: string;
		stats: Array<{ value: string; label: string }>;
		globeAlt?: string;
		countriesHeading?: string;
		countries?: Array<{ flag: string; name: string }>;
	};
}

const { content: d } = Astro.props;

/** Parse CMS stat strings for count-up (e.g. 1.2K+, 47+); literals e.g. 24/7 unchanged */
function statDisplayMeta(
	value: string
):
	| { kind: 'literal'; text: string }
	| { kind: 'count'; target: number; suffix: string; format?: 'compact-k' | 'compact-m' } {
	const t = value.trim();
	if (/^\d+\/\d+$/.test(t)) return { kind: 'literal', text: t };
	const km = t.match(/^(\d+(?:\.\d+)?)([KkMm])(\+)?$/);
	if (km) {
		const num = Number(km[1]);
		const unit = km[2].toUpperCase();
		const suffix = km[3] ?? '';
		const multiplier = unit === 'K' ? 1000 : 1_000_000;
		return {
			kind: 'count',
			target: Math.round(num * multiplier),
			suffix,
			format: unit === 'K' ? 'compact-k' : 'compact-m',
		};
	}
	const normalized = t.replace(/,/g, '');
	const m = normalized.match(/^(\d+)(\+)?$/);
	if (m) return { kind: 'count', target: Number(m[1]), suffix: m[2] ?? '' };
	return { kind: 'literal', text: t };
}

const statSlots = ['lt', 'rt', 'lb', 'rb'] as const;

const faces = [
	'/assets/images/Teacher (1).png',
	'/assets/images/Teacher (2).png',
	'/assets/images/Teacher (3).png',
	'/assets/images/Teacher (4).png',
	'/assets/images/Teacher (5).png',
	'/assets/images/Teacher (6).png',
	'/assets/images/Teacher (1).png',
	'/assets/images/Teacher (2).png',
	'/assets/images/Teacher (3).png',
];

/** Same size/shape rhythm as original globe pins (Figma), applied to each CMS country in order */
const markerStyleByIndex = [
	{ size: 48, shape: 'circle' as const },
	{ size: 40, shape: 'circle' as const },
	{ size: 48, shape: 'circle' as const },
	{ size: 40, shape: 'circle' as const },
	{ size: 32, shape: 'squircle' as const },
	{ size: 40, shape: 'circle' as const },
	{ size: 48, shape: 'circle' as const },
	{ size: 32, shape: 'squircle' as const },
	{ size: 40, shape: 'circle' as const },
	{ size: 32, shape: 'squircle' as const },
	{ size: 40, shape: 'circle' as const },
	{ size: 32, shape: 'squircle' as const },
	{ size: 48, shape: 'circle' as const },
	{ size: 56, shape: 'circle' as const },
	{ size: 48, shape: 'circle' as const },
	{ size: 32, shape: 'squircle' as const },
	{ size: 40, shape: 'circle' as const },
];

/** Globe pins: country lat/lng from CMS order + profile photos (original asset look) */
const markerPoints =
	d.countries
		?.map((country, index) => {
			const coords = WORLD_COUNTRY_COORDS[country.name];
			if (!coords) return null;
			const style = markerStyleByIndex[index] ?? { size: 40, shape: 'circle' as const };
			return {
				lat: coords.lat,
				lng: coords.lng,
				face: faces[index % faces.length],
				name: country.name,
				size: style.size,
				shape: style.shape,
			};
		})
		.filter((point): point is NonNullable<typeof point> => point !== null) ?? [];
---

<section class="bg-white" aria-labelledby="world-heading" data-world-section>
	<div class="mx-auto max-w-[var(--ysa-max)] px-[clamp(1rem,4.44vw,4rem)]">
		<header class="mx-auto max-w-[50rem] text-center">
			<p
				class="mb-4 inline-flex w-[211px] items-center justify-center rounded-full bg-[#e9ddff] px-4 py-2 font-display text-xs font-bold tracking-[0.04em] text-[#7c3aed] uppercase"
			>
				{d.eyebrow}
			</p>
			<h2
				class="m-0 font-display text-[clamp(2rem,4.1vw,2.8rem)] font-bold tracking-[-0.02em] text-[#111827] leading-[1.15]"
				id="world-heading"
			>
				<span class="block">{d.title}</span>
				<span class="block">{d.titleLine2}</span>
			</h2>
			<p class="mx-auto mt-6 mb-16 max-w-[39.125rem] text-base leading-[1.65] text-slate-500">{d.description}</p>
		</header>

		<div
			class="relative mx-auto mt-14 min-h-[21rem] max-w-[77rem] px-0 py-16 max-md:grid max-md:min-h-[35rem] max-md:max-w-[34rem] max-md:gap-[0.9rem]"
		>
			{
				d.stats.map((stat, index) => {
					const meta = statDisplayMeta(stat.value);
					const pos = statSlots[index] ?? 'lt';
					return (
						<div
							class:list={[
								'absolute flex min-h-[4.9rem] w-[clamp(7.8rem,18vw,16rem)] flex-col items-center justify-center rounded-[0.95rem] border border-[#e9eef5] bg-white p-8 shadow-[0_1px_2px_rgba(15,23,42,0.04),0_10px_30px_-16px_rgba(15,23,42,0.2)] max-md:static max-md:w-auto [&.is-counted_.world-stat-value-num]:motion-safe:animate-[world-stat-pop_0.55s_ease-out] motion-reduce:[&.is-counted_.world-stat-value-num]:animate-none',
								pos === 'lt' && 'left-[1%] top-[20%] max-md:order-2',
								pos === 'lb' && 'left-[4%] bottom-[26%] max-[1100px]:left-0 max-md:order-2',
								pos === 'rt' && 'right-[1%] top-[20%] max-md:order-2',
								pos === 'rb' && 'right-[4%] bottom-[26%] max-[1100px]:right-0 max-md:order-2',
							]}
							data-world-stat
						>
							<p class="m-0 font-display text-[clamp(1.3rem,2.5vw,2.625rem)] font-bold tracking-[-0.02em] text-[#0a9dfb] tabular-nums leading-[1.1]">
								{meta.kind === 'literal' ? (
									<span class="world-stat-value-num inline-block min-w-[3ch]">{meta.text}</span>
								) : (
									<span
										class="world-stat-value-num inline-block min-w-[3ch]"
										data-stat-count
										data-stat-target={meta.target}
										data-stat-suffix={meta.suffix}
										data-stat-format={meta.format}
									>
										0
									</span>
								)}
							</p>
							<p class="mt-[0.45rem] mb-0 font-[var(--ysa-font-body)] text-[1.063rem] font-semibold text-[#111827]">
								{stat.label}
							</p>
						</div>
					);
				})
			}

			<div
				class="mx-auto grid aspect-square w-[min(34rem,86vw)] place-items-center rounded-full border border-[#0278cb]/20 max-md:order-1 max-md:w-[min(27rem,90vw)]"
			>
				<div
					class="relative aspect-square w-[min(25rem,50vw)] overflow-hidden rounded-full shadow-[0_20px_44px_-22px_rgba(15,23,42,0.45)] [background:radial-gradient(circle_at_48%_38%,#0278cb_0%,#061897_38%,#001a5a_68%,#000d46_100%)] max-md:w-[min(21rem,72vw)]"
				>
					<div
						class="pointer-events-none absolute inset-0 z-[1] rounded-full [background:radial-gradient(circle_at_22%_18%,rgba(77,240,240,0.35),transparent_42%),radial-gradient(circle_at_50%_50%,transparent_62%,rgba(24,224,235,0.18)_100%),radial-gradient(circle_at_78%_78%,rgba(44,101,168,0.28),transparent_48%)] mix-blend-screen [-webkit-mask-image:radial-gradient(circle,transparent_48%,#000_78%)] [mask-image:radial-gradient(circle,transparent_48%,#000_78%)]"
						aria-hidden="true"
					/>
					<div
						class="relative z-0 block size-full cursor-grab rounded-full [&.is-dragging]:cursor-grabbing [&:active]:cursor-grabbing [&_canvas]:brightness-[1.05] [&_canvas]:contrast-[1.06] [&_canvas]:saturate-[1.18]"
						data-world-globe
						data-globe-alt={d.globeAlt ?? 'Global network of YSA students around the world'}
						data-points={JSON.stringify(markerPoints)}
						role="img"
						aria-label={d.globeAlt ?? 'Global network of YSA students around the world'}
					></div>
				</div>
			</div>
		</div>

		{
			d.countries?.length ? (
				<div class="mx-auto max-w-[52rem] pb-16 text-center">
					{
						d.countriesHeading ? (
							<h3 class="m-0 mb-6 text-[clamp(2rem,4.1vw,2.8rem)] font-bold leading-[1.15] tracking-[-0.02em] text-[#111827]">
								{d.countriesHeading}
							</h3>
						) : null
					}
					<ul
						class="m-0 grid list-none grid-cols-1 gap-x-5 gap-y-2.5 p-0 text-left sm:grid-cols-2 md:grid-cols-[repeat(auto-fill,minmax(11rem,1fr))]"
						aria-label={d.countriesHeading ?? 'Countries served'}
					>
						{d.countries.map((country) => {
							const iso = WORLD_COUNTRY_FLAG_ISO[country.name];
							return (
								<li class="flex items-center gap-2.5">
									{iso ? (
										<img
											src={`https://flagcdn.com/w40/${iso}.png`}
											srcset={`https://flagcdn.com/w80/${iso}.png 2x`}
											alt=""
											width={40}
											height={27}
											class="h-5 w-7 shrink-0 rounded-sm object-cover shadow-sm ring-1 ring-slate-200/80"
											loading="lazy"
											decoding="async"
										/>
									) : null}
									<span class="text-left text-[0.9375rem] font-medium leading-[1.35] text-slate-700">
										{country.name}
									</span>
								</li>
							);
						})}
					</ul>
				</div>
			) : null
		}
	</div>
</section>

<script>
	function smoothStep(edge0, edge1, x) {
		const t = Math.min(1, Math.max(0, (x - edge0) / (edge1 - edge0)));
		return t * t * (3 - 2 * t);
	}

	function clamp255(v) {
		if (v < 0) return 0;
		if (v > 255) return 255;
		return v | 0;
	}

	function loadCrossOriginImage(src) {
		return new Promise((resolve, reject) => {
			const img = new Image();
			img.crossOrigin = 'anonymous';
			img.onload = () => resolve(img);
			img.onerror = () => reject(new Error('globe texture'));
			img.src = src;
		});
	}

	/**
	 * Procedural “digital twin” map: earth-dark = crisp land/ocean mask, earth-night = hubs.
	 * Not a satellite photo — cyan mesh / nodes on deep navy oceans (Figma palette).
	 */
	async function createDigitalGlobeMapDataUrl(darkUrl, nightUrl) {
		const cacheKey = 'ysa-digital-globe-png-v5';
		try {
			for (const stale of [
				'ysa-digital-globe-jpeg-v1',
				'ysa-digital-globe-jpeg-v2',
				'ysa-digital-globe-jpeg-v3',
				'ysa-digital-globe-png-v4',
			]) {
				sessionStorage.removeItem(stale);
			}
		} catch {
			/* ignore */
		}
		try {
			const hit = sessionStorage.getItem(cacheKey);
			if (hit && hit.length > 80000) return hit;
		} catch {
			/* ignore */
		}
		const [imgDark, imgNight] = await Promise.all([
			loadCrossOriginImage(darkUrl),
			loadCrossOriginImage(nightUrl),
		]);
		const W = 1024;
		const H = 512;
		const canvas = document.createElement('canvas');
		canvas.width = W;
		canvas.height = H;
		const ctx = canvas.getContext('2d', { willReadFrequently: true });
		if (!ctx) throw new Error('no canvas');
		ctx.drawImage(imgDark, 0, 0, W, H);
		const darkIm = ctx.getImageData(0, 0, W, H);
		ctx.drawImage(imgNight, 0, 0, W, H);
		const nightIm = ctx.getImageData(0, 0, W, H);
		const dd = darkIm.data;
		const nd = nightIm.data;
		const out = ctx.createImageData(W, H);
		const o = out.data;
		for (let y = 0; y < H; y++) {
			for (let x = 0; x < W; x++) {
				const i = (y * W + x) * 4;
				const dr = dd[i];
				const dg = dd[i + 1];
				const db = dd[i + 2];
				const lumDark = (0.299 * dr + 0.587 * dg + 0.114 * db) / 255;
				const nr = nd[i];
				const ng = nd[i + 1];
				const nb = nd[i + 2];
				const lumNight = (0.299 * nr + 0.587 * ng + 0.114 * nb) / 255;
				const landW = 1 - smoothStep(0.07, 0.12, lumDark);
				/* Smooth land base — no noise tiling (reads as “chex” on a sphere) */
				let lr = 6;
				let lg = 38;
				let lb = 116;
				if (lumNight > 0.1) {
					const k = Math.min(1, (lumNight - 0.1) / 0.5);
					const tr = 195 + 60 * k;
					const tg = 250;
					const tb = 255;
					lr += (tr - lr) * k;
					lg += (tg - lg) * k;
					lb += (tb - lb) * k;
				}
				const or = lumDark * 44;
				const og = 10 + lumDark * 34;
				const ob = 40 + lumDark * 98;
				const coast = smoothStep(0.072, 0.096, lumDark) * (1 - smoothStep(0.096, 0.14, lumDark));
				let R = or * (1 - landW) + lr * landW;
				let G = og * (1 - landW) + lg * landW;
				let B = ob * (1 - landW) + lb * landW;
				R += coast * 88;
				G += coast * 205;
				B += coast * 238;
				o[i] = clamp255(R);
				o[i + 1] = clamp255(G);
				o[i + 2] = clamp255(B);
				o[i + 3] = 255;
			}
		}
		ctx.putImageData(out, 0, 0);
		/* PNG avoids JPEG 8×8 macro-blocks that look like a checker on curved surfaces */
		const url = canvas.toDataURL('image/png');
		try {
			sessionStorage.setItem(cacheKey, url);
		} catch {
			/* quota / private mode — skip cache */
		}
		return url;
	}

	function buildDigitalNetworkPoints(count) {
		const regions = [
			{ lat: [-55, 72], lng: [-130, -30] },
			{ lat: [-38, 38], lng: [-25, 55] },
			{ lat: [-12, 55], lng: [70, 180] },
			{ lat: [-12, 55], lng: [-180, -95] },
			{ lat: [-48, -8], lng: [110, 155] },
			{ lat: [25, 72], lng: [-180, -130] },
			{ lat: [-35, 35], lng: [95, 140] },
		];
		/* Small highlights on land — texture carries continent shapes; dots = network layer */
		const colors = ['#ffffff', '#e8fdff', '#4df0f0', '#18e0eb', '#b8f6ff'];
		const rand = (a, b) => a + Math.random() * (b - a);
		const pts = [];
		for (let i = 0; i < count; i++) {
			const landBias = Math.random() < 0.92;
			let lat;
			let lng;
			if (landBias) {
				const r = regions[Math.floor(Math.random() * regions.length)];
				lat = rand(r.lat[0], r.lat[1]);
				lng = rand(r.lng[0], r.lng[1]);
			} else {
				lat = rand(-80, 80);
				lng = rand(-180, 180);
			}
			pts.push({
				lat,
				lng,
				size: 0.0016 + Math.random() * 0.005,
				r: 0.022 + Math.random() * 0.045,
				color: colors[Math.floor(Math.random() * colors.length)],
			});
		}
		return pts;
	}

	const globeRoot = document.querySelector('[data-world-globe]');
	if (globeRoot) {
		const points = JSON.parse(globeRoot.getAttribute('data-points') ?? '[]');
		Promise.all([import('globe.gl'), import('three')]).then(async ([{ default: Globe }, THREE]) => {
			const globe = Globe({
				animateIn: false,
				waitForGlobeReady: true
			})(globeRoot);

			const earthDark = 'https://unpkg.com/three-globe/example/img/earth-dark.jpg';
			const earthNight = 'https://unpkg.com/three-globe/example/img/earth-night.jpg';

			let globeMapUrl = earthDark;
			try {
				globeMapUrl = await createDigitalGlobeMapDataUrl(earthDark, earthNight);
			} catch {
				globeMapUrl = earthDark;
			}

			const networkDots = buildDigitalNetworkPoints(2000);

			globe
				.backgroundColor('rgba(0,0,0,0)')
				.width(globeRoot.clientWidth)
				.height(globeRoot.clientHeight)
				.globeImageUrl(globeMapUrl)
				.showGraticules(false)
				.showAtmosphere(true)
				.atmosphereColor('#4df0f0')
				.atmosphereAltitude(0.2)
				.pointsData(networkDots)
				.pointLat('lat')
				.pointLng('lng')
				.pointAltitude('size')
				.pointColor('color')
				.pointRadius('r')
				.pointResolution(14)
				.pointsMerge(false)
				.htmlElementsData(points)
				.htmlLat((d) => d.lat)
				.htmlLng((d) => d.lng)
				.htmlAltitude(() => 0.012)
				.htmlElement((d) => {
					const root = document.createElement('div');
					const shape = d.shape === 'squircle' ? 'squircle' : 'circle';
					root.className =
						'relative box-border -translate-x-1/2 -translate-y-1/2 pointer-events-none';
					const markerSize = Number(d.size) || 40;
					root.style.width = `${markerSize}px`;
					root.style.height = `${markerSize}px`;
					if (d.name) {
						root.title = d.name;
						root.setAttribute('aria-label', d.name);
					}

					const glow = document.createElement('span');
					glow.className =
						shape === 'squircle'
							? 'pointer-events-none absolute -inset-2 z-0 rounded-[20px] bg-[#061897] opacity-40 blur-[6px]'
							: 'pointer-events-none absolute -inset-2 z-0 rounded-full bg-[#061897] opacity-40 blur-[6px]';
					glow.setAttribute('aria-hidden', 'true');

					const inner = document.createElement('div');
					inner.className =
						shape === 'squircle'
							? 'relative z-[1] box-border h-full w-full overflow-hidden rounded-2xl border-2 border-white shadow-[0_2px_4px_rgba(0,0,0,0.25)]'
							: 'relative z-[1] box-border h-full w-full overflow-hidden rounded-full border-2 border-white shadow-[0_2px_4px_rgba(0,0,0,0.22)]';

					if (d.face) {
						const img = document.createElement('img');
						img.src = d.face;
						img.alt = '';
						img.className = 'block h-full w-full object-cover';
						img.loading = 'lazy';
						inner.append(img);
					}

					root.append(glow, inner);
					return root;
				});

			const networkArcs = [];
			const maxArcs = 200;
			let tries = 0;
			while (networkArcs.length < maxArcs && tries < 12000) {
				tries++;
				const a = networkDots[Math.floor(Math.random() * networkDots.length)];
				const b = networkDots[Math.floor(Math.random() * networkDots.length)];
				const dLat = Math.abs(a.lat - b.lat);
				const dLng = Math.abs(a.lng - b.lng);
				const span = dLat + dLng;
				if (dLat < 40 && dLng < 100 && span > 6 && span < 58) {
					networkArcs.push({
						startLat: a.lat,
						startLng: a.lng,
						endLat: b.lat,
						endLng: b.lng,
					});
				}
			}
			globe
				.arcsData(networkArcs)
				.arcColor(() => 'rgba(77,240,240,0.38)')
				.arcStroke(0.14)
				.arcAltitude(0.085)
				.arcDashLength(0.2)
				.arcDashGap(0.16)
				.arcDashAnimateTime(11000);

			const controls = globe.controls();
			controls.enableZoom = false;
			controls.enablePan = false;
			controls.enableRotate = true;
			controls.autoRotate = false;
			controls.rotateSpeed = 0.7;
			controls.enableDamping = true;
			controls.dampingFactor = 0.08;

			globe.pointOfView({ lat: 12, lng: 12, altitude: 1.2 }, 0);

			/* Glossy digital sphere — map already carries cyan mesh; keep tint neutral */
			const mat = globe.globeMaterial();
			if (mat) {
				mat.color = new THREE.Color(0xffffff);
				mat.emissive = new THREE.Color(0x041028);
				mat.emissiveIntensity = 0.07;
				if ('bumpScale' in mat && typeof mat.bumpScale === 'number') {
					mat.bumpScale = 0;
				}
				if ('shininess' in mat && typeof mat.shininess === 'number') {
					mat.shininess = 68;
				}
				if ('metalness' in mat && typeof mat.metalness === 'number') {
					mat.metalness = 0.12;
				}
				if ('roughness' in mat && typeof mat.roughness === 'number') {
					mat.roughness = 0.32;
				}
			}
			for (const light of globe.lights()) {
				if (light.type === 'AmbientLight') {
					light.color = new THREE.Color('#2a5088');
					light.intensity = 0.62;
				}
				if (light.type === 'DirectionalLight') {
					light.color = new THREE.Color('#f2fbff');
					light.intensity = 1.05;
					light.position.set(1.25, 0.9, 0.65);
				}
			}
			const scene = globe.scene();
			const hemiName = 'ysa-world-globe-hemi';
			let hemi = scene.getObjectByName(hemiName);
			if (!hemi) {
				hemi = new THREE.HemisphereLight(0x7eedf5, 0x000814, 0.32);
				hemi.name = hemiName;
				scene.add(hemi);
			} else if (hemi.isHemisphereLight) {
				hemi.color.set(0x7eedf5);
				hemi.groundColor.set(0x000814);
				hemi.intensity = 0.32;
			}

			const onPointerDown = () => {
				globeRoot.classList.add('is-dragging');
			};
			const onPointerUp = () => {
				globeRoot.classList.remove('is-dragging');
			};

			globeRoot.addEventListener('pointerdown', onPointerDown);
			window.addEventListener('pointerup', onPointerUp);

			const onResize = () => {
				globe.width(globeRoot.clientWidth);
				globe.height(globeRoot.clientHeight);
			};

			window.addEventListener('resize', onResize);
		});
	}

	function setupWorldStatCounters() {
		const section = document.querySelector('[data-world-section]');
		if (!section) return;
		const els = section.querySelectorAll('[data-stat-count]');
		if (!els.length) return;

		const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function formatCount(n, format) {
			const v = Math.round(n);
			if (format === 'compact-k' && v >= 1000) {
				const k = Math.round((v / 1000) * 10) / 10;
				const kText = k % 1 === 0 ? String(k) : k.toFixed(1);
				return `${kText}K`;
			}
			if (format === 'compact-m' && v >= 1_000_000) {
				const m = Math.round((v / 1_000_000) * 10) / 10;
				const mText = m % 1 === 0 ? String(m) : m.toFixed(1);
				return `${mText}M`;
			}
			return v.toLocaleString('en-US');
		}

		function runCountUp() {
			els.forEach((el) => {
				const target = Number(el.getAttribute('data-stat-target'));
				const suffix = el.getAttribute('data-stat-suffix') || '';
				const format = el.getAttribute('data-stat-format') || '';
				if (!Number.isFinite(target) || target < 0) return;

				if (reduceMotion) {
					el.textContent = formatCount(target, format) + suffix;
					el.closest('[data-world-stat]')?.classList.add('is-counted');
					return;
				}

				const start = performance.now();
				const duration = 2200;
				function tick(now) {
					const t = Math.min(1, (now - start) / duration);
					const eased = 1 - Math.pow(1 - t, 3);
					const v = Math.round(eased * target);
					el.textContent = formatCount(v, format) + suffix;
					if (t < 1) {
						requestAnimationFrame(tick);
					} else {
						el.closest('[data-world-stat]')?.classList.add('is-counted');
					}
				}
				requestAnimationFrame(tick);
			});
		}

		if (reduceMotion) {
			runCountUp();
			return;
		}

		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						runCountUp();
						io.disconnect();
					}
				});
			},
			{ threshold: 0.2, rootMargin: '0px 0px -8% 0px' }
		);
		io.observe(section);
	}

	setupWorldStatCounters();
</script>
