---
import '../../styles/components/world-kids-section.css';

interface Props {
	content: {
		eyebrow: string;
		title: string;
		titleLine2: string;
		description: string;
		stats: Array<{ value: string; label: string }>;
		globeAlt?: string;
	};
}

const { content: d } = Astro.props;

/** Parse CMS stat strings for count-up (e.g. 10,000+ → target + suffix); literals e.g. 24/7 unchanged */
function statDisplayMeta(value: string): { kind: 'literal'; text: string } | { kind: 'count'; target: number; suffix: string } {
	const t = value.trim();
	if (/^\d+\/\d+$/.test(t)) return { kind: 'literal', text: t };
	const normalized = t.replace(/,/g, '');
	const m = normalized.match(/^(\d+)(\+)?$/);
	if (m) return { kind: 'count', target: Number(m[1]), suffix: m[2] ?? '' };
	return { kind: 'literal', text: t };
}

const statSlots = ['lt', 'rt', 'lb', 'rb'] as const;

const faces = [
	'/assets/images/Teacher (1).png',
	'/assets/images/Teacher (2).png',
	'/assets/images/Teacher (3).png',
	'/assets/images/Teacher (4).png',
	'/assets/images/Teacher (5).png',
	'/assets/images/Teacher (6).png',
	'/assets/images/Teacher (1).png',
	'/assets/images/Teacher (2).png',
	'/assets/images/Teacher (3).png',
];

/** Figma 1037:3902 — mixed sizes; squircle = 32px rounded-[16px] student pins */
const markerPoints = [
	{ lat: 49.2827, lng: -123.1207, face: faces[0], size: 48, shape: 'circle' },
	{ lat: 37.7749, lng: -122.4194, face: faces[1], size: 40, shape: 'circle' },
	{ lat: 40.7128, lng: -74.006, face: faces[2], size: 48, shape: 'circle' },
	{ lat: -23.5505, lng: -46.6333, face: faces[3], size: 40, shape: 'circle' },
	{ lat: -34.6037, lng: -58.3816, face: faces[4], size: 32, shape: 'squircle' },
	{ lat: 51.5072, lng: -0.1276, face: faces[5], size: 40, shape: 'circle' },
	{ lat: 48.8566, lng: 2.3522, face: faces[6], size: 48, shape: 'circle' },
	{ lat: 30.0444, lng: 31.2357, face: faces[7], size: 32, shape: 'squircle' },
	{ lat: -1.2864, lng: 36.8172, face: faces[8], size: 40, shape: 'circle' },
	{ lat: 19.076, lng: 72.8777, face: faces[0], size: 32, shape: 'squircle' },
	{ lat: 28.6139, lng: 77.209, face: faces[1], size: 40, shape: 'circle' },
	{ lat: 1.3521, lng: 103.8198, face: faces[2], size: 32, shape: 'squircle' },
	{ lat: 35.6762, lng: 139.6503, face: faces[3], size: 48, shape: 'circle' },
	{ lat: 37.5665, lng: 126.978, face: faces[4], size: 56, shape: 'circle' },
	{ lat: -33.8688, lng: 151.2093, face: faces[5], size: 48, shape: 'circle' },
	{ lat: -6.2088, lng: 106.8456, face: faces[6], size: 32, shape: 'squircle' },
	{ lat: 55.7558, lng: 37.6173, face: faces[2], size: 40, shape: 'circle' },
	{ lat: 25.2048, lng: 55.2708, face: faces[3], size: 32, shape: 'squircle' },
];
---

<section class="ysa-world" aria-labelledby="world-heading">
	<div class="home-section-inner">
		<header class="ysa-world__head">
			<p class="ysa-world__badge">{d.eyebrow}</p>
			<h2 class="ysa-world__title" id="world-heading">
				<span>{d.title}</span>
				<span>{d.titleLine2}</span>
			</h2>
			<p class="ysa-world__desc">{d.description}</p>
		</header>

		<div class="ysa-world__stage">
			{
				d.stats.map((stat, index) => {
					const meta = statDisplayMeta(stat.value);
					const pos = statSlots[index] ?? 'lt';
					return (
						<div class:list={['ysa-world__stat', `ysa-world__stat--${pos}`]}>
							<p class="ysa-world__stat-value">
								{meta.kind === 'literal' ? (
									<span class="ysa-world__stat-value-num">{meta.text}</span>
								) : (
									<span
										class="ysa-world__stat-value-num"
										data-stat-count
										data-stat-target={meta.target}
										data-stat-suffix={meta.suffix}
									>
										0
									</span>
								)}
							</p>
							<p class="ysa-world__stat-label">{stat.label}</p>
						</div>
					);
				})
			}

			<div class="ysa-world__ring">
				<div class="ysa-world__globe-wrap">
					<div
						class="ysa-world__globe"
						data-world-globe
						data-globe-alt={d.globeAlt ?? 'Global network of YSA students around the world'}
						data-points={JSON.stringify(markerPoints)}
						role="img"
						aria-label={d.globeAlt ?? 'Global network of YSA students around the world'}
					></div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	function smoothStep(edge0, edge1, x) {
		const t = Math.min(1, Math.max(0, (x - edge0) / (edge1 - edge0)));
		return t * t * (3 - 2 * t);
	}

	function clamp255(v) {
		if (v < 0) return 0;
		if (v > 255) return 255;
		return v | 0;
	}

	function loadCrossOriginImage(src) {
		return new Promise((resolve, reject) => {
			const img = new Image();
			img.crossOrigin = 'anonymous';
			img.onload = () => resolve(img);
			img.onerror = () => reject(new Error('globe texture'));
			img.src = src;
		});
	}

	/**
	 * Procedural “digital twin” map: earth-dark = crisp land/ocean mask, earth-night = hubs.
	 * Not a satellite photo — cyan mesh / nodes on deep navy oceans (Figma palette).
	 */
	async function createDigitalGlobeMapDataUrl(darkUrl, nightUrl) {
		const cacheKey = 'ysa-digital-globe-png-v5';
		try {
			for (const stale of [
				'ysa-digital-globe-jpeg-v1',
				'ysa-digital-globe-jpeg-v2',
				'ysa-digital-globe-jpeg-v3',
				'ysa-digital-globe-png-v4',
			]) {
				sessionStorage.removeItem(stale);
			}
		} catch {
			/* ignore */
		}
		try {
			const hit = sessionStorage.getItem(cacheKey);
			if (hit && hit.length > 80000) return hit;
		} catch {
			/* ignore */
		}
		const [imgDark, imgNight] = await Promise.all([
			loadCrossOriginImage(darkUrl),
			loadCrossOriginImage(nightUrl),
		]);
		const W = 1024;
		const H = 512;
		const canvas = document.createElement('canvas');
		canvas.width = W;
		canvas.height = H;
		const ctx = canvas.getContext('2d', { willReadFrequently: true });
		if (!ctx) throw new Error('no canvas');
		ctx.drawImage(imgDark, 0, 0, W, H);
		const darkIm = ctx.getImageData(0, 0, W, H);
		ctx.drawImage(imgNight, 0, 0, W, H);
		const nightIm = ctx.getImageData(0, 0, W, H);
		const dd = darkIm.data;
		const nd = nightIm.data;
		const out = ctx.createImageData(W, H);
		const o = out.data;
		for (let y = 0; y < H; y++) {
			for (let x = 0; x < W; x++) {
				const i = (y * W + x) * 4;
				const dr = dd[i];
				const dg = dd[i + 1];
				const db = dd[i + 2];
				const lumDark = (0.299 * dr + 0.587 * dg + 0.114 * db) / 255;
				const nr = nd[i];
				const ng = nd[i + 1];
				const nb = nd[i + 2];
				const lumNight = (0.299 * nr + 0.587 * ng + 0.114 * nb) / 255;
				const landW = 1 - smoothStep(0.07, 0.12, lumDark);
				/* Smooth land base — no noise tiling (reads as “chex” on a sphere) */
				let lr = 6;
				let lg = 38;
				let lb = 116;
				if (lumNight > 0.1) {
					const k = Math.min(1, (lumNight - 0.1) / 0.5);
					const tr = 195 + 60 * k;
					const tg = 250;
					const tb = 255;
					lr += (tr - lr) * k;
					lg += (tg - lg) * k;
					lb += (tb - lb) * k;
				}
				const or = lumDark * 44;
				const og = 10 + lumDark * 34;
				const ob = 40 + lumDark * 98;
				const coast = smoothStep(0.072, 0.096, lumDark) * (1 - smoothStep(0.096, 0.14, lumDark));
				let R = or * (1 - landW) + lr * landW;
				let G = og * (1 - landW) + lg * landW;
				let B = ob * (1 - landW) + lb * landW;
				R += coast * 88;
				G += coast * 205;
				B += coast * 238;
				o[i] = clamp255(R);
				o[i + 1] = clamp255(G);
				o[i + 2] = clamp255(B);
				o[i + 3] = 255;
			}
		}
		ctx.putImageData(out, 0, 0);
		/* PNG avoids JPEG 8×8 macro-blocks that look like a checker on curved surfaces */
		const url = canvas.toDataURL('image/png');
		try {
			sessionStorage.setItem(cacheKey, url);
		} catch {
			/* quota / private mode — skip cache */
		}
		return url;
	}

	function buildDigitalNetworkPoints(count) {
		const regions = [
			{ lat: [-55, 72], lng: [-130, -30] },
			{ lat: [-38, 38], lng: [-25, 55] },
			{ lat: [-12, 55], lng: [70, 180] },
			{ lat: [-12, 55], lng: [-180, -95] },
			{ lat: [-48, -8], lng: [110, 155] },
			{ lat: [25, 72], lng: [-180, -130] },
			{ lat: [-35, 35], lng: [95, 140] },
		];
		/* Small highlights on land — texture carries continent shapes; dots = network layer */
		const colors = ['#ffffff', '#e8fdff', '#4df0f0', '#18e0eb', '#b8f6ff'];
		const rand = (a, b) => a + Math.random() * (b - a);
		const pts = [];
		for (let i = 0; i < count; i++) {
			const landBias = Math.random() < 0.92;
			let lat;
			let lng;
			if (landBias) {
				const r = regions[Math.floor(Math.random() * regions.length)];
				lat = rand(r.lat[0], r.lat[1]);
				lng = rand(r.lng[0], r.lng[1]);
			} else {
				lat = rand(-80, 80);
				lng = rand(-180, 180);
			}
			pts.push({
				lat,
				lng,
				size: 0.0016 + Math.random() * 0.005,
				r: 0.022 + Math.random() * 0.045,
				color: colors[Math.floor(Math.random() * colors.length)],
			});
		}
		return pts;
	}

	const globeRoot = document.querySelector('[data-world-globe]');
	if (globeRoot) {
		const points = JSON.parse(globeRoot.getAttribute('data-points') ?? '[]');
		Promise.all([import('globe.gl'), import('three')]).then(async ([{ default: Globe }, THREE]) => {
			const globe = Globe({
				animateIn: false,
				waitForGlobeReady: true
			})(globeRoot);

			const earthDark = 'https://unpkg.com/three-globe/example/img/earth-dark.jpg';
			const earthNight = 'https://unpkg.com/three-globe/example/img/earth-night.jpg';

			let globeMapUrl = earthDark;
			try {
				globeMapUrl = await createDigitalGlobeMapDataUrl(earthDark, earthNight);
			} catch {
				globeMapUrl = earthDark;
			}

			const networkDots = buildDigitalNetworkPoints(2000);

			globe
				.backgroundColor('rgba(0,0,0,0)')
				.width(globeRoot.clientWidth)
				.height(globeRoot.clientHeight)
				.globeImageUrl(globeMapUrl)
				.showGraticules(false)
				.showAtmosphere(true)
				.atmosphereColor('#4df0f0')
				.atmosphereAltitude(0.2)
				.pointsData(networkDots)
				.pointLat('lat')
				.pointLng('lng')
				.pointAltitude('size')
				.pointColor('color')
				.pointRadius('r')
				.pointResolution(14)
				.pointsMerge(false)
				.htmlElementsData(points)
				.htmlLat((d) => d.lat)
				.htmlLng((d) => d.lng)
				.htmlAltitude(() => 0.012)
				.htmlElement((d) => {
					const root = document.createElement('div');
					const shape = d.shape === 'squircle' ? 'squircle' : 'circle';
					root.className = `ysa-world__marker ysa-world__marker--${shape}`;
					const markerSize = Number(d.size) || 40;
					root.style.width = `${markerSize}px`;
					root.style.height = `${markerSize}px`;

					const glow = document.createElement('span');
					glow.className = 'ysa-world__marker-glow';
					glow.setAttribute('aria-hidden', 'true');

					const inner = document.createElement('div');
					inner.className = 'ysa-world__marker-inner';

					const img = document.createElement('img');
					img.src = d.face;
					img.alt = '';
					img.className = 'ysa-world__marker-img';
					img.loading = 'lazy';
					inner.append(img);
					root.append(glow, inner);
					return root;
				});

			const networkArcs = [];
			const maxArcs = 200;
			let tries = 0;
			while (networkArcs.length < maxArcs && tries < 12000) {
				tries++;
				const a = networkDots[Math.floor(Math.random() * networkDots.length)];
				const b = networkDots[Math.floor(Math.random() * networkDots.length)];
				const dLat = Math.abs(a.lat - b.lat);
				const dLng = Math.abs(a.lng - b.lng);
				const span = dLat + dLng;
				if (dLat < 40 && dLng < 100 && span > 6 && span < 58) {
					networkArcs.push({
						startLat: a.lat,
						startLng: a.lng,
						endLat: b.lat,
						endLng: b.lng,
					});
				}
			}
			globe
				.arcsData(networkArcs)
				.arcColor(() => 'rgba(77,240,240,0.38)')
				.arcStroke(0.14)
				.arcAltitude(0.085)
				.arcDashLength(0.2)
				.arcDashGap(0.16)
				.arcDashAnimateTime(11000);

			const controls = globe.controls();
			controls.enableZoom = false;
			controls.enablePan = false;
			controls.enableRotate = true;
			controls.autoRotate = false;
			controls.rotateSpeed = 0.7;
			controls.enableDamping = true;
			controls.dampingFactor = 0.08;

			globe.pointOfView({ lat: 12, lng: 12, altitude: 1.2 }, 0);

			/* Glossy digital sphere — map already carries cyan mesh; keep tint neutral */
			const mat = globe.globeMaterial();
			if (mat) {
				mat.color = new THREE.Color(0xffffff);
				mat.emissive = new THREE.Color(0x041028);
				mat.emissiveIntensity = 0.07;
				if ('bumpScale' in mat && typeof mat.bumpScale === 'number') {
					mat.bumpScale = 0;
				}
				if ('shininess' in mat && typeof mat.shininess === 'number') {
					mat.shininess = 68;
				}
				if ('metalness' in mat && typeof mat.metalness === 'number') {
					mat.metalness = 0.12;
				}
				if ('roughness' in mat && typeof mat.roughness === 'number') {
					mat.roughness = 0.32;
				}
			}
			for (const light of globe.lights()) {
				if (light.type === 'AmbientLight') {
					light.color = new THREE.Color('#2a5088');
					light.intensity = 0.62;
				}
				if (light.type === 'DirectionalLight') {
					light.color = new THREE.Color('#f2fbff');
					light.intensity = 1.05;
					light.position.set(1.25, 0.9, 0.65);
				}
			}
			const scene = globe.scene();
			const hemiName = 'ysa-world-globe-hemi';
			let hemi = scene.getObjectByName(hemiName);
			if (!hemi) {
				hemi = new THREE.HemisphereLight(0x7eedf5, 0x000814, 0.32);
				hemi.name = hemiName;
				scene.add(hemi);
			} else if (hemi.isHemisphereLight) {
				hemi.color.set(0x7eedf5);
				hemi.groundColor.set(0x000814);
				hemi.intensity = 0.32;
			}

			const onPointerDown = () => {
				globeRoot.classList.add('is-dragging');
			};
			const onPointerUp = () => {
				globeRoot.classList.remove('is-dragging');
			};

			globeRoot.addEventListener('pointerdown', onPointerDown);
			window.addEventListener('pointerup', onPointerUp);

			const onResize = () => {
				globe.width(globeRoot.clientWidth);
				globe.height(globeRoot.clientHeight);
			};

			window.addEventListener('resize', onResize);
		});
	}

	function setupWorldStatCounters() {
		const section = document.querySelector('.ysa-world');
		if (!section) return;
		const els = section.querySelectorAll('[data-stat-count]');
		if (!els.length) return;

		const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function formatCount(n) {
			return Math.round(n).toLocaleString('en-US');
		}

		function runCountUp() {
			els.forEach((el) => {
				const target = Number(el.getAttribute('data-stat-target'));
				const suffix = el.getAttribute('data-stat-suffix') || '';
				if (!Number.isFinite(target) || target < 0) return;

				if (reduceMotion) {
					el.textContent = formatCount(target) + suffix;
					el.closest('.ysa-world__stat')?.classList.add('ysa-world__stat--counted');
					return;
				}

				const start = performance.now();
				const duration = 2200;
				function tick(now) {
					const t = Math.min(1, (now - start) / duration);
					const eased = 1 - Math.pow(1 - t, 3);
					const v = Math.round(eased * target);
					el.textContent = formatCount(v) + suffix;
					if (t < 1) {
						requestAnimationFrame(tick);
					} else {
						el.closest('.ysa-world__stat')?.classList.add('ysa-world__stat--counted');
					}
				}
				requestAnimationFrame(tick);
			});
		}

		if (reduceMotion) {
			runCountUp();
			return;
		}

		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						runCountUp();
						io.disconnect();
					}
				});
			},
			{ threshold: 0.2, rootMargin: '0px 0px -8% 0px' }
		);
		io.observe(section);
	}

	setupWorldStatCounters();
</script>
