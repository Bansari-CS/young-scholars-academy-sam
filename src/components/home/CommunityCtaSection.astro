---
import { homePageSectionsData } from '../../data/homePageSections';

const d = homePageSectionsData.communityCta;
---

<section class="px-4 py-16 md:px-8 md:py-20" aria-labelledby="cta-heading">
	<div class="relative mx-auto w-full max-w-[1152px] overflow-hidden rounded-[32px] bg-gradient-to-r from-[#7c3aed] via-[#4d67ef] to-[#0a9dfb] px-6 py-14 text-center text-white md:px-12 md:py-20">
		<div class="pointer-events-none absolute right-0 top-0 h-96 w-96 rounded-full bg-[rgba(34,211,238,0.5)] blur-[32px] opacity-20"></div>
		<div class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[rgba(255,255,255,0.5)] blur-[32px] opacity-20"></div>

		<div class="relative mx-auto max-w-[740px]">
			<h2 class="font-[var(--ysa-font-display)] text-[34px] font-bold leading-tight md:text-[44px]" id="cta-heading">
				{d.title}
			</h2>
			<p class="mx-auto mt-4 max-w-[640px] text-base leading-7 text-[#e0e9ff] md:text-[17px]">
				{d.description}
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
				<a
					class="inline-flex items-center gap-2 rounded-xl bg-white px-7 py-3.5 text-sm font-semibold capitalize text-[#0a9dfb] shadow-[0px_10px_15px_-3px_rgba(0,0,0,0.1),0px_4px_6px_-4px_rgba(0,0,0,0.1)]"
					href={d.primaryCta.href}
				>
					{d.primaryCta.label}
					<span aria-hidden="true">→</span>
				</a>
				<a
					class="inline-flex items-center rounded-xl border border-[rgba(255,255,255,0.3)] bg-[rgba(255,255,255,0.1)] px-7 py-3.5 text-sm font-semibold capitalize text-white backdrop-blur-sm"
					href={d.secondaryCta.href}
				>
					{d.secondaryCta.label}
				</a>
			</div>
		</div>
	</div>
</section>
