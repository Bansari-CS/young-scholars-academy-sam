---
import GradientCtaSection from '../common/GradientCtaSection.astro';
import arrowRightIcon from '../../assets/common/icon-arrow-right-violet.svg';

interface Props {
	content: {
		title: string;
		description: string;
		primaryCta: { label: string; href: string };
		secondaryCta: { label: string; href: string };
		secondaryLeadingIcon?: string;
		trustPoints: Array<{ icon: string; label: string }>;
	};
}

const { content: d } = Astro.props;
---

<GradientCtaSection
	title={d.title}
	description={d.description}
	primaryCta={d.primaryCta}
	primaryTrailingIcon={arrowRightIcon.src}
	secondaryCta={d.secondaryCta}
	secondaryLeadingIcon={d.secondaryLeadingIcon ?? '🗓'}
	fullWidth={true}
	trustPoints={d.trustPoints}
/>
