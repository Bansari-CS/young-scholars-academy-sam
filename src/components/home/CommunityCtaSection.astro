---
import { homePageSectionsData } from '../../data/homePageSections';
import GradientCtaSection from '../common/GradientCtaSection.astro';
import arrowRightIcon from '../../assets/common/icon-arrow-right-violet.svg';

const d = homePageSectionsData.communityCta;
---

<GradientCtaSection
	title={d.title}
	description={d.description}
	primaryCta={d.primaryCta}
	primaryTrailingIcon={arrowRightIcon.src}
	secondaryCta={d.secondaryCta}
	secondaryLeadingIcon="🗓"
	fullWidth={true}
	trustPoints={[
		{ icon: '☺', label: '100% Satisfaction Guarantee' },
		{ icon: '💳', label: 'No Credit Card Required' },
		{ icon: '◔', label: 'Start Within 48 Hours' },
	]}
/>
