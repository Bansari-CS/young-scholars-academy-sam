---
import '../../styles/components/learner-needs-section.css';

const cardSadPathD =
	'M12 24C18.623 24 24 18.623 24 12C24 5.37702 18.623 0 12 0C5.37702 0 0 5.37702 0 12C0 18.623 5.37702 24 12 24ZM7.46719 18.2203C7.34531 18.6141 6.92344 18.8391 6.52969 18.7125S5.91094 18.1687 6.0375 17.775C6.80625 15.2859 9.20156 13.5 12 13.5C14.7984 13.5 17.1938 15.2859 17.9672 17.7797C18.0891 18.1734 17.8687 18.5953 17.475 18.7172S16.6594 18.6187 16.5375 18.225C15.9609 16.3781 14.1609 15 12 15C9.83906 15 8.03906 16.3781 7.46719 18.2203ZM6.76875 9.75C6.76875 8.92213 7.44088 8.25 8.26875 8.25C9.09662 8.25 9.76875 8.92213 9.76875 9.75C9.76875 10.5779 9.09662 11.25 8.26875 11.25C7.44088 11.25 6.76875 10.5779 6.76875 9.75ZM15.7688 8.25C16.5966 8.25 17.2687 8.92213 17.2687 9.75C17.2687 10.5779 16.5966 11.25 15.7688 11.25C14.9409 11.25 14.2688 10.5779 14.2688 9.75C14.2688 8.92213 14.9409 8.25 15.7688 8.25Z';

const cardGroupPathD =
	'M1.81901 0.239326C1.33151 -0.145049 0.623701 -0.0559865 0.239326 0.431513C-0.145049 0.919014 -0.0559865 1.62683 0.431513 2.0112L28.1815 23.7612C28.669 24.1456 29.3768 24.0565 29.7612 23.569C30.1456 23.0815 30.0565 22.3737 29.569 21.9893L20.6534 15.0003H29.0018C29.555 15.0003 30.0003 14.5503 30.0003 14.0018C30.0003 11.2409 27.7596 9.00026 24.9987 9.00026H23.0018C22.2565 9.00026 21.5487 9.16433 20.9112 9.45495C20.9721 9.79245 21.0003 10.144 21.0003 10.5003C21.0003 11.9159 20.5081 13.219 19.6878 14.2456L18.5065 13.3221C19.13 12.5487 19.5003 11.569 19.5003 10.5003C19.5003 8.01589 17.4846 6.00026 15.0003 6.00026C13.5425 6.00026 12.2487 6.69401 11.4237 7.76745L9.52058 6.27683C10.13 5.6112 10.5003 4.72526 10.5003 3.75026C10.5003 1.67839 8.82214 0.000263487 6.75026 0.000263487C5.45183 0.000263487 4.30808 0.661201 3.63308 1.66433L1.81901 0.239326ZM5.00183 9.00026C2.24089 9.00026 0.000263487 11.2409 0.000263487 14.0018C0.000263487 14.5503 0.450264 15.0003 0.998701 15.0003H11.0018C11.0112 15.0003 11.0206 15.0003 11.0346 15.0003C10.069 14.1471 9.38464 12.994 9.12214 11.6815L5.70964 9.00026H5.00183ZM12.2487 16.5003C8.7987 16.5003 6.00026 19.2987 6.00026 22.7487C6.00026 23.4378 6.55808 24.0003 7.25183 24.0003H22.7487C23.2409 24.0003 23.6628 23.719 23.869 23.3065L15.23 16.5003H12.2487ZM24.0003 7.50026C26.0699 7.50026 27.7503 5.81994 27.7503 3.75026C27.7503 1.68058 26.0699 0.000263487 24.0003 0.000263487C21.9306 0.000263487 20.2503 1.68058 20.2503 3.75026C20.2503 5.81994 21.9306 7.50026 24.0003 7.50026Z';

const cardCheckPathD =
	'M8 16C12.4153 16 16 12.4153 16 8C16 3.58468 12.4153 0 8 0C3.58468 0 0 3.58468 0 8C0 12.4153 3.58468 16 8 16ZM11.5312 6.53125L7.53125 10.5312C7.2375 10.825 6.7625 10.825 6.47188 10.5312L4.47188 8.53125C4.17813 8.2375 4.17813 7.7625 4.47188 7.47188S5.24062 7.17813 5.53125 7.47188L7 8.94063L10.4688 5.46875C10.7625 5.175 11.2375 5.175 11.5281 5.46875S11.8219 6.2375 11.5281 6.52812L11.5312 6.53125Z';

const cardAlonePathD =
	'M26.9906 11.9766C26.9906 12.8203 26.2875 13.4812 25.4906 13.4812H23.9906L24.0234 20.9906C24.0328 22.6547 22.6875 24.0047 21.0234 24.0047H15.3L13.5 21L17.2875 17.8453C17.6531 17.5406 17.6437 16.9734 17.2687 16.6781L11.7469 12.3375C11.0625 11.7984 10.1625 12.6656 10.6781 13.3687L13.5 17.25L9.49219 20.5875C9.20625 20.8219 9.14062 21.2344 9.32812 21.5484L10.8 24H6.00469C4.35 24 3.00469 22.6547 3.00469 21V13.4812H1.5C0.65625 13.4812 0 12.825 0 11.9766C0 11.5547 0.140625 11.1797 0.46875 10.8516L12.4875 0.375C12.8156 0.046875 13.1906 0 13.5188 0C13.8469 0 14.2219 0.09375 14.5031 0.328125L19.5 4.72031V3C19.5 2.17031 20.1703 1.5 21 1.5H22.5C23.3297 1.5 24 2.17031 24 3V8.67188L26.475 10.8469C26.85 11.175 27.0375 11.55 26.9906 11.9719V11.9766Z';
interface Props {
	content: {
		badgeText: string;
		title: string;
		description: string;
		cards: Array<{
			title: string;
			description: string;
			highlight: string;
			icon: string;
		}>;
	};
	processContent: {
		badge: string;
		title: string;
		description: string;
		steps: Array<{
			step: string;
			title: string;
			desc: string;
			footer: string;
			color: string;
		}>;
		buttonText: string;
		note: string;
	};
}

const { content, processContent } = Astro.props;

---

<section class="learner-section bg-[#f8fafc] py-[clamp(2.25rem,5vw,6rem)] pb-0">
	<div class="learner-container mx-auto max-w-[var(--ysa-max)] px-[clamp(1rem,4.44vw,4rem)]">
		
		<div class="learner-heading m-0  text-center">
			
			<span class="inline-flex items-center justify-center rounded-[999px] bg-[#EDE9FE] px-[1rem] py-[0.5rem] text-[12px] font-bold uppercase tracking-[0.06em] text-[#7C3AED]">
				{content.badgeText}
			</span>

			<h2 class="m-[1rem_0_1.5rem] text-[clamp(2rem,4vw,2.75rem)] font-bold leading-[1.15] tracking-[-0.02em] text-[#0F172A]">
				{content.title}
			</h2>

			<p class="mx-auto my-0 max-w-[672px] text-[clamp(1rem,1.9vw,1rem)] leading-[1.65] text-[#64748B] max-sm:text-[0.98rem]">
				{content.description}
			</p>
		</div>

		<div class="learner-cards mt-[clamp(2rem,4vw,4rem)] grid grid-cols-3 gap-8 max-lg:grid-cols-1">
			{
				content.cards.map((card) => (
					<article class="learner-card rounded-[1.25rem] border border-[#E2E8F0] bg-white px-[2.063rem] py-[2.063rem] shadow-[0_1px_2px_rgba(15,23,42,0.04),0_10px_26px_-20px_rgba(15,23,42,0.2)] transition-[border-color,box-shadow] duration-200 ease-in hover:border-[#CBD5E1] hover:shadow-[0_12px_34px_-26px_rgba(15,23,42,0.28)]">
						
						<div
							class:list={[
								"card-icon-slot flex h-14 w-14 shrink-0 items-center justify-center rounded-[0.75rem]",
								card.icon === "stress"
									? "bg-[linear-gradient(145deg,#F5F3FF,#EDE9FE)]"
									: card.icon === "group"
										? "bg-[linear-gradient(145deg,#FEFCE8,#FEF9C3)]"
										: "bg-[linear-gradient(145deg,#E0F2FE,#BAE6FD)]",
							]}
							aria-hidden="true"
						>
							{card.icon === 'stress' ? (
								<svg class="block h-auto max-h-[1.45rem] w-[1.45rem]" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d={cardSadPathD} fill="#7C3AED" />
								</svg>
							) : card.icon === 'group' ? (
								<svg class="block h-auto max-h-[1.45rem] w-[1.75rem]" width="30" height="24" viewBox="0 0 30 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d={cardGroupPathD} fill="#F2DD35" />
								</svg>
							) : (
								<svg class="block h-auto max-h-[1.45rem] w-[1.75rem]" width="27" height="24" viewBox="0 0 27 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d={cardAlonePathD} fill="#0EA5E9" />
								</svg>
							)}
						</div>

						<h3 class="m-[1.5rem_0_0.75rem] text-[clamp(1rem,2.2vw,1.063rem)] font-semibold leading-[1.3] tracking-[-0.015em] text-[#0F172A]">
							{card.title}
						</h3>

						<p class="m-0 text-[1rem] leading-[26px] text-[#475569]">
							{card.description}
						</p>

						<div class="card-divider mt-6 h-px bg-[#EEF2F7]"></div>

						<div class="card-highlight mt-6 flex items-start gap-[0.65rem]">
							
							<span class="card-check mt-[0.1rem] flex h-[1.05rem] w-[1.05rem] shrink-0 items-center justify-center" aria-hidden="true">
								<svg class="block h-auto w-full" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d={cardCheckPathD} fill="#048C3C" />
								</svg>
							</span>

							<strong class="text-[0.875rem] font-medium leading-[1.45] text-[#0F172A]">
								{card.highlight}
							</strong>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<section class=" py-[clamp(72px,8.5vw,96px)] bg-[#f8fafc] pb-[80px]">
  <div class="max-w-[var(--ysa-max)] mx-auto px-[clamp(16px,4.44vw,64px)]">
    
    <header class="text-center mb-[clamp(32px,4vw,56px)]">
      <span class="inline-flex items-center justify-center bg-[#E1F3FF] text-[var(--ysa-primary)] px-[16px] py-[8px] rounded-[999px] text-[12px] font-[700] uppercase tracking-[0.06em]">{processContent.badge}</span>
      <h2 class="mt-[20px] mb-[16px] text-[clamp(32px,4vw,44px)] leading-[1.15] tracking-[-0.02em] text-[#0f172a] font-[700]">{processContent.title}</h2>
      <p class="mx-auto max-w-[549px] text-[#475569] text-[16px] leading-[26px]" set:html={processContent.description}></p>
    </header>

    <div class="flex items-stretch justify-center gap-[24px] flex-wrap md:flex-nowrap max-w-[1376px]">
      {processContent.steps.map((step, index) => (
        <>
          {/* CARD */}
          <article class={`process-card process-card--${step.color}`}>
            
            <div class="process-card__number">{step.step}</div>
            
            <div class={`process-card__icon process-card__icon--${step.color}`} aria-hidden="true">
              {step.step === '01' ? (
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M6.44141 0.961818C6.14062 0.235256 5.34766 -0.151463 4.58984 0.0555683L1.15234 0.993068C0.472656 1.18057 0 1.79776 0 2.50088C0 12.1649 7.83594 20.0009 17.5 20.0009C18.2031 20.0009 18.8203 19.5282 19.0078 18.8485L19.9453 15.411C20.1523 14.6532 19.7656 13.8603 19.0391 13.5595L15.2891 11.997C14.6523 11.7313 13.9141 11.9149 13.4805 12.4501L11.9023 14.3759C9.15234 13.0751 6.92578 10.8485 5.625 8.09854L7.55078 6.52432C8.08594 6.08682 8.26953 5.35244 8.00391 4.71572L6.44141 0.965725V0.961818Z" fill="white"/>
</svg>

              ) : step.step === '02' ? (
               <svg width="15" height="20" viewBox="0 0 15 20" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M7.5 0C5.86719 0 4.47656 1.04297 3.96484 2.5H2.5C1.12109 2.5 0 3.62109 0 5V17.5C0 18.8789 1.12109 20 2.5 20H12.5C13.8789 20 15 18.8789 15 17.5V5C15 3.62109 13.8789 2.5 12.5 2.5H11.0352C10.5234 1.04297 9.13281 0 7.5 0ZM7.5 2.5C7.83152 2.5 8.14946 2.6317 8.38388 2.86612C8.6183 3.10054 8.75 3.41848 8.75 3.75C8.75 4.08152 8.6183 4.39946 8.38388 4.63388C8.14946 4.8683 7.83152 5 7.5 5C7.16848 5 6.85054 4.8683 6.61612 4.63388C6.3817 4.39946 6.25 4.08152 6.25 3.75C6.25 3.41848 6.3817 3.10054 6.61612 2.86612C6.85054 2.6317 7.16848 2.5 7.5 2.5ZM2.8125 10.625C2.8125 10.3764 2.91127 10.1379 3.08709 9.96209C3.2629 9.78627 3.50136 9.6875 3.75 9.6875C3.99864 9.6875 4.2371 9.78627 4.41291 9.96209C4.58873 10.1379 4.6875 10.3764 4.6875 10.625C4.6875 10.8736 4.58873 11.1121 4.41291 11.2879C4.2371 11.4637 3.99864 11.5625 3.75 11.5625C3.50136 11.5625 3.2629 11.4637 3.08709 11.2879C2.91127 11.1121 2.8125 10.8736 2.8125 10.625ZM6.875 10H11.875C12.2188 10 12.5 10.2812 12.5 10.625C12.5 10.9688 12.2188 11.25 11.875 11.25H6.875C6.53125 11.25 6.25 10.9688 6.25 10.625C6.25 10.2812 6.53125 10 6.875 10ZM2.8125 14.375C2.8125 14.1264 2.91127 13.8879 3.08709 13.7121C3.2629 13.5363 3.50136 13.4375 3.75 13.4375C3.99864 13.4375 4.2371 13.5363 4.41291 13.7121C4.58873 13.8879 4.6875 14.1264 4.6875 14.375C4.6875 14.6236 4.58873 14.8621 4.41291 15.0379C4.2371 15.2137 3.99864 15.3125 3.75 15.3125C3.50136 15.3125 3.2629 15.2137 3.08709 15.0379C2.91127 14.8621 2.8125 14.6236 2.8125 14.375ZM6.25 14.375C6.25 14.0312 6.53125 13.75 6.875 13.75H11.875C12.2188 13.75 12.5 14.0312 12.5 14.375C12.5 14.7188 12.2188 15 11.875 15H6.875C6.53125 15 6.25 14.7188 6.25 14.375Z" fill="white"/>
</svg>

              ) : step.step === '03' ? (
              <svg width="23" height="20" viewBox="0 0 23 20" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M15 18.5977L7.5 16.4532V1.40237L15 3.54691V18.5977ZM16.25 18.5508V3.45316L21.2148 1.46487C21.832 1.21878 22.5 1.67191 22.5 2.33597V15.4141C22.5 15.7969 22.2656 16.1407 21.9102 16.2852L16.25 18.5469V18.5508ZM0.589844 3.71487L6.25 1.45316V16.5469L1.28516 18.5352C0.667969 18.7813 0 18.3282 0 17.6641V4.58597C0 4.20316 0.234375 3.85941 0.589844 3.71487Z" fill="white"/>
</svg>

              ) : (
               <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M6.11967 15.0352L4.91264 13.8281C4.5806 13.4961 4.46342 13.0156 4.61185 12.5703C4.72904 12.2227 4.88529 11.7696 5.07279 11.25H0.939979C0.604042 11.25 0.291542 11.0703 0.123573 10.7774C-0.0443957 10.4844 -0.0404895 10.125 0.131386 9.83596L2.18217 6.37893C2.68998 5.52346 3.60795 5.00002 4.60014 5.00002H7.81498C7.90873 4.84377 8.00248 4.69924 8.09623 4.55862C11.2954 -0.160134 16.0611 -0.316384 18.9048 0.207054C19.3579 0.289085 19.7095 0.644554 19.7954 1.09768C20.3189 3.94533 20.1587 8.70705 15.4439 11.9063C15.3072 12 15.1587 12.0938 15.0025 12.1875V15.4024C15.0025 16.3946 14.479 17.3164 13.6236 17.8203L10.1665 19.8711C9.87748 20.043 9.5181 20.0469 9.22514 19.8789C8.93217 19.711 8.75248 19.4024 8.75248 19.0625V14.875C8.2017 15.0664 7.72123 15.2227 7.35795 15.3399C6.92045 15.4805 6.44389 15.3594 6.11576 15.0352H6.11967ZM15.0025 6.56252C15.4169 6.56252 15.8143 6.3979 16.1073 6.10488C16.4004 5.81185 16.565 5.41442 16.565 5.00002C16.565 4.58562 16.4004 4.18819 16.1073 3.89517C15.8143 3.60214 15.4169 3.43752 15.0025 3.43752C14.5881 3.43752 14.1907 3.60214 13.8976 3.89517C13.6046 4.18819 13.44 4.58562 13.44 5.00002C13.44 5.41442 13.6046 5.81185 13.8976 6.10488C14.1907 6.3979 14.5881 6.56252 15.0025 6.56252Z" fill="white"/>
</svg>

              )}
            </div>

            <div class="process-card__body">
              <span class={`process-card__label process-card__label--${step.color}`}>
                STEP {index + 1}
              </span>

              <h3 class="process-card__title">{step.title}</h3>
              <p class="process-card__desc">{step.desc}</p>
              
              <footer class="process-card__footer">
                <span class={`process-card__dot process-card__dot--${step.color}`}></span>
                {step.footer}
              </footer>
            </div>

          </article>

          {/* ARROW BETWEEN CARDS */}
          {index < processContent.steps.length - 1 && (
            <div class="process-arrow-connector">
              <div class="process-arrow-circle">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </div>
            </div>
          )}
        </>
      ))}
    </div>

    <div class="process-cta-wrapper">
      <button class="process-btn">
        <span class="process-btn__icon" aria-hidden="true">
       <svg width="14" height="16" viewBox="0 0 14 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M4 0C4.55312 0 5 0.446875 5 1V2H9V1C9 0.446875 9.44687 0 10 0C10.5531 0 11 0.446875 11 1V2H12.5C13.3281 2 14 2.67188 14 3.5V5H0V3.5C0 2.67188 0.671875 2 1.5 2H3V1C3 0.446875 3.44688 0 4 0ZM0 6H14V14.5C14 15.3281 13.3281 16 12.5 16H1.5C0.671875 16 0 15.3281 0 14.5V6ZM10.2812 9.53125C10.575 9.2375 10.575 8.7625 10.2812 8.47188C9.9875 8.18125 9.5125 8.17813 9.22188 8.47188L6.25313 11.4406L4.78438 9.97188C4.49063 9.67813 4.01562 9.67813 3.725 9.97188C3.43437 10.2656 3.43125 10.7406 3.725 11.0312L5.725 13.0312C6.01875 13.325 6.49375 13.325 6.78438 13.0312L10.2812 9.53125Z" fill="white"/>
</svg>


        </span>
        <span>{processContent.buttonText}</span>
      </button>
      <p class="process-cta-note">
        {processContent.note}
      </p>
    </div>

  </div>
</section>