---

<section class="learner-section">
	<div class="learner-container">
		<div class="learner-heading">
			<span>{learnerSectionData.badgeText}</span>
			<h2>{learnerSectionData.title}</h2>
			<p>{learnerSectionData.description}</p>
		</div>

		<div class="learner-cards">
			{
				learnerSectionData.cards.map((card) => (
					<article class="learner-card">
						<div class:list={['card-icon-slot', `card-icon-slot--${card.icon}`]} aria-hidden="true">
							{card.icon === 'stress' ? (
								<svg class="card-icon-svg" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d={cardSadPathD} fill="#7C3AED" />
								</svg>
							) : card.icon === 'group' ? (
								<svg class="card-icon-svg card-icon-svg-wide" width="30" height="24" viewBox="0 0 30 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d={cardGroupPathD} fill="#F2DD35" />
								</svg>
							) : (
								<svg class="card-icon-svg card-icon-svg-wide" width="27" height="24" viewBox="0 0 27 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d={cardAlonePathD} fill="#0EA5E9" />
								</svg>
							)}
						</div>
						<h3>{card.title}</h3>
						<p>{card.description}</p>
						<div class="card-divider"></div>
						<div class="card-highlight">
							<span class="card-check" aria-hidden="true">
								<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d={cardCheckPathD} fill="#048C3C" />
								</svg>
							</span>
							<strong>{card.highlight}</strong>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
