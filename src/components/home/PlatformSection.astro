---
import type { PlatformFeatureIcon } from '../../types/homePage';

interface Props {
	content: {
		eyebrow: string;
		title: string;
		description: string;
		tablistAriaLabel?: string;
		features: Array<{ icon: PlatformFeatureIcon; title: string; description: string }>;
	};
}

const { content: d } = Astro.props;

/** Static previews — paths under public/assets/images */
const previewByIcon: Record<PlatformFeatureIcon, { src: string }> = {
	live: { src: '/assets/images/platform-tab-live.png' },
	ai: {
		src: '/assets/images/animated coding blocks and colorful programming interface for kids, playful GIF animation.png',
	},
	parent: {
		src: '/assets/images/animated math equations and geometric shapes floating and transforming, educational GIF.png',
	},
	game: {
		src: '/assets/images/animated puzzle pieces connecting and brain neurons lighting up, critical thinking GIF.png',
	},
};

const iconWrapBg: Record<PlatformFeatureIcon, string> = {
	live: 'bg-[#0a9dfb]',
	ai: 'bg-[#7c3aed]',
	parent: 'bg-[#eab308]',
	game: 'bg-[#22c55e]',
};

const tabButtonClasses =
	'm-0 grid w-full cursor-pointer appearance-none grid-cols-[auto_1fr] items-start gap-4 rounded-[0.875rem] border border-[#d9e2ee] bg-white p-7 text-left font-inherit text-inherit shadow-[0_1px_2px_rgba(15,23,42,0.03),0_5px_12px_-10px_rgba(15,23,42,0.2)] transition-[box-shadow,border-color,transform] duration-200 ease-out hover:border-slate-200 hover:shadow-[0_8px_22px_-8px_rgba(15,23,42,0.1)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0a9dfb] aria-selected:border-[#d2dbe7] aria-selected:shadow-[0_2px_6px_rgba(15,23,42,0.05),0_12px_28px_-20px_rgba(87,81,228,0.24)] max-sm:gap-[0.85rem] max-sm:px-[0.85rem] max-sm:py-[0.9rem]';
---

<section
	class="bg-white py-24 max-sm:py-[clamp(3.5rem,10vw,6rem)]"
	aria-labelledby="platform-heading"
	data-platform-tabs
>
	<div class="mx-auto max-w-[var(--ysa-max)] px-[clamp(1rem,4.44vw,4rem)]">
		<header class="mx-auto max-w-3xl text-center">
			<p
				class="mb-4 inline-flex items-center justify-center rounded-full bg-[#e1f3ff] px-4 py-2 font-display text-xs font-bold tracking-[0.01875rem] text-[#0a9dfb] uppercase"
			>
				{d.eyebrow}
			</p>
			<h2
				class="m-0 font-display text-[clamp(2rem,4vw,2.75rem)] font-bold tracking-[-0.02em] text-[#111827] leading-tight"
				id="platform-heading"
			>
				{d.title}
			</h2>
			<p class="mx-auto mt-6 mb-0 max-w-[43.813rem] text-base leading-[1.625rem] text-[#475569]">
				{d.description}
			</p>
		</header>

		<div
			class="mx-auto mt-16 grid w-full max-w-[82rem] grid-cols-2 items-stretch gap-[clamp(1.75rem,3.8vw,3rem)] max-[900px]:mt-12 max-[900px]:grid-cols-1 max-[900px]:gap-8"
		>
			<div
				class="col-start-2 row-start-1 min-w-0 max-[900px]:col-start-1 max-[900px]:row-start-1"
				role="presentation"
			>
				<div
					class="flex h-full rounded-[1.2rem] border border-[#d8deea] bg-white p-[0.85rem] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)]"
				>
					<div
						class="relative aspect-square w-full flex-1 overflow-hidden rounded-[0.82rem] max-[900px]:aspect-[16/10.5]"
					>
						{
							d.features.map((feature, index) => {
								const preview = previewByIcon[feature.icon];
								const slideId = `platform-slide-${index}`;
								return (
									<div
										class:list={[
											'absolute inset-0 flex items-center justify-center opacity-0 invisible pointer-events-none transition-[opacity,visibility] duration-[280ms] ease-out [&.is-active]:pointer-events-auto [&.is-active]:visible [&.is-active]:opacity-100',
											{ 'is-active': index === 0 },
										]}
										id={slideId}
										data-platform-slide
										role="tabpanel"
										aria-labelledby={`platform-tab-${index}`}
										aria-hidden={index === 0 ? 'false' : 'true'}
									>
										<img
											src={preview.src}
											alt={`${feature.title} — platform preview`}
											class="block h-full w-full object-cover"
											loading={index === 0 ? 'eager' : 'lazy'}
										/>
									</div>
								);
							})
						}
					</div>
				</div>
			</div>

			<div
				class="col-start-1 row-start-1 grid h-full min-w-0 grid-rows-4 gap-6 max-[900px]:col-start-1 max-[900px]:row-start-2 max-[900px]:flex max-[900px]:h-auto max-[900px]:flex-col"
				role="tablist"
				aria-label={d.tablistAriaLabel ?? 'Platform highlights'}
			>
				{
					d.features.map((feature, index) => (
						<button
							type="button"
							class={tabButtonClasses}
							id={`platform-tab-${index}`}
							role="tab"
							aria-selected={index === 0 ? 'true' : 'false'}
							aria-controls={`platform-slide-${index}`}
							data-platform-tab
							tabindex={index === 0 ? 0 : -1}
						>
							<span
								class:list={[
									'mt-[0.06rem] flex size-12 shrink-0 items-center justify-center rounded-lg text-white',
									iconWrapBg[feature.icon],
								]}
								aria-hidden="true"
							>
								{feature.icon === 'live' && (
									<svg class="block size-[1.35rem]" width="23" height="15" viewBox="0 0 23 15" fill="none" aria-hidden="true">
										<path
											d="M0 2.5C0 1.12109 1.12109 0 2.5 0H12.5C13.8789 0 15 1.12109 15 2.5V12.5C15 13.8789 13.8789 15 12.5 15H2.5C1.12109 15 0 13.8789 0 12.5V2.5ZM21.8398 1.39844C22.2461 1.61719 22.5 2.03906 22.5 2.5V12.5C22.5 12.9609 22.2461 13.3828 21.8398 13.6016C21.4336 13.7969 20.9414 13.7969 20.5547 13.5391L16.8047 11.0391L16.25 10.668V10V5V4.33203L16.8047 3.96094L20.5547 1.46094C20.9375 1.20703 21.4297 1.17969 21.8398 1.39844Z"
											fill="white"
										/>
									</svg>
								)}
								{feature.icon === 'ai' && (
									<svg class="block size-[1.35rem]" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
										<path
											d="M7.1875 0C8.39453 0 9.375 0.980469 9.375 2.1875V17.8125C9.375 19.0195 8.39453 20 7.1875 20C6.05859 20 5.12891 19.1445 5.01172 18.043C4.80859 18.0977 4.59375 18.125 4.375 18.125C2.99609 18.125 1.875 17.0039 1.875 15.625C1.875 15.3359 1.92578 15.0547 2.01562 14.7969C0.835938 14.3516 0 13.2109 0 11.875C0 10.6289 0.730469 9.55078 1.78906 9.05078C1.44922 8.625 1.25 8.08594 1.25 7.5C1.25 6.30078 2.09375 5.30078 3.21875 5.05469C3.15625 4.83984 3.125 4.60938 3.125 4.375C3.125 3.20703 3.92969 2.22266 5.01172 1.94922C5.12891 0.855469 6.05859 0 7.1875 0ZM12.8125 0C13.9414 0 14.8672 0.855469 14.9883 1.94922C16.0742 2.22266 16.875 3.20312 16.875 4.375C16.875 4.60938 16.8438 4.83984 16.7812 5.05469C17.9062 5.29688 18.75 6.30078 18.75 7.5C18.75 8.08594 18.5508 8.625 18.2109 9.05078C19.2695 9.55078 20 10.6289 20 11.875C20 13.2109 19.1641 14.3516 17.9844 14.7969C18.0742 15.0547 18.125 15.3359 18.125 15.625C18.125 17.0039 17.0039 18.125 15.625 18.125C15.4062 18.125 15.1914 18.0977 14.9883 18.043C14.8711 19.1445 13.9414 20 12.8125 20C11.6055 20 10.625 19.0195 10.625 17.8125V2.1875C10.625 0.980469 11.6055 0 12.8125 0Z"
											fill="white"
										/>
									</svg>
								)}
								{feature.icon === 'parent' && (
									<svg class="block size-[1.35rem]" width="23" height="20" viewBox="0 0 23 20" fill="none" aria-hidden="true">
										<path
											d="M11.875 9.375V0.648438C11.875 0.296875 12.1484 0 12.5 0C17.332 0 21.25 3.91797 21.25 8.75C21.25 9.10156 20.9531 9.375 20.6016 9.375H11.875ZM1.25 10.625C1.25 5.88672 4.76953 1.96484 9.33594 1.33984C9.69531 1.28906 10 1.57812 10 1.94141V11.25L16.1133 17.3633C16.375 17.625 16.3555 18.0547 16.0547 18.2656C14.5234 19.3594 12.6484 20 10.625 20C5.44922 20 1.25 15.8047 1.25 10.625ZM21.8125 11.25C22.1758 11.25 22.4609 11.5547 22.4141 11.9141C22.1133 14.0977 21.0625 16.0391 19.5273 17.4727C19.293 17.6914 18.9258 17.6758 18.6992 17.4453L12.5 11.25H21.8125Z"
											fill="white"
										/>
									</svg>
								)}
								{feature.icon === 'game' && (
									<svg width="25" height="20" viewBox="0 0 25 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
										<path
											d="M7.5 2.5C3.35938 2.5 0 5.85938 0 10C0 14.1406 3.35938 17.5 7.5 17.5H17.5C21.6406 17.5 25 14.1406 25 10C25 5.85938 21.6406 2.5 17.5 2.5H7.5ZM19.375 6.5625C20.2374 6.5625 20.9375 7.26263 20.9375 8.125C20.9375 8.98737 20.2374 9.6875 19.375 9.6875C18.5126 9.6875 17.8125 8.98737 17.8125 8.125C17.8125 7.26263 18.5126 6.5625 19.375 6.5625ZM15.3125 11.875C15.3125 11.0126 16.0126 10.3125 16.875 10.3125C17.7374 10.3125 18.4375 11.0126 18.4375 11.875C18.4375 12.7374 17.7374 13.4375 16.875 13.4375C16.0126 13.4375 15.3125 12.7374 15.3125 11.875ZM6.5625 7.8125C6.5625 7.29297 6.98047 6.875 7.5 6.875C8.01953 6.875 8.4375 7.29297 8.4375 7.8125V9.0625H9.6875C10.207 9.0625 10.625 9.48047 10.625 10C10.625 10.5195 10.207 10.9375 9.6875 10.9375H8.4375V12.1875C8.4375 12.707 8.01953 13.125 7.5 13.125C6.98047 13.125 6.5625 12.707 6.5625 12.1875V10.9375H5.3125C4.79297 10.9375 4.375 10.5195 4.375 10C4.375 9.48047 4.79297 9.0625 5.3125 9.0625H6.5625V7.8125Z"
											fill="white"
										/>
									</svg>
								)}
							</span>
							<span class="flex min-w-0 flex-col gap-[0.35rem]">
								<span
									class="block font-display text-[clamp(1.2rem,1.9vw,1.063rem)] font-bold leading-[1.2] text-[#111827]"
								>
									{feature.title}
								</span>
								<span
									class="block font-[var(--ysa-font-body)] text-[clamp(0.95rem,1.3vw,0.875rem)] leading-normal font-normal text-slate-500"
								>
									{feature.description}
								</span>
							</span>
						</button>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	function setupPlatformTabs() {
		document.querySelectorAll('[data-platform-tabs]').forEach((root) => {
			const tabs = root.querySelectorAll('[data-platform-tab]');
			const slides = root.querySelectorAll('[data-platform-slide]');
			if (!tabs.length || !slides.length) return;

			const activate = (index) => {
				tabs.forEach((tab, i) => {
					const on = i === index;
					tab.setAttribute('aria-selected', on ? 'true' : 'false');
					tab.tabIndex = on ? 0 : -1;
				});
				slides.forEach((slide, i) => {
					const on = i === index;
					slide.classList.toggle('is-active', on);
					slide.setAttribute('aria-hidden', on ? 'false' : 'true');
				});
			};

			tabs.forEach((tab, i) => {
				tab.addEventListener('click', () => activate(i));
			});

			const tablist = root.querySelector('[role="tablist"]');
			tablist?.addEventListener('keydown', (e) => {
				const current = Array.from(tabs).findIndex((t) => t.getAttribute('aria-selected') === 'true');
				let next = current;
				if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
					next = Math.min(current + 1, tabs.length - 1);
				} else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
					next = Math.max(current - 1, 0);
				} else if (e.key === 'Home') {
					next = 0;
				} else if (e.key === 'End') {
					next = tabs.length - 1;
				} else {
					return;
				}
				e.preventDefault();
				activate(next);
				tabs[next]?.focus();
			});
		});
	}

	setupPlatformTabs();
</script>
