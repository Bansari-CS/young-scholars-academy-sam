---
import { homePageSectionsData } from '../../data/homePageSections';
import FaqSection from '../common/FaqSection.astro';

const d = homePageSectionsData.faq;
const faqItems = d.items.map((item, index) => ({
	question: item.question,
	answer: item.answer,
	open: index === 0,
}));
---

<FaqSection
	eyebrow={d.eyebrow}
	title={d.title}
	description={d.description}
	items={faqItems}
	sectionClass="bg-[#f8fafc] px-6 py-20"
	containerClass="mx-auto w-full max-w-[896px]"
/>
