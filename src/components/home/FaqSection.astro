---
import FaqSection from '../common/FaqSection.astro';

interface Props {
	content: {
		eyebrow: string;
		title: string;
		description: string;
		items: Array<{ question: string; answer: string }>;
	};
}

const { content: d } = Astro.props;
const faqItems = d.items.map((item, index) => ({
	question: item.question,
	answer: item.answer,
	open: index === 0,
}));
---

<FaqSection
	eyebrow={d.eyebrow}
	title={d.title}
	description={d.description}
	items={faqItems}
	sectionClass="bg-[#f8fafc] px-6 pb-[clamp(3rem,8vw,6rem)]"
	containerClass="mx-auto w-full max-w-[896px]"
/>
