---
import { homePageSectionsData } from '../../data/homePageSections';

const d = homePageSectionsData.fit;
---

<section class="home-section home-section--surface fit-section" aria-labelledby="fit-heading">
	<div class="home-section-inner">
		<header class="section-head">
			<p class="section-eyebrow">{d.eyebrow}</p>
			<h2 class="section-title" id="fit-heading">{d.title}</h2>
			<p class="section-desc">{d.description}</p>
		</header>
		<div class="fit-grid">
			{
				d.points.map((p) => (
					<div class="fit-card">
						<h3>{p.title}</h3>
						<p>{p.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
