---
import type { ImpactCard, ImpactTestimonialAuthor, ImpactVideoCard } from '../../types/homePage';
import {
	googleDriveDownloadUrl,
	googleDrivePreviewUrl,
	googleDriveThumbnailUrl,
} from '../../utils/googleDrive';

interface Props {
	hideStatLabels?: string[];
	hideStats?: boolean;
	content: {
		eyebrow: string;
		title: string;
		description: string;
		columnsAriaLabel?: string;
		videoAltSuffix?: string;
		playVideoAlt?: string;
		starsAriaSuffix?: string;
		stats: Array<{ value: string; label: string }>;
		columns: Array<{
			flow: 'up' | 'down';
			cards: ImpactCard[];
		}>;
	};
}

const { hideStatLabels = [], hideStats = false, content: d } = Astro.props;
const filteredStats = d.stats.filter((stat) => !hideStatLabels.includes(stat.label));

const imageByIndex = {
	1: '/assets/images/image1.jpg',
	2: '/assets/images/image2.jpg',
	3: '/assets/images/image1.jpg',
	4: '/assets/images/image2.jpg',
	5: '/assets/images/image1.jpg',
	6: '/assets/images/image2.jpg',
} as const;

const getAuthorImage = (author: ImpactTestimonialAuthor) =>
	author.photoSrc ?? imageByIndex[author.avatarIndex];

function isVideoCard(card: ImpactCard): card is ImpactVideoCard {
	return card.type === 'video';
}

function getThumbnail(card: ImpactVideoCard) {
	if (card.posterSrc) return card.posterSrc;
	if (card.author.photoSrc) return card.author.photoSrc;
	if (card.driveFileId) return googleDriveThumbnailUrl(card.driveFileId);
	return imageByIndex[card.thumbnailIndex ?? 1];
}

const trackBaseClasses =
	'flex flex-col gap-[0.875rem] motion-reduce:animate-none max-sm:animate-none [&.is-paused]:[animation-play-state:paused]';
const trackUpClasses = `${trackBaseClasses} motion-safe:animate-[impact-scroll-up_26s_linear_infinite]`;
const trackDownClasses = `${trackBaseClasses} motion-safe:animate-[impact-scroll-down_26s_linear_infinite]`;
---

<section
	class="overflow-hidden bg-[#21103E] py-[clamp(3rem,7vw,6rem)] pb-[121px] text-slate-50"
	aria-labelledby="impact-heading"
	data-impact-section
>
	<div class="mx-auto max-w-[var(--ysa-max)] px-[clamp(1rem,4.44vw,4rem)]">
		<header class="mx-auto mb-[clamp(2.25rem,5vw,4rem)] max-w-[52rem] text-center">
			<p
				class="mb-[22px] inline-block rounded-full border border-white/10 bg-white/[0.08] px-4 py-2 font-display text-xs font-bold tracking-[0.06em] text-white/90 uppercase"
			>
				{d.eyebrow}
			</p>
			<h2
				class="m-0 font-display text-[clamp(1.85rem,3.8vw,2.75rem)] font-bold tracking-[-0.02em] text-slate-50 leading-[1.12]"
				id="impact-heading"
			>
				{d.title}
			</h2>
			<p class="mt-6 mb-0 text-base leading-relaxed text-[rgba(236,233,255,0.78)]">{d.description}</p>
		</header>
		{
			!hideStats && (
				<div class="mt-2 grid grid-cols-4 gap-4 max-[1100px]:grid-cols-2 max-sm:grid-cols-1">
					{
						filteredStats.map((s) => (
							<div class="border-0 bg-transparent p-0 text-center shadow-none">
								<strong class="block font-display text-[clamp(1.85rem,3.2vw,3.375rem)] font-bold tracking-[-0.02em] text-white">
									{s.value}
								</strong>
								<span class="mx-auto mt-[0.55rem] block max-w-[275px] text-sm leading-normal text-[rgba(236,233,255,0.75)]">
									{s.label}
								</span>
							</div>
						))
					}
				</div>
			)
		}

		<div
			class="mt-[clamp(2rem,5vw,4rem)] grid h-[22rem] grid-cols-3 gap-[0.875rem] [mask-image:linear-gradient(to_bottom,transparent_0%,#000_8%,#000_92%,transparent_100%)] max-[1100px]:h-80 max-[1100px]:grid-cols-2 max-sm:h-auto max-sm:[mask-image:none]"
			aria-label={d.columnsAriaLabel ?? 'Parent testimonials'}
		>
			{
				d.columns.map((column) => {
					const repeatedCards = [...column.cards, ...column.cards];
					return (
						<div class="relative overflow-hidden max-sm:overflow-visible">
							<div class={column.flow === 'up' ? trackUpClasses : trackDownClasses} data-impact-column-track>
								{
									repeatedCards.map((card) => (
										<article class="overflow-hidden rounded-xl border border-white/[0.08] bg-[#3c2a74] shadow-[0_20px_28px_-26px_rgba(0,0,0,0.8)]">
											{isVideoCard(card) && card.driveFileId ? (
												<div
													class="relative aspect-video"
													data-impact-video-trigger
													data-drive-download={googleDriveDownloadUrl(card.driveFileId)}
													data-drive-preview={googleDrivePreviewUrl(card.driveFileId)}
													data-video-title={`${card.author.name} testimonial`}
												>
													<img
														src={getThumbnail(card)}
														alt={`${card.author.name} ${d.videoAltSuffix ?? 'video testimonial'}`}
														loading="lazy"
														class="impact-card-poster block h-full w-full object-cover"
													/>
													<button
														type="button"
														class="absolute top-1/2 left-1/2 z-[2] flex h-6 w-[2.15rem] -translate-x-1/2 -translate-y-1/2 items-center justify-center border-0 bg-transparent p-0 cursor-pointer"
														data-impact-video-play
														aria-label={`${d.playVideoAlt ?? 'Play video'} — ${card.author.name}`}
													>
														<img src="/assets/images/Vector.svg" alt="" class="h-full w-full object-contain" />
													</button>
												</div>
											) : null}
											<div class="px-[0.95rem] pt-[0.85rem] pb-[0.9rem]">
												<p
													class="m-0 text-[0.78rem] tracking-[0.14em] text-amber-400"
													aria-label={`${card.rating} ${d.starsAriaSuffix ?? 'out of 5 stars'}`}
												>
													{'★'.repeat(card.rating)}
												</p>
												<p class="mt-2 mb-0 font-[var(--ysa-font-body)] text-[0.86rem] leading-[1.55] text-[rgba(250,245,255,0.96)] italic">
													{card.quote}
												</p>
												<div class="mt-3 flex items-center gap-[0.55rem]">
													<img
														src={getAuthorImage(card.author)}
														alt=""
														aria-hidden="true"
														loading="lazy"
														class="size-[1.85rem] rounded-full object-cover"
													/>
													<div>
														<p class="m-0 text-[0.76rem] font-semibold text-white">{card.author.name}</p>
														<p class="mt-[0.1rem] mb-0 text-[0.67rem] leading-[1.35] text-[rgba(214,205,243,0.85)]">
															{card.author.meta}
														</p>
													</div>
												</div>
											</div>
										</article>
									))
								}
							</div>
						</div>
					);
				})
			}
		</div>
	</div>

	<div
		id="impact-video-modal"
		class="fixed inset-0 z-[200] hidden items-center justify-center p-5 pointer-events-none"
		aria-hidden="true"
		data-impact-video-modal
	>
		<button
			type="button"
			class="absolute inset-0 cursor-pointer border-0 bg-[rgba(8,4,22,0.82)] p-0"
			data-impact-modal-close
			aria-label="Close video"
		/>
		<div
			class="relative z-[1] w-full max-w-[56rem] overflow-hidden rounded-xl bg-[#1a1038] shadow-[0_24px_48px_rgba(0,0,0,0.45)]"
			role="dialog"
			aria-modal="true"
			aria-labelledby="impact-video-modal-title"
		>
			<p
				id="impact-video-modal-title"
				class="m-0 py-[0.65rem] pr-12 pl-4 text-[0.82rem] font-semibold text-[rgba(250,245,255,0.92)]"
			/>
			<button
				type="button"
				class="absolute top-[0.35rem] right-[0.45rem] z-[2] inline-flex size-8 cursor-pointer items-center justify-center rounded-full border-0 bg-white/10 p-0 text-white"
				data-impact-modal-close
				aria-label="Close video"
			>
				<svg class="block size-4 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
					<path d="M18 6 6 18M6 6l12 12" />
				</svg>
			</button>
			<video class="impact-video-modal-video block aspect-video w-full bg-black" controls playsinline preload="metadata" />
			<iframe
				class="impact-video-modal-iframe block min-h-[18rem] aspect-video w-full border-0 bg-black"
				title="Testimonial video"
				allow="autoplay; fullscreen"
				allowfullscreen
				hidden
			/>
		</div>
	</div>
</section>

<script is:inline>
	(function () {
		const modal = document.getElementById('impact-video-modal');
		const modalTitle = document.getElementById('impact-video-modal-title');
		const video = modal && modal.querySelector('.impact-video-modal-video');
		const iframe = modal && modal.querySelector('.impact-video-modal-iframe');
		const tracks = () => document.querySelectorAll('[data-impact-column-track]');

		function pauseMarquee(paused) {
			tracks().forEach((track) => {
				track.classList.toggle('is-paused', paused);
			});
		}

		function closeModal() {
			if (!modal || !video || !iframe) return;
			modal.classList.add('hidden', 'pointer-events-none');
			modal.classList.remove('flex');
			modal.setAttribute('aria-hidden', 'true');
			document.body.classList.remove('overflow-hidden');
			pauseMarquee(false);
			video.pause();
			video.removeAttribute('src');
			video.classList.remove('hidden');
			iframe.hidden = true;
			iframe.removeAttribute('src');
		}

		function openModal(trigger) {
			if (!modal || !video || !iframe || !modalTitle) return;
			const downloadUrl = trigger.getAttribute('data-drive-download');
			const previewUrl = trigger.getAttribute('data-drive-preview');
			const title = trigger.getAttribute('data-video-title') || 'Testimonial video';
			if (!downloadUrl || !previewUrl) return;

			modalTitle.textContent = title;
			modal.classList.remove('hidden', 'pointer-events-none');
			modal.classList.add('flex');
			modal.setAttribute('aria-hidden', 'false');
			document.body.classList.add('overflow-hidden');
			pauseMarquee(true);

			iframe.hidden = true;
			iframe.removeAttribute('src');
			video.classList.remove('hidden');
			video.src = downloadUrl;
			video.load();
			video.play().catch(function () {});

			video.onerror = function () {
				video.pause();
				video.removeAttribute('src');
				video.classList.add('hidden');
				iframe.hidden = false;
				iframe.src = previewUrl;
			};
		}

		function bindTriggers() {
			document.querySelectorAll('[data-impact-video-trigger]').forEach(function (trigger) {
				if (trigger.dataset.impactVideoBound === '1') return;
				trigger.dataset.impactVideoBound = '1';

				var play = function (event) {
					event.preventDefault();
					event.stopPropagation();
					openModal(trigger);
				};

				trigger.querySelector('[data-impact-video-play]')?.addEventListener('click', play);
				trigger.addEventListener('click', function (event) {
					if (event.target === trigger || event.target.closest('.impact-card-poster')) {
						play(event);
					}
				});
			});

			modal?.querySelectorAll('[data-impact-modal-close]').forEach(function (btn) {
				btn.addEventListener('click', closeModal);
			});

			document.addEventListener('keydown', function (event) {
				if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
					closeModal();
				}
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', bindTriggers);
		} else {
			bindTriggers();
		}

		document.addEventListener('astro:page-load', bindTriggers);
	})();
</script>
