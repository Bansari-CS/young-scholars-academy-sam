---
import type { ImpactCard, ImpactTestimonialAuthor, ImpactVideoCard } from '../../types/homePage';
import {
	googleDriveDownloadUrl,
	googleDrivePreviewUrl,
	googleDriveThumbnailUrl,
} from '../../utils/googleDrive';

interface Props {
	hideStatLabels?: string[];
	hideStats?: boolean;
	content: {
		eyebrow: string;
		title: string;
		description: string;
		columnsAriaLabel?: string;
		videoAltSuffix?: string;
		playVideoAlt?: string;
		starsAriaSuffix?: string;
		stats: Array<{ value: string; label: string }>;
		columns: Array<{
			flow: 'up' | 'down';
			cards: ImpactCard[];
		}>;
	};
}

const { hideStatLabels = [], hideStats = false, content: d } = Astro.props;
const filteredStats = d.stats.filter((stat) => !hideStatLabels.includes(stat.label));

const imageByIndex = {
	1: '/assets/images/image1.jpg',
	2: '/assets/images/image2.jpg',
	3: '/assets/images/image1.jpg',
	4: '/assets/images/image2.jpg',
	5: '/assets/images/image1.jpg',
	6: '/assets/images/image2.jpg',
} as const;

const getAuthorImage = (author: ImpactTestimonialAuthor) =>
	author.photoSrc ?? imageByIndex[author.avatarIndex];

function isVideoCard(card: ImpactCard): card is ImpactVideoCard {
	return card.type === 'video';
}

function getThumbnail(card: ImpactVideoCard) {
	if (card.posterSrc) return card.posterSrc;
	if (card.author.photoSrc) return card.author.photoSrc;
	if (card.driveFileId) return googleDriveThumbnailUrl(card.driveFileId);
	return imageByIndex[card.thumbnailIndex ?? 1];
}
---

<section class="home-section impact-section-root impact-section !pb-[121px]" aria-labelledby="impact-heading">
	<div class="home-section-inner">
		<header class="section-head">
			<p class="section-eyebrow">{d.eyebrow}</p>
			<h2 class="section-title" id="impact-heading">{d.title}</h2>
			<p class="section-desc">{d.description}</p>
		</header>
		{
			!hideStats && (
				<div class="impact-stats">
					{
						filteredStats.map((s) => (
							<div class="impact-stat">
								<strong>{s.value}</strong>
								<span>{s.label}</span>
							</div>
						))
					}
				</div>
			)
		}

		<div class="impact-columns" aria-label={d.columnsAriaLabel ?? 'Parent testimonials'}>
			{
				d.columns.map((column) => {
					const repeatedCards = [...column.cards, ...column.cards];
					return (
						<div class={`impact-column impact-column--${column.flow}`}>
							<div class="impact-column-track">
								{
									repeatedCards.map((card) => (
										<article class={`impact-card impact-card--${card.type}`}>
											{isVideoCard(card) && card.driveFileId ? (
												<div
													class="impact-card-media"
													data-impact-video-trigger
													data-drive-download={googleDriveDownloadUrl(card.driveFileId)}
													data-drive-preview={googleDrivePreviewUrl(card.driveFileId)}
													data-video-title={`${card.author.name} testimonial`}
												>
													<img
														src={getThumbnail(card)}
														alt={`${card.author.name} ${d.videoAltSuffix ?? 'video testimonial'}`}
														loading="lazy"
														class="impact-card-poster"
													/>
													<button
														type="button"
														class="impact-card-play"
														data-impact-video-play
														aria-label={`${d.playVideoAlt ?? 'Play video'} — ${card.author.name}`}
													>
														<img src="/assets/images/Vector.svg" alt="" />
													</button>
												</div>
											) : null}
											<div class="impact-card-body">
												<p class="impact-card-stars" aria-label={`${card.rating} ${d.starsAriaSuffix ?? 'out of 5 stars'}`}>
													{'★'.repeat(card.rating)}
												</p>
												<p class="impact-card-quote">{card.quote}</p>
												<div class="impact-card-author">
													<img
														src={getAuthorImage(card.author)}
														alt=""
														aria-hidden="true"
														loading="lazy"
													/>
													<div>
														<p class="impact-card-name">{card.author.name}</p>
														<p class="impact-card-meta">{card.author.meta}</p>
													</div>
												</div>
											</div>
										</article>
									))
								}
							</div>
						</div>
					);
				})
			}
		</div>
	</div>

	<div id="impact-video-modal" class="impact-video-modal impact-video-modal--closed" aria-hidden="true">
		<button type="button" class="impact-video-modal-backdrop" data-impact-modal-close aria-label="Close video"></button>
		<div class="impact-video-modal-panel" role="dialog" aria-modal="true" aria-labelledby="impact-video-modal-title">
			<p id="impact-video-modal-title" class="impact-video-modal-title"></p>
			<button type="button" class="impact-video-modal-close" data-impact-modal-close aria-label="Close video">
				×
			</button>
			<video
				class="impact-video-modal-video"
				controls
				playsinline
				preload="metadata"
			/>
			<iframe
				class="impact-video-modal-iframe"
				title="Testimonial video"
				allow="autoplay; fullscreen"
				allowfullscreen
				hidden
			/>
		</div>
	</div>
</section>

<script is:inline>
	(function () {
		const modal = document.getElementById('impact-video-modal');
		const modalTitle = document.getElementById('impact-video-modal-title');
		const video = modal && modal.querySelector('.impact-video-modal-video');
		const iframe = modal && modal.querySelector('.impact-video-modal-iframe');
		const tracks = () => document.querySelectorAll('.impact-column-track');

		function pauseMarquee(paused) {
			tracks().forEach((track) => {
				track.classList.toggle('is-paused', paused);
			});
		}

		function closeModal() {
			if (!modal || !video || !iframe) return;
			modal.classList.add('impact-video-modal--closed');
			modal.setAttribute('aria-hidden', 'true');
			document.body.classList.remove('impact-video-modal-open');
			pauseMarquee(false);
			video.pause();
			video.removeAttribute('src');
			video.classList.remove('impact-video-modal-video--hidden');
			iframe.hidden = true;
			iframe.removeAttribute('src');
		}

		function openModal(trigger) {
			if (!modal || !video || !iframe || !modalTitle) return;
			const downloadUrl = trigger.getAttribute('data-drive-download');
			const previewUrl = trigger.getAttribute('data-drive-preview');
			const title = trigger.getAttribute('data-video-title') || 'Testimonial video';
			if (!downloadUrl || !previewUrl) return;

			modalTitle.textContent = title;
			modal.classList.remove('impact-video-modal--closed');
			modal.setAttribute('aria-hidden', 'false');
			document.body.classList.add('impact-video-modal-open');
			pauseMarquee(true);

			iframe.hidden = true;
			iframe.removeAttribute('src');
			video.classList.remove('impact-video-modal-video--hidden');
			video.src = downloadUrl;
			video.load();
			video.play().catch(function () {});

			video.onerror = function () {
				video.pause();
				video.removeAttribute('src');
				video.classList.add('impact-video-modal-video--hidden');
				iframe.hidden = false;
				iframe.src = previewUrl;
			};
		}

		function bindTriggers() {
			document.querySelectorAll('[data-impact-video-trigger]').forEach(function (trigger) {
				if (trigger.dataset.impactVideoBound === '1') return;
				trigger.dataset.impactVideoBound = '1';

				var play = function (event) {
					event.preventDefault();
					event.stopPropagation();
					openModal(trigger);
				};

				trigger.querySelector('[data-impact-video-play]')?.addEventListener('click', play);
				trigger.addEventListener('click', function (event) {
					if (event.target === trigger || event.target.closest('.impact-card-poster')) {
						play(event);
					}
				});
			});

			modal?.querySelectorAll('[data-impact-modal-close]').forEach(function (btn) {
				btn.addEventListener('click', closeModal);
			});

			document.addEventListener('keydown', function (event) {
				if (event.key === 'Escape' && modal && !modal.classList.contains('impact-video-modal--closed')) {
					closeModal();
				}
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', bindTriggers);
		} else {
			bindTriggers();
		}

		document.addEventListener('astro:page-load', bindTriggers);
	})();
</script>
