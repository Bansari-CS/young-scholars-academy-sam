---
import { programsSectionData } from '../../data/programsSection';
import type { ProgramCategoryId, ProgramListingCard } from '../../types/programsSection';
import '../../styles/components/programs-section.css';
const coverByKey: Record<ProgramCategoryId, string> = {
	science: '/assets/images/animated science experiment with colorful chemical reactions and beakers, educational GIF style.png',
	coding: '/assets/images/animated coding blocks and colorful programming interface for kids, playful GIF animation.png',
	math: '/assets/images/animated math equations and geometric shapes floating and transforming, educational GIF.png',
	robotics: '/assets/images/animated robot building and moving parts assembling, engineering GIF for kids.png',
	writing: '/assets/images/animated storytelling with magical book pages turning and characters appearing, creative writing GIF.png',
	'critical-thinking': '/assets/images/animated puzzle pieces connecting and brain neurons lighting up, critical thinking GIF.png',
};

const teacherPhotoByKey: Record<ProgramListingCard['teacherPhotoKey'], string> = {
	ross: '/assets/images/Teacher (1).png',
	martinez: '/assets/images/Teacher (2).png',
	chen: '/assets/images/Teacher (3).png',
	johnson: '/assets/images/Teacher (4).png',
	thompson: '/assets/images/Teacher (5).png',
	lee: '/assets/images/Teacher (6).png',
};

const d = programsSectionData;
const { filters } = d;
const initialAge = filters.ageRange.options.find((o) => o.isActive)?.label ?? '';
const toSlug = (value: string) =>
	value
		.toLowerCase()
		.trim()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');
---

<section class="programs-section" aria-labelledby="programs-heading">
	<div class="programs-section__inner">
		<header class="programs-section__head">
			<p class="programs-section__badge">{d.eyebrow}</p>
			<h2 class="programs-section__title" id="programs-heading">{d.title}</h2>
			<p class="programs-section__sub">{d.description}</p>
		</header>

		<div class="programs-filter" data-programs-filter data-initial-age={initialAge}>
			<div class="programs-filter__grid">
				<div class="programs-filter__col">
					<div class="programs-filter__col-head">
						<svg width="10" height="14" viewBox="0 0 10 14" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M6.56505 1.75C6.56505 1.28587 6.38068 0.840752 6.05249 0.512563C5.7243 0.184374 5.27918 0 4.81505 0C4.35092 0 3.9058 0.184374 3.57762 0.512563C3.24943 0.840752 3.06505 1.28587 3.06505 1.75C3.06505 2.21413 3.24943 2.65925 3.57762 2.98744C3.9058 3.31563 4.35092 3.5 4.81505 3.5C5.27918 3.5 5.7243 3.31563 6.05249 2.98744C6.38068 2.65925 6.56505 2.21413 6.56505 1.75ZM3.74591 4.6293C3.09786 4.39961 2.52912 3.96484 2.1381 3.37695L1.6049 2.57578C1.33693 2.17383 0.795522 2.06719 0.390834 2.33516C-0.0138534 2.60313 -0.120494 3.14727 0.147475 3.54922L0.683412 4.34766C1.17833 5.08867 1.85372 5.67109 2.62755 6.05391V13.125C2.62755 13.609 3.01857 14 3.50255 14C3.98654 14 4.37755 13.609 4.37755 13.125V10.5H5.25255V13.125C5.25255 13.609 5.64357 14 6.12755 14C6.61154 14 7.00255 13.609 7.00255 13.125V6.05938C7.79826 5.67109 8.49005 5.06953 8.99044 4.30391L9.4881 3.54102C9.7506 3.13633 9.63576 2.59492 9.23107 2.32969C8.82638 2.06445 8.28498 2.1793 8.01974 2.58672L7.52208 3.34687C6.92599 4.26016 5.91154 4.8125 4.82052 4.8125C4.47599 4.8125 4.13966 4.75781 3.81974 4.65391C3.79513 4.6457 3.77052 4.63477 3.74591 4.6293Z" fill="#0A9DFB"/>
</svg>

						<span>{filters.ageRange.label}</span>
					</div>
					<div class="programs-filter__ages">
						{
							filters.ageRange.options.map((opt) => (
								<button
									type="button"
									class:list={['programs-filter__age', opt.isActive && 'programs-filter__age--active']}
									data-age-option={opt.label}
								>
									{opt.label}
								</button>
							))
						}
					</div>
				</div>

				<div class="programs-filter__col">
					<div class="programs-filter__col-head">
<svg width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1.75 2.625C1.75 1.65977 2.53477 0.875 3.5 0.875H14C14.9652 0.875 15.75 1.65977 15.75 2.625V9.625H14V2.625H3.5V9.625H1.75V2.625ZM0 11.025C0 10.7352 0.235156 10.5 0.525 10.5H16.975C17.2648 10.5 17.5 10.7352 17.5 11.025C17.5 12.1844 16.5594 13.125 15.4 13.125H2.1C0.940625 13.125 0 12.1844 0 11.025ZM7.68359 5.71484L6.83594 6.5625L7.68359 7.41016C7.94063 7.66719 7.94063 8.08281 7.68359 8.33711C7.42656 8.59141 7.01094 8.59414 6.75664 8.33711L5.44414 7.02461C5.18711 6.76758 5.18711 6.35195 5.44414 6.09766L6.75664 4.78516C7.01367 4.52813 7.4293 4.52813 7.68359 4.78516C7.93789 5.04219 7.94063 5.45781 7.68359 5.71211V5.71484ZM10.7461 4.78516L12.0586 6.09766C12.3156 6.35469 12.3156 6.77031 12.0586 7.02461L10.7461 8.33711C10.4891 8.59414 10.0734 8.59414 9.81914 8.33711C9.56484 8.08008 9.56211 7.66445 9.81914 7.41016L10.6668 6.5625L9.81914 5.71484C9.56211 5.45781 9.56211 5.04219 9.81914 4.78789C10.0762 4.53359 10.4918 4.53086 10.7461 4.78789V4.78516Z" fill="#0A9DFB"/>
</svg>
						<span>{filters.campType.label}</span>
					</div>
					<label class="visually-hidden" for="programs-camp-type">Camp type</label>
					<select
						class="programs-filter__select"
						id="programs-camp-type"
						name="campType"
						aria-label={filters.campType.label}
						data-camp-select
					>
						{
							filters.campType.options.map((o, i) => (
								<option value={o.value} selected={i === 0}>
									{i === 0 ? filters.campType.placeholder : o.label}
								</option>
							))
						}
					</select>
				</div>

				<div class="programs-filter__col">
					<div class="programs-filter__col-head">
						<svg width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M4.375 1.75C4.375 0.784766 5.15977 0 6.125 0H15.75C16.7152 0 17.5 0.784766 17.5 1.75V9.625C17.5 10.5902 16.7152 11.375 15.75 11.375H9.20937C8.88672 10.6777 8.3918 10.0762 7.77656 9.625H10.5V8.75C10.5 8.26602 10.891 7.875 11.375 7.875H13.125C13.609 7.875 14 8.26602 14 8.75V9.625H15.75V1.75H6.125V3.09258C5.61094 2.79453 5.01211 2.625 4.375 2.625V1.75ZM4.375 3.5C4.71972 3.5 5.06106 3.5679 5.37954 3.69982C5.69802 3.83173 5.9874 4.02509 6.23116 4.26884C6.47491 4.5126 6.66827 4.80198 6.80018 5.12046C6.9321 5.43894 7 5.78028 7 6.125C7 6.46972 6.9321 6.81106 6.80018 7.12954C6.66827 7.44802 6.47491 7.7374 6.23116 7.98116C5.9874 8.22491 5.69802 8.41827 5.37954 8.55018C5.06106 8.6821 4.71972 8.75 4.375 8.75C4.03028 8.75 3.68894 8.6821 3.37046 8.55018C3.05198 8.41827 2.7626 8.22491 2.51884 7.98116C2.27509 7.7374 2.08173 7.44802 1.94982 7.12954C1.8179 6.81106 1.75 6.46972 1.75 6.125C1.75 5.78028 1.8179 5.43894 1.94982 5.12046C2.08173 4.80198 2.27509 4.5126 2.51884 4.26884C2.7626 4.02509 3.05198 3.83173 3.37046 3.69982C3.68894 3.5679 4.03028 3.5 4.375 3.5ZM3.64492 9.625H5.10234C7.11758 9.625 8.75 11.2574 8.75 13.2699C8.75 13.6719 8.42461 14 8.01992 14H0.730078C0.325391 14 0 13.6746 0 13.2699C0 11.2574 1.63242 9.625 3.64492 9.625Z" fill="#0A9DFB"/>
</svg>

						<span>{filters.teacher.label}</span>
					</div>
					<label class="visually-hidden" for="programs-teacher">Teacher</label>
					<select
						class="programs-filter__select"
						id="programs-teacher"
						name="teacher"
						aria-label={filters.teacher.label}
						data-teacher-select
					>
						{
							filters.teacher.options.map((o, i) => (
								<option value={o.value} selected={i === 0}>
									{i === 0 ? filters.teacher.placeholder : o.label}
								</option>
							))
						}
					</select>
				</div>
			</div>

			<div class="programs-filter__active-row">
				<div class="programs-filter__active-group">
					<span class="programs-filter__active-label">ACTIVE:</span>
					<div class="programs-filter__chips" data-filter-chips></div>
				</div>
				<button type="button" class="programs-filter__clear" data-clear-all>
					{filters.clearLabel}
				</button>
			</div>
		</div>

		<div class="programs-cards">
			{
				d.cards.map((card) => {
					const cover = coverByKey[card.coverImageKey];
					const teacherFace = teacherPhotoByKey[card.teacherPhotoKey];
					const cardHref = `/courses/${toSlug(card.title)}`;
					return (
						<a class="programs-card" href={cardHref}>
							<div class="programs-card__media">
								<img
									src={cover}
									alt={`${card.title} illustration`}
									class="programs-card__cover"
									loading="lazy"
								/>
								<span class="programs-card__age">{card.ageLabel}</span>
							</div>
							<div class="programs-card__body">
								<div class="programs-card__meta">
									<span
										class:list={[
											'programs-card__category-pill',
											`programs-card__category-pill--${card.category.id}`,
										]}
									>
										{card.category.label}
									</span>
									<span class="programs-card__meta-dot" aria-hidden="true">
										•
									</span>
									<span class="programs-card__duration">{card.durationWeeks} weeks</span>
								</div>
								<h3 class="programs-card__title">{card.title}</h3>
								<p class="programs-card__desc">{card.description}</p>
								<div class="programs-card__footer">
									<div class="programs-card__teacher">
										<img
											src={teacherFace}
											alt={card.teacher.name}
											class="programs-card__avatar-img"
											loading="lazy"
										/>
										<span class="programs-card__teacher-name">{card.teacher.name}</span>
									</div>
									<span class="programs-card__link">Learn More →</span>
								</div>
							</div>
						</a>
					);
				})
			}
		</div>

		<div class="programs-section__cta">
			<a class="programs-section__cta-btn" href={d.viewAllCta.href}>
				{d.viewAllCta.label}
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</div>
</section>

<script is:inline>
	(function () {
		function escapeHtml(text) {
			var d = document.createElement('div');
			d.textContent = text;
			return d.innerHTML;
		}

		function setupFilter(root) {
			var ageBtns = root.querySelectorAll('[data-age-option]');
			var campSelect = root.querySelector('[data-camp-select]');
			var teacherSelect = root.querySelector('[data-teacher-select]');
			var chipsHost = root.querySelector('[data-filter-chips]');
			var clearBtn = root.querySelector('[data-clear-all]');
			if (!campSelect || !teacherSelect || !chipsHost || !clearBtn) return;

			var initial = root.getAttribute('data-initial-age') || '';
			var selectedAge = initial;

			function campIsDefault() {
				return !campSelect.value;
			}
			function teacherIsDefault() {
				return !teacherSelect.value;
			}

			function syncAgeButtons() {
				ageBtns.forEach(function (btn) {
					var label = btn.getAttribute('data-age-option');
					btn.classList.toggle('programs-filter__age--active', label === selectedAge);
				});
			}

			function optionText(select) {
				var opt = select.selectedOptions[0];
				return opt ? opt.textContent.trim() : '';
			}

			function renderChips() {
				chipsHost.innerHTML = '';
				var chips = [];
				if (selectedAge) chips.push({ kind: 'age', label: selectedAge });
				if (!campIsDefault()) chips.push({ kind: 'camp', label: optionText(campSelect) });
				if (!teacherIsDefault()) chips.push({ kind: 'teacher', label: optionText(teacherSelect) });

				chips.forEach(function (c) {
					var pill = document.createElement('span');
					pill.className = 'programs-filter__chip-pill';
					pill.innerHTML =
						'<span class="programs-filter__chip-text">' +
						escapeHtml(c.label) +
						'</span><button type="button" class="programs-filter__chip-remove" data-remove="' +
						c.kind +
						'" aria-label="Remove ' +
						c.kind +
						' filter">×</button>';
					chipsHost.appendChild(pill);
				});
			}

			ageBtns.forEach(function (btn) {
				btn.addEventListener('click', function () {
					var label = btn.getAttribute('data-age-option');
					if (!label) return;
					selectedAge = label;
					syncAgeButtons();
					renderChips();
				});
			});

			chipsHost.addEventListener('click', function (e) {
				var t = e.target.closest('[data-remove]');
				if (!t) return;
				var kind = t.getAttribute('data-remove');
				if (kind === 'age') selectedAge = '';
				if (kind === 'camp') campSelect.selectedIndex = 0;
				if (kind === 'teacher') teacherSelect.selectedIndex = 0;
				syncAgeButtons();
				renderChips();
			});

			campSelect.addEventListener('change', renderChips);
			teacherSelect.addEventListener('change', renderChips);

			clearBtn.addEventListener('click', function () {
				selectedAge = '';
				campSelect.selectedIndex = 0;
				teacherSelect.selectedIndex = 0;
				syncAgeButtons();
				renderChips();
			});

			syncAgeButtons();
			renderChips();
		}

		function boot() {
			document.querySelectorAll('[data-programs-filter]').forEach(setupFilter);
		}
		if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
		else boot();
	})();
</script>
