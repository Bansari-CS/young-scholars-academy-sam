---
import '../../styles/components/footer.css';
import logo from '../../assets/common/logo.png';

const year = new Date().getFullYear();

const socialLinks = [
	{
		label: 'Facebook',
		href: 'https://www.facebook.com/YSAENRICHMENT',
		icon: '/assets/footer/social-facebook.svg',
		external: true,
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/company/young-scholars-academy-la',
		icon: '/assets/footer/social-linkedin.svg',
		external: true,
	},
	{
		label: 'YouTube',
		href: 'https://www.youtube.com/@youngscholarsacademy1523',
		icon: '/assets/footer/social-youtube.svg',
		external: false,
	},
	{
		label: 'Instagram',
		href: 'https://www.instagram.com/young_scholars_academy/',
		icon: '/assets/footer/social-instagram.svg',
		external: true,
	},
	{
		label: 'TikTok',
		href: 'https://www.tiktok.com/@young_scholars_academy',
		icon: '/assets/footer/social-tiktok.svg',
		external: false,
	},
];

const companyLinks = [
	{ label: 'About Us', href: '#' },
	{ label: 'Our Teachers', href: '/teachers' },
	{ label: 'Courses Catalog', href: '/semester-sales' },
	{ label: 'FAQ', href: '#' },
];

const resourceLinks = [
	{ label: 'Blog', href: '/blog' },
	{ label: 'Expert Talks', href: '#' },
	{ label: 'Freebies', href: '#' },
];

const courseCategoryLinks = [
	{ label: 'Academic Core, Executive Function & Life Skills', href: '#' },
	{ label: 'Gaming & Social Skills', href: '#' },
	{ label: 'STEM & Science', href: '#' },
	{ label: 'Math Made Fun', href: '#' },
	{ label: 'Creative Arts & Expression', href: '#' },
	{ label: 'Social Connection & Friendship', href: '#' },
	{ label: 'Communication & Life Skills', href: '#' },
	{ label: 'History & Critical Thinking', href: '#' },
	{ label: 'Special Interest & Culture', href: '#' },
];

const communityLinks = [
	{ label: 'Testimonials', href: '#' },
	{ label: 'Events', href: '#' },
	{ label: 'Freebies', href: '#' },
];

const accreditationLinks = [
	{ label: 'FAQ', href: '#' },
	{ label: 'Privacy Policy', href: '#' },
];
---

<footer class="ysa-footer">
	<div class="ysa-footer__inner">
		<div class="ysa-footer__grid">
			<div class="ysa-footer__brand-col">
				<a class="ysa-footer__logo-link" href="/" aria-label="Young Scholars Academy home">
					<img
						class="ysa-footer__logo-img"
						src={logo.src}
						width={logo.width}
						height={logo.height}
						alt="Young Scholars Academy"
					/>
				</a>
				<p class="ysa-footer__tagline">
					Premium STEM education for gifted, twice-exceptional, and neurodivergent learners. Small classes.
					Expert mentors. Real results.
				</p>
				<div class="ysa-footer__social" aria-label="Social media">
					{
						socialLinks.map((item) => (
							<a
								href={item.href}
								aria-label={item.label}
								{...(item.external
									? { target: '_blank', rel: 'noopener noreferrer' }
									: {})}
							>
								<img src={item.icon} alt="" width="20" height="20" />
							</a>
						))
					}
				</div>
			</div>

			<div class="ysa-footer__nav-stack">
				<nav class="ysa-footer__nav-block" aria-label="Company">
					<h3>Company</h3>
					<ul>
						{companyLinks.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))}
					</ul>
				</nav>
				<nav class="ysa-footer__nav-block" aria-label="Resources">
					<h3>Resources</h3>
					<ul>
						{resourceLinks.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<div class="ysa-footer__nav-stack">
				<nav class="ysa-footer__nav-block ysa-footer__nav-block--categories" aria-label="Courses Categories">
					<h3>Courses Categories</h3>
					<ul>
						{courseCategoryLinks.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))}
					</ul>
				</nav>
				<nav class="ysa-footer__nav-block" aria-label="Community">
					<h3>Community</h3>
					<ul>
						{communityLinks.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<div class="ysa-footer__accreditation-col">
				<img
					class="ysa-footer__wasc"
					src="/assets/footer/wasc-accreditation.png"
					alt="WASC Accrediting Commission for Schools"
					width="246"
					height="77"
					loading="lazy"
				/>
				<ul class="ysa-footer__accreditation-links">
					{accreditationLinks.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div class="ysa-footer__bottom">
			<p>© {year} Young Scholars Academy. All rights reserved.</p>
		</div>
	</div>
</footer>
