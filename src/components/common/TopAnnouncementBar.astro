---
import '../../styles/components/top-announcement-bar.css';

interface Props {
	message: string;
	ctaLabel: string;
	ctaHref: string;
}

const { message, ctaLabel, ctaHref } = Astro.props;
---

<div class="announcement-bar" role="region" aria-label="Site announcement">
	<div class="announcement-bar__inner">
		<p class="announcement-bar__message">
			{message}
		</p>
		<a class="announcement-bar__cta" href={ctaHref}>
			<span class="announcement-bar__cta-label">{ctaLabel}</span>
			<span class="announcement-bar__cta-icon" aria-hidden="true">
				<svg
				width="12"
				height="14"
				viewBox="0 0 16 18"
				fill="none"
				xmlns="http://www.w3.org/2000/svg">
					<path
					d="M15.4195 9.79424C15.859 9.35478 15.859 8.64111 15.4195 8.20166L9.79453 2.57666C9.35508 2.13721 8.64141 2.13721 8.20195 2.57666C7.7625 3.01611 7.7625 3.72979 8.20195 4.16924L11.9109 7.87471H1.125C0.502734 7.87471 0 8.37744 0 8.99971C0 9.62197 0.502734 10.1247 1.125 10.1247H11.9074L8.20547 13.8302C7.76602 14.2696 7.76602 14.9833 8.20547 15.4228C8.64492 15.8622 9.35859 15.8622 9.79805 15.4228L15.423 9.79775L15.4195 9.79424Z"
					fill="currentColor">
					</path>
				</svg>
			</span>
		</a>
	</div>
</div>
