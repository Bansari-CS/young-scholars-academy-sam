---
import type { NavItem } from '../../types/home';
import PrimaryButton from '../ui/PrimaryButton.astro';
import '../../styles/components/header.css';

interface Props {
	brand: string;
	navItems: NavItem[];
}

const { brand, navItems } = Astro.props;
---

<header class="site-header">
	<div class="header-container">
		<a class="header-brand" href="/">
			<span class="header-logo" aria-hidden="true">YS</span>
			<span class="header-brand-name">{brand}</span>
		</a>

		<nav class="header-nav" aria-label="Primary">
			<ul class="header-nav-list">
				{
					navItems.map((item) => (
						<li>
							<a class="header-nav-link" href={item.href}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="header-actions">
			<a href="#" class="header-signin">Sign In</a>
			<PrimaryButton href="#" label="Browse Courses" variant="sm" class="header-primary-cta" />
		</div>
	</div>
</header>
