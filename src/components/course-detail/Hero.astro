---
import PrimaryButton from '../ui/PrimaryButton.astro';
import {
	googleDrivePreviewUrl,
	googleDriveThumbnailUrl,
} from '../../utils/googleDrive';

interface Props {
	badges: string[];
	titleLead: string;
	titleAccent: string;
	description: string;
	stats: { label: string; value: string }[];
	price: string;
	priceNote: string;
	instructor: string;
	taughtByLabel: string;
	primaryCtaLabel: string;
	primaryCtaHref?: string;
	secondaryCtaLabel: string;
	videoDriveFileId?: string;
	videoYouTubeId?: string;
	videoAriaLabel?: string;
}

const {
	badges,
	titleLead,
	titleAccent,
	description,
	stats,
	price,
	priceNote,
	instructor,
	taughtByLabel,
	primaryCtaLabel,
	primaryCtaHref,
	secondaryCtaLabel,
	videoDriveFileId: videoDriveFileIdProp,
	videoYouTubeId: videoYouTubeIdProp,
	videoAriaLabel: videoAriaLabelProp,
} = Astro.props;

const videoDriveFileId = videoDriveFileIdProp?.trim();
const videoYouTubeId   = videoYouTubeIdProp?.trim();
const videoAriaLabel   = videoAriaLabelProp ?? 'Course preview video';

// YouTube preferred — muted, looped, no controls natively
const youTubeEmbedUrl = videoYouTubeId
	? `https://www.youtube.com/embed/${videoYouTubeId}?autoplay=1&mute=1&loop=1&playlist=${videoYouTubeId}&controls=0&showinfo=0&rel=0&iv_load_policy=3&modestbranding=1&playsinline=1&enablejsapi=1`
	: null;

// Google Drive fallback
const videoPreviewUrl = (!videoYouTubeId && videoDriveFileId) ? googleDrivePreviewUrl(videoDriveFileId) : null;
const videoPosterUrl  = videoDriveFileId ? googleDriveThumbnailUrl(videoDriveFileId, 800) : null;

const hasVideo = !!(videoYouTubeId || videoDriveFileId);
---

<section class="course-hero">
	<div class="mx-auto flex w-full max-w-[1216px] flex-col items-start gap-[96px] px-4 pt-16 pb-29 lg:flex-row lg:items-center lg:px-4">
		<div class="flex w-full lg:max-w-[560px] max-w-full flex-col gap-8">
			<div class="flex w-full items-start gap-2">
				{
					badges.map((badge, index) => (
						<span
							class:list={[
								'inline-flex min-h-[26px] items-center justify-center whitespace-nowrap rounded-[9999px] px-3 py-1 text-[12px] leading-[18px] font-semibold uppercase tracking-[0.6px]',
								index === 1 ? 'bg-[#14B8A61A] text-[#048C3C]' : 'bg-[#F0F9FF] text-[#0A9DFB]',
							]}
						>
							{badge}
						</span>
					))
				}
			</div>

			<h1 class="font-[var(--ysa-font-display)] xl:text-[44px] text-[32px] font-bold xl:leading-[55px] md:leading-[45px] leading-[52px] font-bold tracking-normal text-slate-900">
				{titleLead}
				<br class="lg:block hidden" />
				<span class="bg-gradient-to-r from-sky-500 to-indigo-500 bg-clip-text text-transparent">{titleAccent}</span>
			</h1>

			<p class="w-full lg:max-w-[512px] max-w-full text-[18px] leading-[32px] text-slate-600">{description}</p>

			<div class="grid h-[162px] w-full grid-cols-2 gap-x-12 gap-y-6 border-y border-slate-100 py-4">
				{
					stats.map((stat) => (
						<div>
							<span class="block text-[14px] text-slate-500">{stat.label}</span>
							<strong class="block text-[14px] leading-7 font-semibold text-slate-900">{stat.value}</strong>
						</div>
					))
				}
			</div>

			<div class="flex w-full items-center justify-between flex-wrap gap-y-4">
				<div>
					<strong class="block font-[var(--ysa-font-display)] text-[30px] leading-9 font-semibold text-slate-900">{price}</strong>
					<span class="block text-sm leading-5 text-slate-500">{priceNote}</span>
				</div>
				<div class="flex w-[353px] items-center justify-between flex-wrap gap-y-4">
					<PrimaryButton
						href={primaryCtaHref || '#'}
						label={primaryCtaLabel}
						variant="lg"
						trailingIconSrc="/assets/course-detail/icon-arrow-right.svg"
						target={primaryCtaHref ? '_blank' : undefined}
						rel={primaryCtaHref ? 'noopener noreferrer' : undefined}
					/>
					<a
						href="#"
						class="inline-flex min-h-14 items-center justify-center rounded-xl border border-slate-200 px-8 py-4 text-base font-medium text-slate-600"
					>
						{secondaryCtaLabel}
					</a>
				</div>
			</div>
		</div>

		<aside class="relative h-[532px] w-full lg:max-w-[560px] max-w-full">
			<div class="absolute inset-[16px_-16px_-16px_16px] rounded-[40px]"></div>
			<div class="relative overflow-hidden rounded-[40px] border-[8px] border-white shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)] h-full">
				{hasVideo ? (
					<div
						class="relative w-full h-full bg-black overflow-hidden"
						data-course-hero-video
						data-youtube-id={videoYouTubeId || ''}
						data-drive-preview={videoPreviewUrl || ''}
					>
						{/* Poster fades out once iframe loads */}
						{videoPosterUrl && (
							<img
								class="course-hero-poster absolute inset-0 z-[2] h-full w-full object-cover transition-opacity duration-700"
								src={videoPosterUrl}
								alt={videoAriaLabel}
								aria-hidden="true"
							/>
						)}

						{/*
							Iframe is 180×180% of the container, centered.
							overflow-hidden on parent clips:
							  • black letterbox bars (aspect ratio mismatch)
							  • Google Drive title bar (top)
							  • Google Drive / YouTube control bar (bottom)
						*/}
						<div class="absolute inset-0 overflow-hidden" style="background:#000;">
							<iframe
								class="course-hero-video-iframe absolute border-0"
								style="top:50%;left:50%;width:180%;height:180%;transform:translate(-50%,-50%);"
								title={videoAriaLabel}
								allow="autoplay; fullscreen; picture-in-picture"
								allowfullscreen
							/>
						</div>

						{/* Click-blocker — prevents accidental interaction with player */}
						<div class="absolute inset-0 z-[3]" aria-hidden="true" style="pointer-events:all;cursor:default;"></div>

						{/* Unmute button — starts muted, families can unmute */}
						<button
							type="button"
							class="absolute bottom-4 right-4 z-[5] flex items-center gap-1.5 rounded-full bg-black/55 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-sm transition-colors hover:bg-black/75 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
							data-course-hero-unmute
							aria-label="Unmute video"
							style="pointer-events:all;"
						>
							<svg data-muted-icon class="block size-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
								<path d="M8 2L4 6H1V10H4L8 14V2Z"/>
								<path d="M11 5L14 8M14 8L11 11" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
							</svg>
							<svg data-unmuted-icon class="hidden size-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
								<path d="M8 2L4 6H1V10H4L8 14V2Z"/>
								<path d="M10.5 5.5A3 3 0 0113.5 8A3 3 0 0110.5 10.5" stroke="white" stroke-width="1.5" stroke-linecap="round" fill="none"/>
							</svg>
							<span data-btn-label>Unmute</span>
						</button>
					</div>
				) : (
					<div class="relative aspect-video w-full min-h-[220px] bg-slate-900 lg:min-h-[516px]">
						<iframe
							class="absolute inset-0 h-full w-full border-0"
							src="https://www.youtube.com/embed/NpEaa2P7qZI?si=aKDUpgdln8tkIYHV"
							title="YouTube video player"
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							referrerpolicy="strict-origin-when-cross-origin"
							allowfullscreen
						/>
					</div>
				)}
			</div>
		</aside>
	</div>
</section>

<script is:inline>
(function () {
	function initCourseHeroVideo() {
		var wrap = document.querySelector('[data-course-hero-video]');
		if (!wrap || wrap.dataset.videoInited === '1') return;
		wrap.dataset.videoInited = '1';

		var iframe     = wrap.querySelector('.course-hero-video-iframe');
		var poster     = wrap.querySelector('.course-hero-poster');
		var youtubeId  = (wrap.getAttribute('data-youtube-id') || '').trim();
		var driveUrl   = (wrap.getAttribute('data-drive-preview') || '').trim();
		if (!iframe) return;

		// YouTube: muted + looped + no controls natively
		// Google Drive: autoplay only (no mute — cross-origin restriction)
		var isYouTube = !!youtubeId;
		var embedUrl  = isYouTube
			? 'https://www.youtube.com/embed/' + youtubeId
				+ '?autoplay=1&mute=1&loop=1&playlist=' + youtubeId
				+ '&controls=0&showinfo=0&rel=0&iv_load_policy=3&modestbranding=1&playsinline=1&enablejsapi=1'
			: driveUrl
				? driveUrl + (driveUrl.indexOf('?') === -1 ? '?' : '&') + 'autoplay=1&loop=1&rm=minimal'
				: '';

		if (!embedUrl) return;

		function hidePoster() {
			if (poster) { poster.style.opacity = '0'; poster.style.pointerEvents = 'none'; }
		}
		function showPoster() {
			if (poster) { poster.style.opacity = '1'; poster.style.pointerEvents = 'none'; }
		}

		var isLoaded      = false;
		var loopTimeout   = null;
		var videoDuration = 0;
		var startedAt     = 0;

		function reloadIframe() {
			clearTimeout(loopTimeout);
			iframe.src = '';
			setTimeout(function () {
				iframe.src = embedUrl;
				startedAt  = Date.now();
				setTimeout(hidePoster, 800);
				if (videoDuration > 0) scheduleLoop();
			}, 150);
		}

		function scheduleLoop() {
			clearTimeout(loopTimeout);
			if (videoDuration <= 0) return;
			var elapsed   = startedAt ? (Date.now() - startedAt) / 1000 : 0;
			var remaining = videoDuration - elapsed - 0.3;
			loopTimeout   = setTimeout(reloadIframe, Math.max(300, remaining * 1000));
		}

		function loadVideo() {
			if (isLoaded) return;
			isLoaded  = true;
			startedAt = Date.now();
			iframe.src = embedUrl;
			setTimeout(hidePoster, 800);
		}

		function unloadVideo() {
			if (!isLoaded) return;
			isLoaded = false;
			clearTimeout(loopTimeout);
			iframe.src = '';
			showPoster();
		}

		// Google Drive postMessage loop detection
		if (!isYouTube) {
			window.addEventListener('message', function (e) {
				if (!iframe.src) return;
				try {
					var d = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
					if (!d || !d.info) return;

					if (d.info.duration > 0 && d.info.duration !== videoDuration) {
						videoDuration = d.info.duration;
						scheduleLoop();
					}

					if (videoDuration > 0 && d.info.currentTime !== undefined) {
						var remaining = videoDuration - d.info.currentTime - 0.3;
						if (remaining > 0 && remaining < videoDuration * 0.2) {
							clearTimeout(loopTimeout);
							loopTimeout = setTimeout(reloadIframe, Math.max(100, remaining * 1000));
						}
					}

					if (d.info.playerState === 0) reloadIframe();
				} catch (_) {}
			});
		}

		// IntersectionObserver — autoplay when visible, pause when off-screen
		var observer = new IntersectionObserver(function (entries) {
			entries.forEach(function (entry) {
				if (entry.isIntersecting) { loadVideo(); } else { unloadVideo(); }
			});
		}, { threshold: 0.25 });

		observer.observe(wrap);

		window.addEventListener('load', function () {
			var r = wrap.getBoundingClientRect();
			if (r.top < window.innerHeight && r.bottom > 0) loadVideo();
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initCourseHeroVideo);
	} else {
		initCourseHeroVideo();
	}
	document.addEventListener('astro:page-load', initCourseHeroVideo);
})();
</script>

<script is:inline>
// Course hero video unmute toggle
(function () {
	function initCourseHeroUnmute() {
		var btn = document.querySelector('[data-course-hero-unmute]');
		if (!btn || btn.dataset.unmuteInited === '1') return;
		btn.dataset.unmuteInited = '1';

		var wrap      = btn.closest('[data-course-hero-video]');
		var iframe    = wrap ? wrap.querySelector('.course-hero-video-iframe') : null;
		var mutedIcon = btn.querySelector('[data-muted-icon]');
		var unmuteIcon = btn.querySelector('[data-unmuted-icon]');
		var label     = btn.querySelector('[data-btn-label]');
		var isMuted   = true;

		if (!iframe) return;

		btn.addEventListener('click', function () {
			var youtubeId = (wrap.getAttribute('data-youtube-id') || '').trim();
			isMuted = !isMuted;

			if (youtubeId && iframe.contentWindow) {
				// YouTube IFrame API — toggle mute
				var cmd = isMuted ? 'mute' : 'unMute';
				try {
					iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: cmd, args: [] }), '*');
				} catch (_) {}
			}

			// Toggle icon + label
			if (isMuted) {
				if (mutedIcon)  mutedIcon.classList.remove('hidden');
				if (unmuteIcon) unmuteIcon.classList.add('hidden');
				if (label) label.textContent = 'Unmute';
				btn.setAttribute('aria-label', 'Unmute video');
			} else {
				if (mutedIcon)  mutedIcon.classList.add('hidden');
				if (unmuteIcon) unmuteIcon.classList.remove('hidden');
				if (label) label.textContent = 'Mute';
				btn.setAttribute('aria-label', 'Mute video');
			}
		});
	}

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCourseHeroUnmute);
	else initCourseHeroUnmute();
	document.addEventListener('astro:page-load', initCourseHeroUnmute);
})();
</script>
