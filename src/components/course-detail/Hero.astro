---
import type { HeroStat } from '../../data/courseDetail';
import PrimaryButton from '../ui/PrimaryButton.astro';

interface Props {
	badges: string[];
	titleLead: string;
	titleAccent: string;
	description: string;
	stats: HeroStat[];
	price: string;
	priceNote: string;
	ratingText: string;
	instructor: string;
}

const { badges, titleLead, titleAccent, description, stats, price, priceNote, ratingText, instructor } = Astro.props;
---

<section class="course-hero">
	<div class="mx-auto flex w-full max-w-[1216px] flex-col items-start gap-16 px-4 pt-16 pb-24 lg:flex-row lg:items-center lg:px-4">
		<div class="flex w-full max-w-[560px] flex-col gap-8">
			<div class="flex w-full items-start gap-2">
				{
					badges.map((badge, index) => (
						<span
							class:list={[
								'inline-flex min-h-[26px] items-center justify-center whitespace-nowrap rounded-[9999px] px-3 py-1 text-[12px] leading-[18px] font-semibold uppercase tracking-[0.6px]',
								index === 1 ? 'bg-[#14B8A61A] text-[#048C3C]' : 'bg-[#F0F9FF] text-[#0A9DFB]',
							]}
						>
							{badge}
						</span>
					))
				}
			</div>

			<h1 class="font-[var(--ysa-font-display)] text-[44px] leading-[52px] font-bold tracking-normal text-slate-900">
				{titleLead}
				<br />
				<span class="bg-gradient-to-r from-sky-500 to-indigo-500 bg-clip-text text-transparent">{titleAccent}</span>
			</h1>

			<p class="w-full max-w-[512px] text-[18px] leading-[32px] text-slate-600">{description}</p>

			<div class="grid h-[162px] w-full grid-cols-2 gap-x-8 gap-y-6 border-y border-slate-100 py-6">
				{
					stats.map((stat) => (
						<div>
							<span class="block text-[14px] text-slate-500">{stat.label}</span>
							<strong class="block text-[14px] leading-7 font-semibold text-slate-900">{stat.value}</strong>
						</div>
					))
				}
			</div>

			<div class="flex w-full items-center justify-between">
				<div>
					<strong class="block font-[var(--ysa-font-display)] text-[30px] leading-9 font-semibold text-slate-900">{price}</strong>
					<span class="mt-1 block text-sm leading-5 text-slate-500">{priceNote}</span>
					<span class="mt-1 block text-xs leading-5 text-slate-500">{ratingText}</span>
				</div>
				<div class="flex w-[353px] items-center justify-between">
					<PrimaryButton
						href="#"
						label="Enroll Now"
						variant="lg"
						trailingIconSrc="https://www.figma.com/api/mcp/asset/697accfc-f1d0-4cc5-87cf-763e65ba23a1"
					/>
					<a
						href="#"
						class="inline-flex min-h-14 items-center justify-center rounded-xl border border-slate-200 px-8 py-4 text-base font-medium text-slate-600"
					>
						View Schedule
					</a>
				</div>
			</div>
		</div>

		<aside class="relative h-[532px] w-full max-w-[560px]">
			<div class="absolute inset-[16px_-16px_-16px_16px] rounded-[40px] bg-[#e0f2fe]"></div>
			<div class="relative overflow-hidden rounded-[40px] border-[8px] border-white shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)]">
			<img
				class="block h-[516px] w-full rounded-[32px] object-cover"
				src="https://www.figma.com/api/mcp/asset/258fd01e-a415-4785-a772-db4e00d4c5aa"
				alt="Kids building a robot together"
				loading="lazy"
			/>
			<div class="absolute bottom-6 left-6 inline-flex items-center gap-3 rounded-2xl bg-white/90 px-4 py-3 backdrop-blur-[4px]">
				<img
					class="h-12 w-12 rounded-full object-cover"
					src="https://www.figma.com/api/mcp/asset/4a7d0bb8-0cf0-4541-9b4a-55b063274a33"
					alt=""
					aria-hidden="true"
					loading="lazy"
				/>
				<div>
					<span class="block text-[11px] leading-tight text-slate-500">Taught by</span>
					<strong class="block text-[13px] leading-tight text-slate-900">{instructor}</strong>
				</div>
			</div>
			</div>
		</aside>
	</div>
</section>
