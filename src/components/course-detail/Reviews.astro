---
import type { ReviewItem } from '../../data/courseDetail';

interface Props {
	rating: string;
	total: string;
	items: ReviewItem[];
}

const { rating, total, items } = Astro.props;
---

<section class="flex flex-col gap-8">
	<div class="flex flex-col gap-6">
	<div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
		<div class="flex flex-col gap-2">
			<h2 class="m-0 text-[24px] leading-8 font-bold text-slate-900">Parent Reviews</h2>
			<p class="flex items-center gap-2">
				<span class="inline-flex items-center gap-0.5">
					{Array.from({ length: 5 }).map(() => (
						<img
							class="h-4 w-[18px]"
							src="https://www.figma.com/api/mcp/asset/e06f87cf-4404-4ad4-8d74-d77d0aeb3eb5"
							alt=""
							aria-hidden="true"
							loading="lazy"
						/>
					))}
				</span>
				<strong class="text-[16px] leading-6 text-slate-800">{rating}</strong>
				<em class="text-[14px] leading-5 not-italic text-slate-400">{total}</em>
			</p>
		</div>
		<a
			href="#"
			class="inline-flex items-center justify-center rounded-[12px] border border-slate-200 px-4 py-2 text-[14px] leading-5 font-semibold text-slate-900 no-underline"
		>
			Write a Review
		</a>
	</div>

	<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
		{
			items.map((item) => (
				<article class="flex min-h-[162px] flex-col gap-3 rounded-2xl border border-[#f8fafc] bg-white p-6 shadow-[0px_1px_1px_rgba(0,0,0,0.05)]">
					<div class="flex items-center gap-3">
						<img
							class="h-10 w-10 flex-shrink-0 rounded-full object-cover"
							src={
								item.name === 'Sarah Miller'
									? 'https://www.figma.com/api/mcp/asset/23ae5b31-9d86-4910-9882-810b4ac94048'
									: 'https://www.figma.com/api/mcp/asset/3694c527-4be9-4b6d-8360-9a57b48fca0c'
							}
							alt={item.name}
							loading="lazy"
						/>
						<div class="flex flex-col">
							<strong class="block text-[14px] leading-5 text-slate-900">{item.name}</strong>
							<small class="mt-0.5 block text-[10px] leading-[15px] text-slate-600">{item.role}</small>
						</div>
					</div>
					<p class="text-[14px] leading-5 text-slate-600 italic">"{item.text}"</p>
				</article>
			))
		}
	</div>
	</div>

	<section class="flex flex-col gap-6">
		<h2 class="m-0 text-[24px] leading-8 font-bold text-slate-900">Inside the Classroom</h2>
		<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
			<img
				class="block h-48 w-full rounded-2xl object-cover"
				src="https://www.figma.com/api/mcp/asset/d2185684-e39f-463e-84e9-e4a7802cab0f"
				alt="Robot project on desk"
				loading="lazy"
			/>
			<img
				class="block h-48 w-full rounded-2xl object-cover"
				src="https://www.figma.com/api/mcp/asset/eb6ce05e-c1c1-4470-8aed-dd062bbd0a72"
				alt="Coding workstation for students"
				loading="lazy"
			/>
			<img
				class="block h-48 w-full rounded-2xl object-cover"
				src="https://www.figma.com/api/mcp/asset/24ca6b3e-63ab-43ce-ab6e-65069bb96b3a"
				alt="Children collaborating in a STEM class"
				loading="lazy"
			/>
		</div>
	</section>
</section>
