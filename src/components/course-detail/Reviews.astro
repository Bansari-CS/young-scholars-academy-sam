---
import { googleDriveDownloadUrl, googleDrivePreviewUrl, googleDriveThumbnailUrl } from '../../utils/googleDrive';

interface Props {
	title: string;
	rating: string;
	total: string;
	starsText: string;
	writeReviewLabel: string;
	galleryTitle: string;
	items: { name: string; role: string; text: string }[];
}

const { title, rating, total, starsText, writeReviewLabel, galleryTitle, items } = Astro.props;
const insideClassroomVideoFileId = '1Bnzq3-lpkgr87KBcVA7mbPjl85DiZv_2';
const insideClassroomVideoDownloadUrl = googleDriveDownloadUrl(insideClassroomVideoFileId);
const insideClassroomVideoPreviewUrl = googleDrivePreviewUrl(insideClassroomVideoFileId);
const insideClassroomVideoPosterUrl = googleDriveThumbnailUrl(insideClassroomVideoFileId, 800);
---

<section class="flex flex-col gap-8">
	<div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
		<div class="flex flex-col gap-2">
			<h2 class="m-0 text-[24px] leading-8 font-bold text-slate-900">{title}</h2>
			<p class="flex items-center gap-2">
				<span class="inline-flex items-center gap-0.5 text-[22px] leading-4 text-[#facc15]" aria-hidden="true">{starsText}</span>
				<strong class="text-[16px] leading-6 text-slate-800">{rating}</strong>
				<em class="text-[14px] leading-5 not-italic text-slate-400">{total}</em>
			</p>
		</div>
		<a
			href="#"
			class="inline-flex items-center justify-center rounded-[12px] border border-slate-200 px-4 py-2 text-[14px] leading-5 font-semibold text-slate-900 no-underline"
		>
			{writeReviewLabel}
		</a>
	</div>

	<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
		{
			items.map((item) => (
				<article class="flex min-h-[162px] flex-col gap-3 rounded-2xl border border-[#f8fafc] bg-white p-6 shadow-[0px_1px_1px_rgba(0,0,0,0.05)]">
					<div class="flex items-center gap-3">
						<img
							class="h-10 w-10 flex-shrink-0 rounded-full object-cover"
							src={
								item.name === 'Sarah Miller'
								? '/assets/course-detail/review-sarah.png'
								: '/assets/course-detail/review-david.png'
							}
							alt={item.name}
							loading="lazy"
						/>
						<div class="flex flex-col">
							<strong class="block text-[14px] leading-5 text-slate-900">{item.name}</strong>
							<small class="mt-0.5 block text-[10px] leading-[15px] text-slate-600">{item.role}</small>
						</div>
					</div>
					<p class="text-[14px] leading-5 text-slate-600 italic">"{item.text}"</p>
				</article>
			))
		}
	</div>

	<section class="flex flex-col gap-6 pt-[61px]">
		<h2 class="m-0 text-[24px] leading-8 font-bold text-slate-900">{galleryTitle}</h2>
		<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
			<div class="relative h-48 w-full overflow-hidden rounded-2xl bg-slate-900" data-inside-classroom-video data-drive-preview={insideClassroomVideoPreviewUrl}>
				<video
					class="inside-classroom-video block h-full w-full object-cover object-center bg-black"
					src={insideClassroomVideoDownloadUrl}
					poster={insideClassroomVideoPosterUrl}
					preload="metadata"
					playsinline
					autoplay
					muted
					loop
					controls
					aria-label="Inside the classroom video"
				/>

				<iframe
					class="inside-classroom-video-iframe hidden h-full w-full border-0"
					title="Inside the classroom video"
					allow="autoplay; fullscreen"
					allowfullscreen
				/>
			</div>
			<img
				class="block h-48 w-full rounded-2xl object-cover"
				src="/assets/course-detail/gallery-2.png"
				alt="Coding workstation for students"
				loading="lazy"
			/>
			<img
				class="block h-48 w-full rounded-2xl object-cover"
				src="/assets/course-detail/gallery-3.png"
				alt="Children collaborating in a STEM class"
				loading="lazy"
			/>
		</div>
	</section>
</section>

<script is:inline>
	(function () {
		const wrap = document.querySelector('[data-inside-classroom-video]');
		if (!wrap) return;

		const video = wrap.querySelector('.inside-classroom-video');
		const iframe = wrap.querySelector('.inside-classroom-video-iframe');
		const previewUrl = wrap.getAttribute('data-drive-preview');
		if (!video || !iframe || !previewUrl) return;

		video.addEventListener('error', function () {
			video.classList.add('hidden');
			video.removeAttribute('src');
			iframe.classList.remove('hidden');
			iframe.src = previewUrl;
		});
	})();
</script>
