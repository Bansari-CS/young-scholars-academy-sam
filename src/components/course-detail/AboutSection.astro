---
interface Props {
	badgeLetter: string;
	title: string;
	description: string;
	linkLabel: string;
}

const { badgeLetter, title, description, linkLabel } = Astro.props;
---

<section class="relative left-1/2 right-1/2 w-screen -translate-x-1/2 bg-[#dbeafe] py-16 md:py-20">
	<div class="mx-auto flex w-full max-w-[800px] flex-col items-center gap-6 px-4 text-center">
		<span class="inline-grid h-16 w-16 place-items-center rounded-2xl bg-[#0284c7] text-[30px] leading-9 font-bold text-white shadow-[0px_20px_25px_-5px_rgba(2,132,199,0.2),0px_8px_10px_-6px_rgba(2,132,199,0.2)]">{badgeLetter}</span>
		<h2 class="max-w-[520px] text-[46px] leading-[52px] font-semibold tracking-[-0.02em] text-slate-900">
			{title}
		</h2>
		<p class="mx-auto max-w-[746px] text-[18px] leading-[29.25px] text-slate-600 mt-[7px] ml-[4px]">
			{description}
		</p>
		<a href="#" class="inline-block text-[16px] leading-6 font-bold text-[#0284c7] no-underline">{linkLabel}</a>
	</div>
</section>
