---
interface Props {
	tabs: string[];
	/** Used with the Web Share API (title / text). */
	shareTitle?: string;
}

const { tabs, shareTitle } = Astro.props;
---

<nav class="border-y border-slate-100 bg-white" aria-label="Course sections">
	<div class="mx-auto flex min-h-12 max-w-[1216px] items-center justify-between gap-4 px-4">
		<ul class="m-0 flex list-none items-center gap-5 p-0">
			{
				tabs.map((tab, index) => (
					<li
						class:list={[
							'border-b-2 border-transparent py-3 text-sm font-semibold text-slate-500',
							index === 0 && 'border-b-sky-500 text-sky-500',
						]}
					>
						<button
							type="button"
							class="tab-button cursor-pointer bg-transparent no-underline"
							data-tab-index={index}
						>
							{tab}
						</button>
					</li>
				))
			}
		</ul>
		<div
			class="course-share relative z-20"
			data-course-share
			data-share-title={shareTitle ?? ''}
		>
			<button
				type="button"
				class="inline-flex items-center gap-1.5 rounded-lg border border-violet-100 bg-violet-50/40 px-2.5 py-1 text-xs font-semibold text-violet-600 shadow-sm transition hover:border-violet-200 hover:bg-violet-50 cursor-pointer"
				data-share-toggle
				aria-label="Share this course"
			>
				<img
					src="/assets/course-detail/icon-share.svg"
					alt=""
					aria-hidden="true"
					class="h-4 w-4"
					loading="lazy"
				/>
				<span>Share</span>
			</button>
		</div>
	</div>
</nav>

<script>
	const buttons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('.tab-button[data-tab-index]')
	);
	const items = buttons
		.map((btn) => btn.closest('li'))
		.filter(Boolean) as HTMLLIElement[];

	const setActive = (activeIndex: number) => {
		items.forEach((item, index) => {
			const isActive = index === activeIndex;
			item.classList.toggle('border-b-sky-500', isActive);
			item.classList.toggle('text-sky-500', isActive);
			item.classList.toggle('border-transparent', !isActive);
			item.classList.toggle('text-slate-500', !isActive);
		});
	};

	buttons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const idx = Number(btn.dataset.tabIndex ?? '0');
			setActive(idx);
		});
	});

	const roots = document.querySelectorAll<HTMLElement>('[data-course-share]');
	roots.forEach((root) => {
		const toggle = root.querySelector<HTMLButtonElement>('[data-share-toggle]');
		if (!toggle) return;

		const titleFromDom = root.dataset.shareTitle?.trim() || '';

		async function copyUrlToClipboard(url: string): Promise<boolean> {
			if (navigator.clipboard?.writeText) {
				try {
					await navigator.clipboard.writeText(url);
					return true;
				} catch {
					/* continue */
				}
			}
			try {
				const ta = document.createElement('textarea');
				ta.value = url;
				ta.setAttribute('readonly', '');
				ta.style.position = 'fixed';
				ta.style.left = '-9999px';
				document.body.appendChild(ta);
				ta.select();
				const ok = document.execCommand('copy');
				document.body.removeChild(ta);
				return ok;
			} catch {
				return false;
			}
		}

		toggle.addEventListener('click', async (e) => {
			e.stopPropagation();
			const url = window.location.href;
			const title = titleFromDom || document.title;
			const payload: ShareData = { title, text: title, url };

			if (typeof navigator.share === 'function') {
				try {
					await navigator.share(payload);
					return;
				} catch (err) {
					const name = err instanceof Error ? err.name : '';
					if (name === 'AbortError') return;
				}
			}

			await copyUrlToClipboard(url);
		});
	});
</script>
