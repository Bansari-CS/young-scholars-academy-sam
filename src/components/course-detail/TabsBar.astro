---
import shareIcon from '../../assets/course-detail/icon-share.svg';
interface Props {
	tabs: string[];
}

const { tabs } = Astro.props;
---

<nav class="border-y border-slate-100 bg-white" aria-label="Course sections">
	<div class="mx-auto flex min-h-12 max-w-[1202px] items-center justify-between gap-4 px-2">
		<ul class="m-0 flex list-none items-center gap-5 p-0">
			{
				tabs.map((tab, index) => (
					<li
						class:list={[
							'border-b-2 border-transparent py-3 text-md font-semibold text-slate-500',
							index === 0 && 'border-b-sky-500 text-sky-500',
						]}
					>
						{tab}
					</li>
				))
			}
		</ul>
		<a
			href="#"
			class="inline-flex items-center gap-1.5 rounded-lg border border-violet-100 bg-violet-50/40 px-2.5 py-1 text-xs font-semibold text-violet-500 no-underline"
		>
			<img
				src={shareIcon.src}
				alt=""
				aria-hidden="true"
				class="h-3 w-3"
				loading="lazy"
			/>
			<span>Share</span>
		</a>
	</div>
</nav>
