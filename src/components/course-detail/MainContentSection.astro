---
import Content from './Content.astro';
import Sidebar from './Sidebar.astro';

interface Pillar {
	title: string;
	description: string;
}

interface Props {
	content: {
		overviewTitle: string;
		overview: string;
		overview2: string;
		pillars: Pillar[];
		gains: { text: string }[];
		gainsTitle: string;
		videoTitle: string;
		videoCaptionTitle: string;
		videoCaptionText: string;
		scheduleTitle: string;
		scheduleHeaderSession: string;
		scheduleHeaderTopic: string;
		scheduleHeaderDate: string;
		downloadCurriculumLabel: string;
		instructorTitle: string;
		instructorName: string;
		instructorRole: string;
		instructorPortfolioLabel: string;
		instructorOtherCoursesLabel: string;
		sessions: { session: string; topic: string; date: string }[];
		instructorBio: string;
	};
	sidebar: {
		price: string;
		cohort: string;
		includesTitle: string;
		includes: { text: string }[];
		related: { image: string; tag: string; title: string; meta: string }[];
		primaryCtaLabel: string;
		guaranteeText: string;
		relatedTitle: string;
	};
}

const { content, sidebar } = Astro.props;
---

<section id="overview" class="scroll-mt-32 bg-slate-50 py-16">
	<div class="mx-auto grid max-w-[1216px] grid-cols-1 items-start gap-12 px-4 lg:grid-cols-[757px_1fr]">
		<Content {...content} />
		<Sidebar {...sidebar} />
	</div>
</section>
