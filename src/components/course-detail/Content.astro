---
interface Pillar {
	title: string;
	description: string;
}

interface Props {
	overviewTitle: string;
	overview: string;
	overview2: string;
	pillars: Pillar[];
	gains: { text: string }[];
	gainsTitle: string;
	videoTitle: string;
	videoCaptionTitle: string;
	videoCaptionText: string;
	scheduleTitle: string;
	scheduleHeaderSession: string;
	scheduleHeaderTopic: string;
	scheduleHeaderDate: string;
	downloadCurriculumLabel: string;
	instructorTitle: string;
	instructorName: string;
	instructorRole: string;
	instructorPortfolioLabel: string;
	instructorOtherCoursesLabel: string;
	sessions: { session: string; topic: string; date: string }[];
	instructorBio: string;
}

const {
	overviewTitle,
	overview,
	overview2,
	pillars,
	gains,
	gainsTitle,
	videoTitle,
	videoCaptionTitle,
	videoCaptionText,
	scheduleTitle,
	scheduleHeaderSession,
	scheduleHeaderTopic,
	scheduleHeaderDate,
	downloadCurriculumLabel,
	instructorTitle,
	instructorName,
	instructorRole,
	instructorPortfolioLabel,
	instructorOtherCoursesLabel,
	sessions,
	instructorBio,
} = Astro.props;
---

<section class="course-content flex flex-col gap-23">
	<div class="flex flex-col gap-4">
	<h2 class="text-[25px] leading-8 font-bold tracking-[-0.02em] text-slate-900">{overviewTitle}</h2>
	<p class="text-[16px] leading-7 text-slate-600 pt-1">{overview}</p>
	<p class="text-[16px] leading-7 text-slate-600">{overview2}</p>

	<div class="mt-2 grid grid-cols-1 gap-4 md:grid-cols-2">
		{
			pillars.map((pillar, index) => (
				<article class="h-[118px] rounded-2xl border border-slate-100 bg-white px-6 py-5 shadow-[0px_1px_1px_rgba(0,0,0,0.05)]">
					<div class="flex items-start gap-4">
						<span
							class:list={[
								'inline-flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl',
								index === 0 ? 'bg-[#eff6ff]' : 'bg-[#ece1ff]',
							]}
							aria-hidden="true"
						>
							<img
								class={index === 0 ? 'h-4 w-5' : 'h-4 w-4'}
								src={
									index === 0
										? '/assets/course-detail/icon-python.svg'
										: '/assets/course-detail/icon-hardware.svg'
								}
								alt=""
							/>
						</span>
						<div class="flex flex-col gap-1">
							<h3 class="m-0 text-[16px] leading-6 font-semibold text-slate-800">{pillar.title}</h3>
							<p class="text-[14px] leading-5 text-slate-500">{pillar.description}</p>
						</div>
					</div>
				</article>
			))
		}
	</div>
	</div>

	<section id="learning-outcomes" class="scroll-mt-[12rem] flex flex-col gap-6 md:scroll-mt-[13rem]">
	<h2 class="text-[25px] leading-8 font-bold tracking-[-0.02em] text-slate-900">{gainsTitle}</h2>
	<ul class="grid list-none grid-cols-1 gap-x-8 gap-y-4 p-0 md:grid-flow-col md:grid-rows-2 md:grid-cols-2">
		{
			gains.map((gain) => (
					<li class="relative pl-7 text-[16px] leading-6 text-slate-600">
						<img
							class="absolute top-[0.42rem] left-0 h-4 w-4"
							src="/assets/course-detail/icon-check.svg"
							alt=""
							aria-hidden="true"
						/>
					{gain.text}
				</li>
			))
		}
	</ul>
	</section>

	<section class="flex flex-col gap-6">
		<h2 class="text-[25px] leading-8 font-bold tracking-[-0.02em] text-slate-900">{videoTitle}</h2>
		<div class="relative h-[400px] overflow-hidden rounded-3xl">
			<img
				class="block h-full w-full object-cover"
				src="/assets/course-detail/video-cover.png"
				alt="Students during robotics class session"
				loading="lazy"
			/>
			<div class="absolute inset-0 bg-[rgba(15,23,42,0.4)]"></div>
			<button
				class="absolute top-1/2 left-1/2 inline-flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-[0px_25px_50px_-12px_rgba(0,0,0,0.25)]"
				aria-label="Play demo video"
			>
				<img
					class="h-6 w-[18px]"
					src="/assets/course-detail/icon-play.svg"
					alt=""
					aria-hidden="true"
				/>
			</button>
			<div class="absolute bottom-6 left-6 flex flex-col">
				<strong class="font-[var(--ysa-font-body)] text-[18px] leading-7 font-semibold text-white">
					{videoCaptionTitle}
				</strong>
				<span class="text-[14px] leading-5 text-white/80">{videoCaptionText}</span>
			</div>
		</div>
	</section>

	<!-- <section id="schedule" class="scroll-mt-[12rem] flex flex-col gap-6 pt-2 md:scroll-mt-[13rem]">
		<h2 class="text-[25px] leading-8 font-bold tracking-[-0.02em] text-slate-900">{scheduleTitle}</h2>
		<div class="overflow-x-auto rounded-3xl border border-slate-100 bg-white">
