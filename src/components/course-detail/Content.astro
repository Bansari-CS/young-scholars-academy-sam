	<section id="teacher" class="scroll-mt-[12rem] flex flex-col gap-6 md:scroll-mt-[13rem]">
		<h2 class="text-[25px] leading-8 font-bold tracking-[-0.02em] text-slate-900">{instructorTitle}</h2>
		<article class="flex items-start md:gap-8 gap-4 rounded-[32px] bg-[rgba(239,246,255,0.3)] p-8 flex-col sm:flex-row">
			<img
				class="md:h-32 md:w-32 h-15 w-15 flex-shrink-0 rounded-2xl object-cover shadow-[0px_10px_15px_-3px_rgba(0,0,0,0.1),0px_4px_6px_-4px_rgba(0,0,0,0.1)]"
				src="/assets/course-detail/hero-teacher.png"
				alt={instructorName}
				loading="lazy"
			/>
			<div class="min-w-0 flex-1">
				<h3 class="m-0 text-[17px] font-semibold text-sky-500">{instructorName}</h3>
				<strong class="block text-[16px] leading-6 font-medium text-slate-900">{instructorRole}</strong>
				<p class="mt-4 text-[16px] leading-[26px] text-slate-600">{instructorBio}</p>
				<div class="mt-4 flex items-center gap-4">
					<a class="text-[14px] leading-5 font-semibold text-sky-600 no-underline" href="#">{instructorPortfolioLabel}</a>
					<span class="text-[16px] leading-6 text-slate-300" aria-hidden="true">•</span>
					<a class="text-[14px] leading-5 font-semibold text-sky-600 no-underline" href="#">{instructorOtherCoursesLabel}</a>
				</div>
			</div>
		</article>
	</section>
</section>
