---
import type { CurriculumSession, GainItem } from '../../data/courseDetail';

interface Pillar {
	title: string;
	description: string;
}

interface Props {
	overview: string;
	overview2: string;
	pillars: Pillar[];
	gains: GainItem[];
	sessions: CurriculumSession[];
	instructorBio: string;
}

const { overview, overview2, pillars, gains, sessions, instructorBio } = Astro.props;
---

<section class="course-content flex flex-col gap-24">
	<div class="flex flex-col gap-6">
	<h2 class="text-[24px] leading-8 font-bold tracking-[-0.02em] text-slate-900">Course Overview</h2>
	<p class="text-[16px] leading-7 text-slate-600">{overview}</p>
	<p class="mt-4 text-[16px] leading-7 text-slate-600">{overview2}</p>

	<div class="mt-2 grid grid-cols-1 gap-4 md:grid-cols-2">
		{
			pillars.map((pillar, index) => (
				<article class="h-[118px] rounded-2xl border border-slate-100 bg-white px-6 py-6 shadow-[0px_1px_1px_rgba(0,0,0,0.05)]">
					<div class="flex items-start gap-4">
						<span
							class:list={[
								'inline-flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl',
								index === 0 ? 'bg-[#eff6ff]' : 'bg-[#ece1ff]',
							]}
							aria-hidden="true"
						>
							<img
								class={index === 0 ? 'h-4 w-5' : 'h-4 w-4'}
								src={
									index === 0
										? 'https://www.figma.com/api/mcp/asset/2d5a06d1-ffd8-4c64-a9bf-6cd066056dd5'
										: 'https://www.figma.com/api/mcp/asset/d31927c6-a7c2-4160-9f63-99a5f64f36d8'
								}
								alt=""
							/>
						</span>
						<div class="flex flex-col gap-1">
							<h3 class="m-0 text-[16px] leading-6 font-semibold text-slate-800">{pillar.title}</h3>
							<p class="text-[14px] leading-5 text-slate-500">{pillar.description}</p>
						</div>
					</div>
				</article>
			))
		}
	</div>
	</div>

	<div class="flex flex-col gap-6">
	<h2 class="text-[24px] leading-8 font-bold tracking-[-0.02em] text-slate-900">What Your Child Will Gain</h2>
	<ul class="grid list-none grid-cols-1 gap-x-8 gap-y-4 p-0 md:grid-cols-2">
		{
			gains.map((gain) => (
					<li class="relative pl-7 text-[16px] leading-6 text-slate-600">
						<img
							class="absolute top-[0.42rem] left-0 h-4 w-4"
							src="https://www.figma.com/api/mcp/asset/82d1098b-35fa-42db-beb7-4372f15e62d4"
							alt=""
							aria-hidden="true"
						/>
					{gain.text}
				</li>
			))
		}
	</ul>
	</div>

	<section class="flex flex-col gap-6">
		<h2 class="text-[24px] leading-8 font-bold tracking-[-0.02em] text-slate-900">See the Class in Action</h2>
		<div class="relative h-[400px] overflow-hidden rounded-3xl">
			<img
				class="block h-full w-full object-cover"
				src="https://www.figma.com/api/mcp/asset/cf1637ad-0d39-4f3b-aa29-6081aac594d9"
				alt="Students during robotics class session"
				loading="lazy"
			/>
			<div class="absolute inset-0 bg-[rgba(15,23,42,0.4)]"></div>
			<button
				class="absolute top-1/2 left-1/2 inline-flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-[0px_25px_50px_-12px_rgba(0,0,0,0.25)]"
				aria-label="Play demo video"
			>
				<img
					class="h-6 w-[18px]"
					src="https://www.figma.com/api/mcp/asset/9233ab96-9fe4-446d-ad98-9ee50872060b"
					alt=""
					aria-hidden="true"
				/>
			</button>
			<div class="absolute bottom-6 left-6 flex flex-col">
				<strong class="font-[var(--ysa-font-body)] text-[18px] leading-7 font-semibold text-white">
					Watch a 2-minute demo
				</strong>
				<span class="text-[14px] leading-5 text-white/80">Experience our interactive teaching style</span>
			</div>
		</div>
	</section>

	<section class="flex flex-col gap-6">
		<h2 class="text-[24px] leading-8 font-bold tracking-[-0.02em] text-slate-900">Class Schedule</h2>
		<div class="overflow-hidden rounded-3xl border border-slate-100 bg-white">
			<table class="w-full border-collapse">
				<thead>
					<tr class="bg-slate-50">
						<th class="border-b border-slate-100 px-6 py-4 text-left text-[12px] leading-4 font-semibold tracking-[0.05em] text-slate-800 uppercase">
							Session
						</th>
						<th class="border-b border-slate-100 px-6 py-4 text-left text-[12px] leading-4 font-semibold tracking-[0.05em] text-slate-800 uppercase">
							Topic
						</th>
						<th class="border-b border-slate-100 px-6 py-4 text-right text-[12px] leading-4 font-semibold tracking-[0.05em] text-slate-800 uppercase">
							Date
						</th>
					</tr>
				</thead>
				<tbody>
					{
						sessions.map((session) => (
							<tr>
								<td class="border-b border-[#c8ccd0] px-6 py-4 text-[17px] leading-6 font-semibold text-slate-800">{session.session}</td>
								<td class="border-b border-[#c8ccd0] px-6 py-4 text-[16px] text-slate-600">{session.topic}</td>
								<td class="border-b border-[#c8ccd0] px-6 py-4 text-right text-[16px] text-slate-600">{session.date}</td>
							</tr>
						))
					}
				</tbody>
			</table>
			<a class="block bg-[#dbeafe] py-4 text-center text-[14px] leading-5 font-semibold text-sky-600 no-underline" href="#">
				Download Full Curriculum (PDF)
			</a>
		</div>
	</section>

	<section class="flex flex-col gap-6">
		<h2 class="text-[24px] leading-8 font-bold tracking-[-0.02em] text-slate-900">Meet Your Instructor</h2>
		<article class="flex items-start gap-8 rounded-[32px] bg-[rgba(239,246,255,0.3)] p-8">
			<img
				class="h-32 w-32 flex-shrink-0 rounded-2xl object-cover shadow-[0px_10px_15px_-3px_rgba(0,0,0,0.1),0px_4px_6px_-4px_rgba(0,0,0,0.1)]"
				src="https://www.figma.com/api/mcp/asset/4a7d0bb8-0cf0-4541-9b4a-55b063274a33"
				alt="Dr. Alex Watson"
				loading="lazy"
			/>
			<div class="min-w-0 flex-1">
				<h3 class="m-0 text-[17px] font-semibold text-sky-500">Dr. Alex Watson</h3>
				<strong class="mt-1 block text-[16px] leading-6 font-medium text-slate-900">Robotics Engineer & Educator</strong>
				<p class="mt-4 text-[16px] leading-[26px] text-slate-600">{instructorBio}</p>
				<div class="mt-4 flex items-center gap-4">
					<a class="text-[14px] leading-5 font-semibold text-sky-600 no-underline" href="#">View Portfolio</a>
					<span class="text-[16px] leading-6 text-slate-300" aria-hidden="true">•</span>
					<a class="text-[14px] leading-5 font-semibold text-sky-600 no-underline" href="#">Other Courses (4)</a>
				</div>
			</div>
		</article>
	</section>
</section>
