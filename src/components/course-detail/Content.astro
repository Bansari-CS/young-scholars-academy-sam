								<td class="border-b border-[#c8ccd0] xl:px-6 xl:py-4 xl:text-[17px] px-3 py-2 text-[14px] xl:leading-6 leading-5 text-slate-600">{session.topic}</td>
								<td class="border-b border-[#c8ccd0] xl:px-6 xl:py-4 xl:text-[17px] px-3 py-2 text-[14px] xl:leading-6 leading-5 text-slate-600">{session.date}</td>
