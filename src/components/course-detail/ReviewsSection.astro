---
import type { ReviewItem } from '../../data/courseDetail';
import Reviews from './Reviews.astro';

interface Props {
	reviews: {
		title: string;
		rating: string;
		total: string;
		starsText: string;
		writeReviewLabel: string;
		galleryTitle: string;
		items: ReviewItem[];
	};
}

const { reviews } = Astro.props;
---

<section id="reviews" class="scroll-mt-32 bg-white py-8 pb-[78px]">
	<div class="mx-auto max-w-[1216px] px-4">
		<div class="max-w-[757px]">
			<Reviews {...reviews} />
		</div>
	</div>
</section>
