---
import PrimaryButton from '../ui/PrimaryButton.astro';

interface Props {
	price: string;
	cohort: string;
	includesTitle: string;
	includes: { text: string }[];
	related: { image: string; tag: string; title: string; meta: string; href?: string }[];
	primaryCtaLabel: string;
	primaryCtaHref?: string;
	guaranteeText: string;
	relatedTitle: string;
	shareTitle?: string;
}

const {
	price,
	cohort,
	includes,
	includesTitle,
	related,
	primaryCtaLabel,
	primaryCtaHref,
	guaranteeText,
	relatedTitle,
	shareTitle,
} = Astro.props;

---
<aside>
	<div class="rounded-3xl border border-[rgba(226,232,240,0.5)] bg-white p-6 shadow-[0px_10px_40px_-10px_rgba(0,132,255,0.08),0px_4px_12px_-4px_rgba(0,0,0,0.04)]">
		<strong class="block text-center font-[var(--ysa-font-display)] text-[30px] leading-9 text-slate-900 font-bold">{price}</strong>
		<span class="mt-2 block text-center text-[14px] leading-5 text-[#475569]">{cohort}</span>
		<div class="mt-[14px] border-t border-[#f8fafc] pt-[14px]">
			<h3 class="mb-4 text-[17px] leading-6 font-semibold text-slate-800">{includesTitle}</h3>
			<ul class="m-0 flex list-none flex-col gap-[11.5px] p-0">
				{
					includes.map((item) => (
						<li class="flex items-center gap-3 text-[14px] leading-5 text-[#475569]">
							<img
								class="h-[14px] w-[14px] flex-shrink-0"
								src="/assets/course-detail/icon-check-simple.svg"
								alt=""
								aria-hidden="true"
								loading="lazy"
							/>
							<span>{item.text}</span>
						</li>
					))
				}
			</ul>
		</div>
		<PrimaryButton href={primaryCtaHref || '#'} label={primaryCtaLabel} variant="lg" class="mt-6 w-full" target={primaryCtaHref ? '_blank' : undefined} rel={primaryCtaHref ? 'noopener noreferrer' : undefined} />
		<div class="mt-4 w-full" data-course-share data-share-title={shareTitle ?? ''}>
			<button
				type="button"
				class="flex w-full min-h-[56px] cursor-pointer items-center justify-center gap-2 rounded-xl border border-violet-100 bg-violet-50/40 px-8 py-4 text-base font-semibold text-violet-600 shadow-sm transition hover:border-violet-200 hover:bg-violet-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-400"
				data-share-toggle
				aria-label="Share this course"
			>
				<img
					src="/assets/course-detail/icon-share.svg"
					alt=""
					aria-hidden="true"
					class="h-4 w-4 shrink-0"
					loading="lazy"
				/>
				<span>Share</span>
			</button>
		</div>
		<p class="mt-6 text-center text-[12px] leading-[18px] text-[#94a3b8]">{guaranteeText}</p>
	</div>

	<div class="mt-7">
		<h3 class="mb-4 text-[18px] leading-7 font-bold text-slate-900">{relatedTitle}</h3>
		<div class="flex flex-col gap-4 pt-[16px]">
			{
				related.map((item) => {
					const tagLower = item.tag.toLowerCase();
					const tagColor =
						tagLower.includes('science') || tagLower.includes('stem')
							? 'text-[#048c3c]'
							: tagLower.includes('social') || tagLower.includes('life')
								? 'text-violet-600'
								: tagLower.includes('art') || tagLower.includes('creative')
									? 'text-pink-500'
									: 'text-sky-500';
					const card = (
						<article class="flex gap-3 rounded-[20px] bg-white overflow-hidden shadow-[0px_4px_12px_0px_rgba(0,0,0,0.06)] transition hover:shadow-[0px_6px_18px_0px_rgba(0,0,0,0.10)]">
							<div class="w-[96px] flex-shrink-0 overflow-hidden">
								<img
									class="h-full w-full object-cover"
									style="aspect-ratio:1/1;"
									src={item.image}
									alt={item.title}
									loading="lazy"
								/>
							</div>
							<div class="flex flex-col justify-center gap-0.5 py-3 pr-3">
								<small class:list={['block text-[11px] leading-4 font-bold tracking-[0.3px] uppercase', tagColor]}>
									{item.tag}
								</small>
								<strong class="block text-[14px] leading-5 font-semibold text-slate-800">{item.title}</strong>
								<p class="mt-0.5 text-[12px] leading-4 text-slate-500">{item.meta}</p>
							</div>
						</article>
					);
					return item.href
						? <a href={item.href} target="_blank" rel="noopener noreferrer" class="no-underline block">{card}</a>
						: <div>{card}</div>;
				})
			}
		</div>
	</div>
</aside>
