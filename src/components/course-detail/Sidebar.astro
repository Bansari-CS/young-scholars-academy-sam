---
import type { CourseIncludeItem, RelatedCourse } from '../../data/courseDetail';
import PrimaryButton from '../ui/PrimaryButton.astro';

interface Props {
	price: string;
	cohort: string;
	includes: CourseIncludeItem[];
	related: RelatedCourse[];
}

const { price, cohort, includes, related } = Astro.props;
---
<aside>
	<div class="rounded-3xl border border-[rgba(226,232,240,0.5)] bg-white p-6 shadow-[0px_10px_40px_-10px_rgba(0,132,255,0.08),0px_4px_12px_-4px_rgba(0,0,0,0.04)]">
		<strong class="block text-center font-[var(--ysa-font-display)] text-[30px] leading-9 text-slate-900">{price}</strong>
		<span class="mt-2 block text-center text-[14px] leading-5 text-[#475569]">{cohort}</span>
		<div class="mt-[14px] border-t border-[#f8fafc] pt-[14px]">
			<h3 class="mb-4 text-[17px] leading-6 font-semibold text-slate-800">Course Includes:</h3>
			<ul class="m-0 flex list-none flex-col gap-[11.5px] p-0">
				{
					includes.map((item) => (
						<li class="flex items-center gap-3 text-[14px] leading-5 text-[#475569]">
							<img
								class="h-[14px] w-[12.25px] flex-shrink-0"
								src="https://www.figma.com/api/mcp/asset/9e9e6b21-1e66-4249-a760-bfc8196a6128"
								alt=""
								aria-hidden="true"
								loading="lazy"
							/>
							<span>{item.text}</span>
						</li>
					))
				}
			</ul>
		</div>
		<PrimaryButton href="#" label="Enroll Now" variant="lg" class="mt-4 w-full" />
		<p class="mt-3 text-center text-[12px] leading-[18px] text-[#94a3b8]">14-day money-back guarantee</p>
	</div>

	<div class="mt-6">
		<h3 class="mb-4 text-[18px] leading-7 font-bold text-slate-900">Related Courses</h3>
		<div class="flex flex-col gap-4">
			{
				related.map((item) => (
					<article class="flex gap-4 rounded-[24px] bg-white p-4 shadow-[0px_4px_12px_0px_rgba(0,0,0,0.04)]">
						<img
							class="h-[64px] w-[64px] flex-shrink-0 rounded-xl object-cover"
							src={item.image}
							alt={item.title}
							loading="lazy"
						/>
						<div>
							<small class="block text-[12px] leading-4 font-bold tracking-[0.3px] text-sky-500 uppercase">{item.tag}</small>
							<strong class="mt-0.5 block text-[17px] leading-6 font-semibold text-slate-800">{item.title}</strong>
							<p class="mt-0.5 text-[12px] leading-4 text-slate-500">{item.meta}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</aside>
