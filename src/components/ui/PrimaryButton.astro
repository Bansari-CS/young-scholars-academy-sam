---
interface Props {
	href: string;
	label: string;
	variant?: 'lg' | 'sm';
	trailingIconSrc?: string;
	showTrailingArrow?: boolean;
	target?: string;
	rel?: string;
	class?: string;
}

const {
	href,
	label,
	variant = 'lg',
	trailingIconSrc,
	showTrailingArrow = false,
	target,
	rel,
	class: className = '',
} = Astro.props;

const variantClass =
	variant === 'sm'
		? 'min-h-11 px-6 py-3 text-sm leading-5'
		: 'min-h-14 px-8 py-4 text-base leading-6';
---

<a
	class:list={[
		'relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border-0 bg-ysa-figma-primary font-sans font-medium text-white no-underline shadow-[0_2px_16px_-4px_rgba(0,0,0,0.06)] transition-[filter] duration-150 hover:brightness-[1.03] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ysa-figma-primary',
		variantClass,
		className,
	]}
	href={href}
	target={target}
	rel={rel}
>
	<span class="relative z-[1]">{label}</span>
	{
		trailingIconSrc ? (
			<img
				class="relative z-[1] block h-3.5 w-[12.25px] shrink-0"
				src={trailingIconSrc}
				alt=""
				width="13"
				height="14"
				loading="lazy"
			/>
		) : showTrailingArrow ? (
			<svg
				class="relative z-[1] block h-3.5 w-[12.25px] shrink-0"
				width="13"
				height="14"
				viewBox="0 0 13 14"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<path
					d="M11.993 7.61807C12.3348 7.27627 12.3348 6.72119 11.993 6.37939L7.61797 2.00439C7.27617 1.6626 6.72109 1.6626 6.3793 2.00439C6.0375 2.34619 6.0375 2.90127 6.3793 3.24307L9.26406 6.1251H0.875C0.391016 6.1251 0 6.51611 0 7.0001C0 7.48408 0.391016 7.8751 0.875 7.8751H9.26133L6.38203 10.7571C6.04023 11.0989 6.04023 11.654 6.38203 11.9958C6.72383 12.3376 7.27891 12.3376 7.6207 11.9958L11.9957 7.6208L11.993 7.61807Z"
					fill="white"
				/>
			</svg>
		) : null
	}
</a>
