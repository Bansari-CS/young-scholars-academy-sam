---
import '../../styles/components/ui-button.css';

interface Props {
	href: string;
	label: string;
	variant?: 'lg' | 'sm';
	trailingIconSrc?: string;
	class?: string;
}

const { href, label, variant = 'lg', trailingIconSrc, class: className = '' } = Astro.props;
---

<a class:list={['ui-primary-btn', `ui-primary-btn--${variant}`, className].filter(Boolean)} href={href}>
	<span class="ui-primary-btn__shadow" aria-hidden="true"></span>
	<span class="ui-primary-btn__label">{label}</span>
	{
		trailingIconSrc ? (
			<img class="ui-primary-btn__icon" src={trailingIconSrc} alt="" width="13" height="14" loading="lazy" />
		) : null
	}
</a>
