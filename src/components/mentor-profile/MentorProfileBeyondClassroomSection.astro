---
import type { CollectionEntry } from 'astro:content';
import { mentorProfileAssets } from './data';

type BeyondContent = CollectionEntry<'mentor-profile'>['data']['beyondClassroom'];

interface Props {
	content: BeyondContent;
}

const { content } = Astro.props as Props;

const iconUrls = [
	mentorProfileAssets.beyondIcon1Url,
	mentorProfileAssets.beyondIcon2Url,
	mentorProfileAssets.beyondIcon3Url,
	mentorProfileAssets.beyondIcon4Url,
];

const iconBackgrounds = ['bg-[#eff6ff]', 'bg-[#f5f3ff]', 'bg-[#ecfdf5]', 'bg-[#fffacf]'];

const items = content.items.map((item, index) => ({
	...item,
	iconUrl: iconUrls[index] ?? iconUrls[0],
	iconBg: iconBackgrounds[index] ?? iconBackgrounds[0],
}));
---

<section class="bg-white  py-14  md:py-20" aria-labelledby="beyond-classroom-title">
	<div class="mx-auto flex w-full px-5 max-w-[1352px] flex-col gap-12">
		<header>
			<h2 class="xl:text-[44px] text-[32px] font-bold leading-[1.1] text-[#111827]" id="beyond-classroom-title">{content.title}</h2>
			<p class="pt-5 text-[20px] font-medium leading-[30px] text-[#475569]">{content.description}</p>
		</header>

		<ul class="grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 xl:grid-cols-4 xl:gap-[30px]">
			{
				items.map((item) => (
					<li class="rounded-[32px] border border-[#e2e8f0] bg-white px-5 py-[30px]">
						<span class={`inline-flex h-16 w-16 items-center justify-center rounded-2xl ${item.iconBg}`}>
							<img class="h-7 w-7" src={item.iconUrl} alt="" aria-hidden="true" />
						</span>
						<h3 class="pt-[24px] pb-[8px] text-[17px] font-semibold leading-[30px] text-[#111827]">{item.title}</h3>
						<p class="text-base leading-[26px] text-[#475569] h-[94px]">{item.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
