---
import type { CollectionEntry } from 'astro:content';
import { mentorProfileAssets } from './data';

type InsideClassroomContent = CollectionEntry<'mentor-profile'>['data']['insideClassroom'];

interface Props {
	content: InsideClassroomContent;
}

const { content } = Astro.props as Props;
---

<section class="bg-[#f8fafc] px-5 pb-20 md:px-16" aria-labelledby="inside-classroom-title">
	<div class="mx-auto flex w-full max-w-[1312px] flex-col gap-12">
		<header>
			<h2 class="text-[44px] font-bold leading-[1.1] text-[#111827] mt-3" id="inside-classroom-title">{content.title}</h2>
			<p class="mt-2 text-[18px] leading-[27px] text-[#475569]">{content.description}</p>
		</header>

		<div class="flex flex-col lg:flex-row gap-6 xl:h-[600px] md:h-[520px]">
			<article class="relative h-[420px] overflow-hidden rounded-[32px] shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1),0_2px_4px_-2px_rgba(0,0,0,0.1)] md:h-[520px] xl:h-[600px] w-full lg:max-w-[58%] max-w-full">
				<img class="h-full w-full object-cover" src={mentorProfileAssets.classroomMainImageUrl} alt="Classroom chemistry experiment session" />
				<div class="absolute inset-0 flex items-center justify-center bg-[rgba(0,0,0,0.2)]">
					<span class="relative inline-flex h-20 w-20 items-center justify-center rounded-full bg-white shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)]">
						<img class="h-[30px] w-[22.5px]" src={mentorProfileAssets.classroomPlayIconUrl} alt="" aria-hidden="true" />
					</span>
				</div>
				<span class="absolute bottom-6 left-6 rounded-full bg-[rgba(255,255,255,0.9)] px-4 py-2 text-sm font-bold leading-[21px] text-[#111827] backdrop-blur-[2px]">
					{content.mainVideoLabel}
				</span>
			</article>

			<div class="grid grid-cols-1 gap-6 xl:h-[600px] xl:grid-rows-2 flex-1 md:h-[520px]">
				<article class="relative h-[288px] overflow-hidden rounded-[32px] shadow-[0_1px_2px_rgba(0,0,0,0.05)]">
					<img class="h-full w-full object-cover" src={mentorProfileAssets.classroomProjectImageUrl} alt="Student molecule visualization project" />
					<span class="absolute right-4 top-4 rounded-full bg-[#7c3aed] px-3 py-1 text-xs font-bold leading-[18px] text-white">{content.projectBadge}</span>
					<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[rgba(0,0,0,0.6)] to-[rgba(0,0,0,0)] p-6">
						<p class="text-base font-semibold leading-6 text-white">{content.projectTitle}</p>
					</div>
				</article>

				<article class="relative h-[288px] overflow-hidden rounded-[32px] shadow-[0_1px_2px_rgba(0,0,0,0.05)]">
					<img class="h-full w-full object-cover" src={mentorProfileAssets.classroomLiveImageUrl} alt="Live classroom breakthrough moment" />
					<span class="absolute right-4 top-4 rounded-full bg-[#0a9dfb] px-3 py-1 text-xs font-bold leading-[18px] text-white">{content.liveBadge}</span>
					<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[rgba(0,0,0,0.6)] to-[rgba(0,0,0,0)] p-6">
						<p class="text-base font-semibold leading-6 text-white">{content.liveTitle}</p>
					</div>
				</article>
			</div>
		</div>
	</div>
</section>
