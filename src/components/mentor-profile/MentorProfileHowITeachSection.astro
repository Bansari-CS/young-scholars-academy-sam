---
import type { CollectionEntry } from 'astro:content';
import { mentorProfileAssets } from './data';

type HowITeachContent = CollectionEntry<'mentor-profile'>['data']['howITeach'];

interface Props {
	content: HowITeachContent;
}

const { content } = Astro.props as Props;

const iconUrls = [
	mentorProfileAssets.teachIcon1Url,
	mentorProfileAssets.teachIcon2Url,
	mentorProfileAssets.teachIcon3Url,
	mentorProfileAssets.teachIcon4Url,
];

const iconBackgrounds = ['bg-[#f5f3ff]', 'bg-[#eff6ff]', 'bg-[#ecfdf5]', 'bg-[#fffacf]'];

const cards = content.cards.map((card, index) => ({
	...card,
	iconUrl: iconUrls[index] ?? iconUrls[0],
	iconBg: iconBackgrounds[index] ?? iconBackgrounds[0],
}));
---

<section class="bg-[#f8fafc] px-5 py-14 md:px-12 md:py-20 lg:px-16" aria-labelledby="how-teach-title">
	<div class="mx-auto flex w-full max-w-[1312px] flex-col gap-12">
		<header class="text-center">
			<h2 class="mt-1 text-[32px] font-bold leading-tight text-[#111827] md:text-[44px]" id="how-teach-title">
				{content.title}
			</h2>
			<p class="mx-auto mt-4 max-w-[672px] text-base leading-[26px] text-[#475569]">
				{content.description}
			</p>
		</header>

		<ul class="grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 xl:grid-cols-4">
			{
				cards.map((card) => (
					<li class="flex min-h-[344px] flex-col items-center rounded-[32px] border border-[#e2e8f0] bg-white px-8 py-10 text-center shadow-[0_1px_1px_rgba(0,0,0,0.05)]">
						<span class={`mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl ${card.iconBg}`}>
							<img class="h-8 w-8" src={card.iconUrl} alt="" aria-hidden="true" />
						</span>
						<h3 class="pb-4 text-[17px] font-semibold leading-[30px] text-[#111827]">{card.title}</h3>
						<p class="w-full max-w-[214px] text-base leading-[26px] text-[#475569]">
							{card.lines.map((line) => (
								<>
									{line}
									<br />
								</>
							))}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
