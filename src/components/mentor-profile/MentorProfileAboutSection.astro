---
import type { CollectionEntry } from 'astro:content';

type AboutContent = CollectionEntry<'mentor-profile'>['data']['about'];

interface Props {
	content: AboutContent;
	mentorName?: string;
}

const { content, mentorName } = Astro.props as Props;
const aboutTitle = mentorName?.trim() ? `About ${mentorName.trim()}` : content.title;
---

<section class="bg-white px-5 py-14 md:px-16 md:py-20" aria-labelledby="mentor-about-title">
	<div class="mx-auto flex w-full max-w-[1312px] flex-col gap-8 lg:flex-row lg:justify-between">
		<div class="w-full max-w-[410.66px] max-h[70px]">
			<h2 class="xl:text-[44px] text-[32px] max-h[70px] font-bold leading-[1.1] text-[#111827]" id="mentor-about-title">{aboutTitle}</h2>
			<div class="mt-4 h-[6px] w-20 rounded-full bg-[#7c3aed]"></div>
		</div>

		<div class="w-full max-w-[821.34px] space-y-8">
			{content.paragraphs.map((paragraph) => <p class="text-base leading-[26px] text-[#475569]">{paragraph}</p>)}
		</div>
	</div>
</section>
