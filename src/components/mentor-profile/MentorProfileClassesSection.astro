---
import { mentorProfileAssets } from './data';
---

<section class="relative z-10 bg-white px-5 py-14 md:px-16 md:py-20" aria-labelledby="classes-title">
	<div class="mx-auto flex w-full max-w-[1312px] flex-col gap-12">
		<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
			<div>
				<h2 class="text-[44px] font-bold leading-[1.1] text-[#111827]" id="classes-title">Classes Taught by Emily</h2>
				<p class="mt-2 text-base leading-[26px] text-[#475569]">Engaging, high-level courses for curious minds.</p>
			</div>
			<a class="inline-flex items-center gap-2 text-sm font-bold leading-[21px] text-[#7c3aed] no-underline" href="#">
				<span>View All Classes</span>
				<img class="h-[14px] w-[12.25px]" src={mentorProfileAssets.classesViewAllArrowUrl} alt="" aria-hidden="true" />
			</a>
		</div>

		<div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
			<article class="h-[612px] overflow-hidden rounded-[32px] border border-[#e2e8f0] bg-white">
				<div class="relative h-[300px]">
					<img class="h-full w-full object-cover" src={mentorProfileAssets.classesMainImageUrl} alt="Alchemy to Atoms class cover" />
					<span class="absolute left-6 top-6 rounded-full bg-[rgba(255,255,255,0.9)] px-4 py-[6px] text-xs font-bold uppercase tracking-[0.6px] text-[#7c3aed] backdrop-blur-[4px]">
						Ages 10-14
					</span>
				</div>
				<div class="h-[312px] p-10">
					<h3 class="text-[17px] font-semibold leading-[30px] text-[#111827]">Alchemy to Atoms</h3>
					<p class="mt-4 text-base leading-[26px] text-[#475569]">
						A deep dive into the history of chemistry, from ancient mysteries to modern molecular science. Perfect for kids who love to ask "why?" about the physical world.
					</p>
					<div class="mt-6 flex items-center justify-between border-t border-[#e2e8f0] pt-8">
						<div>
							<p class="text-xs font-medium uppercase tracking-[1px] text-[#94a3b8]">Starts</p>
							<p class="text-[17px] font-semibold leading-[27px] text-[#111827]">Oct 12th</p>
						</div>
						<a class="inline-flex items-center justify-center rounded-xl bg-[#0a9dfb] px-8 py-[14px] text-base font-semibold leading-6 text-white no-underline" href="#">
							Enroll Now
						</a>
					</div>
				</div>
			</article>

			<article class="flex min-h-[612px] flex-col items-center justify-center rounded-[32px] border border-dashed border-[#cbd5e1] bg-[#f8fafc] px-8 text-center md:px-[100px]">
				<span class="mb-6 inline-flex h-20 w-20 items-center justify-center rounded-full bg-white shadow-[0_1px_1px_rgba(0,0,0,0.05)]">
					<img class="h-[30px] w-[26.25px]" src={mentorProfileAssets.classesPlusIconUrl} alt="" aria-hidden="true" />
				</span>
				<h3 class="text-[30px] font-semibold leading-[36px] text-[#111827]">New Course Coming Soon</h3>
				<p class="mt-2 text-base leading-6 text-[#64748b]">Dr. Ross is currently developing "Neurobiology of Genius".</p>
				<a class="mt-8 inline-flex items-center gap-2 text-sm font-bold leading-[21px] text-[#7c3aed] no-underline" href="#">
					<span>Get Notified</span>
					<img class="h-4 w-[14px]" src={mentorProfileAssets.classesNotifyArrowUrl} alt="" aria-hidden="true" />
				</a>
			</article>
		</div>
	</div>
</section>
