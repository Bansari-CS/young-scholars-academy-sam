---
import type { CollectionEntry } from 'astro:content';
import { mentorProfileAssets } from './data';

type StudentExperienceContent = CollectionEntry<'mentor-profile'>['data']['studentExperience'];

interface Props {
	content: StudentExperienceContent;
}

const { content } = Astro.props as Props;

const iconUrls = [
	mentorProfileAssets.studentExperienceIcon1Url,
	mentorProfileAssets.studentExperienceIcon2Url,
	mentorProfileAssets.studentExperienceIcon3Url,
];

const iconBackgrounds = ['bg-[#7c3aed]', 'bg-[#0a9dfb]', 'bg-[#048c3c]'];

const pillars = content.items.map((item, index) => ({
	...item,
	body: item.lines,
	icon: iconUrls[index] ?? iconUrls[0],
	iconBg: iconBackgrounds[index] ?? iconBackgrounds[0],
}));
---

<section class="relative overflow-hidden bg-[#111827] py-14  md:py-20" aria-labelledby="student-experience-title">
	<img class="pointer-events-none absolute inset-0 h-full w-full object-cover" src={mentorProfileAssets.studentExperienceBgUrl} alt="" aria-hidden="true" />
	<div class="relative mx-auto flex w-full px-16 max-w-[1312px] flex-col gap-16 ">
		<header class="max-w-[672px]">
			<h2 class="text-[44px] font-bold leading-[1.1] text-white mt-3" id="student-experience-title">{content.title}</h2>
			<p class="mt-6 text-base font-semibold leading-6 text-white max-w-[611px]">{content.description}</p>
		</header>

		<ul class="grid list-none grid-cols-1 gap-12 p-0 md:grid-cols-2 lg:grid-cols-3">
			{
				pillars.map((pillar) => (
					<li class="space-y-4">
						<span class={`inline-flex h-12 w-12 items-center justify-center rounded-xl ${pillar.iconBg}`}>
							<img class="h-4 w-5" src={pillar.icon} alt="" aria-hidden="true" />
						</span>
						<h3 class="pt-2 text-[17px] font-semibold leading-8 text-white">{pillar.title}</h3>
						<p class="text-base font-semibold leading-6 text-white">
							{pillar.body.map((line) => (
								<>
									{line}
									<br />
								</>
							))}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
