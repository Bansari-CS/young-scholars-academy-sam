---
interface TestimonialItem {
	quote: string;
	name: string;
	role: string;
	imageUrl?: string;
}

interface Props {
	content: {
		title: string;
		items: TestimonialItem[];
	};
}

const { content } = Astro.props;

const defaultImages = ['/assets/images/testimonial1.jpg', '/assets/images/testimonial2.jpg'] as const;

const quoteIcons = [
	{
		fill: '#0084FF',
		border: 'border-[#0084ff]',
	},
	{
		fill: '#7C3AED',
		border: 'border-[#7c3aed]',
	},
] as const;
---

<section
	class="overflow-hidden bg-[#111827] bg-[radial-gradient(158.45%_146.94%_at_100%_0%,rgba(124,58,237,0.15)_0%,rgba(124,58,237,0)_100%),linear-gradient(90deg,#081738_0%,#2b1f63_100%)] px-6 py-24 lg:px-[120px]"
>
	<div class="mx-auto w-full max-w-[1200px]">
		<h2 class="text-center text-[30px] font-bold leading-[1.15] tracking-[-0.02em] text-white md:text-[44px]">{content.title}</h2>
		<div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
			{
				content.items.map((item, index) => {
					const style = quoteIcons[index] ?? quoteIcons[0];
					const imageSrc = item.imageUrl ?? defaultImages[index] ?? defaultImages[0];
					return (
						<article class="rounded-3xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.05)] p-8 md:p-10">
							<div class="mb-4">
								<svg width="32" height="36" viewBox="0 0 32 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path
										d="M0 15.6875C0 11.0258 3.77578 7.25 8.4375 7.25H9C10.2445 7.25 11.25 8.25547 11.25 9.5C11.25 10.7445 10.2445 11.75 9 11.75H8.4375C6.26484 11.75 4.5 13.5148 4.5 15.6875V16.25H9C11.482 16.25 13.5 18.268 13.5 20.75V25.25C13.5 27.732 11.482 29.75 9 29.75H4.5C2.01797 29.75 0 27.732 0 25.25V23V20.75V15.6875ZM18 15.6875C18 11.0258 21.7758 7.25 26.4375 7.25H27C28.2445 7.25 29.25 8.25547 29.25 9.5C29.25 10.7445 28.2445 11.75 27 11.75H26.4375C24.2648 11.75 22.5 13.5148 22.5 15.6875V16.25H27C29.482 16.25 31.5 18.268 31.5 20.75V25.25C31.5 27.732 29.482 29.75 27 29.75H22.5C20.018 29.75 18 27.732 18 25.25V23V20.75V15.6875Z"
										fill={style.fill}
									/>
								</svg>
							</div>
							<p class="text-base italic leading-[26px] text-[#f0f4ff]">"{item.quote}"</p>
							<div class="mt-8 flex items-center gap-4">
								<img
									src={imageSrc}
									alt={item.name}
									width={56}
									height={56}
									loading="lazy"
									decoding="async"
									class={`h-14 w-14 shrink-0 rounded-full border-2 object-cover object-center ${style.border}`}
								/>
								<div>
									<p class="text-sm font-medium text-white">{item.name}</p>
									<p class="text-xs text-[#c7d5fe]">{item.role}</p>
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</div>
</section>
