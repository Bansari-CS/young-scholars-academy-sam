---
import GradientCtaSection from '../common/GradientCtaSection.astro';

interface Props {
	content: {
		title: string;
		description: string;
		buttonLabel: string;
		buttonHref: string;
		inputPlaceholder: string;
		footnote: string;
	};
}

const { content } = Astro.props;
---

<GradientCtaSection
	title={content.title}
	description={content.description}
	primaryCta={{ label: content.buttonLabel, href: content.buttonHref }}
	layout="newsletter"
	newsletterPlaceholder={content.inputPlaceholder}
	newsletterButtonLabel={content.buttonLabel}
	newsletterPrivacyText={content.footnote}
/>
