---
import featuredImg from '../../assets/images/featuredImg.jpg';
---

<section class="mx-auto w-full max-w-[1200px] px-6 pb-24 pt-6">
	<div class="mb-10 flex items-end justify-between">
		<h2 class="text-[30px] font-bold leading-[1.15] tracking-[-0.02em] md:text-[44px]">Featured Insights</h2>
		<a href="#" class="inline-flex items-center gap-1 text-base font-semibold text-[#0a9dfb]">
			<span>View all</span>
			<svg width="11" height="12" viewBox="0 0 11 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<path d="M10.2807 6.5C10.5736 6.20711 10.5736 5.73223 10.2807 5.43934L6.53067 1.68934C6.23778 1.39645 5.7629 1.39645 5.47001 1.68934C5.17712 1.98223 5.17712 2.45711 5.47001 2.75L7.93934 5.21933H0.75C0.335786 5.21933 0 5.55511 0 5.96933C0 6.38354 0.335786 6.71933 0.75 6.71933H7.93734L5.47334 9.18933C5.18045 9.48222 5.18045 9.9571 5.47334 10.25C5.76623 10.5429 6.24111 10.5429 6.534 10.25L10.284 6.5H10.2807Z" fill="currentColor"/>
			</svg>
		</a>
	</div>
	<div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
		<article class="overflow-hidden rounded-3xl border border-[rgba(226,232,240,0.7)] bg-white shadow-sm md:col-span-2 md:grid md:h-[536px] md:grid-cols-2">
			<img src={featuredImg.src} alt="Featured insight" class="h-[300px] w-full object-cover md:h-[536px]" />
			<div class="flex flex-col justify-between p-6 md:p-10">
				<div>
					<div class="mb-4 flex items-center gap-4">
						<span class="rounded-2xl bg-[#e1f3ff] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.55px] text-[#0a9dfb]">Gifted & 2e</span>
						<span class="inline-flex items-center gap-2 text-sm text-[rgba(71,85,105,0.7)]">
							<svg width="14" height="15" viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
