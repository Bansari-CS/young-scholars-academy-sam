---
import GradientCtaSection from '../common/GradientCtaSection.astro';
const arrowRightIcon = '/assets/course-detail/icon-arrow-right.svg';
---

<div class="mb-24 mt-6">
	<GradientCtaSection
		variant="dark"
		title="You Don’t Have to Figure This Out Alone"
		description="Join our vibrant community of parents, educators, and experts dedicated to helping every child find their path."
		primaryCta={{ label: 'Find My Child’s Best Fit', href: '#' }}
		primaryTrailingIcon={arrowRightIcon}
		secondaryCta={{ label: 'Explore Programs', href: '#' }}
		showPrimaryArrow={true}
	/>
</div>
