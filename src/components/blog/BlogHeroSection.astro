---
interface Props {
	content: {
		badge: string;
		titleLine1: string;
		titleHighlight: string;
		description: string;
		primaryCtaLabel: string;
		primaryCtaHref: string;
		secondaryCtaLabel: string;
		secondaryCtaHref: string;
	};
}

const { content } = Astro.props;
---

<section
	class="bg-[radial-gradient(98.86%_86.83%_at_50%_0%,rgba(124,58,237,0.05)_0%,rgba(124,58,237,0)_50%)] px-6 pb-20 pt-16 md:pb-24 md:pt-20 lg:px-[120px]"
>
	<div class="mx-auto w-full max-w-[1200px]">
		<div class="mx-auto mb-8 flex w-fit items-center gap-2 rounded-full border border-[#e0e9ff] bg-white px-4 py-2 shadow-sm">
			<span class="h-2 w-2 rounded-full bg-[#048c3c]"></span>
			<span class="text-xs font-medium tracking-[0.3px] text-[#7c3aed]">{content.badge}</span>
		</div>
		<h1 class="mx-auto max-w-[840px] text-center text-[34px] font-bold leading-[1.15] tracking-[-0.02em] md:text-[52px]">
			{content.titleLine1}
			<span class="block bg-gradient-to-r from-[#0084ff] to-[#7c3aed] bg-clip-text text-transparent">{content.titleHighlight}</span>
		</h1>
		<p class="mx-auto mt-6 max-w-[760px] text-center text-lg leading-[32px] text-[#475569]">
			{content.description}
		</p>
		<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
			<a href={content.primaryCtaHref} class="inline-flex items-center gap-1 rounded-xl bg-[#0a9dfb] px-8 py-4 text-base font-medium text-white shadow-[0px_2px_16px_-4px_rgba(0,0,0,0.06)]">
				<span>{content.primaryCtaLabel}</span>
				<svg width="11" height="12" viewBox="0 0 11 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path d="M10.2807 6.5C10.5736 6.20711 10.5736 5.73223 10.2807 5.43934L6.53067 1.68934C6.23778 1.39645 5.7629 1.39645 5.47001 1.68934C5.17712 1.98223 5.17712 2.45711 5.47001 2.75L7.93934 5.21933H0.75C0.335786 5.21933 0 5.55511 0 5.96933C0 6.38354 0.335786 6.71933 0.75 6.71933H7.93734L5.47334 9.18933C5.18045 9.48222 5.18045 9.9571 5.47334 10.25C5.76623 10.5429 6.24111 10.5429 6.534 10.25L10.284 6.5H10.2807Z" fill="currentColor"/>
				</svg>
			</a>
			<a href={content.secondaryCtaHref} class="rounded-xl border border-[#0a9dfb] bg-white px-8 py-4 text-base font-medium text-[#111827]">{content.secondaryCtaLabel}</a>
		</div>
	</div>
</section>
