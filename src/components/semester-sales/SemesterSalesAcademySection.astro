---
import { semesterSalesAssets } from './data';

interface Props {
	content: {
		eyebrow: string;
		title: string;
		description: string;
		features: string[];
		badgeTitle: string;
		badgeDescription: string;
	};
}

const { content } = Astro.props as Props;
const featureIcons = [
	semesterSalesAssets.academyGroupIconUrl,
	semesterSalesAssets.academyDiscussionIconUrl,
	semesterSalesAssets.academyMentorIconUrl,
];
---

<section class="bg-white py-20" aria-labelledby="academy-title">
	<div class="mx-auto grid w-full max-w-[1440px] grid-cols-1 gap-12 px-5 md:px-16 lg:grid-cols-2 md:gap-16">
		<div class="relative order-2 xl:order-1">
			<div class="xl:h-[500px] h-full overflow-hidden rounded-3xl pt-[22px]">
				<img class="h-full w-full object-cover" src={semesterSalesAssets.academyMainImageUrl} alt="Students in an interactive academy class" />
			</div>

			<div class="absolute bottom-[-9px] right-[-8px] max-w-[300px] rounded-2xl border border-[#f1f5f9] bg-white p-6 shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)] md:right-[-32px]">
				<div class="flex items-center gap-3">
					<span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#0a9dfb]">
						<img class="h-4 w-[18px]" src={semesterSalesAssets.academyAccreditedIconUrl} alt="" aria-hidden="true" />
					</span>
					<p class="text-base font-bold leading-6 text-[#1e293b]">{content.badgeTitle}</p>
				</div>
				<p class="pt-2 text-sm leading-5 text-[#64748b]">
					{content.badgeDescription}
				</p>
			</div>
		</div>

		<div class="order-1 xl:order-2">
			<span class="rounded-full bg-[rgba(10,157,251,0.1)] px-4 py-2 text-xs font-bold uppercase tracking-[0.6px] text-[#0a9dfb]">
				{content.eyebrow}
			</span>
			<h2 class="pt-[46px] xl:text-[44px] md:text-[32px] text-[25px] font-bold xl:leading-[55px] md:leading-[45px] font-bold leading-[1.1] text-[#111827]" id="academy-title">
				{content.title}
			</h2>
			<p class="pt-[48px] text-base leading-[26px] text-[#475569] text-[16px] max-w-[571px]">
				{content.description}
			</p>

			<ul class="mt-[45px] list-none space-y-4 p-0">
				{
					content.features.map((item, index) => (
						<li class="flex items-center gap-4 rounded-xl border border-[#f1f5f9] bg-[#f8fafc] p-4">
							<img class="h-6 w-6" src={featureIcons[index] ?? featureIcons[0]} alt="" aria-hidden="true" />
							<span class="text-[17px] font-semibold leading-6 text-[#1e293b]">{item}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
