---
import { semesterSalesAssets } from './data';

interface Props {
	content: {
		title: string;
		description: string;
		items: { title: string; description: string }[];
		ctaLabel: string;
		ctaHref: string;
	};
}

const { content } = Astro.props as Props;
const subjectImages = [
	semesterSalesAssets.subjectImageAiUrl,
	semesterSalesAssets.subjectImageMinecraftUrl,
	semesterSalesAssets.subjectImageDebateUrl,
	semesterSalesAssets.subjectImageWritingUrl,
];
---

<section class="bg-[#f8fafc] py-20" aria-labelledby="subjects-title">
	<div class="mx-auto w-full max-w-[1440px] px-5 md:px-16">
		<header class="text-center">
			<h2 class="xl:text-[44px] md:text-[32px] text-[25px] font-bold xl:leading-[55px] md:leading-[45px] font-bold leading-[1.1] text-[#111827]" id="subjects-title">{content.title}</h2>
			<p class="mx-auto mt-[28px] max-w-[696px] text-[16px] leading-[26px] text-[#475569]">
				{content.description}
			</p>
		</header>

		<ul class="mt-12 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 xl:grid-cols-4">
			{
				content.items.map((subject, index) => (
					<li class="rounded-2xl border border-[#e2e8f0] bg-white p-6">
						<div class="h-[140px] overflow-hidden rounded-xl">
							<img class="h-full w-full object-cover" src={subjectImages[index] ?? subjectImages[0]} alt={`${subject.title} course`} />
						</div>
						<h3 class="pt-4 text-[17px] font-semibold leading-6 text-[#111827]">{subject.title}</h3>
						<p class="pt-[16px] text-base leading-[26px] text-[#475569]">{subject.description}</p>
					</li>
				))
			}
		</ul>

		<div class="mt-[67px] flex justify-center">
			<a class="inline-flex h-[60px] items-center justify-center rounded-xl bg-[#0a9dfb] px-12 py-4 text-base font-medium text-white no-underline shadow-[0_10px_15px_-3px_rgba(0,0,0,0.1),0_4px_6px_-4px_rgba(0,0,0,0.1)]" href={content.ctaHref}>
				{content.ctaLabel}
			</a>
		</div>
	</div>
</section>
