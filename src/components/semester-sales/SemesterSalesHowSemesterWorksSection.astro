---
import { semesterSalesAssets } from './data';

interface Props {
	content: {
		title: string;
		points: { title: string; text: string }[];
		highlight: string;
	};
}

const { content } = Astro.props as Props;
const pointVisuals = [
	{ iconType: 'number', number: '11' },
	{ iconType: 'image', icon: semesterSalesAssets.semesterWorkClockIconUrl },
	{ iconType: 'image', icon: semesterSalesAssets.semesterWorkGroupIconUrl },
];
---

<section class="bg-white py-20" aria-labelledby="semester-works-title">
	<div class="mx-auto grid w-full max-w-[1440px] lg:grid-cols-1 lg:gap-12 gap-4 px-5 md:px-16 lg:grid-cols-2 lg:gap-16 mt-[6px] leading-[51px]">
		<div>
			<h2 class="xl:text-[44px] md:text-[32px] text-[25px] font-bold xl:leading-[55px] md:leading-[45px] font-bold leading-[1.1] text-[#111827]" id="semester-works-title">
				{content?.title}
			</h2>

			<ul class="mt-8 list-none space-y-6 p-0">
				{
					content.points.map((point, index) => (
						<li class="flex items-start gap-4 pt-[9px]">
							<span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#f1f5f9]">
								{pointVisuals[index]?.iconType === 'number' ? (
									<span class="text-base font-bold text-[#0a9dfb]">{pointVisuals[index]?.number}</span>
								) : (
									<img class="h-4 w-5" src={pointVisuals[index]?.icon ?? semesterSalesAssets.semesterWorkClockIconUrl} alt="" aria-hidden="true" />
								)}
							</span>
							<div>
								<h3 class="text-[17px] font-semibold leading-7 text-[#111827]">{point.title}</h3>
								<p class="pt-0 text-base leading-[26px] text-[#475569]">{point.text}</p>
							</div>
						</li>
					))
				}
			</ul>

			<div class="mt-8 rounded-r-xl border-l-4 border-[#0a9dfb] bg-[rgba(10,157,251,0.05)] p-6">
				<p class="text-[18px] font-bold leading-7 text-[#0a9dfb]">
					{content.highlight}
				</p>
			</div>
		</div>

		<div class="h-[500px] overflow-hidden rounded-3xl mt-[34px]">
			<img class="h-full w-full object-cover" src={semesterSalesAssets.semesterWorkImageUrl} alt="Students in live semester class on screen" />
		</div>
	</div>
</section>
