---
import { semesterSalesAssets } from './data';

const points = [
	{
		iconType: 'number',
		number: '11',
		title: '11-Week Format',
		text: 'A full semester of deep-dive learning that allows for genuine mastery and curiosity-led exploration.',
	},
	{
		iconType: 'image',
		icon: semesterSalesAssets.semesterWorkClockIconUrl,
		title: '50-Minute Sessions',
		text: 'Optimized for engagement—long enough for depth, but designed to keep brilliant minds focused.',
	},
	{
		iconType: 'image',
		icon: semesterSalesAssets.semesterWorkGroupIconUrl,
		title: 'Consistent Cohorts',
		text: 'Same group, same mentor. This builds the consistency and emotional safety required for real growth.',
	},
];
---

<section class="bg-white py-20" aria-labelledby="semester-works-title">
	<div class="mx-auto grid w-full max-w-[1312px] grid-cols-1 gap-12 px-5 md:px-16 xl:grid-cols-2 xl:gap-16">
		<div>
			<h2 class="text-[44px] font-bold leading-[1.1] text-[#111827]" id="semester-works-title">
				How Our Semester Courses Work
			</h2>

			<ul class="mt-8 list-none space-y-6 p-0">
				{
					points.map((point) => (
						<li class="flex items-start gap-4">
							<span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#f1f5f9]">
								{point.iconType === 'number' ? (
									<span class="text-base font-bold text-[#0a9dfb]">{point.number}</span>
								) : (
									<img class="h-4 w-5" src={point.icon} alt="" aria-hidden="true" />
								)}
							</span>
							<div>
								<h3 class="text-[28px] font-semibold leading-7 text-[#111827]">{point.title}</h3>
								<p class="pt-1 text-base leading-[26px] text-[#475569]">{point.text}</p>
							</div>
						</li>
					))
				}
			</ul>

			<div class="mt-8 rounded-r-xl border-l-4 border-[#0a9dfb] bg-[rgba(10,157,251,0.05)] p-6">
				<p class="text-[18px] font-bold leading-7 text-[#0a9dfb]">
					This is where learning becomes something your child actually looks forward to every week.
				</p>
			</div>
		</div>

		<div class="h-[500px] overflow-hidden rounded-3xl">
			<img class="h-full w-full object-cover" src={semesterSalesAssets.semesterWorkImageUrl} alt="Students in live semester class on screen" />
		</div>
	</div>
</section>
