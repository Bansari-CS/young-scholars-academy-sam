---
import { semesterSalesAssets } from './data';

const items = [
	{
		title: 'Live Interaction',
		text: 'Not passive video watching. Real-time dialogue and problem-solving.',
	},
	{
		title: 'Cameras Optional',
		text: 'We respect sensory needs. Participate via voice or chat if preferred.',
	},
	{
		title: 'Flexible Scheduling',
		text: 'Classes available morning, afternoon, and evening to fit your life.',
	},
	{
		title: 'Global Peer Community',
		text: 'Connect with like-minded students from 40+ states and 13 countries.',
	},
];
---

<section class="bg-white py-20" aria-labelledby="virtual-works-title">
	<div class="mx-auto grid w-full max-w-[1312px] grid-cols-1 gap-12 px-5 md:px-16 lg:grid-cols-2 xl:gap-16 md:gap-8">
		<div class="relative order-2 xl:order-1">
			<div class="pointer-events-none absolute -left-10 -top-10 h-40 w-40 rounded-full bg-[rgba(242,221,53,0.2)] blur-[32px]" aria-hidden="true"></div>
			<div class="pointer-events-none absolute -bottom-10 -right-10 h-40 w-40 rounded-full bg-[rgba(10,157,251,0.2)] blur-[32px]" aria-hidden="true"></div>
			<div class="relative h-[450px] overflow-hidden rounded-[32px] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)]">
				<img class="h-full w-full object-cover" src={semesterSalesAssets.virtualWorksImageUrl} alt="Students in global online classroom grid" />
			</div>
		</div>

		<div class="order-1 xl:order-2">
			<h2 class="xl:text-[44px] md:text-[32px] text-[25px] font-bold xl:leading-[55px] md:leading-[45px] font-bold leading-[53px] text-[#111827] pt-[30px]" id="virtual-works-title">
				A Virtual Experience That Actually Works
			</h2>

			<ul class="mt-6 list-none space-y-4 p-0">
				{
					items.map((item) => (
						<li class="flex items-start gap-3">
							<span class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[rgba(4,140,60,0.1)]">
								<img class="h-3 w-[10.5px]" src={semesterSalesAssets.virtualWorksCheckIconUrl} alt="" aria-hidden="true" />
							</span>
							<div>
								<h3 class="text-[17px] font-semibold leading-6 text-[#111827]">{item.title}</h3>
								<p class="text-[15px] mt-0 leading-[26px] text-[#475569]">{item.text}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
