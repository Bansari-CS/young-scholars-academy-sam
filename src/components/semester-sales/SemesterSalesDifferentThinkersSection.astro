---
import { semesterSalesAssets } from './data';

interface Props {
	content: {
		title: string;
		cards: { title: string; text: string }[];
	};
}

const { content } = Astro.props as Props;
const cardIcons = [
	semesterSalesAssets.differentlyIconMentorUrl,
	semesterSalesAssets.differentlyIconClassUrl,
	semesterSalesAssets.differentlyIconEngageUrl,
];
const cardBackgrounds = ['bg-[rgba(124,58,237,0.1)]', 'bg-[rgba(10,157,251,0.1)]', 'bg-[rgba(4,140,60,0.1)]'];
---

<section class="bg-[#f8fafc] py-20" aria-labelledby="different-thinkers-title">
	<div class="mx-auto w-full max-w-[1440px] px-5 md:px-16">
		<h2 class="text-center xl:text-[44px] md:text-[32px] text-[25px] font-bold xl:leading-[55px] md:leading-[45px] font-bold leading-[1.1] text-[#111827] mt-[10px]" id="different-thinkers-title">
			{content.title}
		</h2>

		<ul class="xl:mt-[56px] mt-[30px] grid list-none md:grid-cols-1 lg:gap-8 gap-4 p-0 lg:grid-cols-3">
			{
				content.cards.map((card, index) => (
					<li class="rounded-3xl border border-[#e2e8f0] bg-white py-10 px-[20px] text-center shadow-[0_1px_1px_rgba(0,0,0,0.05)]">
						<span class={`mx-auto inline-flex h-20 w-20 items-center justify-center rounded-2xl ${cardBackgrounds[index] ?? cardBackgrounds[0]}`}>
							<img class="h-10 w-10" src={cardIcons[index] ?? cardIcons[0]} alt="" aria-hidden="true" />
						</span>
						<h3 class="pt-6 text-[17px] font-semibold leading-8 text-[#111827]">{card.title}</h3>
						<p class="pt-[22px] text-base leading-[26px] text-[#475569]">{card.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
