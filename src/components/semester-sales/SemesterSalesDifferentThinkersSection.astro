---
import { semesterSalesAssets } from './data';

const cards = [
	{
		title: 'Mentors Who Get It',
		text: 'Our mentors don’t just teach these kids—they often were these kids. They understand the quirks, the passions, and the intensity.',
		icon: semesterSalesAssets.differentlyIconMentorUrl,
		bg: 'bg-[rgba(124,58,237,0.1)]',
	},
	{
		title: 'Tiny Class Sizes',
		text: 'With only 6–8 students per class, every child has space to speak, experiment, and be truly heard by their mentor and peers.',
		icon: semesterSalesAssets.differentlyIconClassUrl,
		bg: 'bg-[rgba(10,157,251,0.1)]',
	},
	{
		title: 'Active Engagement',
		text: 'No lectures. No muted boxes. Students actively participate in deep exploration and connection every single session.',
		icon: semesterSalesAssets.differentlyIconEngageUrl,
		bg: 'bg-[rgba(4,140,60,0.1)]',
	},
];
---

<section class="bg-[#f8fafc] py-20" aria-labelledby="different-thinkers-title">
	<div class="mx-auto w-full max-w-[1440px] px-5 md:px-16">
		<h2 class="text-center xl:text-[44px] md:text-[32px] text-[25px] font-bold xl:leading-[55px] md:leading-[45px] font-bold leading-[1.1] text-[#111827] mt-[10px]" id="different-thinkers-title">
			Built Differently for Different Thinkers
		</h2>

		<ul class="xl:mt-[56px] mt-[30px] grid list-none md:grid-cols-1 lg:gap-8 gap-4 p-0 lg:grid-cols-3">
			{
				cards.map((card) => (
					<li class="rounded-3xl border border-[#e2e8f0] bg-white py-10 px-[20px] text-center shadow-[0_1px_1px_rgba(0,0,0,0.05)]">
						<span class={`mx-auto inline-flex h-20 w-20 items-center justify-center rounded-2xl ${card.bg}`}>
							<img class="h-10 w-10" src={card.icon} alt="" aria-hidden="true" />
						</span>
						<h3 class="pt-6 text-[17px] font-semibold leading-8 text-[#111827]">{card.title}</h3>
						<p class="pt-[22px] text-base leading-[26px] text-[#475569]">{card.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
