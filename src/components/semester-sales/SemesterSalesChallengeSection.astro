---
import { semesterSalesAssets } from './data';

const challenges = [
	'Your child finishes work in minutes... then disengages from learning entirely.',
	'They ask deeper, existential questions... but the school curriculum is rigid and shallow.',
	`They feel "different" and struggle to find a community where they truly belong.`,
	`You've tried high-end programs... but they deliver the same passive lecture style.`,
];
---

<section class="bg-white py-20" aria-labelledby="semester-sales-challenge-title">
	<div class="mx-auto w-full max-w-[1312px] px-5 md:px-16">
		<div class="flex flex-col items-center">
			<span class="rounded-full bg-[rgba(124,58,237,0.1)] px-4 py-2 text-xs font-bold uppercase tracking-[0.6px] text-[#7c3aed]">
				The Challenge
			</span>
			<h2 class="pt-4 text-center text-[44px] font-bold leading-[1.1] text-[#111827]" id="semester-sales-challenge-title">
				You’ve Been Searching for the Right Fit
			</h2>
		</div>

		<div class="mt-12 grid grid-cols-1 gap-8 xl:grid-cols-2">
			<div class="rounded-2xl border border-[#e2e8f0] bg-white p-8 shadow-[0_1px_1px_rgba(0,0,0,0.05)]">
				<ul class="list-none space-y-6 p-0">
					{
						challenges.map((line) => (
							<li class="flex items-start gap-4">
								<span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#fee2e2]">
									<img class="h-3 w-[9px]" src={semesterSalesAssets.challengeBulletIconUrl} alt="" aria-hidden="true" />
								</span>
								<p class="text-base leading-[26px] text-[#475569]">{line}</p>
							</li>
						))
					}
				</ul>
			</div>

			<aside class="flex items-center rounded-2xl border border-[#0a9dfb] bg-[#eff6ff] p-[30px]">
				<div>
					<p class="text-base font-medium leading-[26px] text-[#475569]">
						"You know your child is capable of so much more. They don't need a faster version of the same old school—they need a completely different environment."
					</p>
					<div class="mt-6 flex items-center gap-4">
						<span class="h-1 w-12 bg-[#0a9dfb]"></span>
						<p class="text-base font-bold leading-6 text-[#0a9dfb]">This is why we built YSA.</p>
					</div>
				</div>
			</aside>
		</div>
	</div>
</section>
