---
import type { CollectionEntry } from 'astro:content';
import GradientCtaSection from '../common/GradientCtaSection.astro';
import arrowRightIcon from '../../assets/course-detail/icon-arrow-right.svg';

type MentorFitCtaContent = CollectionEntry<'teachers'>['data']['mentorFitCta'];

interface Props {
	content: MentorFitCtaContent;
}

const { content } = Astro.props;
---

<GradientCtaSection
	title={content.title}
	description={content.description}
	primaryCta={{ label: content.buttonLabel, href: content.buttonHref }}
	primaryTrailingIcon={arrowRightIcon.src}
	footnote={content.footnote}
	primaryStyle="brand"
	fullWidth={true}
/>
