---
import type { CollectionEntry } from 'astro:content';

type HeroContent = CollectionEntry<'teachers'>['data']['hero'];

interface Props {
	content: HeroContent;
}

const { content } = Astro.props;
---

<section
	class="relative overflow-hidden bg-[#f8fafc]"
	aria-labelledby="teacher-listing-title"
	style="display: flex; height: 500px; padding: 100px 0 80px 0; flex-direction: column; justify-content: center; align-items: center;"
>
	<div class="pointer-events-none absolute left-[-160px] top-[-160px] h-[600px] w-[600px] rounded-full bg-[rgba(10,157,251,0.15)] blur-[102px]" aria-hidden="true"></div>
	<div class="pointer-events-none absolute bottom-[-80px] right-[-80px] h-[500px] w-[500px] rounded-full bg-[rgba(168,85,247,0.15)] blur-[72px]" aria-hidden="true"></div>

	<div class="relative z-10 mx-auto max-w-[896px] text-center">
	<div class="pb-0">
		<p class="mx-auto inline-flex items-center gap-2 rounded-full border border-[#e0e9ff] bg-white px-4 py-2 text-xs font-medium tracking-[0.3px] text-[#7c3aed] shadow-[0px_1px_1px_rgba(0,0,0,0.05)]">
			<span class="h-2 w-2 rounded-full bg-[#048c3c]" aria-hidden="true"></span>
			{content.eyebrow}
		</p>
		</div>
		<h1
  class="mx-auto mt-6 max-w-[780px] text-center text-[44px] font-bold text-[#111827]"
  id="teacher-listing-title"
  style="font-family: 'Plus Jakarta Sans'; font-style: normal; line-height: normal; margin-top: 50px; line-height: 55px;"
>
  {content.title}
</h1>
		<p
  class="mx-auto mt-4 max-w-[672px] text-center text-[16px] font-normal text-[#475569] leading-[28px] sm:text-[17px] md:text-[18px] md:leading-[32.5px]"
  style="font-style: normal;"
>
  {content.description}
</p>
	</div>
</section>
