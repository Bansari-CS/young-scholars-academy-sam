---
import type { CollectionEntry } from 'astro:content';
import { teacherPageAssets } from './data';

type AdminTeamContent = CollectionEntry<'teachers'>['data']['adminTeam'];

interface Props {
	content: AdminTeamContent;
}

const { content } = Astro.props;
---

<section class="bg-[#f8fafc] px-5 pb-20 md:px-12" aria-labelledby="admin-team-title">
	<header class="mx-auto w-full max-w-[1184px] px-0 pb-12 pt-20 text-center">
		<h2 class="text-4xl font-bold leading-tight text-[#111827] md:text-[44px]" id="admin-team-title">{content.title}</h2>
		<p class="mx-auto mt-4 max-w-[800px] text-base leading-[22px] text-[#475569]">
			{content.description}
		</p>
	</header>

	<ul class="mx-auto grid w-full max-w-[1184px] list-none grid-cols-1 gap-[30px] p-0 xl:grid-cols-2">
		{
			content.items.map((member) => (
				<li>
					<article class="flex h-full flex-col overflow-hidden rounded-3xl border border-[#e2e8f0] bg-white shadow-[0px_1px_2px_rgba(0,0,0,0.05)]">
						<div class="h-[370px] bg-[#f1f5f9]">
							<img class="h-full w-full object-cover" src={member.imageUrl} alt={`${member.name} profile`} loading="lazy" />
						</div>

						<div class="p-6">
							<div class="flex items-start justify-between pb-2">
								<h3
								class="m-0 text-[17px] font-semibold leading-[30px] text-[#111827]"
								style="font-family: 'Plus Jakarta Sans'; font-style: normal;"
								>
								{member.name}
								</h3>
								<span class="inline-flex items-center gap-1 text-base text-[#111827]">
									<img class="h-[15px] w-[15px]" src={teacherPageAssets.adminStarIconUrl} alt="" aria-hidden="true" />
									{member.rating}
								</span>
							</div>

							<p
							class="pb-3 font-semibold leading-[20px] text-[#0A9DFB] capitalize"
							style="font-family: 'Montserrat'; font-style: normal;"
							>
							{member.role}
							</p>
							<p class="pb-5 text-base leading-[38px] text-[#475569] md:leading-[26px]">{member.description}</p>

							<div class="border-t border-[#f1f5f9] pt-4">
								<a class="inline-flex items-center gap-2 text-sm font-bold leading-[21px] text-[#7c3aed] no-underline" href="#">
									<span>View Profile</span>
									<img class="h-[14px] w-[12.25px]" src={teacherPageAssets.arrowIconUrl} alt="" aria-hidden="true" />
								</a>
							</div>
						</div>
					</article>
				</li>
			))
		}
	</ul>
</section>
