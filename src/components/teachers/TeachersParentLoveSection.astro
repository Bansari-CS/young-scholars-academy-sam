---
import { parentLoveCards } from './data';
---

<section class="bg-white px-5 py-14 md:px-12 md:py-20" aria-labelledby="teacher-parent-love-title">
	<header class="text-center">
		<h2 class="text-4xl font-bold leading-tight text-[#111827] md:text-[44px]" id="teacher-parent-love-title">Why Parents Love Our Teachers</h2>
		<p class="mx-auto mt-4 max-w-[800px] text-base leading-[26px] text-[#475569]">
			Our mentors are more than just educators—they are experts in connecting with and inspiring gifted and 2e minds.
		</p>
	</header>

	<ul class="mx-auto mt-10 grid max-w-[1184px] list-none grid-cols-1 gap-6 p-0 md:mt-16 md:grid-cols-2 xl:grid-cols-4">
		{
			parentLoveCards.map((card) => (
				<li class="h-auto rounded-3xl border border-[#f1f5f9] bg-[#f8fafc] p-8 shadow-[0px_1px_1px_rgba(0,0,0,0.05)] md:h-[326px]">
					<span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white shadow-[0px_1px_1px_rgba(0,0,0,0.05)]">
						<img class="max-h-5 max-w-[17px]" src={card.iconUrl} alt="" aria-hidden="true" />
					</span>
					<h3 class="mt-4 text-[17px] font-semibold leading-[30px] text-[#111827]">{card.title}</h3>
					<p class="mt-2 text-base leading-[26px] text-[#475569]">{card.description}</p>
				</li>
			))
		}
	</ul>
</section>
