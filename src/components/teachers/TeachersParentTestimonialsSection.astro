---
import type { CollectionEntry } from 'astro:content';
import { teacherPageAssets } from './data';

type ParentTestimonialsContent = CollectionEntry<'teachers'>['data']['parentTestimonials'];

interface Props {
	content: ParentTestimonialsContent;
}

const { content } = Astro.props;
---

<section class="bg-[#f8fafc] px-5 py-20 md:px-12" aria-labelledby="parent-testimonials-title">
	<div class="mx-auto w-full max-w-[1180px] px-0">
		<header class="text-center">
			<h2 class="text-4xl font-bold leading-tight text-[#111827] md:text-[44px]" id="parent-testimonials-title">{content.title}</h2>
			<p class="mx-auto mt-4 max-w-[702px] text-base leading-[26px] text-[#475569]">
				{content.description}
			</p>
		</header>

		<ul class="mt-12 grid list-none grid-cols-1 gap-[30px] p-0 lg:grid-cols-3 lg:items-stretch">
			{
				content.items.map((testimonial) => (
					<li class="h-full min-h-0">
						<article
							class:list={[
								'relative flex h-full flex-col overflow-hidden rounded-[24px] border border-[#f1f5f9] p-10',
								testimonial.featured
									? 'bg-white shadow-[0px_20px_60px_0px_rgba(17,0,104,0.08)]'
									: 'bg-[#f8fafc] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]',
							]}
						>
							<img
								class="pointer-events-none absolute right-6 top-6 h-[60px] w-[52.5px] opacity-10"
								src={teacherPageAssets.quoteIconUrl}
								alt=""
								aria-hidden="true"
							/>

							<div class="flex gap-1 pb-6">
								{
									Array.from({ length: 5 }).map(() => (
										<img class="h-4 w-4" src={teacherPageAssets.parentTestimonialStarIconUrl} alt="" aria-hidden="true" />
									))
								}
							</div>

							<div
								class="mb-8 min-h-[176px] flex-1 basis-0 overflow-x-hidden overflow-y-auto overscroll-contain pr-1 [scrollbar-color:rgba(148,163,184,0.6)_transparent] [scrollbar-width:thin]"
							>
								<p class="text-[18px] leading-[29.25px] text-[#111827]">"{testimonial.quote}"</p>
							</div>

							<div class="mt-auto flex shrink-0 items-center gap-4 border-t border-[#e2e8f0] pt-8">
								<img
									class="h-12 w-12 shrink-0 rounded-full border-2 border-white object-cover object-center shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]"
									src={testimonial.imageUrl}
									alt={`${testimonial.name} avatar`}
									width={48}
									height={48}
									loading="lazy"
									decoding="async"
								/>
								<div class="min-w-0">
									<p class="text-base font-bold leading-6 text-[#111827]">{testimonial.name}</p>
									<p class="text-sm leading-5 text-[#64748b]">{testimonial.role}</p>
								</div>
							</div>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>
