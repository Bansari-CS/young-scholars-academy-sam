---
import type { CollectionEntry } from 'astro:content';

type ParentQuoteContent = CollectionEntry<'teachers'>['data']['parentQuote'];

interface Props {
	content: ParentQuoteContent;
}

const { content } = Astro.props;
---

<section class="border-y border-[#e2e8f0] bg-[#f8fafc] px-5 pb-16 md:px-12 md:pb-20" aria-label="Parent quote">
	<div class="flex flex-col items-center gap-4 pt-12">
		<div class="flex flex-col items-center gap-4 md:flex-row">
			<img class="h-12 w-12 rounded-full border-2 border-white object-cover shadow-[0px_1px_2px_rgba(0,0,0,0.05)]" src={content.avatarUrl} alt={content.avatarAlt} loading="lazy" />
			<p class="m-0 text-center text-[22px] italic font-medium leading-8 text-[#111827] md:text-2xl md:leading-9">
				“{content.quote}
				<strong class="font-bold text-[#7c3aed]">{content.highlightText}</strong>”
			</p>
		</div>
		<p class="m-0 text-sm leading-5 text-[#64748b]">{content.authorLine}</p>
	</div>
</section>
