---
import { teacherPageAssets } from './data';
---

<section class="bg-white px-5 pb-16 md:px-12 md:pb-20" aria-label="Parent quote">
	<div class="flex flex-col items-center gap-4">
		<div class="flex flex-col items-center gap-4 md:flex-row">
			<img class="h-12 w-12 rounded-full border-2 border-white object-cover shadow-[0px_1px_2px_rgba(0,0,0,0.05)]" src={teacherPageAssets.parentAvatarUrl} alt="Sarah L. portrait" loading="lazy" />
			<p class="m-0 text-center text-[22px] italic font-medium leading-8 text-[#111827] md:text-2xl md:leading-9">
				“Our mentors don’t just teach gifted and 2e kids —
				<strong class="font-bold text-[#7c3aed]">they were those kids.</strong>”
			</p>
		</div>
		<p class="m-0 text-sm leading-5 text-[#64748b]">— Sarah L., Parent of an 11-year-old scholar</p>
	</div>
</section>
