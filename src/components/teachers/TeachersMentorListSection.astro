---
import type { CollectionEntry } from 'astro:content';
import { teacherPageAssets, toneClasses } from './data';

type MentorsContent = CollectionEntry<'teachers'>['data']['mentors'];

interface Props {
	content: MentorsContent;
}

const { content } = Astro.props;
const toSlug = (value: string) =>
	value
		.toLowerCase()
		.trim()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');
---

<section class="bg-white px-5 pb-20 pt-14 md:px-12 md:pb-24 md:pt-12" aria-label="Mentor listing">
	<header class="text-center">
		<h2 class="text-4xl font-bold leading-tight text-[#111827] md:text-[44px]">{content.title}</h2>
		<p class="mx-auto mt-4 max-w-[800px] text-base leading-[26px] text-[#475569]">
			{content.description}
		</p>
	</header>

	<div class="mx-auto mt-12 flex w-full max-w-[1184px] flex-col gap-4 rounded-2xl border border-[rgba(226,232,240,0.5)] bg-white p-4 shadow-[0px_1px_1px_rgba(0,0,0,0.05)] lg:flex-row lg:items-center" role="search">
		<label class="relative flex flex-1 items-center rounded-full border border-[#e2e8f0] bg-[#f8fafc] px-4 pb-[14px] pl-12 pt-[13px]" for="mentor-search">
			<img class="absolute left-4 h-4 w-4" src={teacherPageAssets.searchIconUrl} alt="" aria-hidden="true" />
			<input class="w-full border-none bg-transparent text-sm leading-5 text-[#0f172a] outline-none placeholder:text-[#9ca3af]" id="mentor-search" type="search" name="mentorSearch" placeholder={content.searchPlaceholder} />
		</label>
		<div class="flex flex-wrap gap-2" aria-label="Categories">
			<button class="rounded-full border border-[#0a9dfb] bg-[#0a9dfb] px-6 py-2.5 text-sm font-medium leading-5 text-white" type="button">{content.filterLabels.all}</button>
			<button class="rounded-full border border-[#e2e8f0] bg-[#f8fafc] px-6 py-2.5 text-sm font-medium leading-5 text-[#475569]" type="button">{content.filterLabels.stem}</button>
			<button class="rounded-full border border-[#e2e8f0] bg-[#f8fafc] px-6 py-2.5 text-sm font-medium leading-5 text-[#475569]" type="button">{content.filterLabels.creative}</button>
			<button class="rounded-full border border-[#e2e8f0] bg-[#f8fafc] px-6 py-2.5 text-sm font-medium leading-5 text-[#475569]" type="button">{content.filterLabels.gaming}</button>
			<button class="rounded-full border border-[#e2e8f0] bg-[#f8fafc] px-6 py-2.5 text-sm font-medium leading-5 text-[#475569]" type="button">{content.filterLabels.writing}</button>
		</div>
	</div>

	<ul class="mx-auto mt-[42px] grid max-w-[1152px] list-none grid-cols-1 gap-5 p-0 lg:grid-cols-2 xl:grid-cols-3 xl:gap-[30px]">
		{
			content.items.map((mentor) => (
				<li>
					<a
						href={`/teachers/${toSlug(mentor.name)}`}
						class={`flex h-full flex-col overflow-hidden rounded-3xl border border-[#e2e8f0] bg-white no-underline ${mentor.featured ? 'shadow-[0_10px_40px_-10px_rgba(0,132,255,0.08),0_4px_12px_-4px_rgba(0,0,0,0.04)]' : ''}`}
					>
						<div class="relative h-[304px]">
							<img class="block h-full w-full object-cover" src={mentor.imageUrl} alt={`${mentor.name} profile`} loading="lazy" />
							{mentor.featured && <span class="absolute right-4 top-4 rounded-full bg-[#0a9dfb] px-3 py-1 text-[10px] font-bold leading-[15px] text-white">PEER FAVORITE</span>}
						</div>

						<div class="flex flex-col p-6">
							<div class="flex items-center justify-between">
								<h3 class="m-0 text-[17px] font-semibold leading-[30px] text-[#111827]" style="font-family: 'Plus Jakarta Sans'; font-style: normal;">
									{mentor.name}
								</h3>
								<span class="inline-flex items-center gap-1 text-xs leading-4 text-[#111827]">
									<img class="h-4 w-4" src={teacherPageAssets.starIconUrl} alt="" aria-hidden="true" />
									{mentor.rating}
								</span>
							</div>

							<p class="mt-2 text-[17px] leading-7 text-[#111827]">{mentor.credentials}</p>
							<p class="mt-3 text-base leading-[27px] text-[#475569]">
								{mentor.bio.map((line) => (
									<>
										{line}
										<br />
									</>
								))}
							</p>

							<ul class="mt-6 flex list-none flex-wrap gap-2 p-0">
								{
									mentor.tags.map((tag) => (
										<li class={`rounded-lg px-3 py-1 text-xs font-semibold leading-[5px] ${toneClasses[tag.tone]}`}>{tag.label}</li>
									))
								}
							</ul>

							<ul class="mt-6 grid list-none gap-2 border-t border-[#e2e8f0] pt-4">
								{
									mentor.facts.map((fact) => (
										<li class="flex items-center gap-2 text-xs leading-[18px] text-[#94a3b8]">
											<img class="h-4 w-4" src={teacherPageAssets.checkIconUrl} alt="" aria-hidden="true" />
											<span>{fact}</span>
										</li>
									))
								}
							</ul>

							<span class="mt-6 inline-flex items-center gap-2 text-sm font-bold leading-[25px] text-[#7c3aed]">
								<span>{content.viewProfileLabel}</span>
								<img class="h-[14px] w-[12.25px]" src={teacherPageAssets.arrowIconUrl} alt="" aria-hidden="true" />
							</span>
						</div>
					</a>
				</li>
			))
		}
	</ul>
</section>
