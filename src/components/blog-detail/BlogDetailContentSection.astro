---
interface OutlineItem {
	id: string;
	title: string;
}

interface Props {
	content: {
		breadcrumbHomeLabel: string;
		breadcrumbInsightsLabel: string;
		breadcrumbCategory: string;
		categoryLabel: string;
		title: string;
		authorName: string;
		authorRole: string;
		publishedDate: string;
		readTime: string;
		heroImage: string;
		heroImageAlt: string;
		authorAvatar: string;
		aboutAuthor: {
			title: string;
			description: string;
			image: string;
			imageAlt: string;
		};
		sidebar: {
			toolkit: {
				title: string;
				description: string;
				inputPlaceholder: string;
				buttonLabel: string;
			};
			trending: {
				title: string;
				items: Array<{ title: string; category: string; image: string; href: string }>;
			};
			categories: {
				title: string;
				items: string[];
			};
		};
	};
	Content: any;
	outlineItems?: OutlineItem[];
}

const { content, Content, outlineItems = [] } = Astro.props;
const showOutline = outlineItems.length >= 2;
const article = content.article ?? content;
const sidebar = content.sidebar ?? article.sidebar;

const markdownBodyClass =
	'min-w-0 max-w-none [&_p]:mt-4 [&_p]:leading-[1.625rem] [&_p]:text-[#475569] [&_h2]:scroll-mt-[10.5rem] [&_h2]:mt-10 [&_h2]:mb-5 [&_h2]:text-3xl [&_h2]:leading-9 [&_h2]:font-bold [&_h2]:text-[#111827] lg:[&_h2]:scroll-mt-48 [&_blockquote]:my-8 [&_blockquote]:border-l-4 [&_blockquote]:border-[#0a9dfb] [&_blockquote]:bg-[#f8fafc] [&_blockquote]:p-6 [&_blockquote]:rounded-r-2xl [&_blockquote]:text-lg [&_blockquote]:leading-8 [&_blockquote]:font-medium [&_blockquote]:italic [&_blockquote]:text-[#111827] [&_ul]:mt-4 [&_ul]:grid [&_ul]:gap-3 [&_li]:relative [&_li]:pl-8 [&_li]:leading-[1.625rem] [&_li]:text-[#475569] [&_li]:before:absolute [&_li]:before:left-0 [&_li]:before:top-0.5 [&_li]:before:font-bold [&_li]:before:text-[#0a9dfb] [&_li]:before:content-["✓"] [&_strong]:font-bold [&_strong]:text-[#111827] [&_img]:mt-8 [&_img]:w-full [&_img]:rounded-2xl';
---

<section class="mx-auto w-full max-w-[1200px] px-6 pb-20 md:pb-24">
	<div class="mb-8 flex items-center gap-2 text-sm text-[rgba(71,85,105,0.6)]">
		<a href="/" class="hover:text-[#0a9dfb]">{article.breadcrumbHomeLabel}</a>
		<span><svg width="6" height="9" viewBox="0 0 6 9" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M5.07812 4.62891L1.28906 8.4375C1.09375 8.61328 0.800781 8.61328 0.625 8.4375L0.175781 7.98828C0 7.8125 0 7.51953 0.175781 7.32422L3.18359 4.29688L0.175781 1.28906C0 1.09375 0 0.800781 0.175781 0.625L0.625 0.175781C0.800781 0 1.09375 0 1.28906 0.175781L5.07812 3.98438C5.25391 4.16016 5.25391 4.45312 5.07812 4.62891Z" fill="#475569" fill-opacity="0.6"/>
</svg>
</span>
		<a href="/blog" class="hover:text-[#0a9dfb]">{article.breadcrumbInsightsLabel}</a>
		<span><svg width="6" height="9" viewBox="0 0 6 9" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M5.07812 4.62891L1.28906 8.4375C1.09375 8.61328 0.800781 8.61328 0.625 8.4375L0.175781 7.98828C0 7.8125 0 7.51953 0.175781 7.32422L3.18359 4.29688L0.175781 1.28906C0 1.09375 0 0.800781 0.175781 0.625L0.625 0.175781C0.800781 0 1.09375 0 1.28906 0.175781L5.07812 3.98438C5.25391 4.16016 5.25391 4.45312 5.07812 4.62891Z" fill="#475569" fill-opacity="0.6"/>
</svg>
</span>
		<span class="font-medium text-[#475569]">{article.breadcrumbCategory}</span>
	</div>

	<div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,792px)_302px] lg:justify-between lg:gap-12 lg:items-start">
		<article class="min-w-0">
			<div class="mb-6 inline-flex rounded-lg bg-[#e1f3ff] px-3 py-1 text-xs font-bold uppercase tracking-[0.6px] text-[#0a9dfb]">{article.categoryLabel}</div>
			<h1 class="text-[34px] font-bold leading-tight tracking-[-0.02em] md:text-[44px]">{article.title}</h1>

			<div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-y border-[rgba(226,232,240,0.8)] py-6">
				<div class="flex items-center gap-4">
					<img src={article.authorAvatar} alt={article.authorName} class="h-12 w-12 rounded-full border-2 border-white object-cover shadow-md" />
					<div>
						<p class="text-sm font-bold">{article.authorName}</p>
						<p class="text-xs text-[rgba(71,85,105,0.7)]">{article.authorRole}</p>
					</div>
				</div>
				<div class="flex items-center gap-4 text-sm text-[rgba(71,85,105,0.7)] sm:gap-6">
					<span class="inline-flex items-center gap-2">
						<svg width="13" height="14" viewBox="0 0 13 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path d="M10.9375 1.75C11.6484 1.75 12.25 2.35156 12.25 3.0625V12.6875C12.25 13.4258 11.6484 14 10.9375 14H1.3125C0.574219 14 0 13.4258 0 12.6875V3.0625C0 2.35156 0.574219 1.75 1.3125 1.75H2.625V0.328125C2.625 0.164062 2.76172 0 2.95312 0H4.04688C4.21094 0 4.375 0.164062 4.375 0.328125V1.75H7.875V0.328125C7.875 0.164062 8.01172 0 8.20312 0H9.29688C9.46094 0 9.625 0.164062 9.625 0.328125V1.75H10.9375ZM10.7734 12.6875C10.8555 12.6875 10.9375 12.6328 10.9375 12.5234V4.375H1.3125V12.5234C1.3125 12.6328 1.36719 12.6875 1.47656 12.6875H10.7734Z" fill="#475569" fill-opacity="0.7"/>
						</svg>
						{article.publishedDate}
					</span>
					<span class="inline-flex items-center gap-2">
						<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path d="M6.78125 0C10.5273 0 13.5625 3.03516 13.5625 6.78125C13.5625 10.5273 10.5273 13.5625 6.78125 13.5625C3.03516 13.5625 0 10.5273 0 6.78125C0 3.03516 3.03516 0 6.78125 0ZM6.78125 12.25C9.78906 12.25 12.25 9.81641 12.25 6.78125C12.25 3.77344 9.78906 1.3125 6.78125 1.3125C3.74609 1.3125 1.3125 3.77344 1.3125 6.78125C1.3125 9.81641 3.74609 12.25 6.78125 12.25ZM8.44922 9.40625L6.125 7.71094C6.04297 7.65625 6.01562 7.54688 6.01562 7.46484V2.95312C6.01562 2.78906 6.15234 2.625 6.34375 2.625H7.21875C7.38281 2.625 7.54688 2.78906 7.54688 2.95312V6.83594L9.35156 8.17578C9.51562 8.28516 9.54297 8.47656 9.43359 8.64062L8.91406 9.32422C8.80469 9.48828 8.61328 9.51562 8.44922 9.40625Z" fill="#475569" fill-opacity="0.7"/>
						</svg>
						{article.readTime}
					</span>
				</div>
			</div>

			<img
				src={article.heroImage}
				alt={article.heroImageAlt}
				class="mt-8 w-full rounded-3xl shadow-[0px_10px_40px_-10px_rgba(0,132,255,0.08),0px_4px_12px_-4px_rgba(0,0,0,0.04)]"
			/>

			<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(100px,150px)_minmax(0,1fr)] lg:gap-6 xl:grid-cols-[170px_minmax(0,1fr)] lg:items-start">
