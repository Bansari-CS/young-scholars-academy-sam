		<aside class="space-y-6 text-xs leading-normal text-[#475569] lg:sticky lg:top-24">
			<div class="rounded-2xl bg-gradient-to-br from-[#0a9dfb] to-[#7c3aed] p-5 text-white shadow-[0px_8px_32px_-8px_rgba(0,132,255,0.25)] md:p-6">
				<h3 class="text-[12px] font-bold uppercase tracking-[0.08em] text-white/95">{sidebar.toolkit.title}</h3>
				<p class="mt-2 text-[12px] leading-[1.55] text-[rgba(255,255,255,0.88)]">{sidebar.toolkit.description}</p>
				<input
					placeholder={sidebar.toolkit.inputPlaceholder}
					class="mt-4 w-full rounded-lg border border-[rgba(255,255,255,0.25)] bg-[rgba(255,255,255,0.12)] px-3 py-2.5 text-[12px] text-white placeholder:text-[rgba(255,255,255,0.6)]"
