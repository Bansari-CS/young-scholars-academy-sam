							id="article-outline"
							class="hidden rounded-2xl border border-slate-200 bg-white p-3 shadow-[0px_4px_12px_-4px_rgba(0,0,0,0.04)] lg:sticky lg:top-28 lg:block lg:max-h-[calc(100vh-7rem)] lg:self-start lg:overflow-y-auto xl:p-4"
							aria-label="Table of Contents"
						>
							<p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Table of Contents</p>
							<ul id="article-outline-list" class="mt-3 list-none space-y-0.5 p-0">
								{outlineItems.map((item) => (
