					<span class="text-[#0f172a]">{sidebar.trending.title}</span>
				</h4>
				<ul class="m-0 mt-4 list-none space-y-4 p-0">
					{
						sidebar.trending.items.map((item) => (
							<li class="group -ml-0.5 grid grid-cols-[0.875rem_minmax(0,1fr)] items-start gap-x-2 rounded-xl py-1 pr-1.5 pl-0 transition-colors duration-150 hover:bg-[#f8fafc]">
								<span
									class="flex w-3.5 shrink-0 justify-center pt-2 text-[1.0625rem] leading-none font-extrabold text-[#0a9dfb]"
									aria-hidden="true"
								>
									&#8226;
								</span>
								<a
									href={item.href}
									class="flex min-w-0 gap-3 no-underline opacity-100 transition-opacity duration-150 hover:opacity-95"
								>
									<img src={item.image} alt={item.title} class="h-14 w-14 shrink-0 rounded-lg object-cover" />
									<div class="min-w-0 pt-0.5">
										<p class="text-xs font-semibold leading-snug text-[#0f172a] transition-colors duration-150 group-hover:text-[#0a9dfb]">
											{item.title}
										</p>
										<p class="mt-0.5 text-[11px] font-medium tracking-wide text-[#64748b] uppercase">
											{item.category}
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="rounded-2xl border border-[rgba(226,232,240,0.5)] bg-white p-5 shadow-[0px_10px_40px_-10px_rgba(0,132,255,0.08),0px_4px_12px_-4px_rgba(0,0,0,0.04)]">
				<h4 class="text-[12px] font-bold uppercase tracking-[0.06em] text-[#64748b]">{sidebar.categories.title}</h4>
				<ul class="mt-3 mb-0 list-disc pl-[1.125rem] marker:text-[#0a9dfb]">
					{sidebar.categories.items.map((c) => (
						<li class="mb-2 pl-1.5 text-xs font-medium leading-snug text-[#475569] last:mb-0">{c}</li>
					))}
				</ul>
			</div>
		</aside>
	</div>
</section>

<script is:inline>
	(function initArticleOutline() {
		const md = document.querySelector('article [data-article-markdown]');
		const shell = document.getElementById('article-outline');
		if (!md || !shell) return;

		const slugify = (value) =>
			value
				.toLowerCase()
				.trim()
				.replace(/[^\w\s-]/g, '')
				.replace(/\s+/g, '-');

		const items = Array.from(shell.querySelectorAll('[data-outline-id]'))
			.map((li) => {
				const id = li.getAttribute('data-outline-id');
				if (!id) return null;

				let heading = document.getElementById(id);
				if (!heading) {
					const h2s = Array.from(md.querySelectorAll('h2'));
					heading =
						h2s.find((h) => {
							const text = (h.textContent || '').trim();
							return slugify(text) === id || h.id === id;
						}) ?? null;
					if (heading && !heading.id) heading.id = id;
				}

				const link = li.querySelector('a');
				if (link) {
					link.addEventListener('click', (event) => {
						event.preventDefault();
						if (heading) {
							heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
							history.replaceState(null, '', '#' + id);
						}
						setActive(id);
					});
				}

				return heading && link ? { id, heading, item: li, link } : null;
			})
			.filter(Boolean);

		if (!items.length) return;

		const scrollOffset = 140;

		function setActive(activeId) {
			for (const { id, item, link } of items) {
				const isActive = activeId !== null && id === activeId;
				if (isActive) {
					item.setAttribute('data-active', '');
					link.setAttribute('data-active', '');
					link.setAttribute('aria-current', 'location');
				} else {
					item.removeAttribute('data-active');
					link.removeAttribute('data-active');
					link.removeAttribute('aria-current');
				}
			}
		}

		function updateActiveFromScroll() {
			const scrollPos = window.scrollY + scrollOffset;
			const firstTop =
				items[0].heading.getBoundingClientRect().top + window.scrollY;

			if (scrollPos < firstTop - 24) {
				setActive(null);
				return;
			}

			let activeId = items[0].id;

			for (const { id, heading } of items) {
				const top = heading.getBoundingClientRect().top + window.scrollY;
				if (top <= scrollPos) activeId = id;
			}

			const docBottom = window.scrollY + window.innerHeight;
			const pageBottom = document.documentElement.scrollHeight;
			if (docBottom >= pageBottom - 4) {
				activeId = items[items.length - 1].id;
			}

			setActive(activeId);
		}

		let scrollTicking = false;
		window.addEventListener(
			'scroll',
			() => {
				if (scrollTicking) return;
				scrollTicking = true;
				window.requestAnimationFrame(() => {
					updateActiveFromScroll();
					scrollTicking = false;
				});
			},
			{ passive: true },
		);

		window.addEventListener('resize', updateActiveFromScroll);
		updateActiveFromScroll();
	})();
</script>
