							</a>
							<a href="#" aria-label="Twitter">
								<svg width="20" height="17" viewBox="0 0 20 17" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17.9297 4.02344C17.9297 4.21875 17.9297 4.375 17.9297 4.57031C17.9297 10 13.8281 16.2109 6.28906 16.2109C3.94531 16.2109 1.79688 15.5469 0 14.375C0.3125 14.4141 0.625 14.4531 0.976562 14.4531C2.89062 14.4531 4.64844 13.7891 6.05469 12.6953C4.25781 12.6562 2.73438 11.4844 2.22656 9.84375C2.5 9.88281 2.73438 9.92188 3.00781 9.92188C3.35938 9.92188 3.75 9.84375 4.0625 9.76562C2.1875 9.375 0.78125 7.73438 0.78125 5.74219V5.70312C1.32812 6.01562 1.99219 6.17188 2.65625 6.21094C1.52344 5.46875 0.820312 4.21875 0.820312 2.8125C0.820312 2.03125 1.01562 1.32812 1.36719 0.742188C3.39844 3.20312 6.44531 4.84375 9.84375 5.03906C9.76562 4.72656 9.72656 4.41406 9.72656 4.10156C9.72656 1.83594 11.5625 0 13.8281 0C15 0 16.0547 0.46875 16.8359 1.28906C17.7344 1.09375 18.6328 0.742188 19.4141 0.273438C19.1016 1.25 18.4766 2.03125 17.6172 2.53906C18.4375 2.46094 19.2578 2.22656 19.9609 1.91406C19.4141 2.73438 18.7109 3.4375 17.9297 4.02344Z" fill="#0A9DFB"/></svg>
							</a>
							<a href="#" aria-label="Twitter">
								<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M13.125 5.9375H6.21094C6.79688 2.46094 8.125 0 9.6875 0C11.2109 0 12.5781 2.46094 13.125 5.9375ZM5.9375 9.6875C5.9375 8.82812 5.97656 8.00781 6.05469 7.1875H13.2812C13.3594 8.00781 13.3984 8.82812 13.3984 9.6875C13.3984 10.5859 13.3594 11.4062 13.2812 12.1875H6.05469C5.97656 11.4062 5.9375 10.5859 5.9375 9.6875ZM18.5938 5.9375H14.375C14.0234 3.75 13.3984 1.75781 12.4219 0.429688C15.2344 1.25 17.5 3.32031 18.5938 5.9375ZM6.91406 0.429688C5.9375 1.75781 5.3125 3.75 4.96094 5.9375H0.742188C1.83594 3.32031 4.10156 1.25 6.91406 0.429688ZM19.0234 7.1875C19.2188 8.00781 19.3359 8.82812 19.3359 9.6875C19.3359 10.5859 19.2188 11.4062 19.0234 12.1875H14.5312C14.6094 11.3672 14.6875 10.5469 14.6875 9.6875C14.6875 8.86719 14.6094 8.00781 14.5312 7.1875H19.0234ZM4.6875 9.6875C4.6875 10.5469 4.72656 11.3672 4.80469 12.1875H0.3125C0.117188 11.4062 0 10.5859 0 9.6875C0 8.82812 0.117188 8.00781 0.3125 7.1875H4.80469C4.72656 8.00781 4.6875 8.86719 4.6875 9.6875ZM6.21094 13.4375H13.125C12.5781 16.9531 11.2109 19.375 9.6875 19.375C8.125 19.375 6.79688 16.9531 6.21094 13.4375ZM12.4219 18.9844C13.3984 17.6562 14.0625 15.6641 14.375 13.4375H18.5938C17.5 16.0938 15.2344 18.1641 12.4219 18.9844ZM0.742188 13.4375H4.96094C5.3125 15.6641 5.9375 17.6562 6.91406 18.9844C4.10156 18.1641 1.83594 16.0938 0.742188 13.4375Z" fill="#0A9DFB"/>
								</svg>
