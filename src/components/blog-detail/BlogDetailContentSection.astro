										>
											{item.title}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}

				<div class={markdownBodyClass} data-article-markdown>
					<Content />
				</div>
			</div>

			<div class="mt-10 rounded-3xl border border-[rgba(226,232,240,0.5)] bg-white p-6 shadow-[0px_10px_40px_-10px_rgba(0,132,255,0.08),0px_4px_12px_-4px_rgba(0,0,0,0.04)] md:p-8">
