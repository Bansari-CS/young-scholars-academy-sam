---
import GradientCtaSection from '../common/GradientCtaSection.astro';
const arrowRightIcon = '/assets/course-detail/icon-arrow-right.svg';

interface Props {
	content: {
		title: string;
		description: string;
		primaryCtaLabel: string;
		primaryCtaHref: string;
		secondaryCtaLabel: string;
		secondaryCtaHref: string;
	};
}
const { content } = Astro.props;
---

<GradientCtaSection
	variant="soft"
	title={content.title}
	description={content.description}
	primaryCta={{ label: content.primaryCtaLabel, href: content.primaryCtaHref }}
	primaryTrailingIcon={arrowRightIcon}
	secondaryCta={{ label: content.secondaryCtaLabel, href: content.secondaryCtaHref }}
	primaryStyle="brand"
	showPrimaryArrow={true}
/>
